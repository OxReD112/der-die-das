{"format_version":1,"partition":30585,"records":{"-keit":{"entries":[["-keit",null,"/kaɪ̯t/","Rebracketing of two suffixes in Upper German dialects of Middle High German: -ec (modern -ig) and -heit: -ec-heit was interpreted as -e-keit. Later this phenomenon spread to other suffixes, and even to Central German dialects, in which the equivalents of -ig had never been pronounced with a final [k]-sound. (Compare the modern German Standard German pronunciation of -ig [-ɪç].) However, in some northern dialects of Central German, like Ripuarian, -keit is still absent or has only recently been introduced from standard German. Compare Saterland Frisian -igaid."]],"senses":[[5910,"-keit","suffix","alternative form of -heit",0]],"inflections":[["-keit","-heit","alternative"]]},"butanols":{"entries":[["butanols",null,null,null]],"senses":[[223571,"butanols","noun","genitive singular of Butanol",0]],"inflections":[["butanols","butanol","genitive"]]},"eisenhüttenstadt":{"entries":[["eisenhüttenstadt",null,"/ˌaɪ̯zənˈhʏtənˌʃtat/","1961, from Eisen (“iron”) + Hütte (“works, metallurgical plant”) + -n- + Stadt (“town, city”)."]],"senses":[[669764,"eisenhüttenstadt","name","a town in Brandenburg, Germany",0]]},"erhardt":{"entries":[["erhardt",null,null,null]],"senses":[[63352,"erhardt","name","a male given name, variant of Erhard",0],[63353,"erhardt","name","a surname transferred from the given name",1]],"inflections":[["erhardt","erhard","alternative"]]},"faschistoider":{"entries":[["faschistoider",null,null,null]],"senses":[[468330,"faschistoider","adj","comparative degree of faschistoid",0],[468331,"faschistoider","adj","inflection of faschistoid:",1],[468332,"faschistoider","adj","strong/mixed nominative masculine singular",2],[468333,"faschistoider","adj","strong genitive/dative feminine singular",3],[468334,"faschistoider","adj","strong genitive plural",4]],"inflections":[["faschistoider","faschistoid","masculine,nominative,singular,strong"]]},"geboten":{"entries":[["geboten",nu
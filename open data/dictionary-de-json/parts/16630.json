{"format_version":1,"partition":16630,"records":{"-sen":{"entries":[["-sen",null,"/sən/","From Middle High German -sen, byform of -(ez)zen, from Old High German -ezzen, -azzen, from Proto-West Germanic *-attjan, from Proto-Germanic *-atjaną. In some cases merged with unrelated Old High German -isōn, from Proto-Germanic *-isōną. Modern formations often interact with the nominal suffix -s in such a way that it is impossible to say whether the derivation is denominal or deverbal (e.g. stuppen > Stups > stupsen or stuppen > stupsen > Stups)."]],"senses":[[42762,"-sen","suffix","Verbal suffix that expresses an action being intensified or stretched by iteration.",0],[42763,"-sen","suffix","Placename suffix found in northern Germany.",1]],"inflections":[["-sen","-hausen","alternative"]]},"abnudeln":{"entries":[["abnudeln",null,null,"ab- + nudeln",null,"haben"]],"senses":[[632943,"abnudeln","verb","to wear out",0,null,["colloquial"],null,"transitive"],[632944,"abnudeln","verb","to bang out (to perform or relate in a tired, lackluster manner)",1,null,["colloquial"],null,"transitive"]]},"hundshaien":{"entries":[["hundshaien",null,null,null]],"senses":[[399189,"hundshaien","noun","dative plural of Hundshai",0,"m"]],"inflections":[["hundshaien","hundshai","dative,definite,plural"]]},"kippten um":{"entries":[["kippten um",null,null,null]],"senses":[[497153,"kippten um","verb","inflection of umkippen:",0],[497154,"kippten um","verb","first/third-person plural preterite",1],[497155,"kippten um","verb","first/third-person plural subjunctive II",2]]},"silicatischen":{"entries":[["silicatischen",null,null,null]],"senses":[[213169,"silicatischen","adj","inflection of silicatisch:",0],[213170,"silicatischen","adj","strong genitive masculine/neuter singular",1],[213171,"silicatischen","adj","weak/mixed genitive/dative all-gender singular",2],[213172,"silicatischen","adj","strong/weak/mixed accusative masculine singular",3],[213173,"silicatischen","adj","strong dative plural",4],[213174,
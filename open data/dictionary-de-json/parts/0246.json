{"format_version":1,"partition":246,"records":{"-sen":{"entries":[["-sen",null,"/sən/","From Middle High German -sen, byform of -(ez)zen, from Old High German -ezzen, -azzen, from Proto-West Germanic *-attjan, from Proto-Germanic *-atjaną. In some cases merged with unrelated Old High German -isōn, from Proto-Germanic *-isōną. Modern formations often interact with the nominal suffix -s in such a way that it is impossible to say whether the derivation is denominal or deverbal (e.g. stuppen > Stups > stupsen or stuppen > stupsen > Stups)."]],"senses":[[42762,"-sen","suffix","Verbal suffix that expresses an action being intensified or stretched by iteration.",0],[42763,"-sen","suffix","Placename suffix found in northern Germany.",1]],"inflections":[["-sen","-hausen","alternative"]]},"a-a":{"entries":[["a-a",null,null,null,{"g":"n:f","decl":"|||s/|-|-|-|-"}]],"senses":[[591843,"a-a","noun","alternative spelling of Aa (“feces, poop”)",0,"n:f"]],"inflections":[["a-a","aa","alternative"]]},"ablebenswahrscheinlichkeit":{"entries":[["ablebenswahrscheinlichkeit",null,null,"Ableben + -s- + Wahrscheinlichkeit",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[709200,"ablebenswahrscheinlichkeit","noun","probability of death",0,"f"]]},"abnudeln":{"entries":[["abnudeln",null,null,"ab- + nudeln"]],"senses":[[632943,"abnudeln","verb","to wear out",0,null,["colloquial"]],[632944,"abnudeln","verb","to bang out (to perform or relate in a tired, lackluster manner)",1,null,["colloquial"]]]},"achtzehnjähriger":{"entries":[["achtzehnjähriger",null,"[ˈaxt͡seːnˌjɛːʁɪɡɐ]","Nominalization of achtzehnjährig.",{"g":"m","decl":"/1|1n|1m/1n|1n|1/1n|1/1n|1n|/1n"}]],"senses":[[679600,"achtzehnjähriger","adj","inflection of achtzehnjährig:",0],[679601,"achtzehnjähriger","adj","strong/mixed nominative masculine singular",1],[679602,"achtzehnjähriger","adj","strong genitive/dative feminine singular",2],[679603,"achtzehnjähriger","adj","strong genitive plural",3],[679604,"achtzehnjähriger","noun","an eight
dish לעבעדיק (lebedik), and in some dialectal German forms such as Hunsrik levendich. The shift to the second syllable is first attested in the 16th century; it had established itself as the sole standard by the mid-18th century. While such shifts happened more often in modern German (compare Forelle, Holunder, Wacholder), the case of lebendig is peculiar in that it is a transparent formation rather than a word whose derivation had become obscure."]],"senses":[[35488,"lebendig","adj","living, alive, animate",0],[35489,"lebendig","adj","lively, vivacious, spirited, animated, vibrant, active, agile",1]],"related_forms":[[41682,"lebendig","quicklebendig","derived"],[41683,"lebendig","springlebendig","derived"],[41684,"lebendig","leben","related"],[41685,"lebendig","lebend","related"],[41686,"lebendig","lebendiger","related"],[41687,"lebendig","lebensvoll","related"],[41688,"lebendig","lebhaft","related"]]},"nadelstreifenanzüge":{"entries":[["nadelstreifenanzüge",null,null,null]],"senses":[[690163,"nadelstreifenanzüge","noun","nominative/accusative/genitive plural of Nadelstreifenanzug",0]],"inflections":[["nadelstreifenanzüge","nadelstreifenanzug","plural"]]},"nationalliteratur":{"entries":[["nationalliteratur",null,"/nat͡si̯oˈnaːl.lɪtəʁaˌtuːɐ̯/","From national + Literatur.",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[670105,"nationalliteratur","noun","national literature (the entirety of a nation's literary works of high artistic value)",0,"f",null,null,null,null,["literature"]]]},"säg ab":{"entries":[["säg ab",null,null,null]],"senses":[[390752,"säg ab","verb","singular imperative of absägen",0],[390753,"säg ab","verb","first-person singular present of absägen",1,null,["colloquial"]]]},"türkinnen":{"entries":[["türkinnen",null,null,null]],"senses":[[46888,"türkinnen","noun","plural of Türkin",0]],"inflections":[["türkinnen","türkin","plural"]]},"froschet":{"inflections":[["froschet","froschen","plural,second-person,subjunctive,subjunctive-i"]]},"hellrosaes":{"inf
{"format_version":1,"partition":5498,"records":{"elektrostatischerer":{"entries":[["elektrostatischerer",null,null,null]],"senses":[[172130,"elektrostatischerer","adj","inflection of elektrostatisch:",0],[172131,"elektrostatischerer","adj","strong/mixed nominative masculine singular comparative degree",1],[172132,"elektrostatischerer","adj","strong genitive/dative feminine singular comparative degree",2],[172133,"elektrostatischerer","adj","strong genitive plural comparative degree",3]]},"erübrigen":{"entries":[["erübrigen",null,null,"From er- + übrig (“remaining, left over”) + -en, hence “to leave over, have as surplus”. Accordingly, the reflexive sich erübrigen actually means “to be left, remain” and one would originally say es erübrigt sich, etwas zu tun in the sense of “XY still remains to be done”. The quite opposite contemporary sense seems to emerge around 1900. It probably developed through confusion with the active verb in the sense of “to spare”. Moreover, that which is left to be done last is often the least important thing and may in fact become redundant through developments in the meantime.",null,"haben"]],"senses":[[241934,"erübrigen","verb","to leave over, have extra, put aside, spare",0,null,null,null,"transitive"],[241935,"erübrigen","verb","to be or become gratuitous, redundant, no longer necessary",1,null,null,"acc"],[241936,"erübrigen","verb","to be left, to remain to be done",2,null,null,null,"intransitive"]]},"operieret":{"entries":[["operieret",null,null,null]],"senses":[[129371,"operieret","verb","second-person plural subjunctive I of operieren",0]],"inflections":[["operieret","operieren","plural,second-person,subjunctive,subjunctive-i"]]},"peniblen":{"entries":[["peniblen",null,null,null]],"senses":[[580668,"peniblen","adj","inflection of penibel:",0],[580669,"peniblen","adj","strong genitive masculine/neuter singular",1],[580670,"peniblen","adj","weak/mixed genitive/dative all-gender singular",2],[580671,"peniblen","adj","strong/weak/mixed
{"format_version":1,"partition":7690,"records":{"-erweise":{"entries":[["-erweise",null,"/ɐˌvaɪ̯zə/","From the genitive feminine singular adjective ending -er and the feminine noun Weise. This was originally an adverbial genitive first used in Middle High German. For example, lustiger Weise → lustig + -erweise → lustigerweise. Adverbs formed this way represent univerbations of genitive absolute adjective-noun phrases."]],"senses":[[371387,"-erweise","suffix","Used to form adverbs from adjectives and participles; these adverbs are used to modify phrases or sentences. Cognate with English -wise.",0]]},"abgefunden":{"entries":[["abgefunden",null,null,null]],"senses":[[125311,"abgefunden","verb","past participle of abfinden",0]],"inflections":[["abgefunden","abfinden","participle,past"]]},"abgestürzt":{"entries":[["abgestürzt",null,null,null]],"senses":[[83468,"abgestürzt","verb","past participle of abstürzen",0]],"inflections":[["abgestürzt","abstürzen","participle,past"]]},"anschaulicherer":{"entries":[["anschaulicherer",null,null,null]],"senses":[[158706,"anschaulicherer","adj","inflection of anschaulich:",0],[158707,"anschaulicherer","adj","strong/mixed nominative masculine singular comparative degree",1],[158708,"anschaulicherer","adj","strong genitive/dative feminine singular comparative degree",2],[158709,"anschaulicherer","adj","strong genitive plural comparative degree",3]],"inflections":[["anschaulicherer","anschaulich","comparative,masculine,nominative,singular,strong,without-article"]]},"ausländerfreiem":{"entries":[["ausländerfreiem",null,null,null]],"senses":[[428873,"ausländerfreiem","adj","strong dative masculine/neuter singular of ausländerfrei",0]],"inflections":[["ausländerfreiem","ausländerfrei","dative,masculine,singular,strong,without-article"]]},"beglaubigen":{"entries":[["beglaubigen",null,"[bəˈɡlaʊ̯bɪɡn̩]","From be- + Glaube + -ig + -en.",{"g":"n","decl":"|||s|-|-|-|-"}]],"senses":[[592607,"beglaubigen","verb","to authenticate",0],[592608,"begla
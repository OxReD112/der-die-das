{"format_version":1,"partition":13588,"records":{"keimen":{"entries":[["keimen",null,"/ˈkaɪ̯mən/","From Middle High German kīmen, from kīm, kīme (“sprout”) (see Keim). Supplanted or merged with Middle High German kīnen (“to sprout”), from Old High German kīnan, from Proto-Germanic *kīnaną (“to germinate; sprout”).",null,"haben"]],"senses":[[5494,"keimen","verb","to sprout, germinate",0,null,null,null,"intransitive"],[5495,"keimen","verb","to stir (e.g. hope)",1,null,null,null,"intransitive"],[5496,"keimen","verb","to form (e.g. thought, decision)",2,null,null,null,"intransitive"],[5497,"keimen","verb","to awaken (e.g. love, yearning)",3,null,null,null,"intransitive"],[5498,"keimen","noun","dative plural of Keim",4,"m"]],"related_forms":[[8132,"keimen","keim","related"],[8133,"keimen","auskeimen","related"],[8134,"keimen","verkeimen","related"],[8135,"keimen","keimling","related"]],"inflections":[["keimen","keim","dative,definite,plural"]]},"rebstockes":{"entries":[["rebstockes",null,null,null]],"senses":[[168232,"rebstockes","noun","genitive singular of Rebstock",0]],"inflections":[["rebstockes","rebstock","genitive"]]},"rotscheitelreiher":{"entries":[["rotscheitelreiher",null,null,"Rot (“red”) + Scheitel (“crown”) + Reiher (“heron”)",{"g":"m","decl":"|||s|||n|"}]],"senses":[[375266,"rotscheitelreiher","noun","Japanese night heron",0,"m"]]},"toskana":{"entries":[["toskana",null,null,"Borrowed from Italian Toscana."]],"senses":[[9662,"toskana","name","Tuscany (an administrative region of Italy, located north of Lazio and south of Emilia-Romagna)",0]]},"wollgeborn":{"entries":[["wollgeborn",null,null,null]],"senses":[[383285,"wollgeborn","adj","obsolete spelling of wohlgeboren",0,null,["obsolete"]]],"inflections":[["wollgeborn","wohlgeboren","alternative,obsolete"]]},"götzendienste":{"inflections":[["götzendienste","götzendienst","plural"]]},"selbstbildern":{"inflections":[["selbstbildern","selbstbild","dative,definite,plural"]]}}}
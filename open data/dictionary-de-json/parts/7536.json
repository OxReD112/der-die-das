]],"inflections":[["schwemmen","schwemme","plural"]]},"topasenen":{"entries":[["topasenen",null,null,null]],"senses":[[415225,"topasenen","adj","inflection of topasen:",0],[415226,"topasenen","adj","strong genitive masculine/neuter singular",1],[415227,"topasenen","adj","weak/mixed genitive/dative all-gender singular",2],[415228,"topasenen","adj","strong/weak/mixed accusative masculine singular",3],[415229,"topasenen","adj","strong dative plural",4],[415230,"topasenen","adj","weak/mixed all-case plural",5]],"inflections":[["topasenen","topasen","genitive,masculine,singular,strong,without-article"]]},"vor sich hin":{"entries":[["vor sich hin",null,"/ˌfoːr zɪç ˈhɪn/","Literally, “in front of oneself along”.\nUntil the earlier 19th century the prepositions für (“for”) and vor (“before”) were not distinguished strictly. In this idiom particularly, it may be questioned which of the two is the more proper interpretation. Vor does make good enough sense with verbs such as vor sich hin singen (“to sing to oneself”), but on the whole für may actually be considered more appropriate. Irrespective of this, only vor is now standard and has generally established itself."]],"senses":[[710079,"vor sich hin","adv","to/for oneself (alone, not directed at anyone else)",0],[710080,"vor sich hin","adv","slowly but steadily, without being bothered or interrupted by anyone",1]]},"zensur":{"entries":[["zensur",null,"/t͡sɛnˈzuːɐ̯/",null,{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[25806,"zensur","noun","censorship",0,"f"],[25807,"zensur","noun","mark, grade",1,"f",null,null,null,null,["education"]]]},"beyle":{"inflections":[["beyle","beyl","plural"]]},"bezeichnerinnen":{"inflections":[["bezeichnerinnen","bezeichnerin","plural"]]},"hinuntergekonnt":{"inflections":[["hinuntergekonnt","hinunterkönnen","participle,past"]]},"schwellkörpern":{"inflections":[["schwellkörpern","schwellkörper","dative,definite,plural"]]}}}
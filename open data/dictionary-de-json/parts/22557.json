{"format_version":1,"partition":22557,"records":{"achsel":{"entries":[["achsel",null,"/ˈaksəl/","From Old High German ahsala, ahsla, from Proto-Germanic *ahslō, from Proto-Indo-European *h₂eḱs- (“axis”). Cognate with Old Norse ǫxl (“shoulder”) and ǫxull (“axle”) (whence Danish aksel, Icelandic öxl), English axle. Also cognate with Latin āxilla (“shoulder joint”), Sanskrit अक्ष (ákṣa, “axle”).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[17877,"achsel","noun","armpit, axilla (cavity under the shoulder)",0,"f"],[17878,"achsel","noun","shoulder; shoulder joint (see usage notes below)",1,"f"]],"related_forms":[[26858,"achsel","achselband","related"],[26859,"achsel","achselklappe","related"],[26860,"achsel","achselschnur","related"],[26861,"achsel","achselstück","related"]]},"beschließen":{"entries":[["beschließen",null,"/bəˈʃliːsən/","From Middle High German besliezen, from Old High German bisliozan, from Proto-West Germanic *bisleutan. Equivalent to be- + schließen. Cognate with Dutch besluiten.",{"g":"n","decl":"|||s|-|-|-|-"},"haben"]],"senses":[[34325,"beschließen","verb","to conclude, end; to terminate",0],[34326,"beschließen","verb","to resolve, decide, determine",1],[34327,"beschließen","verb","to confine, enclose; to close up",2,null,["archaic"]],[34328,"beschließen","noun","gerund of beschließen",3,"n"]],"related_forms":[[41136,"beschließen","beschließen","derived"],[41137,"beschließen","beschließer","derived"],[41138,"beschließen","beschließung","derived"],[41139,"beschließen","beschließend","derived"],[41140,"beschließen","beschlossen","derived"],[41141,"beschließen","beschluss","related"]]},"dachstuhles":{"entries":[["dachstuhles",null,null,null]],"senses":[[499824,"dachstuhles","noun","genitive of Dachstuhl",0,"m"]],"inflections":[["dachstuhles","dachstuhl","genitive"]]},"pogatsche":{"entries":[["pogatsche",null,null,"Borrowed from Hungarian pogácsa.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[613933,"pogatsche","noun","A type of small pancake.",0,"f",["Au
{"format_version":1,"partition":9184,"records":{"häuslich":{"entries":[["häuslich",null,"/ˈhɔɪ̯slɪç/","From Middle High German hiuslīche, hiuslīchen, hūslīche. Equivalent to Haus + -lich."]],"senses":[[236285,"häuslich","adj","domestic, homely, household",0],[236286,"häuslich","adj","domesticated",1]],"related_forms":[[53357,"häuslich","häusliche gewalt","derived"],[53358,"häuslich","häuslichkeit","derived"]]},"kündbar":{"entries":[["kündbar",null,"/ˈkʏntbaːr/","Historically from künden + -bar, where künden is used in the archaic/regional sense of “to terminate, resign, dismiss”, for which otherwise kündigen. Synchronically also analysable as a contraction of underlying *kündigbar; compare a similar case in unleugbar for *unleugenbar, from leugnen."]],"senses":[[511471,"kündbar","adj","terminable (capable of being cancelled, terminated)",0],[511472,"kündbar","adj","capable of being dismissed",1]],"related_forms":[[57890,"kündbar","unkündbar","derived"]]},"landessprache":{"entries":[["landessprache",null,"[ˈlandəsˌʃpʁaːχə]","Land + -es- + Sprache",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[596216,"landessprache","noun","national language",0,"f"]]},"quellwolke":{"entries":[["quellwolke",null,null,null,{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[92852,"quellwolke","noun","cumulus (a large white puffy cloud)",0,"f"]]},"renitentes":{"entries":[["renitentes",null,null,null]],"senses":[[117471,"renitentes","adj","strong/mixed nominative/accusative neuter singular of renitent",0]],"inflections":[["renitentes","renitent","neuter,nominative,singular,strong,without-article"]]},"unvollkommenem":{"entries":[["unvollkommenem",null,null,null]],"senses":[[571620,"unvollkommenem","adj","strong dative masculine/neuter singular of unvollkommen",0]],"inflections":[["unvollkommenem","unvollkommen","dative,masculine,singular,strong,without-article"]]},"laserkräuter":{"inflections":[["laserkräuter","laserkraut","plural"]]},"unterwieset":{"inflections":[["unterwieset","unterweisen","forma
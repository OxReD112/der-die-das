{"format_version":1,"partition":1656,"records":{"'n":{"entries":[["'n",null,"/n/","Contraction of ein. Like virtually all traditional German dialects, colloquial standard German distinguishes the indefinite article from the numeral for \"one\". The specific form 'n has spread from the North southward and is thus of chiefly Low German origin. Most High German dialects use forms without the final -n, such as [ə] or [a], at least for the basic form (i.e. the masculine and neuter nominative). These pronunciations are sometimes heard in colloquial standard German as well, but 'n is clearly the commonest form."]],"senses":[[6740,"'n","article","alternative form of ein (“a, an”)",0,null,["colloquial"]],[6741,"'n","article","alternative form of einen (“a, an”)",1,null,["colloquial"]],[6742,"'n","adv","short for denn (used for general emphasis)",2,null,["colloquial"]]],"related_forms":[[9903,"'n","so'n","derived"]],"inflections":[["'n","ein","alternative,informal"]]},"abbildungsfehler":{"entries":[["abbildungsfehler",null,null,"From Abbildung + -s- + Fehler.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[600282,"abbildungsfehler","noun","aberration, image defect",0,"m"]]},"ana-":{"entries":[["ana-",null,null,"From Ancient Greek ἀνα- (ana-), from ἀνά (aná, “on, up, above, throughout”)."]],"senses":[[22159,"ana-","prefix","ana-",0]]},"baumhöhlen":{"entries":[["baumhöhlen",null,null,null]],"senses":[[398511,"baumhöhlen","noun","plural of Baumhöhle",0,"f"]],"inflections":[["baumhöhlen","baumhöhle","plural"]]},"bestechungsgeldes":{"entries":[["bestechungsgeldes",null,null,null]],"senses":[[49124,"bestechungsgeldes","noun","genitive singular of Bestechungsgeld",0]],"inflections":[["bestechungsgeldes","bestechungsgeld","genitive"]]},"e-reader":{"entries":[["e-reader",null,"/ˈiːriːdɐ/","Unadapted borrowing from English e-reader.",{"w":"E-Reader","g":"m","decl":"|||s|||n|"}]],"senses":[[671555,"e-reader","noun","e-reader",0,"m"]]},"empfingen":{"entries":[["empfingen",null,"/ˈɛmp͡fɪŋən/",
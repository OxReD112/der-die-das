{"format_version":1,"partition":22151,"records":{"baumwolle":{"entries":[["baumwolle",null,"/ˈbaʊ̯mˌvɔlə/","From Middle High German boumwolle, from Late Old High German boumwolla. By surface analysis, Baum (“tree”) + Wolle (“wool”). Perhaps based on Herodotus’ description of wool-bearing trees in India; compare Ancient Greek ἐριόξυλον (erióxulon, “cotton”, literally “wood/tree-wool”) and Latin linum xylinum (“cotton”, literally “wood/tree-flax”).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[45185,"baumwolle","noun","cotton (plant)",0,"f"],[45186,"baumwolle","noun","cotton (thread or fabric made from said plant)",1,"f"]],"related_forms":[[45673,"baumwolle","baumwollen","derived"],[45674,"baumwolle","baumwollbluse","derived"],[45675,"baumwolle","baumwollernte","derived"],[45676,"baumwolle","baumwollfeld","derived"],[45677,"baumwolle","baumwollhandschuh","derived"],[45678,"baumwolle","baumwollhemd","derived"],[45679,"baumwolle","baumwollhose","derived"],[45680,"baumwolle","baumwollkleid","derived"],[45681,"baumwolle","baumwolllaken","derived"],[45682,"baumwolle","baumwollmantel","derived"],[45683,"baumwolle","baumwollplantage","derived"],[45684,"baumwolle","baumwollpullover","derived"],[45685,"baumwolle","baumwollsocke","derived"],[45686,"baumwolle","baumwollstoff","derived"],[45687,"baumwolle","baumwolltuch","derived"]]},"franzbrot":{"entries":[["franzbrot",null,null,null,{"g":"n","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[716848,"franzbrot","noun","(French) white bread",0,"n",["archaic"]]]},"kollidierend":{"entries":[["kollidierend",null,null,null]],"senses":[[72919,"kollidierend","verb","present participle of kollidieren",0]],"inflections":[["kollidierend","kollidieren","participle,present"]]},"kränkungen":{"entries":[["kränkungen",null,null,null]],"senses":[[388334,"kränkungen","noun","plural of Kränkung",0]],"inflections":[["kränkungen","kränkung","plural"]]},"neunundzwanzigminütig":{"entries":[["neunundzwanzigminütig",null,"/ˈnɔɪ̯nʊnt͡svant͡sɪçmiˌnyːtɪç/","neunund
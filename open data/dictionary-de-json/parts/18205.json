{"format_version":1,"partition":18205,"records":{"aerodynamischstes":{"entries":[["aerodynamischstes",null,null,null]],"senses":[[335479,"aerodynamischstes","adj","strong/mixed nominative/accusative neuter singular superlative degree of aerodynamisch",0]],"inflections":[["aerodynamischstes","aerodynamisch","neuter,nominative,singular,strong,superlative,without-article"]]},"antirassismus":{"entries":[["antirassismus",null,null,"From anti- + Rassismus.",{"g":"m","decl":"||||2en|2en|2en|2en"}]],"senses":[[622817,"antirassismus","noun","antiracism",0,"m"]]},"hüne":{"entries":[["hüne",null,"/ˈhyːnə/","From German Low German Hüne (“giant, hulk”), from Middle Low German hǖne (“hulk; Hun”), ultimately from the self-designation of the historic Huns. Compare Middle High German hiune, hūne (“Hun; Hungarian”), from Old High German hūn (“Hun”).\nThe High German equivalent Heune became obsolete in Early Modern German and was superseded by the Latin-derived Ungar (“Hungarian”) and Hunne (“Hun”). However, Hüne remained common as a term for “giant, hulk” both in mythic and everyday contexts in many parts of northern Germany, whence it was reintroduced to the written language in the 17th and 18th centuries.",{"g":"m","decl":"|n|n|n|n|n|n|n"}]],"senses":[[18627,"hüne","noun","giant, hulk (tall man, typically also muscular)",0,"m"],[18628,"hüne","noun","giant",1,"m",null,null,null,null,["mythology"]]],"related_forms":[[28360,"hüne","hünenhaft","derived"],[28361,"hüne","hunne","related"],[28362,"hüne","hünenbett","related"],[28363,"hüne","hünengrab","related"],[28364,"hüne","hünenstein","related"],[28365,"hüne","hinkelstein","related"]]},"marketenderzelts":{"entries":[["marketenderzelts",null,"/maʁkəˈtɛndɐˌt͡sɛlt͡s/",null]],"senses":[[687504,"marketenderzelts","noun","genitive singular of Marketenderzelt",0]],"inflections":[["marketenderzelts","marketenderzelt","genitive"]]},"myotropes":{"entries":[["myotropes",null,null,null]],"senses":[[522359,"myotropes","adj","strong/mixed nominativ
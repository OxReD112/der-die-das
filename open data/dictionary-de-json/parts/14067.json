{"format_version":1,"partition":14067,"records":{"auster":{"entries":[["auster",null,"/ˈaʊ̯stɐ/","Attested a few times in Old High German, but only much later effectively introduced via Middle Low German ūster, from Middle Dutch oester. The Dutch word is borrowed from Latin ostrea, itself from Ancient Greek ὄστρεον (óstreon) (pertaining to ὀστέον (ostéon, “bone”), ὄστρακον (óstrakon, “shell”)). Compare Old English ostre, Old French oistre (modern French huître).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[14888,"auster","noun","oyster",0,"f"]]},"diskursen":{"entries":[["diskursen",null,null,null]],"senses":[[352958,"diskursen","noun","dative plural of Diskurs",0,"m"]],"inflections":[["diskursen","diskurs","dative,definite,plural"]]},"diverser":{"entries":[["diverser",null,null,null]],"senses":[[364633,"diverser","adj","comparative degree of divers",0],[364634,"diverser","adj","inflection of divers:",1],[364635,"diverser","adj","strong/mixed nominative masculine singular",2],[364636,"diverser","adj","strong genitive/dative feminine singular",3],[364637,"diverser","adj","strong genitive plural",4]],"inflections":[["diverser","divers","masculine,nominative,singular,strong"]]},"entscheidenderer":{"entries":[["entscheidenderer",null,null,null]],"senses":[[157044,"entscheidenderer","adj","inflection of entscheidend:",0],[157045,"entscheidenderer","adj","strong/mixed nominative masculine singular comparative degree",1],[157046,"entscheidenderer","adj","strong genitive/dative feminine singular comparative degree",2],[157047,"entscheidenderer","adj","strong genitive plural comparative degree",3]],"inflections":[["entscheidenderer","entscheidend","comparative,masculine,nominative,singular,strong,without-article"]]},"impeller":{"entries":[["impeller",null,"/ɪmˈpɛlɐ/","Borrowed from English impeller.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[628392,"impeller","noun","impeller",0,"m"]]},"kachel":{"entries":[["kachel",null,"/ˈkaxəl/","From Middle High German kachel, kachele, fr
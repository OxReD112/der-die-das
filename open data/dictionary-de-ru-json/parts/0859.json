южно-бранденбургскому предприятию, содержался запрещённый гормон роста медрокси-прогестерон-ацетат (МПА).","bold_translation_offsets":[[169,172]],"ref":"// «Der Tagesspiegel», 19 июля 2002 г. [Korpora im DWDS]"}]}}]}],"abrüsten":[{"record_id":25348,"word":"abrüsten","pos":"verb","source_url":"https://ru.wiktionary.org/wiki/abr%C3%BCsten","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["разоружаться"],"id":"ru-abrüsten-de-verb-~v8rjVXB"}}]}],"Gelehrter":[{"record_id":25771,"word":"Gelehrter","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Gelehrter","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["учёный"],"id":"ru-Gelehrter-de-noun-xSyPpdcb"}}]}],"filtern":[{"record_id":26417,"word":"filtern","pos":"verb","source_url":"https://ru.wiktionary.org/wiki/filtern","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["фильтровать"],"id":"ru-filtern-de-verb-oMTe9LKX"}}]}],"gründsätzlich":[{"record_id":26467,"word":"gründsätzlich","pos":"adj","source_url":"https://ru.wiktionary.org/wiki/gr%C3%BCnds%C3%A4tzlich","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["принципиальный"],"id":"ru-gründsätzlich-de-adj-faI1mEjQ"}}]}],"durchfliegen":[{"record_id":29261,"word":"durchfliegen","pos":"verb","source_url":"https://ru.wiktionary.org/wiki/durchfliegen","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["пролетать (сквозь что-л.)"],"id":"ru-durchfliegen-de-verb-0E8JMwWM"}},{"sense_index":1,"display_status":"translation","data":{"glosses":["разг. срезаться, провалиться (на экзамене)"],"id":"ru-durchfliegen-de-verb-SlteqUGt"}}]}],"Biegeversuch":[{"record_id":29442,"word":"Biegeversuch","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Biegeversuch","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["испытание на изгиб"],"id":"ru-Biegeversuch-de-noun-Ulx0IxjM"}}]}],"Lernvermögen":[{"record_id":33758,"word":
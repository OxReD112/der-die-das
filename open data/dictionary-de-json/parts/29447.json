tries":[["ludwig",null,"/ˈluːtvɪç/","From Middle High German Ludewig, from Old High German Ludhuwīg, Hludwig, *Hlūtwīg, from Proto-West Germanic *Hlūdawīg. The first element is (h)lūt (“famed; loud”) (whence modern German laut), from Proto-Germanic *hlūdaz, *hlūþaz (whence also English loud), from Proto-Indo-European *ḱlew- (“to hear”). The second element is Old High German wīg (“battle, strife”) from Proto-Germanic *wīgą.\nThe name is attested as Ludhuwīg in the Straßburger Eide of 842 (where it contrasts with Old French Lodhuuig and Latin Lodhuuic), and as Hludwig in the Rhine Franconian Old High German of the Ludwigslied of 881 (where it contrasts with Latin Hluduicus). Compare Clovis, Dutch Lodewijk, English Lewis, and French Louis."]],"senses":[[6873,"ludwig","name","a male given name from Middle High German, feminine equivalent Luise, Luisa, Louise, or Louisa; variant forms Lutz, Luis, Louis",0],[6874,"ludwig","name","a surname originating as a patronymic",1]]},"panchronischem":{"entries":[["panchronischem",null,null,null]],"senses":[[528936,"panchronischem","adj","strong dative masculine/neuter singular of panchronisch",0]],"inflections":[["panchronischem","panchronisch","dative,masculine,singular,strong,without-article"]]},"röntgenfluoreszenzspektrometrie":{"entries":[["röntgenfluoreszenzspektrometrie",null,null,null,{"g":"f","decl":"||||-|-|-|-"}]],"senses":[[686726,"röntgenfluoreszenzspektrometrie","noun","X-ray fluorescence spectrometry",0,"f"]]},"rüsterner":{"entries":[["rüsterner",null,null,null]],"senses":[[541501,"rüsterner","adj","inflection of rüstern:",0],[541502,"rüsterner","adj","strong/mixed nominative masculine singular",1],[541503,"rüsterner","adj","strong genitive/dative feminine singular",2],[541504,"rüsterner","adj","strong genitive plural",3]],"inflections":[["rüsterner","rüstern","masculine,nominative,singular,strong"]]},"sandboxen":{"entries":[["sandboxen",null,null,null]],"senses":[[113959,"sandboxen","noun","plural of Sandbox",0]],"inf
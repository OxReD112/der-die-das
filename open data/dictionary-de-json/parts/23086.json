76040,"jahrhundertealt","adj","centuries-old",0]]},"kürschner":{"entries":[["kürschner",null,"/ˈkʏʁʃnəʁ/","Inherited from Middle High German kürsenære, from Old High German kursināri, derived from kursina, a borrowing from Proto-Slavic *kъrzьno. Equivalent to obsolete Kürsen, Kürschen (“fur coat / furcoat”) + -er.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[36125,"kürschner","noun","furrier, peltmonger (male or unspecified)",0,"m"]],"inflections":[["kürschner","kürschnerin","masculine"]]},"missgunst":{"entries":[["missgunst",null,"/ˈmɪsɡʊnst/","From miss- + Gunst.",{"g":"f","decl":"||||-|-|-|-"}]],"senses":[[4150,"missgunst","noun","jealousy, resentment",0,"f"]]},"rechtsstaats":{"entries":[["rechtsstaats",null,null,null]],"senses":[[58960,"rechtsstaats","noun","genitive singular of Rechtsstaat",0]],"inflections":[["rechtsstaats","rechtsstaat","genitive"]]},"sauerland":{"entries":[["sauerland",null,"/ˈzaʊ̯ɐlant/","First mentioned in 1266 as Suderlande; the -d- started to disappear around 1400. The first part is possibly a corruption of a Westphalian Low German word for southern: compare süder-, Süd, Old Saxon sûðar, all from sūth, from Proto-West Germanic *sunþr. This is more likely than the theory that it is directly from sauer (“sour”, in this sense \"poor soil\"). The second part is related to Land."]],"senses":[[235260,"sauerland","name","Sauerland (a hilly region of Westphalia, North Rhine-Westphalia)",0]]},"spinnertes":{"entries":[["spinnertes",null,null,null]],"senses":[[552615,"spinnertes","adj","strong/mixed nominative/accusative neuter singular of spinnert",0]],"inflections":[["spinnertes","spinnert","neuter,nominative,singular,strong,without-article"]]},"staatlichem":{"entries":[["staatlichem",null,null,null]],"senses":[[267821,"staatlichem","adj","strong dative masculine/neuter singular of staatlich",0]],"inflections":[["staatlichem","staatlich","dative,masculine,singular,strong,without-article"]]},"staatsbürger":{"entries":[["staatsbürger",null,"/ˈʃtaːtsˌ
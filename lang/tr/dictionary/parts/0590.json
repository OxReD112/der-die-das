{"format_version":1,"partition":590,"records":{"Merkmal":[{"record_id":1025,"word":"Merkmal","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Merkmal","source":"tr.wiktionary","gender":["n"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["alamet, belirti"],"id":"tr-Merkmal-de-noun-pe63ar-7"},"labels":[[0,0,["linguistics"]]]},{"sense_index":1,"display_status":"translation","data":{"glosses":["hususiyet, özellik"],"id":"tr-Merkmal-de-noun-~X-aW9wb"}}]}],"Partizip":[{"record_id":1122,"word":"Partizip","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Partizip","source":"tr.wiktionary","gender":["n"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["durum ortacı, ortaç, partisip, sıfat-fiil"],"id":"tr-Partizip-de-noun-H5wE0AIb","examples":[{"text":"Die Form „spielend“ ist Partizip Präsens.","bold_text_offsets":[[24,32]],"translation":"[Almancada oynamak fiilinin] \"spielend\" şekli mevcut sıfat-fiilidir.","bold_translation_offsets":[[53,67]]},{"text":"Die Form „gespielt“ ist Partizip Perfekt.","bold_text_offsets":[[24,32]],"translation":"[Almancada oynamak fiilinin] \"gespielt\" şekli geçmiş sıfat-fiildir.","bold_translation_offsets":[[53,66]]},{"text":"Das Partizip dient zur Bildung komplexer verbaler Satzglieder oder es wird als Adjektiv verwendet.","bold_text_offsets":[[4,12]],"translation":"Sıfat-fiil, bir cümlenin karmaşık sözlü kısımlarını meydana getirmek veya bir sıfat olarak kullanılır.","bold_translation_offsets":[[0,10]]},{"text":"„Regelmäßige Verben ändern im Präteritum und im Partizip II ihren Stammvokal nicht, unregelmäßige Verben ändern ihn in gesetzmäßiger Weise in den drei Stammformen (Infinitiv - Präteritum - Partizip II) (Ablaut):…“","bold_text_offsets":[[48,56],[189,197]],"translation":"„Normal fiiller geçmişte ve sıfat-fiil olarak kök ünlülerini değiştirmezler, düzensiz fiiller onu üç kök şeklinde değiştirir (mastar - geçmiş zaman - geçmiş zaman) (ünlü almaşması): …“","bold_translation_offsets":[[28,38]]},{"text":"„Auch beim Gebrauch des Partizips lässt sich wohl der allmähliche Prozess der Annäherung an die schwache Flexion beobachten.“","bold_text_offsets":[[24,33]],"translation":"„Zayıf çekimlemeye yaklaşmanın kademeli süreci, sıfat-fiilini kullanırken de gözlemlenebilir.“","bold_translation_offsets":[[48,61]]}]},"labels":[[0,0,["linguistics"]]]}]},{"record_id":1123,"word":"Partizip","pos":"noun","source_pos":"abbrev","source_url":"https://tr.wiktionary.org/wiki/Partizip","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"no-gloss","data":{"id":"tr-Partizip-de-abbrev-47DEQpj8","tags":["no-gloss"]}}]}],"Segmentierung":[{"record_id":1239,"word":"Segmentierung","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Segmentierung","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["bölümleme"],"id":"tr-Segmentierung-de-noun-f5LmXLdy"},"labels":[[0,0,["linguistics"]]]}]}],"Knie":[{"record_id":1639,"word":"Knie","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Knie","source":"tr.wiktionary","gender":["n"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["diz"],"id":"tr-Knie-de-noun-LrVkw4VV"},"labels":[[0,0,["anatomy"]]]}]}],"Sonnenschein":[{"record_id":3208,"word":"Sonnenschein","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Sonnenschein","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["güneş"],"id":"tr-Sonnenschein-de-noun--0pw0Hcx"},"labels":[[0,0,["physics"]]]}]}],"Denim":[{"record_id":4867,"word":"Denim","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Denim","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["denim"],"id":"tr-Denim-de-noun-mblKs~do"},"labels":[[0,0,["textiles"]]]}]}],"Differentialgleichung":[{"record_id":5740,"word":"Differentialgleichung","pos":"noun","source_url":"https://tr.wiktionar
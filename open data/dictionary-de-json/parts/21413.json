{"format_version":1,"partition":21413,"records":{"backfischromans":{"entries":[["backfischromans",null,null,null]],"senses":[[642791,"backfischromans","noun","genitive singular of Backfischroman",0]],"inflections":[["backfischromans","backfischroman","genitive"]]},"bescheinigen":{"entries":[["bescheinigen",null,"/bəˈʃaɪ̯nɪɡən/","Borrowed from Middle Low German beschênigen (14th c.), extended form of beschênen, from be- + Proto-West Germanic *skainijan (“to make appear”). This latter verb is a causative of *skīnan, whence German scheinen (“to shine, appear”). It was borrowed along the Lower Rhine in the 15th century and fully established itself in High German during the 16th. Due to the merger of West Germanic ai and ī, it appears to be derived as be- + Schein + -ig + -en. In truth, the noun Schein is closely related, but does not underlie directly.",null,"haben"]],"senses":[[118593,"bescheinigen","verb","to attest",0],[118594,"bescheinigen","verb","to certify",1]],"related_forms":[[50766,"bescheinigen","bescheinigung","derived"]]},"ebereschen":{"entries":[["ebereschen",null,null,null]],"senses":[[100596,"ebereschen","noun","plural of Eberesche",0]],"inflections":[["ebereschen","eberesche","plural"]]},"entschlüpf":{"entries":[["entschlüpf",null,null,null]],"senses":[[667114,"entschlüpf","verb","singular imperative of entschlüpfen",0]],"inflections":[["entschlüpf","entschlüpfen","imperative,second-person,singular"]]},"faltigerem":{"entries":[["faltigerem",null,null,null]],"senses":[[263352,"faltigerem","adj","strong dative masculine/neuter singular comparative degree of faltig",0]],"inflections":[["faltigerem","faltig","comparative,dative,masculine,singular,strong,without-article"]]},"fussspitze":{"entries":[["fussspitze",null,null,null,{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[665613,"fussspitze","noun","Switzerland and Liechtenstein standard spelling of Fußspitze",0,"f",["Switzerland","Liechtenstein"]]]},"intensivtäterinnen":{"entries":[["intensivtäterinnen",null,
ünen. On the other hand, it seems clear that the similarity to the Polabian name of the town Glain, Glein, Chlein can hardly be coincidental. The Polabian might be from Germanic, but it has also been connected with Proto-Slavic *glina (“clay, loam”)."]],"senses":[[373876,"lüneburg","name","Lüneburg (a town in Lower Saxony, Germany; official name: Hansestadt Lüneburg)",0],[373877,"lüneburg","name","a rural district of Lower Saxony",1],[373878,"lüneburg","name","a farming community in eDumbe local municipality, Zululand district municipality, KwaZulu-Natal, South Africa",2],[373879,"lüneburg","name","a surname transferred from the place name",3]],"related_forms":[[55610,"lüneburg","lüneburgerin","derived"],[55611,"lüneburg","lüneburger","derived"],[55612,"lüneburg","lüneburgisch","derived"],[55613,"lüneburg","lüneburger heide","related"],[55614,"lüneburg","lünebach","related"],[55615,"lüneburg","limburg","related"]]},"missbilligen":{"entries":[["missbilligen",null,"/mɪsˈbɪlɪɡn̩/","miss- + billigen.",{"g":"n","decl":"|||s|-|-|-|-"}]],"senses":[[588265,"missbilligen","verb","to disapprove, to frown upon",0],[588266,"missbilligen","noun","gerund of missbilligen",1,"n"]]},"niederbayrisches":{"entries":[["niederbayrisches",null,null,null]],"senses":[[525089,"niederbayrisches","adj","strong/mixed nominative/accusative neuter singular of niederbayrisch",0]],"inflections":[["niederbayrisches","niederbayrisch","neuter,nominative,singular,strong,without-article"]]},"niedergeschlagenes":{"entries":[["niedergeschlagenes",null,null,null]],"senses":[[668428,"niedergeschlagenes","verb","strong/mixed nominative/accusative neuter singular of niedergeschlagen",0]],"inflections":[["niedergeschlagenes","niedergeschlagen","neuter,nominative,singular,strong,without-article"]]},"paart":{"entries":[["paart",null,null,null]],"senses":[[133270,"paart","verb","inflection of paaren:",0],[133271,"paart","verb","third-person singular present",1],[133272,"paart","verb","second-person plural present
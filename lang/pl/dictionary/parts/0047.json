{"format_version":1,"partition":47,"records":{"Hafnium":[{"record_id":890,"word":"Hafnium","pos":"noun","gender":["n"],"source_url":"https://pl.wiktionary.org/wiki/Hafnium","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["hafn"],"id":"pl-Hafnium-de-noun-M2FyQsF5","examples":[{"text":"Hafnium ist ein chemisches Element mit dem Symbol Hf und der Ordnungszahl 72.","bold_text_offsets":[[0,7]],"translation":"Hafn jest pierwiastkiem chemicznym o symbolu Hf i liczbie porządkowej 72.","bold_translation_offsets":[[0,4]]}]},"labels":[[0,0,["chemistry"]]]}]}],"brennen":[{"record_id":3554,"word":"brennen","pos":"verb","source_url":"https://pl.wiktionary.org/wiki/brennen","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["palić (się), zapalić (się), płonąć, zapłonąć"],"id":"pl-brennen-de-verb-ltXb5iNe","examples":[{"text":"Es brennt!","bold_text_offsets":[[3,9]],"translation":"Pali się!","bold_translation_offsets":[[0,4]]},{"text":"Das Haus brannte schon seit ein paar Minuten, als die Feuerwehr ankamen.","bold_text_offsets":[[9,16]],"translation":"Dom płonął już od kilku minut, gdy przybyła straż pożarna.","bold_translation_offsets":[[4,10]]},{"text":"Wir saßen ruhig an dem Tisch, als der Weihnachtsbaum plötzlich brannte.","bold_text_offsets":[[63,70]],"translation":"Siedzieliśmy spokojnie przy stole, gdy nagle zapaliła się choinka.","bold_translation_offsets":[[45,53]]},{"text":"Wir versuchten, ein paar nasse Äste anzuzünden, aber erst das trockene Reisig brannte.","bold_text_offsets":[[78,85]],"translation":"Próbowaliśmy zapalić kilka wilgotnych gałęzi, ale dopiero suchy chrust zapłonął.","bold_translation_offsets":[[71,79]]},{"text":"Dort sollte er Doktor oder Anwalt werden, jedoch brannte er darauf, seinem Bruder zu folgen.","bold_text_offsets":[[49,56]],"translation":"Tam miał się kształcić na doktora lub prawnika, jednak palił się do tego, by pójść w ślady swego brata.","bold_translation_offsets":[[55,60]],"ref":"Wikipedia.de, John S. McCain senior"},{"text":"Die Flammen schlugen von der brennenden Scheune auf das Haus über.","bold_text_offsets":[[29,39]],"translation":"Dom zajął się od płonącej stodoły.","bold_translation_offsets":[[17,25]]},{"text":"Wir versuchten, aus dem brennenden Haus zu fliehen.","bold_text_offsets":[[24,34]],"translation":"Próbowaliśmy uciec z płonącego domu.","bold_translation_offsets":[[21,30]]}]},"transitivity":"transitive"},{"sense_index":1,"display_status":"translation","data":{"glosses":["palić się, być włączonym"],"id":"pl-brennen-de-verb-V0ZnNM-s","examples":[{"text":"Bei unseren Nachbarn brennt das Licht die ganze Nacht.","bold_text_offsets":[[21,27]],"translation":"U naszych sąsiadów światło pali się całą noc.","bold_translation_offsets":[[27,35]]}]},"transitivity":"transitive"},{"sense_index":2,"display_status":"translation","data":{"glosses":["palić, piec, szczypać"],"id":"pl-brennen-de-verb-MuGwZ4-8","examples":[{"text":"Meine Wunde brannte so stark, dass ich das Bewusstsein verlor.","bold_text_offsets":[[12,19]],"translation":"Rana piekła tak bardzo, że straciłem przytomność.","bold_translation_offsets":[[5,11]]},{"text":"Mama, meine Augen brennen!","bold_text_offsets":[[18,25]],"translation":"Mamo, oczy mnie pieką!","bold_translation_offsets":[[16,21]]}]},"transitivity":"transitive"},{"sense_index":3,"display_status":"translation","data":{"glosses":["wypalać, wypalić (np. porcelanę, płytę CD)"],"id":"pl-brennen-de-verb-v-FDpJth","examples":[{"text":"Er brannte eine Figur aus Lehm.","bold_text_offsets":[[3,10]],"translation":"Wypalił figurkę z gliny.","bold_translation_offsets":[[0,7]]},{"text":"Kannst du mir ihr neues Album auf eine CD brennen?","bold_text_offsets":[[42,49]],"translation":"Możesz mi zgrać ich nowy album na płytę?","bold_translation_offsets":[[10,15]]},{"text":"Hör endlich mit dem Rauchen auf! Guck mal, du hast wieder ein Loch im Teppich gebrannt!","bold_text_offsets":[[78,86]],"translation":"Rzuć wreszcie palenie! Spójrz no, znowu wypaliłeś dziurę w dywanie!","bold_translation_offsets":[[40,49]]}]},"transitivity":"transitive"},{"sense_index":4,"display_status":"translation","data":{"glosses":["destylować"],"id":"pl-brennen-de-verb-D2V4DZNQ","examples":[{"text":"Herr Schmidt brennt Schnaps in seiner Scheune.","bold_text_offsets":[[13,19]],"translation":"Pan Schmidt destyluje wódkę w swojej stodole.","bold_translation_offsets":[[12,21]]}]},"transitivity":"transitive"},{"sense_index":5,"display_status":"translation","data":{"glosses":["prażyć (np. orzechy)"],"id":"pl-brennen-de-verb-b1XxORbm","examples":[{"text":"Ich liebe Weihnachtsspezialitäten am liebsten esse ich gebrannte Nüsse.","bold_text_offsets":[[55,64]],"translation":"Kocham bożonarodzeniowe specjały, najchętniej jadam prażone orzechy.","bold_translation_offsets":[[52,59]]}]},"transitivity":"transitive"},{"sense_index":6,"display_status":"translation","data":{"glosses":["dziać się"],"id":"pl-brennen-de-verb-fvCLCCs5","tags":["metaphoric"],"examples":[{"text":"Wo brennt es denn?","bold_text_offsets":[[3,9]],"translation":"Co się dzieje?","bold_translation_offsets":[[7,13]]}]},"labels":[[0,0,["figuratively"]]],"transitivity":"transitive"}]}],"Hefe":[{"record_id":3896,"word":"Hefe","pos":"noun","gender":["f"],"source_url":"https://pl.wiktionary.org/wiki/Hefe","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["drożdże"],"id":"pl-Hefe-de-noun-4f-1Ep~a","raw_tags":["mykol."]},"labels":[[0,0,["mycology"]]]},{"sense_index":1,"display_status":"translation","data":{"glosses":["drożdże"],"id":"pl-Hefe-de-noun-4f-1Ep~a1"},"labels":[[0,0,["cooking"]]]},{"sense_index":2,"display_status":"translation","data":{"glosses":["Hefe- → drożdżowy"],"id":"pl-Hefe-de-noun-NyAoZ6J-"},"shown":["drożdżowy"]}]}],"Violine":[{"record_id":4481,"word":"Violine","pos":"noun","gender":["f"],"source_url":"https://pl.wiktionary.org/wiki/Violine","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["skrzypce"],"i
{"format_version":1,"partition":18295,"records":{"gebärde":{"entries":[["gebärde",null,"/ɡəˈbɛ(ː)rdə/","From Middle High German gebærde, from Old High German gibārida, gibāridī (“demeanor, behavior, character”), from Proto-Germanic *gabērijaną, *gabarjaną (“to conduct oneself, behave”); see the related *gaberaną (“to bear, beget”) for more. Cognate with dialectal German Bärde, German Low German Gebarr, Dutch gebaarde, Middle English bærde, beard, beorde (“conduct, bearing”).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[375653,"gebärde","noun","gesture (communicative, interpretable motion of the body)",0,"f"],[375654,"gebärde","noun","sign (linguistic unit in sign languages)",1,"f"]],"related_forms":[[56079,"gebärde","gebärden","derived"],[56080,"gebärde","gebärdenspiel","derived"],[56081,"gebärde","gebärdensprache","derived"],[56082,"gebärde","demutsgebärde","derived"],[56083,"gebärde","drohgebärde","derived"]],"inflections":[["gebärde","gebärden","first-person,indicative,present,singular"]]},"geflohen":{"entries":[["geflohen",null,null,null]],"senses":[[273581,"geflohen","verb","past participle of fliehen",0]],"inflections":[["geflohen","fliehen","participle,past"]]},"pfauenspinne":{"entries":[["pfauenspinne",null,null,"From Pfau (“peacock”) + -en- + Spinne (“spider”).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[715751,"pfauenspinne","noun","peacock jumping spider (Maratus)",0,"f"]]},"seherisch":{"entries":[["seherisch",null,null,null]],"senses":[[114024,"seherisch","adj","visionary",0]]},"seins":{"entries":[["seins",null,"/zaɪ̯ns/",null]],"senses":[[38881,"seins","pron","alternative form of seines",0],[38882,"seins","noun","genitive of Sein",1,"n"]],"inflections":[["seins","sein","genitive"],["seins","seiner","neuter,nominative,singular"],["seins","seines","alternative"]]},"sturmwetter":{"entries":[["sturmwetter",null,"/ˈʃtʊʁmˌvɛtɐ/","From Sturm + Wetter.",{"g":"n","decl":"|||s|||n|"}]],"senses":[[371112,"sturmwetter","noun","stormy weather",0,"n"]]},"untröstlich
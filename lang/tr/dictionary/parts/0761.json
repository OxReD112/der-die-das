anslation":"Birlikler çekilmek mecburiyetinde kaldı.","bold_translation_offsets":[[0,9]]},{"text":"„Die Insellage verschonte die Bewohner Britanniens von Einfällen von außen, obwohl es bereits in dieser Zeit vereinzelte Angriffe fränkischer und sächsischer Verbände gab.“","bold_text_offsets":[[158,166]],"translation":"Adanın konumu, şu anda Frank ve Sakson birimleri tarafından zaten izole edilmiş saldırılar olmasına rağmen Britanya sakinlerini dışarıdan gelen saldırılardan korudu.","bold_translation_offsets":[[39,48]]}]},"labels":[[0,0,["military"]]]},{"sense_index":1,"display_status":"translation","data":{"glosses":["cemiyet, dernek"],"id":"tr-Verband-de-noun-BTwTSnRx","raw_tags":["sosyoloji"],"examples":[{"text":"Die Verbände haben ihre Lobby in Berlin.","bold_text_offsets":[[4,12]],"translation":"Derneklerin lobileri Berlin'de.","bold_translation_offsets":[[0,11]]}]},"labels":[[0,0,["law"]]]},{"sense_index":2,"display_status":"translation","data":{"glosses":["pansuman; bandaj, sargı"],"id":"tr-Verband-de-noun-kGgJ3r1H","examples":[{"text":"Da muss dringend ein Verband angelegt werden.","bold_text_offsets":[[21,28]],"translation":"Orada muhakkak bir sargı sarılmalı/pansuman yapılmalı.","bold_translation_offsets":[[19,24],[35,43]]},{"text":"„Der Andere wickelte den Verband auf.“","bold_text_offsets":[[25,32]],"translation":"Diğeri saygıyı çözdü.","bold_translation_offsets":[[7,14]]},{"text":"„Die Wunde an Walts Finger hatte so reichlich geblutet, daß keine Blutvergiftung entstand, aber den Verband mußte er eine Woche am Finger lassen, und die Wunde heilte erst nach drei Wochen zu.“","bold_text_offsets":[[100,107]],"translation":"Walt'ın parmağındaki yara o kadar çok kanıyordu ki kan zehirlenmesi yoktu, ama bandajı bir hafta parmağında bırakmak zorunda kaldı ve yaranın iyileşmesi üç hafta sürdü.","bold_translation_offsets":[[79,86]]},{"text":"„Er hatte einen Verband um den Unterarm.“","bold_text_offsets":[[16,23]],"translation":"Alt kolunun etrafında bir bandaj vardı.","bold_translation_offsets":[[26,32]]}]},"labels":[[0,0,["medicine"]]]}]},{"record_id":6144,"word":"Verband","pos":"noun","source_pos":"abbrev","source_url":"https://tr.wiktionary.org/wiki/Verband","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"no-gloss","data":{"id":"tr-Verband-de-abbrev-47DEQpj8","tags":["no-gloss"]}}]}],"Sieben":[{"record_id":6147,"word":"Sieben","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Sieben","source":"tr.wiktionary","gender":["f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["yedi"],"id":"tr-Sieben-de-noun-CnspYpOZ"}}]}],"aufzukleben":[{"record_id":7761,"word":"aufzukleben","pos":"verb","source_url":"https://tr.wiktionary.org/wiki/aufzukleben","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"form-description","data":{"glosses":["aufkleben eyleminin “zu” mastarı"],"id":"tr-aufzukleben-de-verb-IZ1bPett"}}]}],"durchzugehen":[{"record_id":7942,"word":"durchzugehen","pos":"verb","source_url":"https://tr.wiktionary.org/wiki/durchzugehen","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"form-description","data":{"glosses":["durchgehen eyleminin “zu” mastarı"],"id":"tr-durchzugehen-de-verb-jNasSHv5"}}]}],"Rößler":[{"record_id":8283,"word":"Rößler","pos":"name","source_url":"https://tr.wiktionary.org/wiki/R%C3%B6%C3%9Fler","source":"tr.wiktionary","gender":["m","f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Bir soyadı."],"id":"tr-Rößler-de-name-twAi7g4e"},"name_like":["person","soyadı / ad"],"shown":["Bir soyadı"]}]}],"Münning":[{"record_id":9875,"word":"Münning","pos":"name","source_url":"https://tr.wiktionary.org/wiki/M%C3%BCnning","source":"tr.wiktionary","gender":["m","f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Bir soyadı."],"id":"tr-Münning-de-name-twAi7g4e"},"name_like":["person","soyadı / ad"],"shown":["Bir soyadı"]}]}],"dreizehnte":[{"record_id":12733,"wor
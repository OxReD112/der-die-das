{"format_version":1,"partition":5375,"records":{"-st":{"entries":[["-st",null,"/st/","From Middle High German -est, from older -es through rebracketing in inverted forms like sizzes du → sizzestu → sizzest du (“do you sit”). Further from a merger of various Old High German conjugation suffixes, from Proto-Germanic, from Proto-Indo-European."]],"senses":[[14599,"-st","suffix","Verb suffix for the second-person singular.",0],[14600,"-st","suffix","Forms superlatives of adjectives and adverbs, sometimes triggering umlaut.",1]]},"gebärmüttern":{"entries":[["gebärmüttern",null,null,null]],"senses":[[354129,"gebärmüttern","noun","dative plural of Gebärmutter",0,"f"]],"inflections":[["gebärmüttern","gebärmutter","dative,definite,plural"]]},"geflucht":{"entries":[["geflucht",null,null,null]],"senses":[[114480,"geflucht","verb","past participle of fluchen",0]],"inflections":[["geflucht","fluchen","participle,past"]]},"gehet hinein":{"entries":[["gehet hinein",null,null,null]],"senses":[[377169,"gehet hinein","verb","second-person plural subjunctive I of hineingehen",0]]},"gewährleiste":{"entries":[["gewährleiste",null,null,null]],"senses":[[345741,"gewährleiste","verb","inflection of gewährleisten:",0],[345742,"gewährleiste","verb","first-person singular present",1],[345743,"gewährleiste","verb","first/third-person singular subjunctive I",2],[345744,"gewährleiste","verb","singular imperative",3]],"inflections":[["gewährleiste","gewährleisten","first-person,indicative,present,singular"]]},"großkopf-ringelnattern":{"entries":[["großkopf-ringelnattern",null,null,null]],"senses":[[111399,"großkopf-ringelnattern","noun","plural of Großkopf-Ringelnatter",0]],"inflections":[["großkopf-ringelnattern","großkopf-ringelnatter","plural"]]},"musischster":{"entries":[["musischster",null,null,null]],"senses":[[522137,"musischster","adj","inflection of musisch:",0],[522138,"musischster","adj","strong/mixed nominative masculine singular superlative degree",1],[522139,"musischster","adj","str
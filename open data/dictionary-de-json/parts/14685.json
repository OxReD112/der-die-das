{"format_version":1,"partition":14685,"records":{"buchmacher":{"entries":[["buchmacher",null,"/ˈbuːχˌmaχɐ/","From Middle High German buochmachære, from Old High German buohmahhāri, buohmahheri. Equivalent to Buch + Macher. The sense “bookie” (19th c.) is a semantic loan from English bookmaker.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[516191,"buchmacher","noun","bookmaker; bookie (one who accepts bets; male or unspecified sex)",0,"m"],[516192,"buchmacher","noun","one who makes books, especially a (mediocre) author",1,"m",["archaic"]]],"inflections":[["buchmacher","buchmacherin","masculine"]]},"cremefarbenem":{"entries":[["cremefarbenem",null,null,null]],"senses":[[401055,"cremefarbenem","adj","strong dative masculine/neuter singular of cremefarben",0]],"inflections":[["cremefarbenem","cremefarben","dative,masculine,singular,strong,without-article"]]},"hieltet fern":{"entries":[["hieltet fern",null,null,null]],"senses":[[273553,"hieltet fern","verb","inflection of fernhalten:",0],[273554,"hieltet fern","verb","second-person plural preterite",1],[273555,"hieltet fern","verb","second-person plural subjunctive II",2]]},"niobhaltiger":{"entries":[["niobhaltiger",null,null,null]],"senses":[[331330,"niobhaltiger","adj","inflection of niobhaltig:",0],[331331,"niobhaltiger","adj","strong/mixed nominative masculine singular",1],[331332,"niobhaltiger","adj","strong genitive/dative feminine singular",2],[331333,"niobhaltiger","adj","strong genitive plural",3]],"inflections":[["niobhaltiger","niobhaltig","masculine,nominative,singular,strong"]]},"preise":{"entries":[["preise",null,"/ˈpʁaɪ̯zə/","See the etymology of the corresponding lemma form.",{"g":"f"}]],"senses":[[63730,"preise","noun","nominative/accusative/genitive plural of Preis",0],[63731,"preise","noun","dative singular of Preis",1,null,["archaic"]],[63732,"preise","noun","obsolete form of Prise (“booty, captured ship”)",2,"f",["obsolete"]],[63733,"preise","verb","inflection of preisen:",3],[63734,"preise","verb","fir
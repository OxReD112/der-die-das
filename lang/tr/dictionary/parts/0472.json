rce_url":"https://tr.wiktionary.org/wiki/europ%C3%A4isch","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Avrupa, Avrupâî"],"id":"tr-europäisch-de-adj-Cs~YlAKm","examples":[{"text":"„Dieser Mangel steht in einem deutlichen Missverhältnis zu dem immer wieder von nationalen und europäischen Instanzen erklärten Einsatz für die europäische Sprachenvielfalt und die Mehrsprachigkeit der Europäer.“","bold_text_offsets":[[95,106],[95,107],[144,155]],"translation":"Bu eksiklik, millî ve Avrupa makamları tarafından defalarca beyan edilen Avrupa dil çeşitliliği ve Avrupalıların çok dillilik taahhüdü ile açıkça uyumsuzdur..","bold_translation_offsets":[[22,28],[73,79],[99,105]]},{"text":"„Dies war auch für das europäische Festland von Bedeutung, denn die christliche Mission Westeuropas erfolgte in der Nachfolge Patricks durch irische Mönche!“","bold_text_offsets":[[23,34]],"translation":"Bu aynı zamanda anakara Avrupa için de önemliydi, çünkü Batı Avrupa'daki Hıristiyan misyonu Patrick'i takip eden İrlandalı rahipler tarafından yürütülüyordu!","bold_translation_offsets":[[24,30],[61,67],[61,72]]},{"text":"„Von Kulturschock konnte bei mir keine Rede sein, da ich mit der europäischen Kultur, in ihrer französischen Spielart, vertraut war, …“","bold_text_offsets":[[65,77]],"translation":"Benim için bir kültür şoku mevzubahis değildi, çünkü Avrupa kültürünün Fransız çeşidine âşinâydım...","bold_translation_offsets":[[53,59]]},{"text":"Der Europäische Gerichtshof spricht Recht für ganz Europa.","bold_text_offsets":[[4,15]],"translation":"Avrupa Adalet Divanı, tüm Avrupa adına adaletten bahsediyor.","bold_translation_offsets":[[0,6],[26,32]]},{"text":"Die Europäische Währungsunion steckt zur Zeit in einer Krise.","bold_text_offsets":[[4,15]],"translation":"Avrupa Para Birliği şu anda bir kriz içinde.","bold_translation_offsets":[[0,6]]},{"text":"Die europäischen Aktienmärkte spielten heute wieder verrückt.","bold_text_offsets":[[4,16]],"translation":"Avrupa borsaları bugün yine çıldırdı.","bold_translation_offsets":[[0,6]]}]}},{"sense_index":1,"display_status":"translation","data":{"glosses":["Avrupâî"],"id":"tr-europäisch-de-adj-6ZcN4pZx","examples":[{"text":"Ahmet ist ein sehr europäischer Türke.","bold_text_offsets":[[19,31]],"translation":"Ahmet çok Avrupâî bir Türk.","bold_translation_offsets":[[10,17]]}]}}]},{"record_id":6431,"word":"europäisch","pos":"adj","source_pos":"abbrev","source_url":"https://tr.wiktionary.org/wiki/europ%C3%A4isch","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"no-gloss","data":{"id":"tr-europäisch-de-abbrev-47DEQpj8","tags":["no-gloss"]}}]}],"anzuwerfen":[{"record_id":7728,"word":"anzuwerfen","pos":"verb","source_url":"https://tr.wiktionary.org/wiki/anzuwerfen","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"form-description","data":{"glosses":["anwerfen eyleminin “zu” mastarı"],"id":"tr-anzuwerfen-de-verb-l1SlRMkx"}}]}],"Wille":[{"record_id":8267,"word":"Wille","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Wille","source":"tr.wiktionary","gender":["m","f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Bir soyadı."],"id":"tr-Wille-de-name-twAi7g4e"},"name_like":["person","soyadı / ad"],"shown":["Bir soyadı"]}]}],"Sekmann":[{"record_id":8729,"word":"Sekmann","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Sekmann","source":"tr.wiktionary","gender":["m","f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Bir soyadı."],"id":"tr-Sekmann-de-name-twAi7g4e"},"name_like":["person","soyadı / ad"],"shown":["Bir soyadı"]}]}],"Klinsmann":[{"record_id":8762,"word":"Klinsmann","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Klinsmann","source":"tr.wiktionary","gender":["m","f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Bir soyadı."],"id":"tr-Klinsmann-de-name-twAi7g4e"},"name_like":["person","soyadı /
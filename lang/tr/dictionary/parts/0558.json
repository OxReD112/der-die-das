{"format_version":1,"partition":558,"records":{"AfD":[{"record_id":206,"word":"AfD","pos":"name","source_pos":"abbrev","source_url":"https://tr.wiktionary.org/wiki/AfD","source":"tr.wiktionary","gender":["f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Alternative für Deutschland kavramının kısaltması","(2013'te ortanın sağında kurulmuş bir parti.)"],"id":"tr-AfD-de-abbrev-efd8w8pE","tags":["Germany","abbreviation","form-of"],"form_of":[{"word":"Alternative für Deutschland"}],"examples":[{"text":"Die AfD wurde am 6. Februar 2013 gegründet.","bold_text_offsets":[[4,7]],"translation":"AfD 6 Şubat 2013'te kuruldu.","bold_translation_offsets":[[0,3]]},{"text":"„Von diesem Widerspruch profitiert nun die AfD.“","bold_text_offsets":[[43,46]],"translation":"AfD artık bu çelişkiden yararlanıyor.","bold_translation_offsets":[[0,3]]},{"text":"„Nur weil ich keine Angst vor den Konsequenzen habe wie so viele, die lieber kuschen, als unbequeme Wahrheiten auszusprechen, lasse ich mich nicht von Bewegungen wie Pegida oder Parteien wie der AfD vereinnahmen.“","bold_text_offsets":[[195,198]],"translation":"Rahatsız edici gerçekleri söylemektense sinmeyi tercih eden pek çok kişi gibi, sonuçlarından korkmadığım için, Pegida gibi hareketlerin veya AfD gibi partilerin kontrolüne geçmeme izin vermiyorum."},{"text":"„Die AfD ist unter Druck.“","bold_text_offsets":[[5,8]],"translation":"AfD baskı altında.","bold_translation_offsets":[[0,3]]},{"text":"„Die Frage nach dem Menschenbild der AfD steht im Zentrum der Untersuchung.“","bold_text_offsets":[[37,40]],"translation":"AfD'nin insanlığa bakış açısı ise soruşturmanın merkezinde yer alıyor.","bold_translation_offsets":[[0,4]]},{"text":"„[…] Wer AfD wählt, ist nicht unbedingt rassistisch, rechtsextrem oder fremdenfeindlich; wohl aber unterstützt er Rassisten, Rechtsextreme und Fremdenfeinde – oder AfD-Vertreter, die Rassisten, Rechtsextreme und Fremdenfeinde in ihren Reihen willkommen heißen.“","bold_text_offsets":[[9,12],[164,167]],"translation":"[…] AfD'ye oy veren herkesin mutlaka ırkçı, aşırı sağcı veya yabancı düşmanı olması gerekmez; ancak muhtemelen ırkçıları, aşırı sağcıları ve yabancı düşmanlarını ya da ırkçıları, aşırı sağcıları ve yabancı düşmanlarını saflarına kabul eden AfD temsilcilerini desteklemektedir.","bold_translation_offsets":[[4,7],[4,8],[240,243]]}]},"labels":[[0,0,["politics"]],[1,0,["politics"]]],"name_like":["other","politics"],"shown":["2013'te ortanın sağında kurulmuş bir parti","2013'te ortanın sağında kurulmuş bir parti"]},{"sense_index":1,"display_status":"translation","data":{"glosses":["Alternative für Deutschland kavramının kısaltması","(2013'te ortanın sağında kurulmuş bir parti.)"],"id":"tr-AfD-de-abbrev-efd8w8pE1","tags":["Germany","abbreviation","form-of"],"form_of":[{"word":"Alternative für Deutschland"}],"examples":[{"text":"Die AfD wurde am 6. Februar 2013 gegründet.","bold_text_offsets":[[4,7]],"translation":"AfD 6 Şubat 2013'te kuruldu.","bold_translation_offsets":[[0,3]]},{"text":"„Von diesem Widerspruch profitiert nun die AfD.“","bold_text_offsets":[[43,46]],"translation":"AfD artık bu çelişkiden yararlanıyor.","bold_translation_offsets":[[0,3]]},{"text":"„Nur weil ich keine Angst vor den Konsequenzen habe wie so viele, die lieber kuschen, als unbequeme Wahrheiten auszusprechen, lasse ich mich nicht von Bewegungen wie Pegida oder Parteien wie der AfD vereinnahmen.“","bold_text_offsets":[[195,198]],"translation":"Rahatsız edici gerçekleri söylemektense sinmeyi tercih eden pek çok kişi gibi, sonuçlarından korkmadığım için, Pegida gibi hareketlerin veya AfD gibi partilerin kontrolüne geçmeme izin vermiyorum."},{"text":"„Die AfD ist unter Druck.“","bold_text_offsets":[[5,8]],"translation":"AfD baskı altında.","bold_translation_offsets":[[0,3]]},{"text":"„Die Frage nach dem Menschenbild der AfD steht im Zentrum der Untersuchung.“","bold_text_offsets":[[37,40]],"translation":"AfD'nin insanlığa bakış açısı ise soruşturmanın merkezinde yer alıyor.","bold_translation_offsets":[[0,4]]},{"text":"„[…] Wer AfD wählt, ist nicht unbedingt rassistisch, rechtsextrem oder fremdenfeindlich; wohl aber unterstützt er Rassisten, Rechtsextreme und Fremdenfeinde – oder AfD-Vertreter, die Rassisten, Rechtsextreme und Fremdenfeinde in ihren Reihen willkommen heißen.“","bold_text_offsets":[[9,12],[164,167]],"translation":"[…] AfD'ye oy veren herkesin mutlaka ırkçı, aşırı sağcı veya yabancı düşmanı olması gerekmez; ancak muhtemelen ırkçıları, aşırı sağcıları ve yabancı düşmanlarını ya da ırkçıları, aşırı sağcıları ve yabancı düşmanlarını saflarına kabul eden AfD temsilcilerini desteklemektedir.","bold_translation_offsets":[[4,7],[4,8],[240,243]]}]},"labels":[[0,0,["politics"]],[1,0,["politics"]]],"name_like":["other","politics"],"shown":["2013'te ortanın sağında kurulmuş bir parti","2013'te ortanın sağında kurulmuş bir parti"]}]}],"Dorsal":[{"record_id":324,"word":"Dorsal","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Dorsal","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["dilüstü ünsüzü"],"id":"tr-Dorsal-de-noun-2BxI6j~G"},"labels":[[0,0,["linguistics"]]]}]}],"Aktivum":[{"record_id":496,"word":"Aktivum","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Aktivum","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["etken çatı"],"id":"tr-Aktivum-de-noun-5uKtQXyq"},"labels":[[0,0,["linguistics"]]]},{"sense_index":1,"display_status":"translation","data":{"glosses":["etken eylem"],"id":"tr-Aktivum-de-noun-phCcXeyY"},"labels":[[0,0,["linguistics"]]]}]}],"ziehen":[{"record_id":1740,"word":"ziehen","pos":"verb","source_url":"https://tr.wiktionary.org/wiki/ziehen","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["çekmek, sürüklemek"],"id":"tr-ziehen-de-verb-q9TMPgHE","tags":["transitive"],"examples":[{"text":"eine Karte ziehen","translation":"kart
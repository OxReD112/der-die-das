{"format_version":1,"partition":20467,"records":{"dehnen":{"entries":[["dehnen",null,"/ˈdeːnən/","From Middle High German denen, dennen, from Old High German thenen, thennen, from Proto-West Germanic *þannjan, from Proto-Germanic *þanjaną, from Proto-Indo-European *ten- (“to stretch”). The simple -n- was generalised from certain inflected forms of the West Germanic verb. Cognate with Gothic 𐌿𐍆𐌸𐌰𐌽𐌾𐌰𐌽 (ufþanjan), Latin tenēre.",null,"haben"]],"senses":[[20757,"dehnen","verb","to stretch, to make longer or wider by pulling, pushing, extending",0]]},"deplatziertestem":{"entries":[["deplatziertestem",null,null,null]],"senses":[[157666,"deplatziertestem","adj","strong dative masculine/neuter singular superlative degree of deplatziert",0]],"inflections":[["deplatziertestem","deplatziert","dative,masculine,singular,strong,superlative,without-article"]]},"heizölen":{"entries":[["heizölen",null,null,null]],"senses":[[243684,"heizölen","noun","dative plural of Heizöl",0,"n"]],"inflections":[["heizölen","heizöl","dative,definite,plural"]]},"hemdsärmel":{"entries":[["hemdsärmel",null,"/ˈhɛmt͡sˌʔɛʁml̩/","From Hemd + -s- + Ärmel.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[679810,"hemdsärmel","noun","shirt sleeve",0,"m"]]},"hochzeitliches":{"entries":[["hochzeitliches",null,null,null]],"senses":[[444669,"hochzeitliches","adj","strong/mixed nominative/accusative neuter singular of hochzeitlich",0]],"inflections":[["hochzeitliches","hochzeitlich","neuter,nominative,singular,strong,without-article"]]},"höhner":{"entries":[["höhner",null,"/ˈhøːnɐ/",null,{"g":"m","decl":"|||s|||n|"}]],"senses":[[678286,"höhner","noun","agent noun of höhnen",0,"m"]]},"ibs":{"entries":[["ibs",null,null,null]],"senses":[[2854,"ibs","noun","initialism of Inbetriebsetzung",0]]},"trunksüchtigerem":{"entries":[["trunksüchtigerem",null,null,null]],"senses":[[562138,"trunksüchtigerem","adj","strong dative masculine/neuter singular comparative degree of trunksüchtig",0]],"inflections":[["trunksüchtigerem","trunks
 Middle High German hecheln is the same verb as that in etymology 2 below, through a cross-linguistic tendency of using verbs denoting ungentle treatments in a sexual sense (and vice versa)."]],"senses":[[374056,"hecheln","verb","to pant or breathe fast and loudly through one’s mouth (much like dogs do when hot or short of breath)",0],[374057,"hecheln","verb","to hackle, heckle (to dress [flax or hemp] with a hackle)",1],[374058,"hecheln","verb","to heckle; to slag off",2,null,["figuratively"]],[374059,"hecheln","verb","to hit; to beat",3,null,["archaic"]],[374060,"hecheln","verb","to copulate with; to fuck",4,null,["obsolete"]]],"related_forms":[[55730,"hecheln","durchhecheln","derived"]],"inflections":[["hecheln","hechel","plural"]]},"hergibt":{"entries":[["hergibt",null,null,null]],"senses":[[655877,"hergibt","verb","third-person singular dependent present of hergeben",0]],"inflections":[["hergibt","hergeben","indicative,present,singular,subordinate-clause,third-person"]]},"heteronormativster":{"entries":[["heteronormativster",null,null,null]],"senses":[[649866,"heteronormativster","adj","inflection of heteronormativ:",0],[649867,"heteronormativster","adj","strong/mixed nominative masculine singular superlative degree",1],[649868,"heteronormativster","adj","strong genitive/dative feminine singular superlative degree",2],[649869,"heteronormativster","adj","strong genitive plural superlative degree",3]],"inflections":[["heteronormativster","heteronormativ","masculine,nominative,singular,strong,superlative,without-article"]]},"kostenlose":{"entries":[["kostenlose",null,null,null]],"senses":[[265326,"kostenlose","adj","inflection of kostenlos:",0],[265327,"kostenlose","adj","strong/mixed nominative/accusative feminine singular",1],[265328,"kostenlose","adj","strong nominative/accusative plural",2],[265329,"kostenlose","adj","weak nominative all-gender singular",3],[265330,"kostenlose","adj","weak accusative feminine/neuter singular",4]],"inflections":[["kostenlose","
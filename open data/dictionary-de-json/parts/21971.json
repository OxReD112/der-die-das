nses":[[646853,"nichtessentiellem","adj","strong dative masculine/neuter singular of nichtessentiell",0]],"inflections":[["nichtessentiellem","nichtessentiell","dative,masculine,singular,strong,without-article"]]},"ordnungswidrigkeiten":{"entries":[["ordnungswidrigkeiten",null,null,null]],"senses":[[387747,"ordnungswidrigkeiten","noun","plural of Ordnungswidrigkeit",0,"f"]],"inflections":[["ordnungswidrigkeiten","ordnungswidrigkeit","plural"]]},"orgien":{"entries":[["orgien",null,null,null]],"senses":[[63076,"orgien","noun","plural of Orgie",0]],"inflections":[["orgien","orgie","plural"]]},"schlucht":{"entries":[["schlucht",null,"/ʃlʊχt/","There are two etymological paths whose accuracy and possible interrelation are not conclusively established.\n* Schlucht is most readily explained as a Middle Low German form of the archaic High German equivalent Schluft, with the Low German development of -ft- → -cht- (cf. Nichte). Schluft pertains to the verb schliefen (“to slip, to move through”). This etymology is favoured by most authorities, although they seem to be unable to find attestations for the Middle Low German word.\n* There is an Upper German attestation of Middle High German wazzersluht or possibly -slůht (“water-filled ditch”), which is in line with similar words in modern Upper German dialects. Some of these words also mean “cut-off branch” and may pertain to schlagen (“to hew”). The sense of “ditch” might be derived from “branch”.\nCompare Danish slug (“sluice”), Old Norse slok (“gully, channel”).",{"g":"f","decl":"||||en/4üchte|en/4üchte|en/4üchten|en/4üchte"}]],"senses":[[2222,"schlucht","noun","canyon, chasm, gorge, ravine",0,"f"]]},"silberbeschichteter":{"entries":[["silberbeschichteter",null,null,null]],"senses":[[362003,"silberbeschichteter","adj","inflection of silberbeschichtet:",0],[362004,"silberbeschichteter","adj","strong/mixed nominative masculine singular",1],[362005,"silberbeschichteter","adj","strong genitive/dative feminine singular",2],[362006
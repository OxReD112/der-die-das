 Upper German umlaut blocking in -ur- + consonant. This southern origin also partially explains the hardening of -g- to -k-, though the lack of any g-forms in Schurke is peculiar. The noun moreover has little currency in dialects, north or south.",{"g":"m","decl":"|n|n|n|n|n|n|n"}]],"senses":[[27371,"schurke","noun","villain, scoundrel",0,"m"]],"inflections":[["schurke","schurkin","masculine"]]},"suchtkranken":{"entries":[["suchtkranken",null,null,null]],"senses":[[556995,"suchtkranken","adj","inflection of suchtkrank:",0],[556996,"suchtkranken","adj","strong genitive masculine/neuter singular",1],[556997,"suchtkranken","adj","weak/mixed genitive/dative all-gender singular",2],[556998,"suchtkranken","adj","strong/weak/mixed accusative masculine singular",3],[556999,"suchtkranken","adj","strong dative plural",4],[557000,"suchtkranken","adj","weak/mixed all-case plural",5]],"inflections":[["suchtkranken","suchtkrank","genitive,masculine,singular,strong,without-article"]]},"trinkbarster":{"entries":[["trinkbarster",null,null,null]],"senses":[[316306,"trinkbarster","adj","inflection of trinkbar:",0],[316307,"trinkbarster","adj","strong/mixed nominative masculine singular superlative degree",1],[316308,"trinkbarster","adj","strong genitive/dative feminine singular superlative degree",2],[316309,"trinkbarster","adj","strong genitive plural superlative degree",3]],"inflections":[["trinkbarster","trinkbar","masculine,nominative,singular,strong,superlative,without-article"]]},"wärmeübertragern":{"entries":[["wärmeübertragern",null,null,null]],"senses":[[356575,"wärmeübertragern","noun","dative plural of Wärmeübertrager",0,"m"]],"inflections":[["wärmeübertragern","wärmeübertrager","dative,definite,plural"]]},"abdampfentölers":{"inflections":[["abdampfentölers","abdampfentöler","genitive"]]},"versatile":{"inflections":[["versatile","versatil","feminine,nominative,singular,strong,without-article"]]}}}
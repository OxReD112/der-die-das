{"format_version":1,"partition":15007,"records":{"abfall":{"entries":[["abfall",null,"[ˈapfal]","From Middle High German abfal, abefal, equivalent to ab- (“from”) + Fall (“fall”). Cognate with German Low German Offall, Dutch afval, English offal, Swedish avfall.\nCompare typologically Bulgarian отпадък (otpadǎk), Czech otpad, Serbo-Croatian отпад (< Proto-Slavic *otъpadъ < *otъ + *padati). Also compare French déchet (<< Latin dēcidō < dē- + cadō).",{"g":"m","decl":"||/e|es/s|3älle|3älle|3ällen|3älle"}]],"senses":[[12053,"abfall","noun","waste, garbage, rubbish, litter",0,"m"],[12054,"abfall","noun","decrease, decline, drop",1,"m"],[12055,"abfall","noun","apostasy",2,"m",null,null,null,null,["religion"]],[12056,"abfall","noun","shutter, lid",3,"m",["obsolete"]]],"related_forms":[[16643,"abfall","beifall","related"]]},"applike":{"entries":[["applike",null,null,"Borrowed from French applique (“adornment”), from appliquer.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[624235,"applike","noun","applique",0,"f"]]},"architekten":{"entries":[["architekten",null,null,null]],"senses":[[48664,"architekten","noun","genitive singular of Architekt",0],[48665,"architekten","noun","dative singular of Architekt",1],[48666,"architekten","noun","accusative singular of Architekt",2],[48667,"architekten","noun","plural of Architekt",3]],"inflections":[["architekten","architekt","genitive"]]},"dogmen":{"entries":[["dogmen",null,null,null]],"senses":[[63909,"dogmen","noun","plural of Dogma",0]],"inflections":[["dogmen","dogma","plural"]]},"erleichtertet":{"entries":[["erleichtertet",null,null,null]],"senses":[[133910,"erleichtertet","verb","inflection of erleichtern:",0],[133911,"erleichtertet","verb","second-person plural preterite",1],[133912,"erleichtertet","verb","second-person plural subjunctive II",2]],"inflections":[["erleichtertet","erleichtern","indicative,plural,preterite,second-person"]]},"schaufelförmiger":{"entries":[["schaufelförmiger",null,null,null]],"senses":[[545279,"schau
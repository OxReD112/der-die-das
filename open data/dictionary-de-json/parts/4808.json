Germanic *knuttô, whence Middle High German knotze and English knot, though a relation is very likely.\nThe senses “journeyman”, “person (of some quality)” are probably due, at least in part, to conflation with Middle Low German genôte (“mate, companion”), cognate of German Genosse. Alongside, there is a common tendency of referring to people, especially children, with words for thick, plump, or inflated objects (compare e.g. Balg).",{"g":"m","decl":"|||s||||"}]],"senses":[[18917,"knoten","noun","knot (looping)",0,"m"],[18918,"knoten","noun","knot (swelling)",1,"m"],[18919,"knoten","noun","interchange (motorway junction)",2,"m",["Austria"]],[18920,"knoten","noun","knot (unit of speed)",3,"m"],[18921,"knoten","noun","vertex, node",4,"m"],[18922,"knoten","noun","craftsman; journeyman; farmhand",5,"m",["derogatory","obsolete"]],[18923,"knoten","noun","a person of some specified quality or practice; chiefly in Furzknoten, but sometimes other colloquial formations",6,"m"],[18924,"knoten","verb","to tie into a knot",7]],"related_forms":[[28695,"knoten","knotenameise","derived"],[28696,"knoten","knotig","derived"],[28697,"knoten","knotenpunkt","related"],[28698,"knoten","knotenschrift","related"]]},"machwerken":{"entries":[["machwerken",null,null,null]],"senses":[[354522,"machwerken","noun","dative plural of Machwerk",0,"n"]],"inflections":[["machwerken","machwerk","dative,definite,plural"]]},"mehrfamilienhause":{"entries":[["mehrfamilienhause",null,null,null]],"senses":[[597584,"mehrfamilienhause","noun","dative of Mehrfamilienhaus",0]],"inflections":[["mehrfamilienhause","mehrfamilienhaus","dative,singular"]]},"methylbromids":{"entries":[["methylbromids",null,null,null]],"senses":[[248788,"methylbromids","noun","genitive singular of Methylbromid",0,"n"]],"inflections":[["methylbromids","methylbromid","genitive"]]},"minuspunkte":{"entries":[["minuspunkte",null,null,null]],"senses":[[612543,"minuspunkte","noun","nominative/accusative/genitive plural of Minuspunkt",0]],"inf
{"format_version":1,"partition":15813,"records":{"biber":{"entries":[["biber",null,"/ˈbiːbər/","From Middle High German biber, from Old High German bibar, bibur, from Proto-West Germanic *bebru, from Proto-Germanic *bebruz (“beaver”), from Proto-Indo-European *bʰébʰrus. The spelling with ⟨i⟩ instead of ⟨ie⟩ is unusual. Biber is perhaps the only inherited Germanic word in which /iː/ is spelt ⟨i⟩ without there being a special reason for this (e.g. homophone disambiguation as in Lid, word-initial position as in Igel, function-word character as in mir).",{"g":"m","decl":"|||s|||n|"}]],"senses":[[17942,"biber","noun","beaver",0,"m"],[17943,"biber","name","a surname, variant of Bieber",1]]},"dichtschließende":{"entries":[["dichtschließende",null,null,null]],"senses":[[431909,"dichtschließende","adj","inflection of dichtschließend:",0],[431910,"dichtschließende","adj","strong/mixed nominative/accusative feminine singular",1],[431911,"dichtschließende","adj","strong nominative/accusative plural",2],[431912,"dichtschließende","adj","weak nominative all-gender singular",3],[431913,"dichtschließende","adj","weak accusative feminine/neuter singular",4]],"inflections":[["dichtschließende","dichtschließend","feminine,nominative,singular,strong,without-article"]]},"eingeengtem":{"entries":[["eingeengtem",null,null,null]],"senses":[[185796,"eingeengtem","adj","strong dative masculine/neuter singular of eingeengt",0]],"inflections":[["eingeengtem","eingeengt","dative,masculine,singular,strong,without-article"]]},"fotographiert":{"entries":[["fotographiert",null,null,null]],"senses":[[91710,"fotographiert","verb","past participle of fotographieren",0],[91711,"fotographiert","verb","inflection of fotographieren:",1],[91712,"fotographiert","verb","third-person singular present",2],[91713,"fotographiert","verb","second-person plural present",3],[91714,"fotographiert","verb","plural imperative",4]],"inflections":[["fotographiert","fotographieren","present,singular,third-person"]]},"luftp
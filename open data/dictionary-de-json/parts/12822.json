{"format_version":1,"partition":12822,"records":{"anderthalb":{"entries":[["anderthalb",null,"/andərthalb/","From Old High German andar halb, anderhalb (literally “second half”). Anderthalb is the single surviving relic of an older system to describe fractions, which counted from the higher ordinal number rather than the lower cardinal. Compare Old English ōþer healf, Dutch anderhalf, Danish halvanden. Compare also the use of the word halb in the sense of a half-hour before the following hour, such as halb zwei to mean one thirty. The word anderer has since lost the meaning \"second\", being used solely as \"other\" in modern German."]],"senses":[[48030,"anderthalb","num","one and a half (1+¹⁄₂), sesqui-",0]]},"dürlingers":{"entries":[["dürlingers",null,"[ˈdyːɐ̯ˌlɪŋɐs]",null]],"senses":[[692566,"dürlingers","name","genitive singular of Dürlinger",0],[692567,"dürlingers","name","plural of Dürlinger",1]],"inflections":[["dürlingers","dürlinger","genitive,masculine"]]},"einreicht":{"entries":[["einreicht",null,null,null]],"senses":[[653539,"einreicht","verb","inflection of einreichen:",0],[653540,"einreicht","verb","second-person plural dependent present",1],[653541,"einreicht","verb","third-person singular dependent present",2]],"inflections":[["einreicht","einreichen","indicative,plural,present,second-person,subordinate-clause"]]},"heuchlerischeren":{"entries":[["heuchlerischeren",null,null,null]],"senses":[[153930,"heuchlerischeren","adj","inflection of heuchlerisch:",0],[153931,"heuchlerischeren","adj","strong genitive masculine/neuter singular comparative degree",1],[153932,"heuchlerischeren","adj","weak/mixed genitive/dative all-gender singular comparative degree",2],[153933,"heuchlerischeren","adj","strong/weak/mixed accusative masculine singular comparative degree",3],[153934,"heuchlerischeren","adj","strong dative plural comparative degree",4],[153935,"heuchlerischeren","adj","weak/mixed all-case plural comparative degree",5]],"inflections":[["heuchlerischeren
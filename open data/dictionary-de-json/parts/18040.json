{"format_version":1,"partition":18040,"records":{"'n":{"entries":[["'n",null,"/n/","Contraction of ein. Like virtually all traditional German dialects, colloquial standard German distinguishes the indefinite article from the numeral for \"one\". The specific form 'n has spread from the North southward and is thus of chiefly Low German origin. Most High German dialects use forms without the final -n, such as [ə] or [a], at least for the basic form (i.e. the masculine and neuter nominative). These pronunciations are sometimes heard in colloquial standard German as well, but 'n is clearly the commonest form."]],"senses":[[6740,"'n","article","alternative form of ein (“a, an”)",0,null,["colloquial"]],[6741,"'n","article","alternative form of einen (“a, an”)",1,null,["colloquial"]],[6742,"'n","adv","short for denn (used for general emphasis)",2,null,["colloquial"]]],"related_forms":[[9903,"'n","so'n","derived"]],"inflections":[["'n","ein","alternative,informal"]]},"empfingen":{"entries":[["empfingen",null,"/ˈɛmp͡fɪŋən/",null]],"senses":[[376932,"empfingen","verb","inflection of empfangen:",0],[376933,"empfingen","verb","first/third-person plural preterite",1],[376934,"empfingen","verb","first/third-person plural subjunctive II",2],[376935,"empfingen","name","Empfingen (a village in Baden-Württemberg, Germany)",3]],"inflections":[["empfingen","empfahen","first-person,indicative,plural,preterite"],["empfingen","empfangen","first-person,indicative,plural,preterite"]]},"herausziehen":{"entries":[["herausziehen",null,"/hɛˈʁaust͡siːən/","From Middle High German herūzziehen. Equivalent to heraus- + ziehen.",null,"haben"]],"senses":[[420842,"herausziehen","verb","to pull (out)",0,null,null,null,"transitive"]]},"jobaussicht":{"entries":[["jobaussicht",null,"/ˈd͡ʒɔpˌaʊ̯szɪçt/","Job (job) + Aussicht (prospect)",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[601554,"jobaussicht","noun","job prospect",0,"f",["colloquial"]]]},"kämt zuvor":{"entries":[["kämt zuvor",null,null,null]],"s
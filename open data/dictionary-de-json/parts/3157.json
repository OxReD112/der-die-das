{"format_version":1,"partition":3157,"records":{"ahnen":{"entries":[["ahnen",null,"/ˈʔaːnən/","From Middle High German anen, from Old High German *anōn, from Proto-West Germanic *anōn, from *ana (“on”, preposition), from Proto-Germanic *an (“on”).\nCognate with Middle Low German ānen (whence German Low German ahnen (“to suspect, guess”)), dialectal Dutch anen (“to conjecture, tell, calculate”), Saterland Frisian oanje (“to suspect, guess”).",null,"haben"]],"senses":[[18864,"ahnen","verb","to suspect, guess",0,null,null,null,"transitive"],[18865,"ahnen","noun","plural of Ahn",1,"m"]],"inflections":[["ahnen","ahn","genitive"],["ahnen","ahne","plural"]]},"bauernfrühstück":{"entries":[["bauernfrühstück",null,"[ˈbaʊ̯ɐnˌfʁyːʃtʏk]","From Bauer (“farmer”) + Frühstück (“breakfast”).",{"g":"n","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[145611,"bauernfrühstück","noun","a dish made of fried potatoes, scrambled eggs and bacon",0,"n"]]},"eidgenössisch":{"entries":[["eidgenössisch",null,"[ˈʔaɪ̯tɡəˌnœsɪʃ]","From Eidgenosse + -isch."]],"senses":[[243791,"eidgenössisch","adj","confederate",0],[243792,"eidgenössisch","adj","Swiss",1]]},"laib":{"entries":[["laib",null,"/laɪ̯p/","From Middle High German leip, from Old High German hleib, from Proto-West Germanic *hlaib.\nCognate with English loaf, Polish chleb, Russian хлеб (xleb). The spelling with -ai- follows the old Upper German orthography; it was advocated by grammarians such as Johann Christoph Gottsched in order to distinguish from Leib (“body”).",{"g":"m","decl":"||/e|es/s|e/|e/|en/|e/"}]],"senses":[[10880,"laib","noun","loaf (of bread), wheel, block (of cheese)",0,"m",["uncommon"]]]},"literatursprachen":{"entries":[["literatursprachen",null,null,null]],"senses":[[606365,"literatursprachen","noun","plural of Literatursprache",0]],"inflections":[["literatursprachen","literatursprache","plural"]]},"messerstechereien":{"entries":[["messerstechereien",null,null,null]],"senses":[[62894,"messerstechereien","noun","plural of Messerstech
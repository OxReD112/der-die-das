{"format_version":1,"partition":31664,"records":{"düster":{"entries":[["düster",null,"/ˈdyːstər/","From Middle Low German dûster, from Old Saxon thiustri, ultimately from Proto-West Germanic *þiustrī (“dark, without light”). The word also exists in parts of West Central German (compare Luxembourgish däischter), which probably facilitated the borrowing; but the standardised form is definitely from Low German in view of its lacking diphthongisation."]],"senses":[[20814,"düster","adj","dark, dim, gloomy, obscure",0],[20815,"düster","adj","cheerless, melancholy, somber",1,null,["figuratively"]]]},"funktionsabschluß":{"entries":[["funktionsabschluß",null,null,null,{"g":"m","decl":"||/1sse|1sses|2üsse|2üsse|2üssen|2üsse"}]],"senses":[[707029,"funktionsabschluß","noun","Formerly standard spelling of Funktionsabschluss which was deprecated in the spelling reform (Rechtschreibreform) of 1996.",0,"m",["archaic"]]],"inflections":[["funktionsabschluß","funktionsabschluss","alternative"]]},"gemeinsten":{"entries":[["gemeinsten",null,null,null]],"senses":[[155527,"gemeinsten","adj","superlative degree of gemein",0],[155528,"gemeinsten","adj","inflection of gemein:",1],[155529,"gemeinsten","adj","strong genitive masculine/neuter singular superlative degree",2],[155530,"gemeinsten","adj","weak/mixed genitive/dative all-gender singular superlative degree",3],[155531,"gemeinsten","adj","strong/weak/mixed accusative masculine singular superlative degree",4],[155532,"gemeinsten","adj","strong dative plural superlative degree",5],[155533,"gemeinsten","adj","weak/mixed all-case plural superlative degree",6]],"inflections":[["gemeinsten","gemein","genitive,masculine,singular,strong,superlative,without-article"]]},"kühlerem":{"entries":[["kühlerem",null,null,null]],"senses":[[247231,"kühlerem","adj","strong dative masculine/neuter singular comparative degree of kühl",0]],"inflections":[["kühlerem","kühl","comparative,dative,masculine,singular,strong,without-article"]]},"literalerer":{"entr
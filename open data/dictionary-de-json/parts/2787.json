{"format_version":1,"partition":2787,"records":{"absiedlung":{"entries":[["absiedlung",null,null,"absiedeln + -ung",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[677425,"absiedlung","noun","metastasis (spread of cancer)",0,"f"]]},"altweibersommer":{"entries":[["altweibersommer",null,"/altˈvaɪ̯bɐˌzɔmɐ/","At least in the meaning \"Indian summer\", seemingly from alt (“old”) + Weiber (“women's”) + Sommer (“summer”), literally \"old women's summer\". Compare Hungarian vénasszonyok nyara, Polish babie lato, archaic Czech babské léto, Russian ба́бье ле́то (bábʹje léto), Belarusian ба́біна ле́та (bábina ljéta), Ukrainian ба́бине лі́то (bábyne líto), and English old wives' summer; compare also German Mädchensommer (literally “girls' summer”); the Polish and Czech terms for the season are also used for the webs. DWDS suggests the use for cobwebs could be comparing them to old women's white hair, like the name of the wood anemone, Altweibergras, and a regional name for cottongrass, alte Mägde. Alternatively, the middle element Weib may be a regional variant of Spinnwebe (“spider's web”) (cognate to English web), or related to weben (meaning, and related to, weave).\nCompare English gossamer, traditionally taken to be from \"goose summer\" and to have originally referred to the season (like Scots goesomer (“St Martin's summer”)) and then to webs; DWDS considers the connection of that word with summer and this word with Sommer (“summer”) uncertain, but besides other summery words for the webs like Sommerfäden (literally “summer threads”) (cognate to Dutch zomerdraden (literally “summer-threads”)), fliegender Sommer (“strands of web”), and Mariensommer, there are words like Herbstfäden (literally “autumn threads”).",{"g":"m","decl":"|||s|||n|"}]],"senses":[[34049,"altweibersommer","noun","loose gossamer or cobwebs found in the air or on the ground",0,"m"],[34050,"altweibersommer","noun","Indian summer (a stretch of warm days in autumn)",1,"m"]],"related_forms":[[40970,"altweibersommer","weiberfastnacht","related"],[40971,"altweibersommer","sommerferien","related"],[40972,"altweibersommer","spätsommer","related"]]},"angebrochen":{"entries":[["angebrochen",null,null,null]],"senses":[[376225,"angebrochen","verb","past participle of anbrechen",0]],"inflections":[["angebrochen","anbrechen","participle,past"]]},"barrieren":{"entries":[["barrieren",null,null,null]],"senses":[[48680,"barrieren","noun","plural of Barriere",0,"f"]],"inflections":[["barrieren","barriere","plural"]]},"bilden nach":{"entries":[["bilden nach",null,null,null]],"senses":[[496392,"bilden nach","verb","inflection of nachbilden:",0],[496393,"bilden nach","verb","first/third-person plural present",1],[496394,"bilden nach","verb","first/third-person plural subjunctive I",2]]},"biologistischer":{"entries":[["biologistischer",null,null,null]],"senses":[[148661,"biologistischer","adj","inflection of biologistisch:",0],[148662,"biologistischer","adj","strong/mixed nominative masculine singular",1],[148663,"biologistischer","adj","strong genitive/dative feminine singular",2],[148664,"biologistischer","adj","strong genitive plural",3]],"inflections":[["biologistischer","biologistisch","masculine,nominative,singular,strong"]]},"büschelohrmakis":{"entries":[["büschelohrmakis",null,null,null]],"senses":[[107435,"büschelohrmakis","noun","genitive singular of Büschelohrmaki",0],[107436,"büschelohrmakis","noun","plural of Büschelohrmaki",1]],"inflections":[["büschelohrmakis","büschelohrmaki","genitive"]]},"dimension":{"entries":[["dimension",null,null,"From Latin dīmensio, dīmensiōnis.",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[7587,"dimension","noun","dimension",0,"f"]]},"eleganz":{"entries":[["eleganz",null,null,null,{"g":"f","decl":"||||-|-|-|-"}]],"senses":[[39122,"eleganz","noun","elegance",0,"f"]]},"entehrtest":{"entries":[["entehrtest",null,null,null]],"senses":[[653617,"entehrtest","verb","inflection of entehren:",0],[653618,"entehrtest","verb","second-person singular pret
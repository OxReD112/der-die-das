[["efeu",null,"/ˈeːfɔʏ̯/","From Middle High German ephöu, from Old High German ebhouwi, derived through popular association with houwi (“hay”) from older ebah. Possibly from Proto-Germanic *ibahs, from Proto-Indo-European *(h₁)ebʰ-. The spelling and pronunciation in modern German used to be Epheu [ˈeːpˌhɔʏ̯]. The contemporary -f- is a spelling pronunciation that emanated from the North, reinforced by forms in Central and Low German dialects with original -f- (compare Middle Low German īflōf, ifflōf, Ripuarian Effche). Akin to English ivy.",{"g":"m:n","decl":"|||s|-|-|-|-"}]],"senses":[[17460,"efeu","noun","ivy",0,"m:n",["uncommon"]]]},"feingliedrigster":{"entries":[["feingliedrigster",null,null,null]],"senses":[[468723,"feingliedrigster","adj","inflection of feingliedrig:",0],[468724,"feingliedrigster","adj","strong/mixed nominative masculine singular superlative degree",1],[468725,"feingliedrigster","adj","strong genitive/dative feminine singular superlative degree",2],[468726,"feingliedrigster","adj","strong genitive plural superlative degree",3]],"inflections":[["feingliedrigster","feingliedrig","masculine,nominative,singular,strong,superlative,without-article"]]},"gewichtigere":{"entries":[["gewichtigere",null,null,null]],"senses":[[475213,"gewichtigere","adj","inflection of gewichtig:",0],[475214,"gewichtigere","adj","strong/mixed nominative/accusative feminine singular comparative degree",1],[475215,"gewichtigere","adj","strong nominative/accusative plural comparative degree",2],[475216,"gewichtigere","adj","weak nominative all-gender singular comparative degree",3],[475217,"gewichtigere","adj","weak accusative feminine/neuter singular comparative degree",4]],"inflections":[["gewichtigere","gewichtig","comparative,feminine,nominative,singular,strong,without-article"]]},"irrlichternde":{"entries":[["irrlichternde",null,null,null]],"senses":[[449341,"irrlichternde","adj","inflection of irrlichternd:",0],[449342,"irrlichternde","adj","strong/mixed nominative/accu
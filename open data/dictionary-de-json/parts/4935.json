hô, weak-stem variant of *elhaz. Compare the Old High German hapax elo for usual el(a)ho. This would make it a mere byform of Elch.",{"g":"n:m","decl":"|||s||||"}]],"senses":[[11198,"elen","noun","moose (US), elk (UK) (Alces alces)",0,"n:m",["archaic"]]]},"gewaltsamer":{"entries":[["gewaltsamer",null,null,null]],"senses":[[658430,"gewaltsamer","adj","comparative degree of gewaltsam",0],[658431,"gewaltsamer","adj","inflection of gewaltsam:",1],[658432,"gewaltsamer","adj","strong/mixed nominative masculine singular",2],[658433,"gewaltsamer","adj","strong genitive/dative feminine singular",3],[658434,"gewaltsamer","adj","strong genitive plural",4]],"inflections":[["gewaltsamer","gewaltsam","masculine,nominative,singular,strong"]]},"herzkrankheit":{"entries":[["herzkrankheit",null,null,"Herz + Krankheit",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[196777,"herzkrankheit","noun","heart disease",0,"f"]]},"mache frei":{"entries":[["mache frei",null,null,null]],"senses":[[118175,"mache frei","verb","inflection of freimachen:",0],[118176,"mache frei","verb","first-person singular present",1],[118177,"mache frei","verb","first/third-person singular subjunctive I",2],[118178,"mache frei","verb","singular imperative",3]]},"mobilisierungen":{"entries":[["mobilisierungen",null,null,null]],"senses":[[145133,"mobilisierungen","noun","plural of Mobilisierung",0]],"inflections":[["mobilisierungen","mobilisierung","plural"]]},"nicht-gattern":{"entries":[["nicht-gattern",null,null,null]],"senses":[[371937,"nicht-gattern","noun","dative plural of NICHT-Gatter",0,"n"]],"inflections":[["nicht-gattern","nicht-gatter","dative,definite,plural"]]},"perlmutternem":{"entries":[["perlmutternem",null,null,null]],"senses":[[530615,"perlmutternem","adj","strong dative masculine/neuter singular of perlmuttern",0]],"inflections":[["perlmutternem","perlmuttern","dative,masculine,singular,strong,without-article"]]},"rautenförmige":{"entries":[["rautenförmige",null,null,null]],"senses":[[537670,"raut
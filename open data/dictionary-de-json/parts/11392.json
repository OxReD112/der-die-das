{"format_version":1,"partition":11392,"records":{"auch":{"entries":[["auch",null,"/aʊ̯x/","From Middle High German ouch, from Old High German ouh, from Proto-Germanic *auk. Cognate with Dutch ook (“also”), Low German ook (“also”), West Frisian ek (“also, too”), Luxembourgish och (“also”), Swedish och (“and”), Icelandic og (“and”), Danish og (“and”), and archaic English eke (“also”)."]],"senses":[[11753,"auch","adv","also, too, as well (in addition to whatever or whoever has previously been listed)",0],[11754,"auch","adv","Used for emphasis.",1],[11755,"auch","adv","To confirm a preceding statement by someone else: really, actually, indeed, in fact",2],[11756,"auch","adv","To ask for confirmation of something one considers necessary.",3],[11757,"auch","adv","To imply that something is unreasonable.",4],[11758,"auch","adv","even (implying an extreme example in the case mentioned, as compared to the implied reality)",5],[11759,"auch","adv","ever as in whatever, whenever, however, etc.",6],[11760,"auch","intj","in answering a yes-no question, used to express that the thing asked about covers part of the truth but not all of it; “yes, and more”",7],[11761,"auch","name","a surname, common in Southern Germany as an occupational surname for those who watched livestock at night",8]]},"bademeisterinnen":{"entries":[["bademeisterinnen",null,null,null]],"senses":[[636085,"bademeisterinnen","noun","nominative/genitive/dative/accusative plural of Bademeisterin",0]],"inflections":[["bademeisterinnen","bademeisterin","plural"]]},"brechtianer":{"entries":[["brechtianer",null,null,null,{"g":"m","decl":"|||s|||n|"}]],"senses":[[675608,"brechtianer","noun","a follower of Bertolt Brecht",0,"m",["uncommon"]]]},"draufgängerischem":{"entries":[["draufgängerischem",null,null,null]],"senses":[[464946,"draufgängerischem","adj","strong dative masculine/neuter singular of draufgängerisch",0]],"inflections":[["draufgängerischem","draufgängerisch","dative,masculine,singular,strong,without-article
der meaning, but the semantic split between both forms was completed only during the 19th century. The adverbs schlechthin and schlechterdings (both “plainly, absolutely”) remain as relicts to this day."]],"senses":[[34296,"schlicht","adj","plain, simple, artless, natural",0],[34297,"schlicht","verb","second-person plural preterite of schleichen",1]],"inflections":[["schlicht","schleichen","indicative,plural,preterite,second-person"],["schlicht","schlichten","imperative,second-person,singular"]]},"schönbohms":{"entries":[["schönbohms",null,"/ˈʃøːnˌboːms/",null]],"senses":[[701998,"schönbohms","name","genitive singular of Schönbohm",0]],"inflections":[["schönbohms","schönbohm","genitive,masculine"]]},"seelen":{"entries":[["seelen",null,"/ˈzeːlən/",null]],"senses":[[42280,"seelen","noun","plural of Seele",0]],"inflections":[["seelen","seele","plural"]]},"stechbeitel":{"entries":[["stechbeitel",null,"/ˈʃtɛçˌbaɪ̯tl̩/","From stechen + Beitel (“wood chisel”).",{"g":"m","decl":"|||s|||n|"}]],"senses":[[627028,"stechbeitel","noun","chisel, wood chisel (a tool for caving wood, etc.)",0,"m"]]},"straußen":{"entries":[["straußen",null,null,null]],"senses":[[350590,"straußen","noun","dative plural of Strauß (“ostrich”)",0],[350591,"straußen","noun","nominative/genitive/accusative plural of Strauß",1,null,["uncommon"]],[350592,"straußen","noun","genitive/dative/accusative singular of Strauß",2,null,["archaic"]]],"inflections":[["straußen","strauß","dated,genitive"]]},"tixo":{"entries":[["tixo",null,"/ˈtɪkso/","From the trademarked brand name Tixo. Compare Tesa in Germany.",{"g":"n","decl":"|||s|s|s|s|s"}]],"senses":[[675486,"tixo","noun","adhesive tape",0,"n",["informal","Austria"]]]},"untrennbarer":{"entries":[["untrennbarer",null,null,null]],"senses":[[321282,"untrennbarer","adj","inflection of untrennbar:",0],[321283,"untrennbarer","adj","strong/mixed nominative masculine singular",1],[321284,"untrennbarer","adj","strong genitive/dative feminine singular",2],[321285,"untrennba
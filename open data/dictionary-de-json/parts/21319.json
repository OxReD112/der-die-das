{"format_version":1,"partition":21319,"records":{"biomarkern":{"entries":[["biomarkern",null,null,null]],"senses":[[682884,"biomarkern","noun","dative plural of Biomarker",0]],"inflections":[["biomarkern","biomarker","dative,definite,plural"]]},"elen":{"entries":[["elen",null,"/ˈeːlən/","From Middle High German eln, elent (mid-13th c.), of uncertain origin. Often derived from Old Lithuanian elenis (“deer”, modern élnias), from Proto-Indo-European *h₁el-. This derivation is supported by the fact that the el(e)n form appears during a time when the elk was gradually dying out in the German-speaking lands. However, it must be noted that the Lithuanian word does not refer to the elk specifically. Even more importantly, elen (from elhen by regular loss of prevocalic h in Central and Low German dialects) can represent a generalised oblique case or plural of Proto-Germanic *elhô, weak-stem variant of *elhaz. Compare the Old High German hapax elo for usual el(a)ho. This would make it a mere byform of Elch.",{"g":"n:m","decl":"|||s||||"}]],"senses":[[11198,"elen","noun","moose (US), elk (UK) (Alces alces)",0,"n:m",["archaic"]]]},"mobilisierungen":{"entries":[["mobilisierungen",null,null,null]],"senses":[[145133,"mobilisierungen","noun","plural of Mobilisierung",0]],"inflections":[["mobilisierungen","mobilisierung","plural"]]},"schlechtmachend":{"entries":[["schlechtmachend",null,null,null]],"senses":[[396759,"schlechtmachend","verb","present participle of schlechtmachen",0]],"inflections":[["schlechtmachend","schlechtmachen","participle,present"]]},"schliddernd":{"entries":[["schliddernd",null,null,null]],"senses":[[589210,"schliddernd","verb","present participle of schliddern",0]],"inflections":[["schliddernd","schliddern","participle,present"]]},"schrie heraus":{"entries":[["schrie heraus",null,null,null]],"senses":[[493054,"schrie heraus","verb","first/third-person singular preterite of herausschreien",0]]},"sedimentgestein":{"entries":[["sedimentgestein",null,null,"Sedime
e,singular,strong"]]},"kochsendung":{"entries":[["kochsendung",null,null,"kochen + Sendung",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[712222,"kochsendung","noun","cooking show",0,"f",null,null,null,null,["television"]]]},"koronarer":{"entries":[["koronarer",null,null,null]],"senses":[[507962,"koronarer","adj","inflection of koronar:",0],[507963,"koronarer","adj","strong/mixed nominative masculine singular",1],[507964,"koronarer","adj","strong genitive/dative feminine singular",2],[507965,"koronarer","adj","strong genitive plural",3]],"inflections":[["koronarer","koronar","masculine,nominative,singular,strong"]]},"leichtsinniges":{"entries":[["leichtsinniges",null,null,null]],"senses":[[300368,"leichtsinniges","adj","strong/mixed nominative/accusative neuter singular of leichtsinnig",0]],"inflections":[["leichtsinniges","leichtsinnig","neuter,nominative,singular,strong,without-article"]]},"morgenstund hat gold im mund":{"entries":[["morgenstund hat gold im mund",null,null,"Origin disputed. Early etymological attempts linked the phrase to Germanic mythology or fairytales. In 1881, Robert Geete discovered the variant Icelandic Morgunstund gefur gull í mund, noting that the Icelandic mund (“hand”) (derived from with Old Norse mund and cognate with Old High German munt) is distinct from munnur (“mouth”).\nAlfred Götze later challenged this as the proverb's origin, noting a lack of attestations prior to the 16th century. He supported Heinrich Brunner's theory that the phrase originated as a schoolmaster's mnemonic device aurora habet aurum in ore (literally, \"dawn has gold in [its] mouth\").\nHowever, modern scholarship based on the work of Richard Jente largley views the proverb as a vernacular evolution of the Humanist Latin maxim aurora musis amica (“dawn is friend to the muses”). Jente observed that 16th- and 17th-century variants frequently used Brot (“bread”), Arbeit (“work”), or Gott (“God”) instead of Gold (e.g., Morgenstund hat das Brot im Mund). The rhyming version with Gold only became dominant and widely popular in the 19th century."]],"senses":[[21640,"morgenstund hat gold im mund","proverb","Proverb extolling the virtues of activity in the morning hours, encouraging early rising",0]]},"nikotinhaltigsten":{"entries":[["nikotinhaltigsten",null,null,null]],"senses":[[525605,"nikotinhaltigsten","adj","superlative degree of nikotinhaltig",0],[525606,"nikotinhaltigsten","adj","inflection of nikotinhaltig:",1],[525607,"nikotinhaltigsten","adj","strong genitive masculine/neuter singular superlative degree",2],[525608,"nikotinhaltigsten","adj","weak/mixed genitive/dative all-gender singular superlative degree",3],[525609,"nikotinhaltigsten","adj","strong/weak/mixed accusative masculine singular superlative degree",4],[525610,"nikotinhaltigsten","adj","strong dative plural superlative degree",5],[525611,"nikotinhaltigsten","adj","weak/mixed all-case plural superlative degree",6]],"inflections":[["nikotinhaltigsten","nikotinhaltig","genitive,masculine,singular,strong,superlative,without-article"]]},"sonst wer":{"entries":[["sonst wer",null,null,"From sonst (“else, otherwise”) + wer (“someone”) (in the colloquial sense of \"someone\")."]],"senses":[[695665,"sonst wer","pron","someone else, anyone else, whoever else",0,null,["informal"]]]},"übergabe":{"entries":[["übergabe",null,"/ˈyːbɐˌɡaːbə/","über- + Gabe.\nCompare Dutch overgave.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[358061,"übergabe","noun","handover, handoff, transfer, delivery",0,"f"],[358062,"übergabe","noun","surrender, capitulation",1,"f"]],"related_forms":[[54640,"übergabe","abgabe","related"],[54641,"übergabe","angabe","related"],[54642,"übergabe","aufgabe","related"],[54643,"übergabe","beigabe","related"],[54644,"übergabe","mitgabe","related"],[54645,"übergabe","übergeben","related"],[54646,"übergabe","vergabe","related"],[54647,"übergabe","vorgabe","related"],[54648,"übergabe","zurückgabe","related"]]},"anfühle":{"inflections":[["anfühle","anfühlen","fir
{"format_version":1,"partition":14813,"records":{"bayreuth":{"entries":[["bayreuth",null,"/baɪ̯ˈʁɔʏ̯t/","From Middle High German Beierrūte. The second component is related to roden (“clear, make arable”); compare toponyms in -rode, -roth, -rade, -rath. The first component is somewhat puzzling. The only connection that suggests itself is with Bayern (“Bavaria”), but Bayreuth is far north of the historically Bavarian territories (which exclude great parts of the modern state, while including most of Austria)."]],"senses":[[35257,"bayreuth","name","Bayreuth (an independent town in the Upper Franconia region, Bavaria, Germany)",0],[35258,"bayreuth","name","Bayreuth (a rural district of the Upper Franconia region, Bavaria, surrounding but not including the town of Bayreuth, which nevertheless serves as its administrative seat)",1]],"related_forms":[[41578,"bayreuth","bayreutherin","derived"],[41579,"bayreuth","bayreuther","derived"],[41580,"bayreuth","bubenreuth","related"],[41581,"bayreuth","konradsreuth","related"],[41582,"bayreuth","mödlareuth","related"],[41583,"bayreuth","neureuth","related"],[41584,"bayreuth","tirschenreuth","related"]]},"bleichmittel":{"entries":[["bleichmittel",null,"[ˈblaɪ̯çˌmɪtl̩]","From bleichen (“to bleach”) + Mittel (“agent”).",{"g":"n","decl":"|||s|||n|"}]],"senses":[[189132,"bleichmittel","noun","bleach",0,"n"],[189133,"bleichmittel","noun","whitener",1,"n"]]},"donnerstagnachmittags":{"entries":[["donnerstagnachmittags",null,null,null]],"senses":[[499885,"donnerstagnachmittags","noun","genitive of Donnerstagnachmittag",0,"m"]],"inflections":[["donnerstagnachmittags","donnerstagnachmittag","genitive"]]},"eigennützigen":{"entries":[["eigennützigen",null,null,null]],"senses":[[467128,"eigennützigen","adj","inflection of eigennützig:",0],[467129,"eigennützigen","adj","strong genitive masculine/neuter singular",1],[467130,"eigennützigen","adj","weak/mixed genitive/dative all-gender singular",2],[467131,"eigennützigen","adj","strong/weak/mixed a
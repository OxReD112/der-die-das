{"format_version":1,"partition":26898,"records":{"bundesanwaltschaft":{"entries":[["bundesanwaltschaft",null,null,null,{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[351448,"bundesanwaltschaft","noun","federal prosecutor",0,"f",["Switzerland","Germany"],null,null,null,["law"]]]},"i-dötzchen":{"entries":[["i-dötzchen",null,"/ˈiːˌdœts.çən/","Partial calque of Central Franconian i-Dötzje (“first-year pupil”), from the letter i, which was traditionally the first letter that school children learnt, and the noun Dotz (“little, often chubby, child”). This word’s original meaning is \"knob, bump\", it being probably cognate with Dutch dot, English dot. The word i-Dötzje might therefore alternatively be derived from i-Dotz meaning \"dot of the i\", as has been proposed; but neither is this latter sense in general use, nor does the derivation suggest itself semantically.",{"w":"I-Dötzchen","g":"n","decl":"|||s||||","alt":[["n","|||s||||"],["n","|||s||||","i-Dötzchen"]]}]],"senses":[[387864,"i-dötzchen","noun","alternative spelling of i-Dötzchen",0,"n"],[387865,"i-dötzchen","noun","first-year pupil; child who has just started school; abecedarian",1,"n",["informal","regional","Rhineland"]]]},"katholischer":{"entries":[["katholischer",null,null,null]],"senses":[[202096,"katholischer","adj","inflection of katholisch:",0],[202097,"katholischer","adj","strong/mixed nominative masculine singular",1],[202098,"katholischer","adj","strong genitive/dative feminine singular",2],[202099,"katholischer","adj","strong genitive plural",3]],"inflections":[["katholischer","katholisch","masculine,nominative,singular,strong"]]},"kennte":{"entries":[["kennte",null,null,null]],"senses":[[91611,"kennte","verb","first/third-person singular subjunctive II of kennen",0]],"inflections":[["kennte","kennen","past,subjunctive"]]},"kochtöpfe":{"entries":[["kochtöpfe",null,null,null]],"senses":[[61902,"kochtöpfe","noun","nominative/accusative/genitive plural of Kochtopf",0]],"inflections":[["kochtöpfe","koc
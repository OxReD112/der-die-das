"rübe",null,"/ˈʁyːbə/","From Middle High German rüebe, ruobe, from Old High German ruoba, from Proto-West Germanic *rōbijā.\nCognate with Middle Dutch roeve, Middle Low German rö̂ve (modern Rööv). Forms with back vowel in Upper German dialects are due to umlaut hindrance before labials, but Icelandic rófa, Danish roe, Swedish rova require a byform Proto-Germanic *rōbǭ. See also Latin rāpa, rāpum, Proto-Slavic *rěpa, etc., all meaning “beet, turnip”. An ablaut variant Proto-Germanic *rēbǭ underlies in Old High German rāba (if it is not from Latin).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[19313,"rübe","noun","a cover term for a variety of root vegetables including:",0,"f"],[19314,"rübe","noun","beetroot",1,"f"],[19315,"rübe","noun","turnip",2,"f"],[19316,"rübe","noun","rutabaga",3,"f"],[19317,"rübe","noun","carrot",4,"f"],[19318,"rübe","noun","radish",5,"f"],[19319,"rübe","noun","parsnip",6,"f"],[19320,"rübe","noun","root parsley",7,"f"],[19321,"rübe","noun","celeriac",8,"f"],[19322,"rübe","noun","Beta (genus within the family Amaranthaceae)",9,"f"],[19323,"rübe","noun","Beta vulgaris",10,"f"],[19324,"rübe","noun","head, bonce, noggin",11,"f",["colloquial"]]],"related_forms":[[29146,"rübe","bastrübe","derived"],[29147,"rübe","bayerische rübe","derived"],[29148,"rübe","beta-rübe","derived"],[29149,"rübe","futterrübe","derived"],[29150,"rübe","gelbe rübe","derived"],[29151,"rübe","herbstrübe","derived"],[29152,"rübe","holzrübe","derived"],[29153,"rübe","kohlrübe","derived"],[29154,"rübe","kraut und rüben","derived"],[29155,"rübe","mairübe","derived"],[29156,"rübe","mohrrübe","derived"],[29157,"rübe","rote rübe","derived"],[29158,"rübe","rübenacker","derived"],[29159,"rübe","rübenartig","derived"],[29160,"rübe","rübenernte","derived"],[29161,"rübe","rübenfeld","derived"],[29162,"rübe","rübenferien","derived"],[29163,"rübe","rübenkampagne","derived"],[29164,"rübe","rübenkraut","derived"],[29165,"rübe","rübenroder","derived"],[29166,"rübe","rübensaft","derived"],[2916
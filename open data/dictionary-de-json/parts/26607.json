eblume":{"entries":[["pusteblume",null,"/ˈpuːstəˌbluːmə/","Attested 19th century, chiefly from Low German dialects. Analysable as pusten (“to blow”) + Blume (“flower”), from the children’s habit of blowing off the seeds. However, this may be only a remotivation of an underlying dialectal Pissblume, from the dandelion's diuretic effect; compare Dutch pisbloem.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[36209,"pusteblume","noun","a blowball, dandelion clock (seedhead of dandelion)",0,"f",["informal"]],[36210,"pusteblume","noun","dandelion (plant)",1,"f",["colloquial","childish"]]]},"putzen":{"entries":[["putzen",null,"/ˈpʊt͡sn̩/","15th century, also in the form butzen. Origin unknown. Perhaps derived from Middle High German butze (“lump, piece, stump”), from Old High German *butz, from Proto-West Germanic *butt, from Proto-Germanic *buttaz (whence also English butt), with the interpretation of the verb being \"to (remove) lumps and stumps\", but there are several other theories.\nPerhaps related to Latin puto in the sense of \"clean\".",{"g":"n","decl":"|||s|-|-|-|-"},"haben"]],"senses":[[60085,"putzen","verb","to clean, especially by rubbing with something wet, to brush (one's teeth)",0,null,null,null,"both"],[60086,"putzen","verb","to groom oneself",1,null,null,"acc"],[60087,"putzen","verb","to beautify oneself by washing, styling, and putting on fancy clothes",2,null,["dated","~of a person"],"acc"],[60088,"putzen","verb","to plaster",3,null,null,null,null,null,["construction"]],[60089,"putzen","noun","gerund of putzen",4,"n"],[60090,"putzen","noun","plural of Putze",5]],"related_forms":[[48471,"putzen","verputzen","derived"],[48472,"putzen","lampenputzer","related"],[48473,"putzen","lampputzer","related"],[48474,"putzen","putze","related"],[48475,"putzen","putzfrau","related"],[48476,"putzen","putzlappen","related"],[48477,"putzen","putzmann","related"]],"inflections":[["putzen","putz","dative,definite,plural"],["putzen","putze","plural"]]},"reibekuchens":{"entri
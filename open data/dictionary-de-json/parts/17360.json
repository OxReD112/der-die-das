{"format_version":1,"partition":17360,"records":{"heidewitzka":{"entries":[["heidewitzka",null,"/ˌhaɪ̯dəˈvɪtska/","Popularized by the 1936 Kölsch song Heidewitzka, Herr Kapitän by Karl Berbuer (also known as the Müllemer Böötche). Ultimately in all likelihood onomatopoeic. It seems unclear whether the word was coined by Berbuer or already existed before. Many commentators think that the phrase Heidewitzka, Herr Kapitän (roughly “Huzzah, Mr. Captain”) was a covert parody of Heil Hitler."]],"senses":[[685585,"heidewitzka","intj","huzzah!, come on! (used to incite to vigorous action)",0],[685586,"heidewitzka","intj","bam!, wham! (used as a praising reaction to such action)",1]]},"lagerplätze":{"entries":[["lagerplätze",null,"[ˈlaːɡɐˌplɛtsə]",null]],"senses":[[615753,"lagerplätze","noun","nominative/accusative/genitive plural of Lagerplatz",0]],"inflections":[["lagerplätze","lagerplatz","plural"]]},"niveauvolleren":{"entries":[["niveauvolleren",null,null,null]],"senses":[[265998,"niveauvolleren","adj","inflection of niveauvoll:",0],[265999,"niveauvolleren","adj","strong genitive masculine/neuter singular comparative degree",1],[266000,"niveauvolleren","adj","weak/mixed genitive/dative all-gender singular comparative degree",2],[266001,"niveauvolleren","adj","strong/weak/mixed accusative masculine singular comparative degree",3],[266002,"niveauvolleren","adj","strong dative plural comparative degree",4],[266003,"niveauvolleren","adj","weak/mixed all-case plural comparative degree",5]],"inflections":[["niveauvolleren","niveauvoll","comparative,genitive,masculine,singular,strong,without-article"]]},"polnischerem":{"entries":[["polnischerem",null,null,null]],"senses":[[266470,"polnischerem","adj","strong dative masculine/neuter singular comparative degree of polnisch",0]],"inflections":[["polnischerem","polnisch","comparative,dative,masculine,singular,strong,without-article"]]},"räudigstes":{"entries":[["räudigstes",null,null,null]],"senses":[[541208,"räudigstes","adj","str
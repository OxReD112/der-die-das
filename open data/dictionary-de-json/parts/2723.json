f- is an adaptation to the High German consonantism, for which there may have been rare antetypes in northern dialects of Central German, but which was chiefly artificial. Kneipen remained predominant until the earlier 19th century, but was somewhat informal. The more standard-looking kneifen then fully established itself in written German and displaced kneipen by the mid-20th century.",null,"haben"]],"senses":[[18911,"kneifen","verb","to pinch, to squeeze",0,null,null,null,"both"],[18912,"kneifen","verb","to chicken out; to back out; to shirk",1,null,null,null,"intransitive"]],"related_forms":[[28688,"kneifen","kneifen","derived"],[28689,"kneifen","kneifer","derived"],[28690,"kneifen","kneifzange","derived"],[28691,"kneifen","kniff","derived"],[28692,"kneifen","kneipe","related"],[28693,"kneifen","kniepen","related"]]},"losmachte":{"entries":[["losmachte",null,null,null]],"senses":[[660842,"losmachte","verb","inflection of losmachen:",0],[660843,"losmachte","verb","first/third-person singular dependent preterite",1],[660844,"losmachte","verb","first/third-person singular dependent subjunctive II",2]],"inflections":[["losmachte","losmachen","first-person,indicative,preterite,singular,subordinate-clause"]]},"musikstücks":{"entries":[["musikstücks",null,null,null]],"senses":[[637529,"musikstücks","noun","genitive singular of Musikstück",0]],"inflections":[["musikstücks","musikstück","genitive"]]},"mykenische":{"entries":[["mykenische",null,null,null]],"senses":[[522240,"mykenische","adj","inflection of mykenisch:",0],[522241,"mykenische","adj","strong/mixed nominative/accusative feminine singular",1],[522242,"mykenische","adj","strong nominative/accusative plural",2],[522243,"mykenische","adj","weak nominative all-gender singular",3],[522244,"mykenische","adj","weak accusative feminine/neuter singular",4]],"inflections":[["mykenische","mykenisch","feminine,nominative,singular,strong,without-article"]]},"nachbörslichem":{"entries":[["nachbörslichem",null,null,null]],"s
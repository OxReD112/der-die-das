{"format_version":1,"partition":7723,"records":{"abfassens":{"entries":[["abfassens",null,null,null]],"senses":[[498794,"abfassens","noun","genitive of Abfassen",0,"n"]],"inflections":[["abfassens","abfassen","genitive"]]},"beschwerlichen":{"entries":[["beschwerlichen",null,null,null]],"senses":[[282214,"beschwerlichen","adj","inflection of beschwerlich:",0],[282215,"beschwerlichen","adj","strong genitive masculine/neuter singular",1],[282216,"beschwerlichen","adj","weak/mixed genitive/dative all-gender singular",2],[282217,"beschwerlichen","adj","strong/weak/mixed accusative masculine singular",3],[282218,"beschwerlichen","adj","strong dative plural",4],[282219,"beschwerlichen","adj","weak/mixed all-case plural",5]],"inflections":[["beschwerlichen","beschwerlich","genitive,masculine,singular,strong,without-article"]]},"elektrisirtes":{"entries":[["elektrisirtes",null,null,null]],"senses":[[401997,"elektrisirtes","adj","strong/mixed nominative/accusative neuter singular of elektrisirt",0]],"inflections":[["elektrisirtes","elektrisirt","neuter,nominative,singular,strong,without-article"]]},"erzbistümer":{"entries":[["erzbistümer",null,null,null]],"senses":[[691402,"erzbistümer","noun","nominative/accusative/genitive plural of Erzbistum",0]],"inflections":[["erzbistümer","erzbistum","plural"]]},"friemeln":{"entries":[["friemeln",null,"/ˈfriːməln/","20th century, from Low German and Central Franconian dialects. Cognate to Dutch friemelen (“to fiddle, fidget”). Probably the same as Dutch and Middle Dutch wriemelen (“to move back and forth”, intransitive and transitive), Low German wrimen (“to rub”), with a development from wr- to fr-, which is widespread among dialects of all the relevant languages. Philippa (Etymologisch Woordenboek, 2003-09) casts doubt on this because wriemelen also means “to swarm” (of a collective). This collective sense need not be the oldest, however. In fact, the first attestation has the sense “to move back and forth with exertion” (of a man during sexual intercourse), and the sense “to fiddle, fidget” is attested for the wr-form as well. Philippa prefers to derive friemelen from frommelen (“to fidget”) and this in turn from fommelen (German fummeln). However, frommelen shows variants with wr- as well and is also regionally more restricted.",null,"haben"]],"senses":[[82510,"friemeln","verb","to fiddle; to move something in one's hands, especially by rubbing it between thumb and forefinger",0],[82511,"friemeln","verb","to do delicate manual tasks, such as inserting a thread through the eye of a needle or undoing a tangle, implying either laboriousness of the task or clumsiness of them who do it",1]],"related_forms":[[49330,"friemeln","auseinanderfriemeln","derived"],[49331,"friemeln","friemelei","derived"],[49332,"friemeln","herumfriemeln","derived"],[49333,"friemeln","reinfriemeln","derived"]]},"gebrauchten":{"entries":[["gebrauchten",null,null,null]],"senses":[[153538,"gebrauchten","adj","inflection of gebraucht:",0],[153539,"gebrauchten","adj","strong genitive masculine/neuter singular",1],[153540,"gebrauchten","adj","weak/mixed genitive/dative all-gender singular",2],[153541,"gebrauchten","adj","strong/weak/mixed accusative masculine singular",3],[153542,"gebrauchten","adj","strong dative plural",4],[153543,"gebrauchten","adj","weak/mixed all-case plural",5]],"inflections":[["gebrauchten","gebrauchen","first-person,indicative,plural,preterite"],["gebrauchten","gebraucht","genitive,masculine,singular,strong,without-article"]]},"gehen her":{"entries":[["gehen her",null,null,null]],"senses":[[273744,"gehen her","verb","inflection of hergehen:",0],[273745,"gehen her","verb","first/third-person plural present",1],[273746,"gehen her","verb","first/third-person plural subjunctive I",2]]},"kennzahlen":{"entries":[["kennzahlen",null,null,null]],"senses":[[357392,"kennzahlen","noun","plural of Kennzahl",0,"f"]],"inflections":[["kennzahlen","kennzahl","plural"]]},"masurischen":{"entries":[["masurischen",null,null
flections":[["internationalisierst","internationalisieren","indicative,present,second-person,singular"]]},"läuten":{"entries":[["läuten",null,"/lɔʏ̯tən/","From Middle High German liuten, from Old High German hlūten, from Proto-West Germanic *hlūdijan (“to make sound”), factitive of *hlūdēn (“to sound”), whence lauten. Equivalent to Laut + -en. Cognate with Dutch luiden. In Middle High German, the distinction between both verbs was increasingly lost, i.e. läuten came to be used intransitively. In Modern German, the two forms were then redistributed on semantic grounds: läuten was restricted to bells while lauten survives only in the figurative sense “to read, have a content”.",{"g":"n","decl":"|||s|-|-|-|-"},"haben"]],"senses":[[360579,"läuten","verb","to ring, toll (a bell)",0,null,null,null,"both"],[360580,"läuten","verb","to ring, toll",1,null,null,null,"intransitive"],[360581,"läuten","verb","to ring (at a door, front desk, etc.)",2,null,null,null,"intransitive"],[360582,"läuten","verb","to ring",3],[360583,"läuten","noun","gerund of läuten: ringing, tolling",4,"n"]],"related_forms":[[54847,"läuten","geläut","derived"],[54848,"läuten","geläute","derived"],[54849,"läuten","läuten","derived"],[54850,"läuten","etwas läuten hören","derived"]]},"nachtragenderer":{"entries":[["nachtragenderer",null,null,null]],"senses":[[523276,"nachtragenderer","adj","inflection of nachtragend:",0],[523277,"nachtragenderer","adj","strong/mixed nominative masculine singular comparative degree",1],[523278,"nachtragenderer","adj","strong genitive/dative feminine singular comparative degree",2],[523279,"nachtragenderer","adj","strong genitive plural comparative degree",3]],"inflections":[["nachtragenderer","nachtragend","comparative,masculine,nominative,singular,strong,without-article"]]},"schorfes":{"entries":[["schorfes",null,null,null]],"senses":[[355724,"schorfes","noun","genitive singular of Schorf",0,"m"]],"inflections":[["schorfes","schorf","genitive"]]},"schwinde":{"entries":[["sc
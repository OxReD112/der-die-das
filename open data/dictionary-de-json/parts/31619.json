{"format_version":1,"partition":31619,"records":{"-i":{"entries":[["-i",null,"[i]","From (especially Alemannic) Middle High German -ī, from Old High German -īn, from Proto-West Germanic *-īn (diminutive suffix). Generalized in Modern German through pet names like Rudi (Middle High German Ruodī). Cognate with English -en as in chicken, maiden.\nNot directly related with English -ie, -y (from Old English -iġ), nor with Dutch -ie, -je (from Proto-West Germanic *-ikīn, whence German -chen). However, the vowel /i/ has an onomatopoeic quality to it, which is likely to reinforce its development or preservation in diminutives."]],"senses":[[5442,"-i","suffix","Forms pet names from given names, kinship terms, and terms of address.",0,null,["informal"]],[5443,"-i","suffix","Forms nouns from adjectives and verbs denoting someone characterized by that word.",1,null,["informal","derogatory","endearing"]],[5444,"-i","suffix","Forms clippings, with a meaning of -ist, -ian, -an",2,null,["colloquial","informal","derogatory"]],[5445,"-i","suffix","Forms clippings.",3,null,["colloquial","informal"]],[5446,"-i","suffix","Forms gender-neutral nouns.",4,null,["informal","rare"]],[5447,"-i","suffix","an unproductive ending of nouns for Semitic and Indo-Iranian groups, especially peoples",5,null,["informal"]],[5448,"-i","suffix","forms the plurals of some nouns of Latin origin with a singular in -us.",6,null,["informal"]],[5449,"-i","suffix","forms the plurals of some nouns of Italian origin with a singular in -o.",7,null,["informal"]]]},"hantiger":{"entries":[["hantiger",null,null,null]],"senses":[[482327,"hantiger","adj","comparative degree of hantig",0],[482328,"hantiger","adj","inflection of hantig:",1],[482329,"hantiger","adj","strong/mixed nominative masculine singular",2],[482330,"hantiger","adj","strong genitive/dative feminine singular",3],[482331,"hantiger","adj","strong genitive plural",4]],"inflections":[["hantiger","hantig","masculine,nominative,singular,strong"]]},"hässlichke
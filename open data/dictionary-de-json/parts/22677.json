{"format_version":1,"partition":22677,"records":{"bezichtigen":{"entries":[["bezichtigen",null,"/bəˈtsɪçtɪɡən/","Enhanced form of earlier bezichten (15th c.), denominal from now obsolete Bezicht (“accusation”), from Middle High German beziht, itself deverbal from Old High German bezīhan. Modern German bezeihen was gradually displaced, but is still attested until the early 20th century.\nThe form with -ig- (16th c.) appears to be of northern origin; compare Middle Low German betichtigen (14th c.), Middle Dutch betichtigen (early 15th c., though now only betichten). It follows the adjective in Middle Low German betichtich, Middle High German bezihtec (“accused, infamous”).",null,"haben"]],"senses":[[29523,"bezichtigen","verb","to accuse",0,null,null,null,"transitive"]]},"campings":{"entries":[["campings",null,null,null]],"senses":[[606261,"campings","noun","genitive singular of Camping",0]],"inflections":[["campings","camping","genitive"]]},"ermahnst":{"entries":[["ermahnst",null,null,null]],"senses":[[659168,"ermahnst","verb","second-person singular present of ermahnen",0]],"inflections":[["ermahnst","ermahnen","indicative,present,second-person,singular"]]},"geruchtilgenden":{"entries":[["geruchtilgenden",null,null,null]],"senses":[[439243,"geruchtilgenden","adj","inflection of geruchtilgend:",0],[439244,"geruchtilgenden","adj","strong genitive masculine/neuter singular",1],[439245,"geruchtilgenden","adj","weak/mixed genitive/dative all-gender singular",2],[439246,"geruchtilgenden","adj","strong/weak/mixed accusative masculine singular",3],[439247,"geruchtilgenden","adj","strong dative plural",4],[439248,"geruchtilgenden","adj","weak/mixed all-case plural",5]],"inflections":[["geruchtilgenden","geruchtilgend","genitive,masculine,singular,strong,without-article"]]},"homophob":{"entries":[["homophob",null,"/homoˈfoːp/","homo- + -phob."]],"senses":[[111124,"homophob","adj","homophobic",0]]},"hüfe":{"entries":[["hüfe",null,null,null]],"senses":[[632659,"hüfe","noun","nom
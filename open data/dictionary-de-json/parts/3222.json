{"format_version":1,"partition":3222,"records":{"belämmert":{"entries":[["belämmert",null,"/bəˈlɛmɐt/","Past participle of the rarer verb belämmern or belemmern (“to annoy\", \"to molest”), from Middle Low German belemmeren. The verb pertains to lahm (“lame”) and is cognate with Dutch belemmeren (“to hamper”). The semantic development of the adjective in German is, at least in part, due to association with Lamm (“lamb”, plural Lämmer), a supposedly naïve or stupid animal. Hence also the folk-etymological reform spelling with -ä-."]],"senses":[[374171,"belämmert","verb","past participle of belämmern",0],[374172,"belämmert","adj","perplexed; in a sudden state of confusion (e.g. through a lack of concentration, or shock)",1],[374173,"belämmert","adj","intimidated, discouraged, disheartened",2],[374174,"belämmert","adj","stupid, silly, crazy (interchangeable with behämmert)",3,null,["colloquial"]],[374175,"belämmert","verb","inflection of belämmern:",4],[374176,"belämmert","verb","third-person singular present",5],[374177,"belämmert","verb","second-person plural present",6],[374178,"belämmert","verb","plural imperative",7],[374179,"belämmert","verb","preterite participle",8]],"inflections":[["belämmert","belämmern","present,singular,third-person"]]},"korkigere":{"entries":[["korkigere",null,null,null]],"senses":[[509652,"korkigere","adj","inflection of korkig:",0],[509653,"korkigere","adj","strong/mixed nominative/accusative feminine singular comparative degree",1],[509654,"korkigere","adj","strong nominative/accusative plural comparative degree",2],[509655,"korkigere","adj","weak nominative all-gender singular comparative degree",3],[509656,"korkigere","adj","weak accusative feminine/neuter singular comparative degree",4]],"inflections":[["korkigere","korkig","comparative,feminine,nominative,singular,strong,without-article"]]},"laupheim":{"entries":[["laupheim",null,"/ˈlaʊ̯phaɪ̯m/",null]],"senses":[[702397,"laupheim","name","Laupheim (a town in southern Baden-Württembe
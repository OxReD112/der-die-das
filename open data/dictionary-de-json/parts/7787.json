{"format_version":1,"partition":7787,"records":{"-broich":{"entries":[["-broich",null,"/broːx/","Borrowed from Central Franconian form of Bruch (“wetland”), from Middle High German bruoch, from Old High German bruoh, from Proto-West Germanic *brōk. The -i- is the so-called rheinisches Dehnungs-i (“Rhenish lengthening i”) used to indicate the length of the preceding vowel, similarly to -h- in Standard German."]],"senses":[[592305,"-broich","suffix","Placename suffix found in the Rhineland, chiefly its northern parts.",0,null,["idiomatic"]]],"inflections":[["-broich","bruch","alternative"]]},"gottverdammt":{"entries":[["gottverdammt",null,null,"Gott + verdammt"]],"senses":[[421814,"gottverdammt","adj","goddamned",0],[421815,"gottverdammt","intj","goddamn",1]]},"hatza":{"entries":[["hatza",null,null,"Borrowed from Hadza person.",{"g":"m:f"}]],"senses":[[628279,"hatza","noun","older orthography for Hadza",0,"m:f"]]},"kampflosen":{"entries":[["kampflosen",null,null,null]],"senses":[[503669,"kampflosen","adj","inflection of kampflos:",0],[503670,"kampflosen","adj","strong genitive masculine/neuter singular",1],[503671,"kampflosen","adj","weak/mixed genitive/dative all-gender singular",2],[503672,"kampflosen","adj","strong/weak/mixed accusative masculine singular",3],[503673,"kampflosen","adj","strong dative plural",4],[503674,"kampflosen","adj","weak/mixed all-case plural",5]],"inflections":[["kampflosen","kampflos","genitive,masculine,singular,strong,without-article"]]},"sichelförmig":{"entries":[["sichelförmig",null,"/ˈzɪçl̩ˌfœʁmɪç/","Sichel + -förmig"]],"senses":[[549781,"sichelförmig","adj","crescent-shaped, sickle-shaped",0]]},"sicherheitsventils":{"entries":[["sicherheitsventils",null,null,null]],"senses":[[179307,"sicherheitsventils","noun","genitive singular of Sicherheitsventil",0]],"inflections":[["sicherheitsventils","sicherheitsventil","genitive"]]},"sozialere":{"entries":[["sozialere",null,null,null]],"senses":[[151067,"sozialere","adj","inflection of sozial:
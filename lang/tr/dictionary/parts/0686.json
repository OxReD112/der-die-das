{"format_version":1,"partition":686,"records":{"Kasus":[{"record_id":881,"word":"Kasus","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Kasus","source":"tr.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["ismin hâli"],"id":"tr-Kasus-de-noun-DpxzIQVq","examples":[{"text":"Die Kasus bestimmen die Funktion der Satzglieder (Wortgruppen) im Satz.","bold_text_offsets":[[4,9]],"translation":"İsmin hâlleri, cümle kelime gruplarının cümledeki fonksiyonlarını belirler.","bold_translation_offsets":[[0,13]]},{"text":"„Die kritischen Aussagen verweisen meistens auf die Flexion des Nomens und des Adjektivs und monieren implizit die Mißverhältnisse zwischen Formenvielfalt und Leistungen in den Bereichen Genus, Numerus und Kasus.“","bold_text_offsets":[[206,211]],"translation":"„Tenkitçi ifâdeler çoğu zaman ismin ve sıfatın çekimine işaret ederek dolaylı olarak cins, sayı ve ismin hâli ile şekil çeşitleri ve performansı arasındaki uyumsuzluklara işaret ederler.“","bold_translation_offsets":[[99,109]]}]},"labels":[[0,0,["linguistics"]]]},{"sense_index":1,"display_status":"translation","data":{"glosses":["durum, hâl; hadise, olay, vukuat"],"id":"tr-Kasus-de-noun-oHnh0rZh","tags":["rare"],"raw_tags":["eğitim dili"],"examples":[{"text":"„Anfang des Jahres ist schließlich auch die amerikanische Steuerbehörde IRS (Internal Revenue Service) aufmerksam geworden. Sie hat festgestellt, dass im SL [Second Life] an ihr vorbei Umsatz gemacht wird. Das bedeutet: Schwarzmarkt. Der Kasus beschäftigt seitdem den Kongress.“","bold_text_offsets":[[238,243]],"translation":"„Senenin başında nihayet Amerikan vergi dairesi IRS (Internal Revenue Service)'nin dikkatini çekti. SL [Second Life]'in bildirmediği ciroları olduğunu tespit etti. Bunun mânâsı: Karaborsa. Bu durum o zamandan biri Kongre'yi meşgûl ediyor.“","bold_translation_offsets":[[192,197]]},{"text":"„Das Präsidium wurde mit dem Kasus befasst und bekräftigte den Häkeldecken-Beschluss von 1997, die Liberalen aber blieben halsstarrig.","bold_text_offsets":[[29,34]],"translation":"„Büro durum ile uğraştı ve 1997 tığ işi battaniye kararını doğruladı, ancak Liberaller inatçı kaldı.“","bold_translation_offsets":[[6,11]],"ref":"“ -"}]},"labels":[[0,0,["rare"]]]}]}],"Stunde":[{"record_id":2126,"word":"Stunde","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Stunde","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["saat"],"id":"tr-Stunde-de-noun-5s43e6w~"}}]}],"Jan":[{"record_id":4374,"word":"Jan","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Jan","source":"tr.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Bir erkek adı. Almanca erkek ismi"],"id":"tr-Jan-de-name-QL8UObtR"},"name_like":["person","soyadı / ad"]}]},{"record_id":4375,"word":"Jan","pos":"name","source_pos":"abbrev","source_url":"https://tr.wiktionary.org/wiki/Jan","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"reference","data":{"glosses":["J."],"id":"tr-Jan-de-abbrev-PydIP5fJ"}}]}],"Rot":[{"record_id":4962,"word":"Rot","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Rot","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["kırmızı, kızıl, al"],"id":"tr-Rot-de-noun-yxTSf3Jk"}}]}],"Vereinigte Staaten von Amerika":[{"record_id":5653,"word":"Vereinigte Staaten von Amerika","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Vereinigte%20Staaten%20von%20Amerika","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Amerika Birleşik Devletleri"],"id":"tr-Vereinigte_Staaten_von_Amerika-de-name-4KfWHUjy","raw_tags":["ülke"]},"labels":[[0,0,["geography","politics"]]],"name_like":["place","geography"]}]},{"record_id":1029131,"word":"Vereinigte Staaten von Amerika","pos":"phrase","source_url":"https://de.wiktionary.org/wiki/Vereinig
{"format_version":1,"partition":19386,"records":{"der und der":{"entries":[["der und der",null,null,"From a doubling of the definite article or demonstrative pronoun der, with a listing of multiple supposedly definite referents evoking an unspecific subset or stand-in. This usage of doubled determiners goes back to Old High German times. Compare dies und das, soundso and English so-and-so, as well as adverbial constructions like hier und da, dann und wann."]],"senses":[[723196,"der und der","det","so-and-so, this or that, (a) certain (one); used to stand in for definite referents that were specified in a different speech context, and whose specificity in that context is highlighted in the current one, but whose actual identity is not relevant in the current context.",0]]},"gütergemeinschaft":{"entries":[["gütergemeinschaft",null,"/ˈɡyːtɐɡəˌmaɪ̯nʃaft/","Güter + Gemeinschaft",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[100923,"gütergemeinschaft","noun","public ownership",0,"f"],[100924,"gütergemeinschaft","noun","universal community of property",1,"f",null,null,null,null,["law"]]]},"inkommoden":{"entries":[["inkommoden",null,null,null]],"senses":[[447384,"inkommoden","adj","inflection of inkommod:",0],[447385,"inkommoden","adj","strong genitive masculine/neuter singular",1],[447386,"inkommoden","adj","weak/mixed genitive/dative all-gender singular",2],[447387,"inkommoden","adj","strong/weak/mixed accusative masculine singular",3],[447388,"inkommoden","adj","strong dative plural",4],[447389,"inkommoden","adj","weak/mixed all-case plural",5]],"inflections":[["inkommoden","inkommod","genitive,masculine,singular,strong,without-article"]]},"innovative":{"entries":[["innovative",null,null,null]],"senses":[[5709,"innovative","adj","inflection of innovativ:",0],[5710,"innovative","adj","strong/mixed nominative/accusative feminine singular",1],[5711,"innovative","adj","strong nominative/accusative plural",2],[5712,"innovative","adj","weak nominative all-gender singular",3]
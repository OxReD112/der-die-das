{"format_version":1,"partition":500,"records":{"abc-schütze":{"entries":[["abc-schütze",null,"/ˌaːbeˈtseːˌʃʏtsə/","From Abc (“ABC”) + Schütze (“shooter; private”), of uncertain origin, 16th c. Schütze might refer to the lowest army rank, possibly in part because school starters are often made to walk in rows of two and, generally, are treated like incompetent beings similarly to military recruits. Alternatively, from Latin tīrō (“beginner”) incorrectly interpreted as related to French tirer (“to shoot”).",{"w":"ABC-Schütze","g":"m","alt":[["m",""],["m","|n|n|n|n|n|n|n","Abc-Schütze"]]}]],"senses":[[416399,"abc-schütze","noun","nonstandard form of Abc-Schütze",0,"m",["nonstandard"]],[416400,"abc-schütze","noun","first-year pupil; child who has just started school; abecedarian",1,"m",["informal","dated","~in most regions"]]]},"buchenhölzer":{"entries":[["buchenhölzer",null,null,null]],"senses":[[383763,"buchenhölzer","noun","nominative/accusative/genitive plural of Buchenholz",0,"n"]],"inflections":[["buchenhölzer","buchenholz","plural"]]},"enigmatischeres":{"entries":[["enigmatischeres",null,null,null]],"senses":[[461689,"enigmatischeres","adj","strong/mixed nominative/accusative neuter singular comparative degree of enigmatisch",0]],"inflections":[["enigmatischeres","enigmatisch","comparative,neuter,nominative,singular,strong,without-article"]]},"stacheldrahtes":{"entries":[["stacheldrahtes",null,"[ˈʃtaxl̩ˌdʁaːtəs]",null]],"senses":[[501021,"stacheldrahtes","noun","genitive of Stacheldraht",0,"m"]],"inflections":[["stacheldrahtes","stacheldraht","genitive"]]},"steilster":{"entries":[["steilster",null,null,null]],"senses":[[313706,"steilster","adj","inflection of steil:",0],[313707,"steilster","adj","strong/mixed nominative masculine singular superlative degree",1],[313708,"steilster","adj","strong genitive/dative feminine singular superlative degree",2],[313709,"steilster","adj","strong genitive plural superlative degree",3]],"inflections":[["steilster","steil","mas
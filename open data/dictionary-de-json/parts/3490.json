{"format_version":1,"partition":3490,"records":{"bekenntnis":{"entries":[["bekenntnis",null,"/bəˈkɛntnɪs/","From Middle High German bekentnisse, bekantnisse f, from Old High German bikantnussi n. By surface analysis, bekennen + -nis. Compare Dutch bekentenis.",{"g":"n","decl":"||/se|ses|se|se|sen|se"}]],"senses":[[43160,"bekenntnis","noun","confession",0,"n"],[43161,"bekenntnis","noun","creed",1,"n"]],"related_forms":[[45163,"bekenntnis","bekenntnis von nicäa","derived"],[45164,"bekenntnis","glaubensbekenntnis","derived"],[45165,"bekenntnis","lippenbekenntnis","derived"],[45166,"bekenntnis","nichtbekenntnis","derived"],[45167,"bekenntnis","schuldbekenntnis","derived"],[45168,"bekenntnis","suchtbekenntnis","derived"],[45169,"bekenntnis","teilbekenntnis","derived"],[45170,"bekenntnis","anerkenntnis","related"],[45171,"bekenntnis","sachkenntnis","related"]]},"büdingerin":{"entries":[["büdingerin",null,"[ˈbyːdɪŋəʁɪn]","From Büdinger + -in.",{"g":"f","decl":"||||nen|nen|nen|nen"}]],"senses":[[711940,"büdingerin","noun","female equivalent of Büdinger; a female person from Büdingen or of Büdingen descent.",0,"f"]],"inflections":[["büdingerin","büdinger","feminine"]]},"demgemäßen":{"entries":[["demgemäßen",null,null,null]],"senses":[[431310,"demgemäßen","adj","inflection of demgemäß:",0],[431311,"demgemäßen","adj","strong genitive masculine/neuter singular",1],[431312,"demgemäßen","adj","weak/mixed genitive/dative all-gender singular",2],[431313,"demgemäßen","adj","strong/weak/mixed accusative masculine singular",3],[431314,"demgemäßen","adj","strong dative plural",4],[431315,"demgemäßen","adj","weak/mixed all-case plural",5]],"inflections":[["demgemäßen","demgemäß","genitive,masculine,singular,strong,without-article"]]},"dienstag":{"entries":[["dienstag",null,"/ˈdiːnsˌtaːk/","Spread via the Lower Rhineland from Middle Low German dingesdach, dinsdach and Middle Dutch dinsendach (both with variants), and gradually replaced Middle High German ziestac and other High German forms like Alemannic German Zischtig or Bavarian Ertag. Only since the second half of the 17th. century is the modern form in common Script usage.\nProbably from Proto-Germanic *þingas-dagaz (“Day of Thingsus”), from *þingą + *dagaz. Thingsus is the attested Latin name of a Germanic god who may or may not be the same as Tiw. Further particulars unsettled. Another theory is that it is the “Day of the Thing (“historic Germanic council”)”. Dienstag is cognate with Dutch dinsdag and Luxembourgish Dënschdeg.",{"g":"m","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[6310,"dienstag","noun","Tuesday",0,"m"]]},"kopflastigeres":{"entries":[["kopflastigeres",null,null,null]],"senses":[[509551,"kopflastigeres","adj","strong/mixed nominative/accusative neuter singular comparative degree of kopflastig",0]],"inflections":[["kopflastigeres","kopflastig","comparative,neuter,nominative,singular,strong,without-article"]]},"molliger":{"entries":[["molliger",null,"/ˈmɔlɪɡɐ/",null]],"senses":[[613752,"molliger","adj","comparative degree of mollig",0],[613753,"molliger","adj","inflection of mollig:",1],[613754,"molliger","adj","strong/mixed nominative masculine singular",2],[613755,"molliger","adj","strong genitive/dative feminine singular",3],[613756,"molliger","adj","strong genitive plural",4]],"inflections":[["molliger","mollig","masculine,nominative,singular,strong"]]},"plakatwand":{"entries":[["plakatwand",null,"/plaˈkaːtvant/","From Plakat (“poster”) + Wand (“wall”).",{"g":"f","decl":"||||3ände|3ände|3änden|3ände"}]],"senses":[[707014,"plakatwand","noun","billboard",0,"f"]]},"treppenschliff":{"entries":[["treppenschliff",null,"/ˈtʁɛpənˌʃlɪf/","From Treppe (“stairs”) + -n- + Schliff (“cut”).",{"g":"m","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[628740,"treppenschliff","noun","step cut (of a gemstone)",0,"m"]]},"trötest":{"entries":[["trötest",null,null,null]],"senses":[[703844,"trötest","verb","inflection of tröten:",0],[703845,"trötest","verb","second-person singular present",1],[703846,"tröte
{"format_version":1,"partition":1723,"records":{"elftal":{"entries":[["elftal",null,"/ˈɛlfˌta(ː)l/","Borrowed from Dutch elftal n (“group of eleven”, hence “football team”). Cognate with German elf (“eleven”) and Zahl (“number”) respectively. The latter word probably also triggered the feminine gender in German.\nDutch media commonly call their team het Nederlands elftal, but not usually het elftal on its own. This is similar to German die Mannschaft, which is used as a nickname for the German team in some countries (including the Netherlands)."]],"senses":[[699594,"elftal","name","the Dutch national football (soccer) team",0,null,["slang"],null,null,null,["media","soccer"]]]},"im selben atemzug":{"entries":[["im selben atemzug",null,null,null]],"senses":[[40057,"im selben atemzug","adv","in the same breath",0,null,["idiomatic"]]]},"kartoffelschale":{"entries":[["kartoffelschale",null,"/karˈtɔfl̩ˌʃaːlə/","From Kartoffel + Schale.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[601107,"kartoffelschale","noun","potato peel",0,"f"]]},"quatschen fest":{"entries":[["quatschen fest",null,null,null]],"senses":[[394588,"quatschen fest","verb","inflection of festquatschen:",0],[394589,"quatschen fest","verb","first/third-person plural present",1],[394590,"quatschen fest","verb","first/third-person plural subjunctive I",2]]},"samischere":{"entries":[["samischere",null,null,null]],"senses":[[542256,"samischere","adj","inflection of samisch:",0],[542257,"samischere","adj","strong/mixed nominative/accusative feminine singular comparative degree",1],[542258,"samischere","adj","strong nominative/accusative plural comparative degree",2],[542259,"samischere","adj","weak nominative all-gender singular comparative degree",3],[542260,"samischere","adj","weak accusative feminine/neuter singular comparative degree",4]],"inflections":[["samischere","samisch","comparative,feminine,nominative,singular,strong,without-article"]]},"sozialer netzwerke":{"entries":[["sozialer netzwerke",null,null,n
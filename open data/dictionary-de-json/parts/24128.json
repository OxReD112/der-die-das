","herausgeberin","plural"]]},"kopfballungeheuer":{"entries":[["kopfballungeheuer",null,"/ˈkɔpfbalˌʊnɡəhɔʏ̯ər/","From Kopfball (“header”) + Ungeheuer (“monster”), originally nickname of Horst Hrubesch.",{"g":"n","decl":"|||s|||n|"}]],"senses":[[697432,"kopfballungeheuer","noun","a striker who scores a lot of headed goals",0,"n",["informal"],null,null,null,["soccer"]]]},"können":{"entries":[["können",null,"/ˈkœnən/","From Middle High German künnen, kunnen, from Old High German kunnan, from Proto-West Germanic *kunnan, from Proto-Germanic *kunnaną, from Proto-Indo-European *ǵneh₃- (“to know”).\nThe umlauted ö in the infinitive and plural present—as well as the umlaut in the other modal verbs mögen (“to like”), müssen (“to have to”), and dürfen (“to be allowed to”)—is unexpected from an historical point of view. This umlaut first appeared in Middle High German and while a number of explanations have been proposed it is best interpreted as a transcategorial plural marker, that is to say the umlauted vowels are taken as a sign of plurality just as in nouns like Mutter–Mütter, Sohn–Söhne, Gans–Gänse, Haus–Häuser.",{"g":"n","decl":"|||s|-|-|-|-"},"haben"]],"senses":[[14849,"können","verb","to be able (to do or be something), to have the possibility of, can.",0,null,["colloquial","regional","informal","~with an infinitive"],null,"both",null,["law"]],[14850,"können","verb","to be able to do something implied; can.",1],[14851,"können","verb","to know how to do (something); to know; to understand; to be able to do (something); to be capable of; can do (something), to have a specific skill. (which is notably unlike in English where another verb is needed for a main verb)",2],[14852,"können","verb","to be possible, to make sense",3],[14853,"können","verb","to be allowed (to do something); to be permitted (to do something); may.",4],[14854,"können","verb","to be in the legal situation of being able to realize a legal effect even if it be legally disallowed",5],[14855,"können","verb","to be to blame, to be at fault",6,null,["informal","~in the negative with \"nichts\""]],[14856,"können","noun","gerund of können; skill, ability",7,"n"]],"related_forms":[[21511,"können","können","derived"],[21512,"können","könner","derived"]]},"minrecordits":{"entries":[["minrecordits",null,null,null]],"senses":[[236657,"minrecordits","noun","genitive singular of Minrecordit",0]],"inflections":[["minrecordits","minrecordit","genitive"]]},"morastiger":{"entries":[["morastiger",null,null,null]],"senses":[[521523,"morastiger","adj","comparative degree of morastig",0],[521524,"morastiger","adj","inflection of morastig:",1],[521525,"morastiger","adj","strong/mixed nominative masculine singular",2],[521526,"morastiger","adj","strong genitive/dative feminine singular",3],[521527,"morastiger","adj","strong genitive plural",4]],"inflections":[["morastiger","morastig","masculine,nominative,singular,strong"]]},"zürich":{"entries":[["zürich",null,"/ˈtsʏrɪç/","From Old High German Zurih, from Latin Turicum."]],"senses":[[3235,"zürich","name","Zurich (the capital city of Zurich canton, Switzerland)",0],[3236,"zürich","name","Zurich (a canton of Switzerland)",1]],"related_forms":[[4400,"zürich","züricher","derived"],[4401,"zürich","zürcher","derived"],[4402,"zürich","züricherisch","derived"],[4403,"zürich","zürcherisch","derived"],[4404,"zürich","zürichsee","derived"]]},"übrigbleibens":{"entries":[["übrigbleibens",null,null,null]],"senses":[[501136,"übrigbleibens","noun","genitive of Übrigbleiben",0,"n"]],"inflections":[["übrigbleibens","übrigbleiben","genitive"]]},"akzelerierten":{"inflections":[["akzelerierten","akzelerieren","first-person,indicative,plural,preterite"]]},"brinken":{"inflections":[["brinken","brink","dative,definite,plural"]]},"kohlendioxid-ausstößen":{"inflections":[["kohlendioxid-ausstößen","kohlendioxid-ausstoß","dative,definite,plural"]]},"murmeltieren":{"inflections":[["murmeltieren","murmeltier","dative,definite,plural"]]},"prinzgemahles":{"inflection
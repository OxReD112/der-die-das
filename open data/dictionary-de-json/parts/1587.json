005,"kinofassung","noun","theatrical version",0,"f",null,null,null,null,["cinematography"]]]},"könig":{"entries":[["könig",null,"/ˈkøːnɪç/","From Middle High German künec, from Old High German kuning (rarer kunig), from Proto-West Germanic *kuning, from Proto-Germanic *kuningaz.\nThe development Old High German -ning → later -nig is regular (see Pfennig). The modern vocalism -ö- is chiefly Central and Low German; compare Middle Low German köninc, from Old Saxon kuning.\nCognate with Old Dutch kuning (whence Dutch koning), Old English cyning (whence English king), Old Norse konungr (whence e.g. Danish konge). The word was borrowed into non-Germanic languages in Proto-Germanic times: Finnish and Estonian kuningas, Russian князь (knjazʹ).",{"g":"m","decl":"||/e|s/es|e|e|en|e"}]],"senses":[[14292,"könig","noun","king (monarch, chess, card games)",0,"m"],[14293,"könig","name","a common surname transferred from the nickname",1]]},"negativste":{"entries":[["negativste",null,null,null]],"senses":[[372394,"negativste","adj","inflection of negativ:",0],[372395,"negativste","adj","strong/mixed nominative/accusative feminine singular superlative degree",1],[372396,"negativste","adj","strong nominative/accusative plural superlative degree",2],[372397,"negativste","adj","weak nominative all-gender singular superlative degree",3],[372398,"negativste","adj","weak accusative feminine/neuter singular superlative degree",4]],"inflections":[["negativste","negativ","feminine,nominative,singular,strong,superlative,without-article"]]},"penisknochens":{"entries":[["penisknochens",null,null,null]],"senses":[[500701,"penisknochens","noun","genitive of Penisknochen",0,"m"]],"inflections":[["penisknochens","penisknochen","genitive"]]},"tetroxids":{"entries":[["tetroxids",null,null,null]],"senses":[[170231,"tetroxids","noun","genitive singular of Tetroxid",0]],"inflections":[["tetroxids","tetroxid","genitive"]]},"unfreieres":{"entries":[["unfreieres",null,null,null]],"senses":[[318395,"unfreier
{"format_version":1,"partition":30671,"records":{"absteigen":{"entries":[["absteigen",null,"/ˈapˌʃtaɪ̯ɡən/","From Middle High German *abestīgen (attested in the noun abestīc, abesteic), derived from stīgen abe (verb + preposition). Analysable as ab- (“off, down”) + steigen (“to rise, mount”). Compare Dutch afstijgen, Gothic 𐌰𐍆𐍃𐍄𐌴𐌹𐌲𐌰𐌽 (afsteigan).",{"g":"n","decl":"|||s|-|-|-|-"},"sein"]],"senses":[[104479,"absteigen","verb","to dismount; to get off something that one stands or sits on; chiefly used when the object is implied; with the preposition von, the simplex steigen is preferred",0],[104480,"absteigen","verb","to arrive (at a hotel etc.) in order to stay for one or more nights",1],[104481,"absteigen","verb","to sink; to descend; to become lower",2,null,["figuratively","~with aufsteigen"]],[104482,"absteigen","verb","to be relegated; to sink to a lower league",3,null,null,null,null,null,["sports"]],[104483,"absteigen","noun","gerund of absteigen",4,"n"]],"related_forms":[[50179,"absteigen","absteigerin","derived"],[50180,"absteigen","absteiger","derived"],[50181,"absteigen","absteigung","derived"],[50182,"absteigen","absteigen","related"],[50183,"absteigen","abstieg","related"],[50184,"absteigen","absteigend","related"],[50185,"absteigen","abgestiegen","related"],[50186,"absteigen","ansteigen","related"],[50187,"absteigen","aufsteigen","related"],[50188,"absteigen","aussteigen","related"],[50189,"absteigen","umsteigen","related"]],"inflections":[["absteigen","absteige","plural"]]},"campieren":{"entries":[["campieren",null,null,"Camp + -ieren",null,"haben"]],"senses":[[670261,"campieren","verb","to camp",0]]},"ferschnitz":{"entries":[["ferschnitz",null,null,null]],"senses":[[591640,"ferschnitz","name","a municipality of Lower Austria, Austria",0]]},"klassischstes":{"entries":[["klassischstes",null,null,null]],"senses":[[174565,"klassischstes","adj","strong/mixed nominative/accusative neuter singular superlative degree of klassisch",0]],"inflections":[["klassischs
{"format_version":1,"partition":21192,"records":{"aussprüchen":{"entries":[["aussprüchen",null,null,null]],"senses":[[664174,"aussprüchen","noun","dative plural of Ausspruch",0]],"inflections":[["aussprüchen","ausspruch","dative,definite,plural"]]},"belohntet":{"entries":[["belohntet",null,null,null]],"senses":[[118452,"belohntet","verb","inflection of belohnen:",0],[118453,"belohntet","verb","second-person plural preterite",1],[118454,"belohntet","verb","second-person plural subjunctive II",2]],"inflections":[["belohntet","belohnen","indicative,plural,preterite,second-person"]]},"knoten":{"entries":[["knoten",null,"/ˈknoːtən/","From Middle High German knote, knode, from Old High German knoto, knodo.\nThe two forms are probably variants based on Grammatischer Wechsel. The form with -t- (from Proto-Germanic *-d-) was predominant in East Central German, that with -d- (from Proto-Germanic *-þ-) in Upper German. Incidentally, this situation explains the lengthened vowel in the standardized form (lengthening being blocked before -t- in Upper German, but not in Central German). Neither German form can be derived directly from Proto-Germanic *knuttô, whence Middle High German knotze and English knot, though a relation is very likely.\nThe senses “journeyman”, “person (of some quality)” are probably due, at least in part, to conflation with Middle Low German genôte (“mate, companion”), cognate of German Genosse. Alongside, there is a common tendency of referring to people, especially children, with words for thick, plump, or inflated objects (compare e.g. Balg).",{"g":"m","decl":"|||s||||"},"haben"]],"senses":[[18917,"knoten","noun","knot (looping)",0,"m"],[18918,"knoten","noun","knot (swelling)",1,"m"],[18919,"knoten","noun","interchange (motorway junction)",2,"m",["Austria"]],[18920,"knoten","noun","knot (unit of speed)",3,"m",null,null,null,null,["nautical"]],[18921,"knoten","noun","vertex, node",4,"m",null,null,null,null,["graph-theory"]],[18922,"knoten","noun","craftsman; journeyman; farmhand",5,"m",["derogatory","obsolete"]],[18923,"knoten","noun","a person of some specified quality or practice; chiefly in Furzknoten, but sometimes other colloquial formations",6,"m"],[18924,"knoten","verb","to tie into a knot",7,null,null,null,"transitive"]],"related_forms":[[28695,"knoten","knotenameise","derived"],[28696,"knoten","knotig","derived"],[28697,"knoten","knotenpunkt","related"],[28698,"knoten","knotenschrift","related"]]},"mehrfamilienhause":{"entries":[["mehrfamilienhause",null,null,null]],"senses":[[597584,"mehrfamilienhause","noun","dative of Mehrfamilienhaus",0]],"inflections":[["mehrfamilienhause","mehrfamilienhaus","dative,singular"]]},"pyrite":{"entries":[["pyrite",null,null,null]],"senses":[[349782,"pyrite","noun","nominative/accusative/genitive plural of Pyrit",0,"n"]],"inflections":[["pyrite","pyrit","plural"]]},"w.":{"entries":[["w.",null,null,null]],"senses":[[374525,"w.","adj","abbreviation of weiblich",0]],"inflections":[["w.","weiblich","alternative,abbreviation"]]},"dönekens":{"inflections":[["dönekens","döneken","plural"]]},"flimmerst":{"inflections":[["flimmerst","flimmern","indicative,present,second-person,singular"]]},"glattflächigstes":{"inflections":[["glattflächigstes","glattflächig","neuter,nominative,singular,strong,superlative,without-article"]]},"hobelst":{"inflections":[["hobelst","hobeln","indicative,present,second-person,singular"]]},"klopapieres":{"inflections":[["klopapieres","klopapier","genitive"]]},"stickstoffdioxydes":{"inflections":[["stickstoffdioxydes","stickstoffdioxyd","genitive"]]},"überragenderer":{"inflections":[["überragenderer","überragend","comparative,masculine,nominative,singular,strong,without-article"]]}}}
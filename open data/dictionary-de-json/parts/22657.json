{"format_version":1,"partition":22657,"records":{"besitzen":{"entries":[["besitzen",null,"/bəˈzɪtsən/","From Middle High German besitzen, from Old High German bisizzen, from Proto-West Germanic *bisittjan, from Proto-Germanic *bisitjaną, Equivalent to be- + sitzen. Cognate with Norwegian Bokmål besitte, Danish besidde, Dutch bezitten, English besit, Swedish besitta, Gothic 𐌱𐌹𐍃𐌹𐍄𐌰𐌽 (bisitan).\n(to own, to possess): Compare typologically Latin possideō (whence English possess), Macedonian поседува (poseduva), Serbo-Croatian поседовати, Slovene posedovati, Polish posiadać (cognate via Proto-Indo-European *sed-).",null,"haben"]],"senses":[[28533,"besitzen","verb","to own, to possess",0],[28534,"besitzen","verb","to have",1],[28535,"besitzen","noun","plural of Besitz",2,"m"]],"related_forms":[[37401,"besitzen","besitzerin","derived"],[37402,"besitzen","besitzer","derived"],[37403,"besitzen","besitztum","derived"],[37404,"besitzen","besitzung","derived"],[37405,"besitzen","besitz","derived"],[37406,"besitzen","besitzen","related"]],"inflections":[["besitzen","besitz","dative,definite,plural"]]},"birmanisch":{"entries":[["birmanisch",null,"/bɪʁˈmaːnɪʃ/","Birmane + -isch"]],"senses":[[101427,"birmanisch","name","Burmese (language)",0],[101428,"birmanisch","adj","Burmese",1]]},"blaublütigstem":{"entries":[["blaublütigstem",null,null,null]],"senses":[[457880,"blaublütigstem","adj","strong dative masculine/neuter singular superlative degree of blaublütig",0]],"inflections":[["blaublütigstem","blaublütig","dative,masculine,singular,strong,superlative,without-article"]]},"bärbeißigen":{"entries":[["bärbeißigen",null,null,null]],"senses":[[459106,"bärbeißigen","adj","inflection of bärbeißig:",0],[459107,"bärbeißigen","adj","strong genitive masculine/neuter singular",1],[459108,"bärbeißigen","adj","weak/mixed genitive/dative all-gender singular",2],[459109,"bärbeißigen","adj","strong/weak/mixed accusative masculine singular",3],[459110,"bärbeißigen","adj","strong dative plural",4]
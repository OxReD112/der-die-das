{"format_version":1,"partition":31487,"records":{"bischof":{"entries":[["bischof",null,"/ˈbɪʃɔf/","From Middle High German bischof, from Old High German biscof, from Proto-West Germanic *biskop, from Latin episcopus. The -f- is due to the High German consonant shift, but in Middle High German it irregularly developed into -v- (thus predominantly bischoves rather than bischoffes), which explains the (variably) lengthened vowel. This development has been ascribed to renewed Romance influence; compare Italian vescovo.",{"g":"m","decl":"|||s|2öfe|2öfe|2öfen|2öfe"}]],"senses":[[17949,"bischof","noun","bishop (male or of unspecified gender)",0,"m"]],"inflections":[["bischof","bischöfin","masculine"]]},"bogenganges":{"entries":[["bogenganges",null,"/ˈboːɡənˌɡaŋəs/",null]],"senses":[[629679,"bogenganges","noun","genitive singular of Bogengang",0]],"inflections":[["bogenganges","bogengang","genitive"],["bogenganges","bogengangs","alternative"]]},"krauserer":{"entries":[["krauserer",null,null,null]],"senses":[[299301,"krauserer","adj","inflection of kraus:",0],[299302,"krauserer","adj","strong/mixed nominative masculine singular comparative degree",1],[299303,"krauserer","adj","strong genitive/dative feminine singular comparative degree",2],[299304,"krauserer","adj","strong genitive plural comparative degree",3]],"inflections":[["krauserer","kraus","comparative,masculine,nominative,singular,strong,without-article"]]},"schminkten":{"entries":[["schminkten",null,null,null]],"senses":[[78823,"schminkten","verb","inflection of schminken:",0],[78824,"schminkten","verb","first/third-person plural preterite",1],[78825,"schminkten","verb","first/third-person plural subjunctive II",2]],"inflections":[["schminkten","schminken","first-person,indicative,plural,preterite"]]},"seifert":{"entries":[["seifert",null,null,null]],"senses":[[45915,"seifert","name","a surname, derived from Siegfried",0]]},"tonsilbe":{"entries":[["tonsilbe",null,"/ˈtoːnˌzɪlbə/","Ton + Silbe",{"g":"f","decl":"||||n
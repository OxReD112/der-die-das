iguity between plural Waagen and Wagen (“car[s], carriage[s]”), as for example in Waagenbau (“construction of scales”) versus Wagenbau (“construction of cars”).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[11970,"waage","noun","scales (weighing machine)",0,"f"],[11971,"waage","noun","Libra",1,"f",null,null,null,null,["astrology","astronomy"]],[11972,"waage","name","a surname",2]],"related_forms":[[16413,"waage","briefwaage","derived"],[16414,"waage","personenwaage","derived"],[16415,"waage","waagschale","derived"],[16416,"waage","zünglein an der waage","derived"],[16417,"waage","wagen","related"],[16418,"waage","wägen","related"],[16419,"waage","erwägen","related"],[16420,"waage","wiegen","related"]]},"zweifeltet":{"entries":[["zweifeltet",null,null,null]],"senses":[[66251,"zweifeltet","verb","inflection of zweifeln:",0],[66252,"zweifeltet","verb","second-person plural preterite",1],[66253,"zweifeltet","verb","second-person plural subjunctive II",2]],"inflections":[["zweifeltet","zweifeln","indicative,plural,preterite,second-person"]]},"adelheids":{"inflections":[["adelheids","adelheid","genitive"]]},"diskussionsforums":{"inflections":[["diskussionsforums","diskussionsforum","genitive"]]},"fachmanne":{"inflections":[["fachmanne","fachmann","dative,singular"]]},"pedanteste":{"inflections":[["pedanteste","pedant","feminine,nominative,singular,strong,superlative,without-article"]]},"staumauern":{"inflections":[["staumauern","staumauer","plural"]]}}}
{"format_version":1,"partition":4391,"records":{"-husen":{"entries":[["-husen",null,"/ˈhuːzən/","From Middle Low German -hûsen. Placenames with this suffix were generally standardized with the High German equivalent -hausen. Unadapted forms survive mainly, albeit not exclusively, in two regions which adopted written High German comparatively late: Schleswig-Holstein (where -husen is predominant) and Ostfriesland (where both forms appear alongside)."]],"senses":[[693250,"-husen","suffix","alternative form of -hausen (placename suffix)",0]],"inflections":[["-husen","-hausen","alternative"]]},"arg":{"entries":[["arg",null,null,"From Middle High German arc, from Old High German arg.\nCompare Hunsrik aarich, Pennsylvania German arrig, Central Franconian ärch, and Dutch erg. Also etymologically linked is English eerie.",{"g":"n","decl":"|||s|-|-|-|-"}]],"senses":[[15960,"arg","adj","bad",0],[15961,"arg","adj","intense",1],[15962,"arg","adj","wicked",2],[15963,"arg","adj","disgusting",3],[15964,"arg","noun","malice, wickedness, falsehood, deceit",4,"n",["dated"]]],"related_forms":[[22831,"arg","arg","related"],[22832,"arg","ärgern","related"],[22833,"arg","arglist","related"],[22834,"arg","arglistig","related"],[22835,"arg","arglos","related"],[22836,"arg","argwohn","related"],[22837,"arg","argwöhnen","related"],[22838,"arg","argwöhnisch","related"],[22839,"arg","verargen","related"]]},"austretender":{"entries":[["austretender",null,null,null]],"senses":[[179768,"austretender","adj","inflection of austretend:",0],[179769,"austretender","adj","strong/mixed nominative masculine singular",1],[179770,"austretender","adj","strong genitive/dative feminine singular",2],[179771,"austretender","adj","strong genitive plural",3]],"inflections":[["austretender","austretend","masculine,nominative,singular,strong"]]},"balkanisieret":{"entries":[["balkanisieret",null,null,null]],"senses":[[362513,"balkanisieret","verb","second-person plural subjunctive I of balkanisieren",0]],"inflection
{"format_version":1,"partition":20775,"records":{"-husen":{"entries":[["-husen",null,"/ˈhuːzən/","From Middle Low German -hûsen. Placenames with this suffix were generally standardized with the High German equivalent -hausen. Unadapted forms survive mainly, albeit not exclusively, in two regions which adopted written High German comparatively late: Schleswig-Holstein (where -husen is predominant) and Ostfriesland (where both forms appear alongside)."]],"senses":[[693250,"-husen","suffix","alternative form of -hausen (placename suffix)",0]],"inflections":[["-husen","-hausen","alternative"]]},"eigenartige":{"entries":[["eigenartige",null,null,null]],"senses":[[238579,"eigenartige","adj","inflection of eigenartig:",0],[238580,"eigenartige","adj","strong/mixed nominative/accusative feminine singular",1],[238581,"eigenartige","adj","strong nominative/accusative plural",2],[238582,"eigenartige","adj","weak nominative all-gender singular",3],[238583,"eigenartige","adj","weak accusative feminine/neuter singular",4]],"inflections":[["eigenartige","eigenartig","feminine,nominative,singular,strong,without-article"]]},"flohe":{"entries":[["flohe",null,"/ˈfloːə/",null]],"senses":[[501708,"flohe","noun","dative singular of Floh",0,"m"]],"inflections":[["flohe","floh","dative,singular"]]},"straußen":{"entries":[["straußen",null,null,null]],"senses":[[350590,"straußen","noun","dative plural of Strauß (“ostrich”)",0],[350591,"straußen","noun","nominative/genitive/accusative plural of Strauß",1,null,["uncommon"]],[350592,"straußen","noun","genitive/dative/accusative singular of Strauß",2,null,["archaic"]]],"inflections":[["straußen","strauß","dated,genitive"]]},"entzweizureißen":{"inflections":[["entzweizureißen","entzweireißen","infinitive,infinitive-zu"]]},"strauchelst":{"inflections":[["strauchelst","straucheln","indicative,present,second-person,singular"]]}}}
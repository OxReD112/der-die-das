nterndsten","ermunternd","genitive,masculine,singular,strong,superlative,without-article"]]},"gschertem":{"entries":[["gschertem",null,null,null]],"senses":[[480937,"gschertem","adj","strong dative masculine/neuter singular of gschert",0]],"inflections":[["gschertem","gschert","dative,masculine,singular,strong,without-article"]]},"kugel":{"entries":[["kugel",null,"/ˈkuːɡəl/","From Middle High German kugel(e), of unknown origin. It is not clear whether Middle Dutch coghele, coeghele (modern kogel) is a cognate or rather a borrowing from High German. In the former case it would require a Proto-West Germanic *kugulā.\nPossibly related with English cudgel, from Proto-West Germanic *kuggil, a derivative of Proto-Germanic *kuggǭ (“cog, swelling”), whence German Kogge (“roundish ship”). This group has been compared to words like Lithuanian gugà (“hump”), Albanian gogël (“acorn”), and may be further derived from Proto-Indo-European *gew- (“to bow, bend, arch, curve”). Other German words that may be related to this root include kauern, Keule, Koben, Kuhle, Quaddel.\nFurther discussion\nThe word appears from the Middle High German period referring to a ball used in games, e.g. skittles / bowling. A Swiss dialect form has an additional r, in Krugle, found already in Middle High German in the diminutive form krúgellin (Konrad of Würzburg, d. 1287). Another variant is contracted kūle, kaule, kulle. Low German and parts of West Central German used cognates of Klotz for the ball in skittles.\nThe sense “bullet” is probably an extension of the former use. However, it could theoretically be older than the introduction of firearms, because lead or iron spheres were already used as projectiles fired with slingshots.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[1216,"kugel","noun","a ball, usually solid",0,"f"],[1217,"kugel","noun","bullet, projectile",1,"f",null,null,null,null,["firearms"]],[1218,"kugel","noun","round, cartridge, bullet",2,"f",null,null,null,null,["firearms"]],[1219,"kugel","noun","scoop",3,"f"],[1220,"kugel","noun","orb, globe, celestial body",4,"f",null,null,null,null,["astronomy","geography"]],[1221,"kugel","noun","sphere, orb",5,"f",null,null,null,null,["geometry"]],[1222,"kugel","noun","roundel (of any tincture)",6,"f",null,null,null,null,["heraldry"]],[1223,"kugel","noun","alternative form of Kogel (“cowl”)",7,"f"],[1224,"kugel","verb","inflection of kugeln:",8],[1225,"kugel","verb","first-person singular present",9],[1226,"kugel","verb","singular imperative",10]],"inflections":[["kugel","kogel","alternative"],["kugel","kugeln","first-person,indicative,present,singular"]]},"kundigste":{"entries":[["kundigste",null,null,null]],"senses":[[527742,"kundigste","adj","inflection of kundig:",0],[527743,"kundigste","adj","strong/mixed nominative/accusative feminine singular superlative degree",1],[527744,"kundigste","adj","strong nominative/accusative plural superlative degree",2],[527745,"kundigste","adj","weak nominative all-gender singular superlative degree",3],[527746,"kundigste","adj","weak accusative feminine/neuter singular superlative degree",4]],"inflections":[["kundigste","kundig","feminine,nominative,singular,strong,superlative,without-article"]]},"reichswehr":{"entries":[["reichswehr",null,"/ˈʁaɪ̯çsveːɐ̯/","From Reich (“empire”) + -s- + Wehr (“defense”)."]],"senses":[[11141,"reichswehr","name","the German army between 1918 and 1935",0,null,["historical"]]]},"unfreien":{"entries":[["unfreien",null,null,null]],"senses":[[318420,"unfreien","adj","inflection of unfrei:",0],[318421,"unfreien","adj","strong genitive masculine/neuter singular",1],[318422,"unfreien","adj","weak/mixed genitive/dative all-gender singular",2],[318423,"unfreien","adj","strong/weak/mixed accusative masculine singular",3],[318424,"unfreien","adj","strong dative plural",4],[318425,"unfreien","adj","weak/mixed all-case plural",5]],"inflections":[["unfreien","unfrei","genitive,masculine,singular,strong,without-article"]]},"vagiler":{"entries":[["vagil
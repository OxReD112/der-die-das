 Proto-Germanic *hlaupaną probably meant “to leap, jump”, which would point to the wedding celebration (compare Dutch huwelijk). However, the sense “to run” may also be old, in which case a reference to the taking-home or ritualized abduction of the bride becomes very suggestive. The latter idea is preferred in much of the literature.",{"g":"m","decl":"|||s|3äufe|3äufe|3äufen|3äufe"}]],"senses":[[416936,"brautlauf","noun","wedding",0,"m",["obsolete"]]]},"dankbareres":{"entries":[["dankbareres",null,null,null]],"senses":[[284432,"dankbareres","adj","strong/mixed nominative/accusative neuter singular comparative degree of dankbar",0]],"inflections":[["dankbareres","dankbar","comparative,neuter,nominative,singular,strong,without-article"]]},"dienstverpflichteter":{"entries":[["dienstverpflichteter",null,null,null]],"senses":[[432016,"dienstverpflichteter","adj","inflection of dienstverpflichtet:",0],[432017,"dienstverpflichteter","adj","strong/mixed nominative masculine singular",1],[432018,"dienstverpflichteter","adj","strong genitive/dative feminine singular",2],[432019,"dienstverpflichteter","adj","strong genitive plural",3]],"inflections":[["dienstverpflichteter","dienstverpflichtet","masculine,nominative,singular,strong"]]},"energiearme":{"entries":[["energiearme",null,null,null]],"senses":[[223713,"energiearme","adj","inflection of energiearm:",0],[223714,"energiearme","adj","strong/mixed nominative/accusative feminine singular",1],[223715,"energiearme","adj","strong nominative/accusative plural",2],[223716,"energiearme","adj","weak nominative all-gender singular",3],[223717,"energiearme","adj","weak accusative feminine/neuter singular",4]],"inflections":[["energiearme","energiearm","feminine,nominative,singular,strong,without-article"]]},"ergehen":{"entries":[["ergehen",null,"/ɛʁˈɡeːən/","Middle High German ergēn, ergān, from Old High German irgēn, irgān, from Proto-West Germanic *uʀgān. Equivalent to er- + gehen."]],"senses":[[388024,"ergehen","verb","forms the
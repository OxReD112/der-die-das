on with houseworkers. However, the verb reaches much further south along the Rhine than does the noun and many forms require an underlying long vowel. Many dialects also have several forms alongside. Therefore the above seems to have been influenced by or merged with one or more other verbs, including perhaps one from Old French faute (“fault, misbehaviour”). Compare Luxembourgish fuddelen, fautelen, pautelen, all “to cheat”.",null,"haben"]],"senses":[[418933,"fudeln","verb","to cheat, usually at a game",0],[418934,"fudeln","verb","to work negligently",1,null,["dated"]]],"related_forms":[[57539,"fudeln","fudelei","derived"],[57540,"fudeln","fudler","derived"]]},"glücklichem":{"entries":[["glücklichem",null,null,null]],"senses":[[203011,"glücklichem","adj","strong dative masculine/neuter singular of glücklich",0]],"inflections":[["glücklichem","glücklich","dative,masculine,singular,strong,without-article"]]},"harfe":{"entries":[["harfe",null,"/ˈharfə/","From Middle High German harpfe, from Old High German harfa, from Proto-West Germanic *harpā, from Proto-Germanic *harpǭ. Akin to Bavarian Harpfn, Old Saxon harpa, Dutch harp, English harp, Danish harpe. Doublet of Harpfe.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[16157,"harfe","noun","harp",0,"f",null,null,null,null,["music"]]]},"hoffärtiges":{"entries":[["hoffärtiges",null,null,null]],"senses":[[444703,"hoffärtiges","adj","strong/mixed nominative/accusative neuter singular of hoffärtig",0]],"inflections":[["hoffärtiges","hoffärtig","neuter,nominative,singular,strong,without-article"]]},"klüngle":{"entries":[["klüngle",null,null,null]],"senses":[[391889,"klüngle","verb","inflection of klüngeln:",0],[391890,"klüngle","verb","first-person singular present",1],[391891,"klüngle","verb","first/third-person singular subjunctive I",2],[391892,"klüngle","verb","singular imperative",3]],"inflections":[["klüngle","klüngeln","first-person,indicative,present,singular"]]},"mannhafter":{"entries":[["mannhafter",null,null,null]],
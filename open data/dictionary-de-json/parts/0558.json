áz (“house”). On the other hand, compare Old High German hutta, whence German Hütte, Dutch hut, English hut.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[9998,"kate","noun","hut, cot, cottage",0,"f",["Northern-Germany"]]]},"kirchenlateinischen":{"entries":[["kirchenlateinischen",null,null,null]],"senses":[[504990,"kirchenlateinischen","adj","inflection of kirchenlateinisch:",0],[504991,"kirchenlateinischen","adj","strong genitive masculine/neuter singular",1],[504992,"kirchenlateinischen","adj","weak/mixed genitive/dative all-gender singular",2],[504993,"kirchenlateinischen","adj","strong/weak/mixed accusative masculine singular",3],[504994,"kirchenlateinischen","adj","strong dative plural",4],[504995,"kirchenlateinischen","adj","weak/mixed all-case plural",5]],"inflections":[["kirchenlateinischen","kirchenlateinisch","genitive,masculine,singular,strong,without-article"]]},"lebenspartnerinnen":{"entries":[["lebenspartnerinnen",null,null,null]],"senses":[[631955,"lebenspartnerinnen","noun","plural of Lebenspartnerin",0]],"inflections":[["lebenspartnerinnen","lebenspartnerin","plural"]]},"lithiumlegierungen":{"entries":[["lithiumlegierungen",null,null,null]],"senses":[[186690,"lithiumlegierungen","noun","plural of Lithiumlegierung",0,"f"]],"inflections":[["lithiumlegierungen","lithiumlegierung","plural"]]},"lügnerischstes":{"entries":[["lügnerischstes",null,null,null]],"senses":[[516082,"lügnerischstes","adj","strong/mixed nominative/accusative neuter singular superlative degree of lügnerisch",0]],"inflections":[["lügnerischstes","lügnerisch","neuter,nominative,singular,strong,superlative,without-article"]]},"muslimas":{"entries":[["muslimas",null,"/mʊsˈliːmas/",null]],"senses":[[387326,"muslimas","noun","genitive singular of Muslima",0],[387327,"muslimas","noun","plural of Muslima",1]],"inflections":[["muslimas","muslima","plural"]]},"rauschgolds":{"entries":[["rauschgolds",null,null,null]],"senses":[[615557,"rauschgolds","noun","genitive singular of Rauschgold",0,"n
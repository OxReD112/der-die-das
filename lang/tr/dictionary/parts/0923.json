{"format_version":1,"partition":923,"records":{"Lithium":[{"record_id":118,"word":"Lithium","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Lithium","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["lityum"],"id":"tr-Lithium-de-noun-bb2w8Wkc"}}]}],"Osteologie":[{"record_id":2441,"word":"Osteologie","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Osteologie","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["osteoloji, kemik bilimi"],"id":"tr-Osteologie-de-noun-Am~jQ10s"},"labels":[[0,0,["biology"]]]}]}],"Elfenbeinküste":[{"record_id":2636,"word":"Elfenbeinküste","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Elfenbeink%C3%BCste","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Fildişi Sahili"],"id":"tr-Elfenbeinküste-de-noun-MZImOQaB"}}]},{"record_id":1027062,"word":"Elfenbeinküste","pos":"name","source_url":"https://de.wiktionary.org/wiki/Elfenbeink%C3%BCste","source":"de.wiktionary","gender":["f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Fildişi Sahili"],"id":"de-Elfenbeinküste-name-1","sense_number":"1","definition_de":"Staat in Westafrika"}}]}],"sandig":[{"record_id":4978,"word":"sandig","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/sandig","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["kumlu, kumsal"],"id":"tr-sandig-de-adj-P36Up4Sr"}}]}],"Mithras":[{"record_id":5064,"word":"Mithras","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Mithras","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Mitra'nın"],"id":"tr-Mithras-de-name-S5YaVH3m"},"name_like":["other",""]}]},{"record_id":5065,"word":"Mithras","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Mithras","source":"tr.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"reference","data":{"glosses":["Mitra"],"id":"tr-Mithras-de-name-V~nuh1VC","examples":[{"text":"„Auf die Einweihung in die Mysterien bereitet sich der Anwärter durch verschiedene Mutproben und Waschungen vor, nach seiner Aufnahme schreitet er in sieben Weihegraden bis zum vollendeten Mithrasjünger empor. So wie Mithras vom Sonnengott Helios auf dem Sonnenwagen nach oben geleitet wird, so hofft auch er auf seine eigene strahlende Erhöhung im Jenseits. Ein heiliges Mahl vereint auch die Mitglieder dieser Kultgemeinschaft und weist die Tischgenossen auf ein gemeinsames glückliches Leben im Jenseits hin.“","bold_text_offsets":[[189,196],[217,224]],"translation":"„Sırların başlangıcındaki aday, çeşitli denemeler ve yıkanmalarla takdise hazırlanır; kabulünden sonra, yedi merhalede mükemmel Mitras havarisine kadar yükselir. Mitras’ı Güneş Tanrısı Helios Güneş arabasıyla nasıl yükseltiyorsa ahirette kendisinin de ışıl ışıl [bir şekilde] yükseleceğini umar. Kutsal bir yemek, bu kült topluluğunun üyelerini bir araya getirir ve masa arkadaşlarına öbür dünyada mutlu bir hayatı hatırlatır.","bold_translation_offsets":[[128,134],[162,168],[162,170]]},{"text":"„Mithras wird am 25. Dezember, dem Tag der Sonnenwende in einer Höhle geboren. Seine Mutter ist eine Jungfrau. Hirten sind bei der Geburt dabei – und beobachten die Ankunft des Lichtträgers in der Welt. Sie kommen, um ihn anzubeten und opfern ihm die Erstlinge der Herden und der Früchte ihres Ackers.“","bold_text_offsets":[[1,8]],"translation":"„Mitras, gündönümü olan 25 Aralık'ta bir mağarada Dünya'ya gelir. Annesi bakiredir. Çobanlar doğumunda hazır bulunurlar ve ışık taşıyıcısı [olan Mitras’ın] Dünya'ya gelmesini izler. Ona tapınmaya gelenler, sürülerinde ilk doğanları ve tarlalarındaki hasadı [ona] getirirler.“","bold_translation_offsets":[[1,7],[145,151]]}]}}]},{"record_id":1444081,"word":"Mithras","pos":"noun","source_url":"https://de.wiktionary.org/wiki/Mithras","source":"de.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Mitra"],"id":"de-Mithras-noun-1","sense_number":"1","definition_de":"Göttergestalt, die eine mythologische Personifizierung der Sonne in Rom darstellt und auf den altiranischen Lichtgott zurückzuführen ist"}}]}],"Ast":[{"record_id":5495,"word":"Ast","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Ast","source":"tr.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["dal, sap, sak"],"id":"tr-Ast-de-noun-4xg72EDA"},"labels":[[0,0,["botany"]]]}]}],"scheu":[{"record_id":5571,"word":"scheu","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/scheu","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["utangaç"],"id":"tr-scheu-de-adj-xlPHzmT1"}}]}],"Konditional":[{"record_id":5630,"word":"Konditional","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Konditional","source":"tr.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["koşul bileşik zamanı, şart bileşik zamanı"],"id":"tr-Konditional-de-noun-MYLj3FN8"},"labels":[[0,0,["linguistics"]]]}]}],"extérieures":[{"record_id":5820,"word":"extérieures","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/ext%C3%A9rieures","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"form-description","data":{"glosses":["Çoğul ad çekimi.","dışarılar"],"id":"tr-extérieures-de-noun-g1SCNJS1"}},{"sense_index":1,"display_status":"form-description","data":{"glosses":["Çoğul ad çekimi.","dışarılar"],"id":"tr-extérieures-de-noun-g1SCNJS11"}}]}],"ökonomisch":[{"record_id":6337,"word":"ökonomisch","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/%C3%B6konomisch","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["ekonomik, iktisadi"],"id":"tr-ökonomisch-de-adj-XzEurZbR"},"labels":[[0,0,["economi
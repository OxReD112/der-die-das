example_de":"ohne meinen Bruder"}],"forms":null,"search_forms":["ohne"],"wortschatz_excluded":true},{"id":"preposition-014","type":"preposition","word":"um","translation_ru":"в (о точном времени); вокруг; о (es geht um …)","translation_en":"at (clock time); around; about (es geht um …)","cases":["Akkusativ"],"government":[{"pattern":"um + Akkusativ","case":"Akkusativ","position":"before","status":"standard","note_ru":"время по часам; вокруг чего-либо","note_en":"clock time; around something","example_de":"um den Tisch"}],"contractions":{"ums":"um das"},"forms":null,"forms_note_ru":"Разговорная слитная форма: ums = um das.","forms_note_en":"Colloquial contracted form: ums = um das.","search_forms":["um"],"wortschatz_excluded":true},{"id":"preposition-015","type":"preposition","word":"bis","translation_ru":"до","translation_en":"until; up to, as far as","cases":["Akkusativ","Dativ"],"government":[{"pattern":"bis + Akkusativ","case":"Akkusativ","position":"before","status":"standard","note_ru":"обычно без артикля: до какого-то времени или места","note_en":"usually without an article: until a time, as far as a place","example_de":"bis nächsten Freitag"},{"pattern":"bis zu + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"с zu: падеж определяет zu","note_en":"with zu: zu decides the case","example_de":"bis zum Bahnhof","combined_with":"zu"},{"pattern":"bis an / auf / in + Akkusativ","case":"Akkusativ","position":"before","status":"standard","note_ru":"с другим предлогом: падеж определяет второй предлог","note_en":"with another preposition: the second preposition decides the case","example_de":"bis in die Nacht","combined_with":"an / auf / in"}],"forms":null,"search_forms":["bis"],"wortschatz_excluded":true},{"id":"preposition-016","type":"preposition","word":"entlang","translation_ru":"вдоль","translation_en":"along","cases":["Akkusativ","Genitiv","Dativ"],"government":[{"pattern":"Akkusativ + entlang","case":"Akkusativ","position":"after","statu
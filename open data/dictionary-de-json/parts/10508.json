{"format_version":1,"partition":10508,"records":{"anzetteln":{"entries":[["anzetteln",null,"/ˈan.t͡sɛtəln/","Derived from Anzettel + -n. In weaving, the term Anzettel was used to describe the beginning of the process of stretching the yarn to form a woven fabric (then also known as a Zettel). This meaning of \"beginning, starting something\" was then extended. Synchronically analyzable as an- + zetteln.",{"g":"n","decl":"|||s|-|-|-|-"},"haben"]],"senses":[[417545,"anzetteln","verb","to instigate, to incite, to stir up",0,null,["derogatory"],null,"transitive"],[417546,"anzetteln","noun","dative plural of Anzettel",1],[417547,"anzetteln","noun","gerund of anzetteln",2,"n"]],"inflections":[["anzetteln","anzettel","dative,definite,plural"]]},"einen wegstecken":{"entries":[["einen wegstecken",null,null,"Literally, “to stick one away”",null,"haben"]],"senses":[[706205,"einen wegstecken","verb","to have sex",0,null,["colloquial","vulgar"],null,"intransitive"]]},"einsatzbereichs":{"entries":[["einsatzbereichs",null,null,null]],"senses":[[360627,"einsatzbereichs","noun","genitive singular of Einsatzbereich",0,"m"]],"inflections":[["einsatzbereichs","einsatzbereich","genitive"]]},"faxt":{"entries":[["faxt",null,null,null]],"senses":[[83579,"faxt","verb","inflection of faxen:",0],[83580,"faxt","verb","second/third-person singular present",1],[83581,"faxt","verb","second-person plural present",2],[83582,"faxt","verb","plural imperative",3]],"inflections":[["faxt","faxen","present,singular,third-person"]]},"klicker":{"entries":[["klicker",null,"/ˈklɪkɐ/","An onomatopoetic word already attested in Middle High German klucker. Another variant of the same is Dutch knikker.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[375749,"klicker","noun","marble (small glass ball)",0,"m",["dated","regional","Germany","Western"]]]},"kärglichere":{"entries":[["kärglichere",null,null,null]],"senses":[[299706,"kärglichere","adj","inflection of kärglich:",0],[299707,"kärglichere","adj","strong/mixed nom
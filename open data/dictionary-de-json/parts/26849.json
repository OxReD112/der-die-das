{"format_version":1,"partition":26849,"records":{"auerhuhn":{"entries":[["auerhuhn",null,null,"From Middle High German ûr-han, from Old High German ūr-huon (variant of orre-huon), from Proto-West Germanic *ūrʀahōn, from a compound of the Proto-Germanic elements *urzô (“black grouse ~ capercaillie”) + *hōną (“hen”) (see Huhn), literally \"grouse-hen\", referring to the bird's call. The first element, which is cognate with Swedish orre and Faroese orri, is possibly from Proto-Indo-European *wérsō (“virile, male; male livestock animal, bull calf”). Cognate with German Low German Urhane and Dutch woerhaan (< *worʀahanō).",{"g":"n","decl":"||/e|es/s|3ühner|3ühner|3ühnern|3ühner"}]],"senses":[[25658,"auerhuhn","noun","capercaillie, wood grouse (Tetrao urogallus)",0,"n"]]},"büffelt":{"entries":[["büffelt",null,null,null]],"senses":[[66593,"büffelt","verb","inflection of büffeln:",0],[66594,"büffelt","verb","third-person singular present",1],[66595,"büffelt","verb","second-person plural present",2],[66596,"büffelt","verb","plural imperative",3]],"inflections":[["büffelt","büffeln","present,singular,third-person"]]},"erhöhenden":{"entries":[["erhöhenden",null,null,null]],"senses":[[223583,"erhöhenden","adj","inflection of erhöhend:",0],[223584,"erhöhenden","adj","strong genitive masculine/neuter singular",1],[223585,"erhöhenden","adj","weak/mixed genitive/dative all-gender singular",2],[223586,"erhöhenden","adj","strong/weak/mixed accusative masculine singular",3],[223587,"erhöhenden","adj","strong dative plural",4],[223588,"erhöhenden","adj","weak/mixed all-case plural",5]],"inflections":[["erhöhenden","erhöhend","genitive,masculine,singular,strong,without-article"]]},"fahrtüchtigen":{"entries":[["fahrtüchtigen",null,null,null]],"senses":[[335118,"fahrtüchtigen","adj","inflection of fahrtüchtig:",0],[335119,"fahrtüchtigen","adj","strong genitive masculine/neuter singular",1],[335120,"fahrtüchtigen","adj","weak/mixed genitive/dative all-gender singular",2],[335121,"fahrtücht
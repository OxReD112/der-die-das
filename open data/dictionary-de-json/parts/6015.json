om Proto-Germanic *kranô (“crane”).\nThe word was used metaphorically for the lifting device due to the similar appearance of the bird’s neck and head. This metaphorical use is first attested in Middle Dutch krane, and thence spread to several European languages (compare English crane, French grue). The sense “water tap” is restricted to a smaller territory (compare Dutch kraan, Luxembourgish Krunn).",{"g":"m","decl":"||/e|es/s|2äne/e|2äne/e|2änen/en|2äne/e"}]],"senses":[[18983,"kran","noun","crane (a lifting device)",0,"m"],[18984,"kran","noun","tap, faucet",1,"m",["regional","Germany","Western"]]]},"offenhaltet":{"entries":[["offenhaltet",null,null,null]],"senses":[[667674,"offenhaltet","verb","inflection of offenhalten:",0],[667675,"offenhaltet","verb","second-person plural dependent present",1],[667676,"offenhaltet","verb","second-person plural dependent subjunctive I",2]],"inflections":[["offenhaltet","offenhalten","indicative,plural,present,second-person,subordinate-clause"]]},"oktaeterischem":{"entries":[["oktaeterischem",null,null,null]],"senses":[[527245,"oktaeterischem","adj","strong dative masculine/neuter singular of oktaeterisch",0]],"inflections":[["oktaeterischem","oktaeterisch","dative,masculine,singular,strong,without-article"]]},"sprachbundes":{"entries":[["sprachbundes",null,null,null]],"senses":[[239920,"sprachbundes","noun","genitive singular of Sprachbund",0]],"inflections":[["sprachbundes","sprachbund","genitive"]]},"uhrenturm":{"entries":[["uhrenturm",null,"[ˈuːʁənˌtʊʁm]","From Uhr (“clock”) + -en- + Turm (“tower, spire; steeple”).",{"g":"m","decl":"||/e|es/s|3ürme|3ürme|3ürmen|3ürme"}]],"senses":[[613454,"uhrenturm","noun","clock tower",0,"m",null,null,null,null,["architecture"]]]},"verkehrsunfalles":{"entries":[["verkehrsunfalles",null,null,null]],"senses":[[400589,"verkehrsunfalles","noun","genitive of Verkehrsunfall",0,"m"]],"inflections":[["verkehrsunfalles","verkehrsunfall","genitive"]]},"verschlüsseler":{"entries":[["verschlüsseler",nu
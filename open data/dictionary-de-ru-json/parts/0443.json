xt_offsets":[[217,236]],"translation":"В октябре 1935 года Италия без объявления войны вторглась в Абиссинскую империю (ныне Эфиопия) и аннексировала страну. Африканские историки уже рассматривают это как начало Второй мировой войны. Эта аннексия, нарушавшая международное право, была частью заявленной цели Муссолини по возрождению Римской империи.","bold_translation_offsets":[[209,239]]}]}}]}],"Kriegsteilnehmer":[{"record_id":55319,"word":"Kriegsteilnehmer","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Kriegsteilnehmer","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["участник войны; фронтовик"],"id":"ru-Kriegsteilnehmer-de-noun-KlwQKRFI"}}]}],"Schlagspur":[{"record_id":55774,"word":"Schlagspur","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Schlagspur","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["след (от) удара"],"id":"ru-Schlagspur-de-noun-jP~QAKMU"}}]}],"Verhaltensänderung":[{"record_id":58037,"word":"Verhaltensänderung","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Verhaltens%C3%A4nderung","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["изменение поведения"],"id":"ru-Verhaltensänderung-de-noun-5yTRnLv2"}}]}],"Fremdheit":[{"record_id":59836,"word":"Fremdheit","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Fremdheit","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["незнакомство, неосведомлённость (in D в чём-л.)"],"id":"ru-Fremdheit-de-noun-mmqXmalg"}},{"sense_index":1,"display_status":"translation","data":{"glosses":["странность, необычность"],"id":"ru-Fremdheit-de-noun--kAAbDry"}}]}],"elsässisch":[{"record_id":60418,"word":"elsässisch","pos":"adj","source_url":"https://ru.wiktionary.org/wiki/els%C3%A4ssisch","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["эльзасский (от Эльзас)"],"id":"ru-elsässisch-de-adj-edBHtdd~"}}]}],"Rauchschleier":[{"record_id":61637,"word":"Rau
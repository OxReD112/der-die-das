ig-de-adv-gWLg2~sr","examples":[{"text":"nach dem Öffnen kühl lagern und kurzfristig aufbrauchen","bold_text_offsets":[[32,43]],"translation":"после открытия держать в холоде и употребить в короткий срок"}]}}]}],"Schweinskopf":[{"record_id":16466,"word":"Schweinskopf","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Schweinskopf","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["свиная голова"],"id":"ru-Schweinskopf-de-noun-63DwqaK1"}}]}],"Aporie":[{"record_id":16687,"word":"Aporie","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Aporie","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["филос. апория"],"id":"ru-Aporie-de-noun-rBiLQ6tF"}},{"sense_index":1,"display_status":"translation","data":{"glosses":["книжн. безвыходность"],"id":"ru-Aporie-de-noun-vUQl1cSj"}}]}],"Sprachlosigkeit":[{"record_id":16893,"word":"Sprachlosigkeit","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Sprachlosigkeit","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["физиол. немота"],"id":"ru-Sprachlosigkeit-de-noun-0LsT5CGj","examples":[{"text":"Das Gerede ist die Ausdrucksform der Sprachlosigkeit.","bold_text_offsets":[[37,52]],"translation":"Болтовня — есть форма выражения немоты.","bold_translation_offsets":[[32,38]],"ref":"Autor: Jacques Wirion"}]}},{"sense_index":1,"display_status":"translation","data":{"glosses":["психол. афазия (системное расстройство различных видов речевой деятельности)"],"id":"ru-Sprachlosigkeit-de-noun-hSR0UibR","examples":[{"text":"“Sprachlosigkeit ist ein Phänomen in meinem Leben, das meinen Alltag begleitet. Sie ist da, mal mehr mal weniger, aber sie gehört zu mir, wie ein Kleidungsstück. Nur kann ich selbst schlecht bestimmen, wann ich es ablege oder anziehe. Sie ist gewissermaßen selbständig und in ihrer Unvorhersehbarkeit so vertraut.“","bold_text_offsets":[[1,16]],"translation":"«Афазия — такое явление в моей жизни, которое сопровождает мою повседневность. Она присутствует всегда, иногда больше, иногда меньше, однако она принадлежит мне, точно так же, как одежда/предметы одежды. Вот только я сама не решаю, когда её/их снять или надеть. В определённой степени она самостоятельна и так верна собственной непредсказуемости»","bold_translation_offsets":[[1,7]],"ref":"[источник — http://stilleschaos.wordpress.com/2012/01/22/mutismus-zitate/]"}]}}]}],"Gramineen":[{"record_id":18127,"word":"Gramineen","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Gramineen","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["ботан. злаки"],"id":"ru-Gramineen-de-noun-~D99Ci5V"}}]}],"fordern":[{"record_id":18561,"word":"fordern","pos":"verb","source_url":"https://ru.wiktionary.org/wiki/fordern","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["требовать чего-либо"],"id":"ru-fordern-de-verb-6exXRgoQ"}},{"sense_index":1,"display_status":"translation","data":{"glosses":["требовать, просить, запрашивать"],"id":"ru-fordern-de-verb-AijsU9PX"}},{"sense_index":2,"display_status":"translation","data":{"glosses":["вызывать"],"id":"ru-fordern-de-verb-iqQdDele"}},{"sense_index":3,"display_status":"translation","data":{"glosses":["вызывать на дуэль"],"id":"ru-fordern-de-verb-fYH7vmyi"}}]}],"jenseitig":[{"record_id":22394,"word":"jenseitig","pos":"adj","source_url":"https://ru.wiktionary.org/wiki/jenseitig","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["лежащий по ту (другую) сторону; относящийся к другой (противоположной) стороне"],"id":"ru-jenseitig-de-adj-pzoN7kGH"}},{"sense_index":1,"display_status":"translation","data":{"glosses":["потусторонний"],"id":"ru-jenseitig-de-adj-CJH1cO7P"}},{"sense_index":2,"display_status":"translation","data":{"glosses":["филос. трансцендентный"],"id":"ru-jenseitig-de-adj-V6rIyKAY"}}]}],"Speläologie":[{"record_id":22622,"word":"Speläologie","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Spel%C3%A4ologie","sen
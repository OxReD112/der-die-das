{"format_version":1,"partition":5240,"records":{"ach du grüne neune":{"entries":[["ach du grüne neune",null,"/ˌax du ˈɡʁyːnə ˌnɔʏ̯nə/","Literally, “oh you green nine!”\nGrüne Neun means “nine of leaves” in the traditional German card deck, where Grün (“green”) or Laub (“leaves”) is the equivalent of spades. The nine of spades is a negative card in tarot card reading, traditionally associated with death.\nThe form Neune suggests origin in East Central German, where such nominalized numerals in -e are common, perhaps specifically Berlin. Accordingly, one theory links the phrase to a popular theater in 19th-century Berlin called “Grüne Neune”, evidently because it was located in a green house at number 9, but possibly also alluding to the tarot card. The semantic connection is not apparent, however. (The theater, while playing mainly comedies, seems to have been well respected.)"]],"senses":[[635613,"ach du grüne neune","intj","Used to express surprise, shock or confusion.",0,null,["colloquial"]]]},"ehepartnerin":{"entries":[["ehepartnerin",null,"[ˈeːəˌpaʁtnəʁɪn]","Ehepartner + -in",{"g":"f","decl":"||||nen|nen|nen|nen"}]],"senses":[[623401,"ehepartnerin","noun","female equivalent of Ehepartner",0,"f"]],"inflections":[["ehepartnerin","ehepartner","feminine"]]},"irrtümlichere":{"entries":[["irrtümlichere",null,null,null]],"senses":[[297714,"irrtümlichere","adj","inflection of irrtümlich:",0],[297715,"irrtümlichere","adj","strong/mixed nominative/accusative feminine singular comparative degree",1],[297716,"irrtümlichere","adj","strong nominative/accusative plural comparative degree",2],[297717,"irrtümlichere","adj","weak nominative all-gender singular comparative degree",3],[297718,"irrtümlichere","adj","weak accusative feminine/neuter singular comparative degree",4]],"inflections":[["irrtümlichere","irrtümlich","comparative,feminine,nominative,singular,strong,without-article"]]},"mohnblumen":{"entries":[["mohnblumen",null,null,null]],"senses":[[621743,"mohnblumen","noun
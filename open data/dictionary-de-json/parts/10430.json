{"format_version":1,"partition":10430,"records":{"-rich":{"entries":[["-rich",null,"/-ʁɪç/","Extracted from names such as Friedrich, ultimately from Proto-Germanic *rīks (“king, ruler”). With animals first in Enterich, which is a folk-etymological alteration of Middle High German antreche, equivalent to Ente + the cognate of English drake. Then by analogy Gänserich, and subsequently other forms."]],"senses":[[387894,"-rich","suffix","suffix to derive masculine nouns, especially for male animals",0]]},"binnenmeer":{"entries":[["binnenmeer",null,null,"binnen- (“inner”) + Meer (“sea”)",{"g":"n","decl":"||/e|s/es|e|e|en|e"}]],"senses":[[707615,"binnenmeer","noun","inland sea",0,"n"]]},"fundiertes":{"entries":[["fundiertes",null,null,null]],"senses":[[290644,"fundiertes","adj","strong/mixed nominative/accusative neuter singular of fundiert",0]],"inflections":[["fundiertes","fundiert","neuter,nominative,singular,strong,without-article"]]},"hämmer aus":{"entries":[["hämmer aus",null,null,null]],"senses":[[380217,"hämmer aus","verb","inflection of aushämmern:",0],[380218,"hämmer aus","verb","first-person singular present",1],[380219,"hämmer aus","verb","singular imperative",2]]},"kausalem":{"entries":[["kausalem",null,null,null]],"senses":[[232849,"kausalem","adj","strong dative masculine/neuter singular of kausal",0]],"inflections":[["kausalem","kausal","dative,masculine,singular,strong,without-article"]]},"konsekutiv":{"entries":[["konsekutiv",null,"/ˌkɔnzekuˈtiːf/","From Medieval Latin cōnsecūtīvus, in part through French consécutif."]],"senses":[[507017,"konsekutiv","adj","consecutive (expressing the consequence of an action)",0,null,null,null,null,null,["grammar"]],[507018,"konsekutiv","adj","consecutive (following each other)",1,null,["literary"]]],"related_forms":[[57879,"konsekutiv","konsekutivsatz","derived"],[57880,"konsekutiv","konsequenz","related"]]},"möbliertet":{"entries":[["möbliertet",null,null,null]],"senses":[[129268,"möbliertet","verb","inflection of möb
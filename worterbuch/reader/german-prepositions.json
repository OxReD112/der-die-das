{"format_version":1,"source":"german-prepositions.json","details_parts":1,"entries":[{"id":"preposition-001","type":"preposition","word":"aus","translation_ru":"из; из-за, от (причина)","translation_en":"from, out of; (made) of; out of (reason)","cases":["Dativ"],"government":[{"pattern":"aus + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"откуда: из чего-либо","note_en":"where from: out of something","example_de":"aus dem Haus"}],"forms":null,"search_forms":["aus"],"wortschatz_excluded":true},{"id":"preposition-002","type":"preposition","word":"bei","translation_ru":"у, при; около; во время","translation_en":"at, with; near; during","cases":["Dativ"],"government":[{"pattern":"bei + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"у кого-либо, где-либо","note_en":"at someone's place, somewhere","example_de":"bei meinen Eltern"}],"contractions":{"beim":"bei dem"},"forms":null,"forms_note_ru":"Слитная форма: beim = bei dem.","forms_note_en":"Contracted form: beim = bei dem.","search_forms":["bei"],"wortschatz_excluded":true},{"id":"preposition-003","type":"preposition","word":"mit","translation_ru":"с; на (о транспорте); с помощью","translation_en":"with; by (transport)","cases":["Dativ"],"government":[{"pattern":"mit + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"с кем-либо, с чем-либо","note_en":"with someone or something","example_de":"mit meiner Schwester"}],"forms":null,"search_forms":["mit"],"wortschatz_excluded":true},{"id":"preposition-004","type":"preposition","word":"nach","translation_ru":"в, на (направление: города, страны без артикля); после; по, согласно","translation_en":"to (cities, countries); after; according to","cases":["Dativ"],"government":[{"pattern":"nach + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"куда (города, страны без артикля); после чего-либо","note_en":"where to (cities, countries without an article); after something","example_de":"nach dem Essen"},{"pattern":"Dativ + nach","case":"Dativ","position":"after","status":"standard","note_ru":"в значении «по, согласно» может стоять после существительного","note_en":"meaning according to, it can follow the noun","example_de":"meiner Meinung nach"}],"forms":null,"search_forms":["nach"],"wortschatz_excluded":true},{"id":"preposition-005","type":"preposition","word":"seit","translation_ru":"с (какого-то момента); уже (в течение)","translation_en":"since; for (up to now)","cases":["Dativ"],"government":[{"pattern":"seit + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"с какого-то момента до сейчас","note_en":"from a point in the past up to now","example_de":"seit dem Sommer"}],"forms":null,"search_forms":["seit"],"wortschatz_excluded":true},{"id":"preposition-006","type":"preposition","word":"von","translation_ru":"от; с, из (откуда); о (erzählen von); принадлежность (вместо Genitiv); кем (в пассиве)","translation_en":"from; about (erzählen von); of; by (passive)","cases":["Dativ"],"government":[{"pattern":"von + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"от кого-либо, откуда","note_en":"from someone or somewhere","example_de":"von meiner Oma"}],"contractions":{"vom":"von dem"},"forms":null,"forms_note_ru":"Слитная форма: vom = von dem.","forms_note_en":"Contracted form: vom = von dem.","search_forms":["von"],"wortschatz_excluded":true},{"id":"preposition-007","type":"preposition","word":"zu","translation_ru":"к; в, на (направление к человеку, месту, событию)","translation_en":"to","cases":["Dativ"],"government":[{"pattern":"zu + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"куда: к человеку, месту или событию","note_en":"where to: a person, a place or an event","example_de":"zum Arzt"}],"contractions":{"zum":"zu dem","zur":"zu der"},"forms":null,"forms_note_ru":"Слитные формы: zum = zu dem, zur = zu der.","forms_note_en":"Contracted forms: zum = zu dem, zur = zu der.","search_forms":["zu"],"wortschatz_excluded":true},{"id":"preposition-008","type":"preposition","word":"ab","translation_ru":"с, начиная с (о времени, месте)","translation_en":"from, as of, starting","cases":["Dativ","Akkusativ"],"government":[{"pattern":"ab + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"начиная с какого-то момента или места","note_en":"starting from a time or place","example_de":"ab dem 1. Mai"},{"pattern":"ab + Akkusativ","case":"Akkusativ","position":"before","status":"also_correct","note_ru":"о времени без артикля с прилагательным тоже возможен Akkusativ","note_en":"with time expressions without an article but with an adjective, Akkusativ is also possible","example_de":"ab nächste Woche"}],"forms":null,"search_forms":["ab"],"wortschatz_excluded":true},{"id":"preposition-009","type":"preposition","word":"gegenüber","translation_ru":"напротив; по отношению к; по сравнению с","translation_en":"opposite; towards; compared with","cases":["Dativ"],"government":[{"pattern":"gegenüber + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"перед существительным: напротив чего-либо","note_en":"before the noun: opposite something","example_de":"gegenüber dem Bahnhof"},{"pattern":"Dativ + gegenüber","case":"Dativ","position":"after","status":"standard","note_ru":"может стоять и после существительного; после местоимения — обычно так: mir gegenüber","note_en":"it can also follow the noun; after a pronoun this is the usual order: mir gegenüber","example_de":"dem Bahnhof gegenüber"},{"pattern":"gegenüber von + Dativ","case":"Dativ","position":"before","status":"also_correct","note_ru":"особенно в разговорной речи и с названиями мест; падеж определяет von","note_en":"especially in speech and with place names; von decides the case","example_de":"gegenüber vom Bahnhof","combined_with":"von"}],"forms":null,"search_forms":["gegenüber"],"wortschatz_excluded":true},{"id":"preposition-010","type":"preposition","word":"durc
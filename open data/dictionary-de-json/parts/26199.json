{"format_version":1,"partition":26199,"records":{"affe":{"entries":[["affe",null,"[ˈafə]","From Middle High German affe, from Old High German affo, from Proto-West Germanic *apō, from Proto-Germanic *apô.\nThe sense of drunkenness has been traced to the late 18ᵗʰ century, allegedly playing on the homophony of Czech opice (“monkey or ape”) and opít se (“to get drunk”), though the image of a monkey being a possessing demon is translingual, and thus Spanish mona (“she-ape”) also means drunkenness, Spanish mono (“he-ape”) withdrawal symptoms, English monkey a substance (typically, a recreational drug) addiction.",{"g":"m","decl":"|n|n|n|n|n|n|n"}]],"senses":[[2201,"affe","noun","monkey or ape (male or female or of unspecified sex)",0,"m"],[2202,"affe","noun","ellipsis of Fellaffe, a kind of furry military knapsack",1,"m"],[2203,"affe","noun","drunkenness, alcohol intoxication",2,"m",["slang","regional"]]],"related_forms":[[2739,"affe","affig","derived"],[2740,"affe","nachäffen","derived"],[2741,"affe","wie ein affe auf dem schleifstein","derived"],[2742,"affe","affenbande","related"],[2743,"affe","affenbrotbaum","related"],[2744,"affe","affenente","related"],[2745,"affe","affentheater","related"]],"inflections":[["affe","äffin","masculine"]]},"aluminiumblechen":{"entries":[["aluminiumblechen",null,null,null]],"senses":[[243870,"aluminiumblechen","noun","dative plural of Aluminiumblech",0,"n"]],"inflections":[["aluminiumblechen","aluminiumblech","dative,definite,plural"]]},"erschrick":{"entries":[["erschrick",null,null,null]],"senses":[[273472,"erschrick","verb","singular imperative of erschrecken",0]],"inflections":[["erschrick","erschrecken","imperative,second-person,singular"]]},"internate":{"entries":[["internate",null,null,null]],"senses":[[61878,"internate","noun","nominative/accusative/genitive plural of Internat",0]],"inflections":[["internate","internat","plural"]]},"koboldmakis":{"entries":[["koboldmakis",null,null,null]],"senses":[[62651,"koboldmakis","noun","
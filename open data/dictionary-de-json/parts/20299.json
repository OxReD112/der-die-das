{"format_version":1,"partition":20299,"records":{"angebot":{"entries":[["angebot",null,"/ˈanɡəˌboːt/","18th-century alteration of Anbot, from Middle High German anbot, anpot (14th c.). Compare Dutch aanbod, Middle Low German anbot. Deverbal from anbieten (“to offer”). The alteration is due to the general replacement of the noun Bot (from Old High German bot and Proto-Germanic *budą) with prefixed Gebot; hence by surface analysis, an- + Gebot.",{"g":"n","decl":"||/e|s/es|e|e|en|e"}]],"senses":[[27541,"angebot","noun","offer, proposition",0,"n"],[27542,"angebot","noun","quote, estimate, offer (as made by an artisan)",1,"n"],[27543,"angebot","noun","sale, bargain, offer (with a lowered price)",2,"n"],[27544,"angebot","noun","a range of products or services provided by a company or institution",3,"n"],[27545,"angebot","noun","a product, service, facility, or activity made available to consumers or users",4,"n"],[27546,"angebot","noun","supply (as in supply and demand)",5,"n",null,null,null,null,["economics"]]],"related_forms":[[36549,"angebot","heiratsangebot","related"],[36550,"angebot","platzangebot","related"],[36551,"angebot","sonderangebot","related"],[36552,"angebot","stellenangebot","related"],[36553,"angebot","überangebot","related"],[36554,"angebot","warenangebot","related"],[36555,"angebot","anbieten","related"],[36556,"angebot","nachfrage","related"]]},"badebekleidung":{"entries":[["badebekleidung",null,null,"baden (“bath”) + Bekleidung (“clothes”)",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[589625,"badebekleidung","noun","swimwear",0,"f"]]},"einundzwanzigköpfiger":{"entries":[["einundzwanzigköpfiger",null,"/ˈaɪ̯nʊnt͡svant͡sɪçˌkœp͡fɪɡɐ/",null]],"senses":[[680242,"einundzwanzigköpfiger","adj","inflection of einundzwanzigköpfig:",0],[680243,"einundzwanzigköpfiger","adj","strong/mixed nominative masculine singular",1],[680244,"einundzwanzigköpfiger","adj","strong genitive/dative feminine singular",2],[680245,"einundzwanzigköpfiger","adj","strong genitive pl
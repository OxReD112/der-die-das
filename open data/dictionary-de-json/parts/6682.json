nflicting analogy with the merged accusative/dative forms uns, euch."]],"senses":[[11240,"sich","pron","Reflexive pronoun of the third person singular or plural: herself, himself, itself, oneself, themselves (in both dative and accusative)",0],[11241,"sich","pron","Reciprocal pronoun of the third person plural: each other (in both dative and accusative)",1]],"related_forms":[[14801,"sich","mich","related"],[14802,"sich","mir","related"],[14803,"sich","dich","related"],[14804,"sich","dir","related"],[14805,"sich","uns","related"],[14806,"sich","euch","related"],[14807,"sich","seiner","related"],[14808,"sich","ihrer","related"]]},"sklavischer":{"entries":[["sklavischer",null,null,null]],"senses":[[312130,"sklavischer","adj","comparative degree of sklavisch",0],[312131,"sklavischer","adj","inflection of sklavisch:",1],[312132,"sklavischer","adj","strong/mixed nominative masculine singular",2],[312133,"sklavischer","adj","strong genitive/dative feminine singular",3],[312134,"sklavischer","adj","strong genitive plural",4]],"inflections":[["sklavischer","sklavisch","masculine,nominative,singular,strong"]]},"skurrilstem":{"entries":[["skurrilstem",null,null,null]],"senses":[[410933,"skurrilstem","adj","strong dative masculine/neuter singular superlative degree of skurril",0]],"inflections":[["skurrilstem","skurril","dative,masculine,singular,strong,superlative,without-article"]]},"sparst ein":{"entries":[["sparst ein",null,null,null]],"senses":[[343325,"sparst ein","verb","second-person singular present of einsparen",0]]},"synergistisch":{"entries":[["synergistisch",null,"/ˌsʏnɛʁˈɡɪstɪʃ/",null]],"senses":[[557194,"synergistisch","adj","synergistic",0]]},"teilstücken":{"entries":[["teilstücken",null,null,null]],"senses":[[714528,"teilstücken","noun","dative plural of Teilstück",0]],"inflections":[["teilstücken","teilstück","dative,definite,plural"]]},"trübsten":{"entries":[["trübsten",null,null,null]],"senses":[[153520,"trübsten","adj","superlative degree of trüb",0],[15352
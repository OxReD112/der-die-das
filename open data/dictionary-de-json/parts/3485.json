{"format_version":1,"partition":3485,"records":{"aber":{"entries":[["aber",null,"/ˈaːbɐ/","From Middle High German aber, aver, from Old High German aber, ābar, abur, aver, avur, afur, from Proto-Germanic *aferą (“behind”). Compare Bavarian owa (“but”), Luxembourgish awer (“but”), Saterland Frisian oaber (“but”), Middle Low German āver, German Low German aver (“but”).",{"g":"n","decl":"|||s/|s/|s/|s/n|s/"}]],"senses":[[2429,"aber","conj","but; however; though",0],[2430,"aber","adv","again",1,null,["obsolete"]],[2431,"aber","adv","rather; quite; unusually; used with adjectives to express a surprising degree, whether this surprise be real or for effect",2],[2432,"aber","adv","nonetheless, nevertheless",3],[2433,"aber","noun","an objection, a but",4,"n"]],"related_forms":[[3373,"aber","abermals","derived"],[3374,"aber","abertausend","derived"]]},"aspie":{"entries":[["aspie",null,"/ˈaspi/","Borrowed from English aspie, itself a derivation of German Asperger.",{"g":"m:f","decl":"|||s/|s|s|s|s","alt":[["m","|||s|s|s|s|s"],["f","||||s|s|s|s"]]}]],"senses":[[63825,"aspie","noun","aspie",0,"m",["colloquial"]],[63826,"aspie","noun","female aspie",1,"f",["colloquial"]]]},"ausgibst":{"entries":[["ausgibst",null,null,null]],"senses":[[90336,"ausgibst","verb","second-person singular dependent present of ausgeben",0]],"inflections":[["ausgibst","ausgeben","indicative,present,second-person,singular,subordinate-clause"]]},"dioxygenasen":{"entries":[["dioxygenasen",null,null,null]],"senses":[[229365,"dioxygenasen","noun","plural of Dioxygenase",0,"f"]],"inflections":[["dioxygenasen","dioxygenase","plural"]]},"einfüßigen":{"entries":[["einfüßigen",null,null,null]],"senses":[[433539,"einfüßigen","adj","inflection of einfüßig:",0],[433540,"einfüßigen","adj","strong genitive masculine/neuter singular",1],[433541,"einfüßigen","adj","weak/mixed genitive/dative all-gender singular",2],[433542,"einfüßigen","adj","strong/weak/mixed accusative masculine singular",3],[433543,"einfüßigen","adj","
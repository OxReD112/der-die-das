{"format_version":1,"partition":1502,"records":{"ampfer":{"entries":[["ampfer",null,"/ˈam(p)fɐ/","From the equivalent Middle High German ampfer, Old High German ampfaro m, allied to the equivalent Old English ompre, from Proto-West Germanic *amprō; an adjective used as a substantive. Compare Dutch amper (“sharp, bitter, unripe”), Old Swedish amper, Old Norse apr (“sharp, chiefly of cold”) (for Proto-Germanic *ampraz); also Low German ampern (“to prove bitter to the taste”). Sauerampfer (also corrupted to Sauer-ramf) is a tautological compound like Windhund. In case *ampraz, from earlier Pre-Germanic *ambras, represents the properly Proto-Indo-European *amrós (see *h₂eh₃mós), Sanskrit अम्ल (amlá, “sour; wood-sorrel”) and Latin amārus (“bitter”) are primitively cognate with this word.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[62139,"ampfer","noun","sorrel (genus Rumex)",0,"m"]]},"aufglühen":{"entries":[["aufglühen",null,"/ˈaʊ̯fˌɡlyːən/","From auf + glühen.",{"g":"n","decl":"|||s|-|-|-|-"}]],"senses":[[366310,"aufglühen","verb","to (begin to) glow or gleam",0],[366311,"aufglühen","verb","to awaken",1],[366312,"aufglühen","noun","gerund of aufglühen",2,"n"]],"related_forms":[[55045,"aufglühen","aufglühung","derived"],[55046,"aufglühen","aufglühen","related"],[55047,"aufglühen","aufglühend","related"],[55048,"aufglühen","aufgeglüht","related"],[55049,"aufglühen","aufblühen","related"]]},"ausgesprochenem":{"entries":[["ausgesprochenem",null,null,null]],"senses":[[595801,"ausgesprochenem","verb","strong dative masculine/neuter singular of ausgesprochen",0]],"inflections":[["ausgesprochenem","ausgesprochen","dative,masculine,singular,strong,without-article"]]},"beantworten":{"entries":[["beantworten",null,"/bəˈʔantˌvɔɐ̯tn̩/",null,{"g":"n","decl":"|||s|-|-|-|-"}]],"senses":[[75388,"beantworten","verb","to answer (a question)",0],[75389,"beantworten","noun","gerund of beantworten",1,"n"]]},"beeinträchtigtster":{"entries":[["beeinträchtigtster",null,null,null]],"senses":[[451
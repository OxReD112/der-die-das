{"format_version":1,"partition":10393,"records":{"bratwurst":{"entries":[["bratwurst",null,"/ˈbʁaːtvʊʁst/","From Middle High German brātwurst, from Old High German brātwurst. The term originally denoted a sausage (Wurst) made of Brät (Old High German brāto), but has come to be used for a sausage that is fried or is suited to being fried (braten). Kluge suggests the modern word might be a conflation of those two etymologies rather than a derivation of only the first one.",{"g":"f","decl":"||||4ürste|4ürste|4ürsten|4ürste"}]],"senses":[[7373,"bratwurst","noun","a sausage which has been or is suited to be fried or grilled; a bratwurst",0,"f"],[7374,"bratwurst","noun","a smoked sausage, made of raw Brät, which is eaten cold or cooked in water",1,"f",["regional"]]]},"explosiv":{"entries":[["explosiv",null,"/ɛksploˈziːf/",null,{"g":"m","decl":"|||s|e|e|en|e"}]],"senses":[[30227,"explosiv","adj","explosive",0],[30228,"explosiv","noun","plosive",1,"m"]]},"pexieren":{"entries":[["pexieren",null,"[pɛkˈsiːɐ̯n]",null,null,"haben"]],"senses":[[146662,"pexieren","verb","alternative form of pekzieren",0]],"inflections":[["pexieren","pekzieren","alternative"]]},"spitzers":{"entries":[["spitzers",null,null,null]],"senses":[[349850,"spitzers","noun","genitive singular of Spitzer",0,"m"]],"inflections":[["spitzers","spitzer","genitive"]]},"unvollkommenen":{"entries":[["unvollkommenen",null,null,null]],"senses":[[571614,"unvollkommenen","adj","inflection of unvollkommen:",0],[571615,"unvollkommenen","adj","strong genitive masculine/neuter singular",1],[571616,"unvollkommenen","adj","weak/mixed genitive/dative all-gender singular",2],[571617,"unvollkommenen","adj","strong/weak/mixed accusative masculine singular",3],[571618,"unvollkommenen","adj","strong dative plural",4],[571619,"unvollkommenen","adj","weak/mixed all-case plural",5]],"inflections":[["unvollkommenen","unvollkommen","genitive,masculine,singular,strong,without-article"]]},"äthan":{"entries":[["äthan",null,"/ɛˈtaːn/","From
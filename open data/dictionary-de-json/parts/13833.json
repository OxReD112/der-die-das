{"format_version":1,"partition":13833,"records":{"baumbestand":{"entries":[["baumbestand",null,"/ˈbaʊ̯mbəˌʃtant/","Baum (“tree”) + Bestand (“population, stock”)",{"g":"m","decl":"||/e|es/s|3ände|3ände|3änden|3ände"}]],"senses":[[618716,"baumbestand","noun","tree population",0,"m"]]},"dung":{"entries":[["dung",null,"/dʊŋ/","From Middle High German tunc, tunge, from Old High German tung, tunga, from Proto-West Germanic *dungu, from Proto-Germanic *dungō, from Proto-Indo-European *dʰengʰ- (“to cover”).\nThe word also meant in High German—and it seems exclusively in Low German (compare Old Saxon dung)—a dwelling or storage room (originally under the earth and covered with dung), from Proto-West Germanic *dung (“cellar”); also compare *dungijǭ (“dung-hill, dung-heap; bower”). The modern consonantism is of regional origin (see düngen). Cognate to English dung.",{"g":"m","decl":"||/e|es/s|-|-|-|-"}]],"senses":[[7633,"dung","noun","dung",0,"m"]]},"einzelfaktor":{"entries":[["einzelfaktor",null,null,"From einzel- (“single”) + Faktor (“factor”).",{"g":"m","decl":"|||s|en|en|en|en"}]],"senses":[[670294,"einzelfaktor","noun","single factor, individual factor",0,"m"]]},"fiberglasbeschichtung":{"entries":[["fiberglasbeschichtung",null,null,"From Fiberglas + Beschichtung.",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[687280,"fiberglasbeschichtung","noun","fiberglass coating",0,"f"]]},"gemäßere":{"entries":[["gemäßere",null,null,null]],"senses":[[336581,"gemäßere","adj","inflection of gemäß:",0],[336582,"gemäßere","adj","strong/mixed nominative/accusative feminine singular comparative degree",1],[336583,"gemäßere","adj","strong nominative/accusative plural comparative degree",2],[336584,"gemäßere","adj","weak nominative all-gender singular comparative degree",3],[336585,"gemäßere","adj","weak accusative feminine/neuter singular comparative degree",4]],"inflections":[["gemäßere","gemäß","comparative,feminine,nominative,singular,strong,without-article"]]},"kunstdünger":{"entries":
reas), plausibly under the influence of Middle High German zūpe (“bitch, doe rabbit”). Note that the unadapted form is found in northern East Central German Tiffe (“cur”) as well as Ripuarian Tiff (“bitch”, locally also “doe rabbit”).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[2551,"zibbe","noun","ewe or nanny goat",0,"f",["regional"]],[2552,"zibbe","noun","doe hare or doe rabbit",1,"f",null,null,null,null,["technical"]],[2553,"zibbe","noun","bitch, she-dog",2,"f",["archaic","dialectal"]]],"inflections":[["zibbe","hund","feminine"]]},"zusammenpacke":{"entries":[["zusammenpacke",null,null,null]],"senses":[[650205,"zusammenpacke","verb","inflection of zusammenpacken:",0],[650206,"zusammenpacke","verb","first-person singular dependent present",1],[650207,"zusammenpacke","verb","first/third-person singular dependent subjunctive I",2]],"inflections":[["zusammenpacke","zusammenpacken","first-person,indicative,present,singular,subordinate-clause"]]},"hineinließe":{"inflections":[["hineinließe","hineinlassen","first-person,singular,subjunctive,subjunctive-ii,subordinate-clause"]]},"lachshaien":{"inflections":[["lachshaien","lachshai","dative,definite,plural"]]},"troern":{"inflections":[["troern","troer","dative,definite,plural"]]},"wöhnlichem":{"inflections":[["wöhnlichem","wöhnlich","dative,masculine,singular,strong,without-article"]]},"zuschneitet":{"inflections":[["zuschneitet","zuschneien","indicative,plural,preterite,second-person,subordinate-clause"]]}}}
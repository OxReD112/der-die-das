{"format_version":1,"partition":10479,"records":{"ausborgen":{"entries":[["ausborgen",null,"/ˈaʊ̯sˌbɔʁɡn̩/","aus- + borgen",null,"haben"]],"senses":[[634711,"ausborgen","verb","to borrow",0,null,null,null,"transitive"]]},"bingelkraut":{"entries":[["bingelkraut",null,"[ˈbɪŋl̩ˌkʁaʊ̯t]","From bingeln, a dialectal form of now standard pinkeln (“to pee”), by the diuretic effect of Mercurialis annua. For the same reason it is called in dialectal Slovene usȃčnica, usačna zel from uscáti se (“to relieve oneself of water”). Other relevant names of the plant include Scheißkraut, Scheißmelde, Schweißkraut, Schweißmelde, Ruhrkaut, Klystierkraut.\nAlternatively, bingel may represent a diminutive of the noun attested in Old High German as bungo, which refers to a type of bulbiferous plant.",{"g":"n","decl":"||/e|es/s|3äuter|3äuter|3äutern|3äuter"}]],"senses":[[614967,"bingelkraut","noun","mercury (Mercurialis gen. et spp.)",0,"n"]]},"etter":{"entries":[["etter",null,"/ˈɛtɐ/","From Middle High German eter (“fence”), from Old High German etar (“fence, border”), from Proto-Germanic *edaraz (“fence, enclosure”), possibly from Proto-Indo-European *edh-.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[57125,"etter","noun","fence",0,"m"],[57126,"etter","noun","the surrounding border of a village",1,"m",["archaic","Southern-Germany"]],[57127,"etter","noun","boundary or border of an area or location",2,"m"],[57128,"etter","noun","the central area of a locality",3,"m"]]},"lebensweise":{"entries":[["lebensweise",null,"/ˈleːbn̩sˌvaɪ̯zə/","From Leben (“life”) + -s- + Weise (“way”).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[390539,"lebensweise","noun","lifestyle, way of life",0,"f"]]},"milchmixgetränks":{"entries":[["milchmixgetränks",null,"[ˈmɪlçmɪksɡəˌtʁɛŋks]",null]],"senses":[[671490,"milchmixgetränks","noun","genitive singular of Milchmixgetränk",0,"n"]],"inflections":[["milchmixgetränks","milchmixgetränk","genitive"]]},"oberende":{"entries":[["oberende",null,null,"From ober- (“upper”) + End
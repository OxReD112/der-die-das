al enlargement, such as in Knopf).",{"g":"m","decl":"||/e|es|e|e|en|e"}]],"senses":[[387883,"knust","noun","heel of bread",0,"m",["regional","Northern-Germany"]]]},"malaysischer":{"entries":[["malaysischer",null,null,null]],"senses":[[408404,"malaysischer","adj","comparative degree of malaysisch",0],[408405,"malaysischer","adj","inflection of malaysisch:",1],[408406,"malaysischer","adj","strong/mixed nominative masculine singular",2],[408407,"malaysischer","adj","strong genitive/dative feminine singular",3],[408408,"malaysischer","adj","strong genitive plural",4]],"inflections":[["malaysischer","malaysisch","masculine,nominative,singular,strong"]]},"missgelaunten":{"entries":[["missgelaunten",null,null,null]],"senses":[[519985,"missgelaunten","adj","inflection of missgelaunt:",0],[519986,"missgelaunten","adj","strong genitive masculine/neuter singular",1],[519987,"missgelaunten","adj","weak/mixed genitive/dative all-gender singular",2],[519988,"missgelaunten","adj","strong/weak/mixed accusative masculine singular",3],[519989,"missgelaunten","adj","strong dative plural",4],[519990,"missgelaunten","adj","weak/mixed all-case plural",5]],"inflections":[["missgelaunten","missgelaunt","genitive,masculine,singular,strong,without-article"]]},"nachbartischen":{"entries":[["nachbartischen",null,null,null]],"senses":[[636495,"nachbartischen","noun","dative plural of Nachbartisch",0]],"inflections":[["nachbartischen","nachbartisch","dative,definite,plural"]]},"süßlicheres":{"entries":[["süßlicheres",null,null,null]],"senses":[[315367,"süßlicheres","adj","strong/mixed nominative/accusative neuter singular comparative degree of süßlich",0]],"inflections":[["süßlicheres","süßlich","comparative,neuter,nominative,singular,strong,without-article"]]},"heißzeiten":{"inflections":[["heißzeiten","heißzeit","plural"]]},"hintanhaltest":{"inflections":[["hintanhaltest","hintanhalten","second-person,singular,subjunctive,subjunctive-i,subordinate-clause"]]},"schnelltest":{"inflections":[["sch
erman hiruz, from Proto-West Germanic *herut, from Proto-Germanic *herutaz. Cognate with Dutch hert, English hart.\nWhen the Old High German -u- was lost by syncope (in inflected forms), the fricative /s̄/ came to stand after a consonant, which regularly it never did. This anomaly was then removed by replacing /s̄/ either with /s̠/ (spelt ⟨s⟩) or with the affricate /t͡s/ (cf. Luxembourgish Hierz). In the former case, the cluster /rs̠/ was regularly shifted further to /rʃ/ (cf. Kirsche etc.).",{"g":"m","decl":"|/en|/e/en|es/s/en|e/en|e/en|en|e/en"}]],"senses":[[13208,"hirsch","noun","deer",0,"m"],[13209,"hirsch","noun","two-wheeler (e.g. bicycle, moped, motorbike)",1,"m",["humorous"]],[13210,"hirsch","noun","expert",2,"m",["informal","regional"]],[13211,"hirsch","noun","fool",3,"m",["colloquial","derogatory"]],[13212,"hirsch","name","a surname",4]],"related_forms":[[19076,"hirsch","hirschgeweih","related"],[19077,"hirsch","hirschkopf","related"],[19078,"hirsch","hirschkuh","related"],[19079,"hirsch","hirschschrei","related"],[19080,"hirsch","hirschzecke","related"],[19081,"hirsch","hirschhorn","related"]]},"misstrautet":{"entries":[["misstrautet",null,null,null]],"senses":[[347120,"misstrautet","verb","inflection of misstrauen:",0],[347121,"misstrautet","verb","second-person plural preterite",1],[347122,"misstrautet","verb","second-person plural subjunctive II",2]],"inflections":[["misstrautet","misstrauen","indicative,plural,preterite,second-person"]]},"naturgeschichtlerinnen":{"entries":[["naturgeschichtlerinnen",null,"[naˈtuːɐ̯ɡəˌʃɪçtləʁɪnən]",null]],"senses":[[696576,"naturgeschichtlerinnen","noun","plural of Naturgeschichtlerin",0,"f"]],"inflections":[["naturgeschichtlerinnen","naturgeschichtlerin","plural"]]},"nebligeren":{"entries":[["nebligeren",null,null,null]],"senses":[[157355,"nebligeren","adj","inflection of neblig:",0],[157356,"nebligeren","adj","strong genitive masculine/neuter singular comparative degree",1],[157357,"nebligeren","adj","weak/mixed geni
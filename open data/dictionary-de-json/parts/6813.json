. Alternatively—though less likely both on semantic and phonetic grounds—from Old French estoner, whence English astound, astonish. Probably not related to English stun (German stöhnen).\nThe original sense is “to become stiff, stand still”, used especially of the eyes and thus “to muse, contemplate, romanticise” (German sinnen, schwärmen, schwelgen), which is the sense in which Haller used it. Outside of Switzerland, however, the word was reinterpreted by backformation from the derivative erstaunen (“to amaze, astonish”), which had already been in general use since the 16th century.",{"g":"n","decl":"|||s|-|-|-|-"}]],"senses":[[21528,"staunen","verb","to be amazed or astonished; to wonder or marvel",0],[21529,"staunen","noun","gerund of staunen",1,"n"],[21530,"staunen","noun","astonishment, amazement",2,"n"]],"related_forms":[[32817,"staunen","erstaunen","related"],[32818,"staunen","verwunderung","related"],[32819,"staunen","überraschung","related"]]},"stäbchen":{"entries":[["stäbchen",null,"/ˈʃtɛːpçən/","Stab + -chen",{"g":"n","decl":"|||s||||"}]],"senses":[[13133,"stäbchen","noun","diminutive of Stab",0,"n"],[13134,"stäbchen","noun","rod (in the retina)",1,"n"],[13135,"stäbchen","noun","skewer (pin used to secure food during cooking)",2,"n"],[13136,"stäbchen","noun","chopstick",3,"n"]],"related_forms":[[19016,"stäbchen","essstäbchen","derived"],[19017,"stäbchen","räucherstäbchen","derived"],[19018,"stäbchen","sehstäbchen","derived"],[19019,"stäbchen","wattestäbchen","derived"]],"inflections":[["stäbchen","stab","diminutive,neuter"]]},"ternär":{"entries":[["ternär",null,"/ˌtɛʁˈnɛːɐ̯/",null]],"senses":[[364190,"ternär","adj","ternary",0]]},"töpfernd":{"entries":[["töpfernd",null,null,null]],"senses":[[87758,"töpfernd","verb","present participle of töpfern",0]],"inflections":[["töpfernd","töpfern","participle,present"]]},"unterrichtes":{"entries":[["unterrichtes",null,null,null]],"senses":[[626355,"unterrichtes","noun","genitive singular of Unterricht",0]],"inflecti
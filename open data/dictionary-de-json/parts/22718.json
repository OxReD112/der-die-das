{"format_version":1,"partition":22718,"records":{"baßes":{"entries":[["baßes",null,null,null]],"senses":[[498955,"baßes","noun","genitive of Baß",0,"m"]]},"bin":{"entries":[["bin",null,"/bɪn/","From Middle High German bin, from Old High German bim (“am”), from Proto-Germanic *biumi (first-person singular present active indicative of Proto-Germanic *beuną (“to be”)), from Proto-Indo-European *bʰew- (“to be, become, appear”). Cognate with Dutch ben (“am”), Old English bēom (“am”). More at be.\nGerman bin and Dutch ben have two sources:\n* a form based on Proto-Indo-European *h₁ésmi (“am”) like English am, Old Norse em\n* an initial b- that was added to the word under influence of verb forms based on Proto-Germanic *beuną (as in Old English beon)"]],"senses":[[3941,"bin","verb","first-person singular present of sein",0]],"inflections":[["bin","sein","first-person,indicative,present,singular"]]},"dis-":{"entries":[["dis-",null,"[dɪs-]","Learned borrowing from Latin dis-."]],"senses":[[3298,"dis-","prefix","dis-",0]]},"entscheidende":{"entries":[["entscheidende",null,null,null]],"senses":[[157031,"entscheidende","adj","inflection of entscheidend:",0],[157032,"entscheidende","adj","strong/mixed nominative/accusative feminine singular",1],[157033,"entscheidende","adj","strong nominative/accusative plural",2],[157034,"entscheidende","adj","weak nominative all-gender singular",3],[157035,"entscheidende","adj","weak accusative feminine/neuter singular",4]],"inflections":[["entscheidende","entscheidend","feminine,nominative,singular,strong,without-article"]]},"friemelten":{"entries":[["friemelten",null,null,null]],"senses":[[131877,"friemelten","verb","inflection of friemeln:",0],[131878,"friemelten","verb","first/third-person plural preterite",1],[131879,"friemelten","verb","first/third-person plural subjunctive II",2]],"inflections":[["friemelten","friemeln","first-person,indicative,plural,preterite"]]},"gehobenstes":{"entries":[["gehobenstes",null,null,null]],"senses":[[291
{"format_version":1,"partition":352,"records":{"Entwicklung":[{"record_id":714,"word":"Entwicklung","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Entwicklung","source":"tr.wiktionary","gender":["f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["zaman içinde değişme, gelişim, gelişme"],"id":"tr-Entwicklung-de-noun-IkbnHuoA","examples":[{"text":"Nach der Krise deuten jüngste Entwicklungen einen schnellen Frieden an.","bold_text_offsets":[[30,43]],"translation":"Krizin ardından son gelişmeler hızlı bir barışa işaret ediyor.","bold_translation_offsets":[[20,30]]},{"text":"„Ganztagsschulen, in denen Kinder vielfältige Lernerfahrungen sammeln, Phasen der An- und Entspannung erleben, mit ihren Mitschüler sozial interagieren können, seien eine geeignete Form, die Folgen der demografischen Entwicklung abzufedern.“","bold_text_offsets":[[217,228]],"translation":"Çocukların çeşitli öğrenme deneyimleri topladıkları, gerginlik ve gevşeme aşamaları yaşadıkları, sınıf arkadaşları ile sosyal olarak etkileşime girebildikleri tam gün süren okullar, demografik gelişimin sonuçlarını hafifletmenin uygun bir yoludur.","bold_translation_offsets":[[193,202]]},{"text":"„Entwicklung braucht das Überwinden der Verharrungstendenz. Sie braucht die Grenzsprengung, weil nur so die Handlungsspielräume und die eigenen Persönlichkeitsdimensionen erfahrbar werden.“","bold_text_offsets":[[1,12]],"translation":"Gelişim, ısrar etme eğiliminin üstesinden gelmelidir. Sınırları aşması şart, çünkü fiilin kapsamını ve kişinin kendi kişilik boyutlarını deneyimlemenin tek yolu bu.","bold_translation_offsets":[[0,7]]},{"text":"„Drachenfliegen ist heute mindestens ebenso sicher wie Segelfliegen – dank enormer technischer Entwicklungen.“","bold_text_offsets":[[95,108]],"translation":"Muazzam teknik gelişmeler sayesinde bugün delta kanatla uçma, en az plânörle uçma kadar emindir.","bold_translation_offsets":[[15,25]]}]}},{"sense_index":1,"display_status":"translation","data":{"glosses":["canlının büyüyüp gelişmesi"],"id":"tr-Entwicklung-de-noun-uHHyDv~3","raw_tags":["psikoloji","sosyoloji"],"examples":[{"text":"Die Entwicklung dieser Pflanzen erfolgt unter Optimalbedingungen sehr schnell.","bold_text_offsets":[[4,15]],"translation":"Bu bitkiler in gelişmesi, optimum şartlar altında çok hızlı olur..","bold_translation_offsets":[[15,24]]},{"text":"Die Entwicklung des Sprachkonzepts erfolgt bei Kleinkindern im frühen Alter.","bold_text_offsets":[[4,15]],"translation":"Dil kavramının gelişmesi, küçük çocuklarda erken yaşta olur.","bold_translation_offsets":[[15,24]]}]},"labels":[[0,0,["biology"]]]},{"sense_index":2,"display_status":"translation","data":{"glosses":["developman"],"id":"tr-Entwicklung-de-noun-4dVdUNJC","examples":[{"text":"Nach der Entwicklung eines Farbnegativfilms sind die Bildinhalte darauf zu erkennen, aber die Farben invertiert.","bold_text_offsets":[[9,20]],"translation":"Renkli bir negatif film geliştirdikten sonra görüntü içeriği üzerinde görülebilirse de renkler tersine döner.","bold_translation_offsets":[[24,38]]}]},"labels":[[0,0,["photography"]]]},{"sense_index":3,"display_status":"translation","data":{"glosses":["geliştirme"],"id":"tr-Entwicklung-de-noun-G0xazwar","raw_tags":["teknik"],"examples":[{"text":"Die Entwicklung des Prototypen ging sehr schnell.","bold_text_offsets":[[4,15]],"translation":"Prototipin geliştirilmesi çok hızlı ilerledi.","bold_translation_offsets":[[11,25]]},{"text":"„Mit der Entwicklung des Offsetdrucks, bei dem ein Gummituchzylinder das Druckbild von der Form auf das Papier überträgt, wurde diese Technologie auch für den Hochdruck entdeckt.“","bold_text_offsets":[[9,20]],"translation":"Ofset baskının gelişmesiyle birlikte kauçuk bez silindirinin baskı görüntüsünü formdan kâğıda aktarmasıyla bu teknoloji, tipo baskı için de keşfedildi.","bold_translation_offsets":[[15,27]]},{"text":"„Fünf Leute aus Toms Team trafen sich mit ihm, um Organisatorisches für die Entwicklung nötiger Software zu besprechen.“","bold_text_offsets":[[76,87]],"translation":"Tom'un ekibinden beş kişi, gerekli yazılımın geliştirilmesi için organizasyonla ilgili konuları tartışmak üzere onunla bir araya geldi.","bold_translation_offsets":[[45,59]]}]},"labels":[[0,0,["technology","engineering","computing"]]]}]}],"Komparatist":[{"record_id":915,"word":"Komparatist","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Komparatist","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["karşılaştırmacı"],"id":"tr-Komparatist-de-noun-SYnKx~EV"},"labels":[[0,0,["linguistics"]]]},{"sense_index":1,"display_status":"translation","data":{"glosses":["karşılaştımalı edebiyat bilimcisi"],"id":"tr-Komparatist-de-noun-SGkE1Bja"},"labels":[[0,0,["linguistics"]]]}]}],"sprachlich":[{"record_id":1291,"word":"sprachlich","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/sprachlich","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["dilsel"],"id":"tr-sprachlich-de-adj-JQasJJ9d"},"labels":[[0,0,["linguistics"]]]}]}],"Pilz":[{"record_id":1813,"word":"Pilz","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Pilz","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["mantar"],"id":"tr-Pilz-de-noun-ykuaDfMQ","raw_tags":["mantarlar"]}}]}],"Vortag":[{"record_id":2979,"word":"Vortag","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Vortag","source":"tr.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["dün"],"id":"tr-Vortag-de-noun-eLAnSXDM"}}]}],"Diabetes":[{"record_id":3181,"word":"Diabetes","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Diabetes","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["diyabet, şeker hastalığı"],"id":"tr-Diabetes-de-noun-nO8bKbdq"},"labels":[[0,0,["medicine"]]]}]}],"Schooner":[{"record
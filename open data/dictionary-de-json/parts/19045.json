{"format_version":1,"partition":19045,"records":{"allmächtig":{"entries":[["allmächtig",null,"/ʔalˈmɛçtɪç/","From Middle High German almehtec, from Old High German almahtīg, alamahtīg, from Proto-West Germanic *alamahtīg, from Proto-Germanic *alamahtīgaz. Equivalent to all (“all”) + -mächtig (“mighty”). Synchronically also analyzable as Allmacht (“omnipotence”) + -ig, although Allmacht in fact represents a back-formation from the adjective. Cognates include Dutch almachtig, English almighty, and Old Norse almáttigr (whence Icelandic and Faroese almáttugur)."]],"senses":[[26361,"allmächtig","adj","omnipotent, all-powerful, almighty",0]]},"am ende des tages":{"entries":[["am ende des tages",null,null,"Calque of English at the end of the day."]],"senses":[[605996,"am ende des tages","adv","at the end of the day",0,null,["colloquial"]]]},"anschuldigens":{"entries":[["anschuldigens",null,null,null]],"senses":[[499476,"anschuldigens","noun","genitive of Anschuldigen",0,"n"]],"inflections":[["anschuldigens","anschuldigen","genitive"]]},"antithetischem":{"entries":[["antithetischem",null,null,null]],"senses":[[279083,"antithetischem","adj","strong dative masculine/neuter singular of antithetisch",0]],"inflections":[["antithetischem","antithetisch","dative,masculine,singular,strong,without-article"]]},"asexuelleres":{"entries":[["asexuelleres",null,null,null]],"senses":[[453751,"asexuelleres","adj","strong/mixed nominative/accusative neuter singular comparative degree of asexuell",0]],"inflections":[["asexuelleres","asexuell","comparative,neuter,nominative,singular,strong,without-article"]]},"bekomme mit":{"entries":[["bekomme mit",null,null,null]],"senses":[[273943,"bekomme mit","verb","inflection of mitbekommen:",0],[273944,"bekomme mit","verb","first-person singular present",1],[273945,"bekomme mit","verb","first/third-person singular subjunctive I",2],[273946,"bekomme mit","verb","singular imperative",3]]},"biografie":{"entries":[["biografie",null,"/bioɡʁaˈfiː/",null,{"g
{"format_version":1,"partition":703,"records":{"Archaismus":[{"record_id":542,"word":"Archaismus","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Archaismus","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["eskil biçim"],"id":"tr-Archaismus-de-noun-m8RKWvdp"},"labels":[[0,0,["linguistics"]]]}]}],"Apfel":[{"record_id":1553,"word":"Apfel","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Apfel","source":"tr.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["elma"],"id":"tr-Apfel-de-noun-04qcPqAO","raw_tags":["gülgiller","meyveler"],"examples":[{"text":"Der Apfel ist eine Obstart.","bold_text_offsets":[[4,9]],"translation":"Elma bir meyve çeşitidir.","bold_translation_offsets":[[0,4]]},{"text":"„Danach ging es [das Mädchen] weiter und kam zu einem Baum, der hing voll Äpfel und rief ihm zu: ‚Ach, schüttel mich, schüttel mich, wir Äpfel sind alle miteinander reif.‘ “","bold_text_offsets":[[74,79],[137,142]],"translation":"„Ondan sonra [kız] devam etti ve ona ‚Ah salla beni, salla beni, biz elmalar hep olgunlaştık‘ diye haykıran bir ağacın yanına geldi.“","bold_translation_offsets":[[69,76]]}]}},{"sense_index":1,"display_status":"translation","data":{"glosses":["elma ağacı"],"id":"tr-Apfel-de-noun-eeiO2MkY","raw_tags":["ağaçlar","gülgiller"],"examples":[{"text":"Im Garten habe ich mehrere Äpfel stehen.","bold_text_offsets":[[27,32]],"translation":"Bahçede birkaç elma ağacım var.","bold_translation_offsets":[[15,26]]}]}},{"sense_index":2,"display_status":"translation","data":{"glosses":["kadının göğüsleri"],"id":"tr-Apfel-de-noun-3-wQud~H","examples":[{"text":"Als sie dreizehn war, konnte man von","translation":"On üç yaşına geldiğinde göğüsler görünmeye başladı.","bold_translation_offsets":[[24,32]],"ref":"Äpfeln"},{"text":"„Er streichelte die prallen Äpfel, drückte sie und wünschte sich, wenigstens einmal seine Lippen auf die steifen Knospen senken zu können, die sich so unverschämt gut anfühlten.“","bold_text_offsets":[[28,33]],"translation":"„O, dolgun göğüsleri okşadı, sıktı ve aşırı güzel olarak hissettiği o sert goncalara hiç olmazsa bir kere dudaklarını koymayı içinden geçirdi.“","bold_translation_offsets":[[11,16]]}]},"labels":[[0,0,["literature"]]]},{"sense_index":3,"display_status":"reference","data":{"glosses":["Pferdeapfel kavramının kısaltması"],"id":"tr-Apfel-de-noun-ii83X683","tags":["abbreviation","form-of","rare"],"form_of":[{"word":"Pferdeapfel"}],"examples":[{"text":"Grüne, weiche Pferdeäpfel stammen von Tieren, die sich von frischer, grüner Nahrung ernähren, während gelb-hellbraune Äpfel von Tieren stammen, die mit Stroh, Heu und Hafer gefüttert werden.","bold_text_offsets":[[118,123]],"translation":"Yeşil, yumuşak at gübreleri, taze ve yeşil gıdayla beslenen hayvanlardan gelirken sarı-açık kahverengi gübreler saman, kuru ot ve yulafla beslenilen hayvanlardandır.","bold_translation_offsets":[[18,26],[103,111]]},{"text":"Meine 7-jährige Stute frisst seit kurzem ihre eigenen Äpfel und die von anderen Pferden, die sie bekommen kann.","bold_text_offsets":[[54,59]],"translation":"Yedi yaşındaki dişi atım, kısa zamandan beri kendi ve başka atlardan bulabildiği gübreyi yiyor.","bold_translation_offsets":[[81,86]]},{"text":"„Sobald das Pferd ein paar Äpfel fallen ließ, sprang eine aparte Deutsche herbei, die an der Empfangstheke auf einem Drehstuhl saß, und schaufelte den Mist in die Wanne.“","bold_text_offsets":[[27,32]],"translation":"„At birkaç gübre düşürür düşürmez giriş tezgâhı arkasında döner sandalyede hususî olarak oturan bir Alman bayan koşarak gelir ve gübreyi bir küvete kürüklerdi.“","bold_translation_offsets":[[11,16],[129,134]]},{"text":"„Damals gab es ja noch viele Pferdefuhrwerke und die Pferde hinterließen Äpfel.“","bold_text_offsets":[[73,78]],"translation":"„O zamanlar birçok at arabası vardı ve atlar gübre bırakırdı.“","bold_translation_offsets":[[45,50]]},{"text":"„Darauf kam auch der Mist der Pferde, die ihre Äpfel gelegentlich auf der Straße fallen ließen und vor allem der Schafsmist, der die Straße übersäte, wenn der Schäfer seine Herde auf die Wiesen trieb, die das Altersheim umgaben.“","bold_text_offsets":[[47,52]],"translation":"„Bunun üzerine gübrelerini ara sıra sokağa düşürüp her tarafa dağılan atların ve çoban, huzur evinin etrafındaki otlaklara sürüsünü sürerken dökülen koyun gübreleri de geldi.“","bold_translation_offsets":[[15,20],[155,160]]},{"text":"„Offenbar kennt er dieses Phänomen, denn mit einer geübten Armbewegung setzt er die Schaufel an und versenkt Lottes Äpfel im Rhein.“","bold_text_offsets":[[116,121]],"translation":"„Bu fenomeni bildiği bariz şekilde ortadaydı, çünkü tecrübeli bir kol hareketiyle küreği eline alıp Lotte'nin gübresini Ren nehrine attı.“","bold_translation_offsets":[[110,119]]}]}}]}],"Suriname":[{"record_id":1976,"word":"Suriname","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Suriname","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Surinam"],"id":"tr-Suriname-de-name-qg4f7V2Y"},"name_like":["other",""]}]}],"nützen":[{"record_id":4753,"word":"nützen","pos":"verb","source_url":"https://tr.wiktionary.org/wiki/n%C3%BCtzen","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["yaramak"],"id":"tr-nützen-de-verb-romdIRDc"}}]}],"Ökosystem":[{"record_id":4875,"word":"Ökosystem","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/%C3%96kosystem","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["ekosistem"],"id":"tr-Ökosystem-de-noun-8rH-4xMh"}}]}],"zeigen":[{"record_id":4959,"word":"zeigen","pos":"verb","source_url":"https://tr.wiktionary.org/wiki/zeigen","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["göstermek"],"id":"tr-zeigen-de-verb-2O7RIZKE"}}]}],"Kaukasien":[{"record_id":61
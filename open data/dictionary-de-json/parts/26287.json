t forms hub, gehaben were retained until Early Modern German. The verb was then shifted to the class 2 past forms of fliegen etc. (Compare Dutch heffen and Middle English heven, which were also shifted, though to classes 7 and 4/5 respectively.)",{"g":"n","decl":"|||s|-|-|-|-"},"haben"]],"senses":[[11725,"heben","verb","to lift; to raise",0,null,null,null,"transitive"],[11726,"heben","verb","to heave; to hoist",1,null,null,null,"transitive"],[11727,"heben","verb","to rise; to lift",2,null,null,"acc"],[11728,"heben","noun","gerund of heben",3,"n"]],"related_forms":[[15740,"heben","abheben","derived"],[15741,"heben","anheben","derived"],[15742,"heben","aufheben","derived"],[15743,"heben","ausheben","derived"],[15744,"heben","beheben","derived"],[15745,"heben","darunterheben","derived"],[15746,"heben","draufheben","derived"],[15747,"heben","drüberheben","derived"],[15748,"heben","drunterheben","derived"],[15749,"heben","einheben","derived"],[15750,"heben","emporheben","derived"],[15751,"heben","entheben","derived"],[15752,"heben","erheben","derived"],[15753,"heben","gewichtheben","derived"],[15754,"heben","hebebühne","derived"],[15755,"heben","heben","derived"],[15756,"heben","heraufheben","derived"],[15757,"heben","herausheben","derived"],[15758,"heben","hereinheben","derived"],[15759,"heben","herüberheben","derived"],[15760,"heben","herunterheben","derived"],[15761,"heben","hervorheben","derived"],[15762,"heben","hinaufheben","derived"],[15763,"heben","hinausheben","derived"],[15764,"heben","hineinheben","derived"],[15765,"heben","hinüberheben","derived"],[15766,"heben","hinunterheben","derived"],[15767,"heben","hinwegheben","derived"],[15768,"heben","hochheben","derived"],[15769,"heben","raufheben","derived"],[15770,"heben","rausheben","derived"],[15771,"heben","reinheben","derived"],[15772,"heben","rüberheben","derived"],[15773,"heben","runterheben","derived"],[15774,"heben","überheben","derived"],[15775,"heben","umheben","derived"],[15776,"heben","unterheben","der
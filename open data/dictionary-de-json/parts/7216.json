manic *hangijaną (“to hang”, transitive).\nBecause of various interferences in the inflected forms, due to grammatischer Wechsel, umlaut and Rückumlaut, these three verbs were bound to be intermingled. Verbs 1 and 2 were merged in such a way that the present stem hang- was combined with the strong past forms of hāhen. This development is first attested in the north and seems to have spread from Middle Low German hangen to Central German dialects of Middle High German (14th century). The transitive verb 3 (hängen) was kept separate into the 20th century, at least by prescription, but the present stem is now häng- for all uses. The split is upheld in the past forms, but is not consistently followed outside of formal contexts.\nCognate to Dutch hangen, English hang.",{"g":"n","decl":"|||s|-|-|-|-"}]],"senses":[[21020,"hängen","verb","to hang, to be suspended",0],[21021,"hängen","verb","to be attached to; to be fond of; to be devoted to; to cling to",1,null,["figuratively"]],[21022,"hängen","verb","to depend",2,null,["informal","figuratively"]],[21023,"hängen","verb","to hang, to suspend",3,null,["colloquial"]],[21024,"hängen","verb","to hang, to execute by hanging",4],[21025,"hängen","verb","to hang on to; to follow",5,null,["figuratively"]],[21026,"hängen","noun","gerund of hängen",6,"n"],[21027,"hängen","noun","dative plural of Hang",7,"m"]],"related_forms":[[31762,"hängen","hänger","derived"],[31763,"hängen","hängen","related"],[31764,"hängen","abhängen","related"],[31765,"hängen","durchhängen","related"],[31766,"hängen","festhängen","related"],[31767,"hängen","nachhängen","related"],[31768,"hängen","herumhängen","related"],[31769,"hängen","rumhängen","related"],[31770,"hängen","zusammenhängen","related"],[31771,"hängen","behängen","derived"],[31772,"hängen","erhängen","derived"],[31773,"hängen","verhängen","derived"],[31774,"hängen","hängend","related"],[31775,"hängen","anhängen","related"],[31776,"hängen","aufhängen","related"],[31777,"hängen","heraushängen","related"],[31778,"hängen","herabhängen","related"],[31779,"hängen","hängenbleiben","related"],[31780,"hängen","hängenlassen","related"]],"inflections":[["hängen","hang","dative,definite,plural"]]},"hörenswertestem":{"entries":[["hörenswertestem",null,null,null]],"senses":[[407224,"hörenswertestem","adj","strong dative masculine/neuter singular superlative degree of hörenswert",0]],"inflections":[["hörenswertestem","hörenswert","dative,masculine,singular,strong,superlative,without-article"]]},"klapprige":{"entries":[["klapprige",null,null,null]],"senses":[[250662,"klapprige","adj","inflection of klapprig:",0],[250663,"klapprige","adj","strong/mixed nominative/accusative feminine singular",1],[250664,"klapprige","adj","strong nominative/accusative plural",2],[250665,"klapprige","adj","weak nominative all-gender singular",3],[250666,"klapprige","adj","weak accusative feminine/neuter singular",4]],"inflections":[["klapprige","klapprig","feminine,nominative,singular,strong,without-article"]]},"linoleum":{"entries":[["linoleum",null,"/liˈnoːleʊm/",null,{"g":"n","decl":"|||s|-|-|-|-"}]],"senses":[[622429,"linoleum","noun","linoleum",0,"n"]]},"lost place":{"entries":[["lost place",null,null,"Pseudo-anglicism, derived from lost + place.",{"w":"Lost Place","g":"m","decl":"|||s|s|s|s|s"}]],"senses":[[719776,"lost place","noun","abandoned building",0,"m",["colloquial"]]]},"marktvolumen":{"entries":[["marktvolumen",null,"[ˈmaʁktvoˌluːmən]","Markt (“market”) + Volumen (“volume”)",{"g":"n","decl":"|||s||||"}]],"senses":[[719057,"marktvolumen","noun","market volume (the total actual sales or turnover of all suppliers in a specific market within a defined period)",0,"n"]]},"mühevollen":{"entries":[["mühevollen",null,null,null]],"senses":[[232180,"mühevollen","adj","inflection of mühevoll:",0],[232181,"mühevollen","adj","strong genitive masculine/neuter singular",1],[232182,"mühevollen","adj","weak/mixed genitive/dative all-gender singular",2],[232183,"mühevollen","adj","strong/weak/mixe
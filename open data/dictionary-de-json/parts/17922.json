{"format_version":1,"partition":17922,"records":{"buche":{"entries":[["buche",null,"/ˈbuːxə/","From Middle High German buoche, from Old High German buohha, from Proto-West Germanic *bōku and *bōkijā (both “beech”). The first West Germanic form corresponds to Old English bōc, Old Frisian bōk, the second to Old English bēċe (English beech), Dutch beuk, Luxembourgish Bich. The Standard German form can continue either variant, in the first case regularly, in the second with Upper German umlaut hindrance before velar (cf. suchen).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[16355,"buche","noun","a beech (Fagus); the common tree",0,"f"],[16356,"buche","noun","beech; the wood of the tree",1,"f"],[16357,"buche","noun","dative singular of Buch",2,"n",["archaic"]],[16358,"buche","verb","inflection of buchen:",3],[16359,"buche","verb","first-person singular present",4],[16360,"buche","verb","first/third-person singular subjunctive I",5],[16361,"buche","verb","singular imperative",6]],"related_forms":[[24191,"buche","buchecker","derived"],[24192,"buche","buchenforst","derived"],[24193,"buche","buchenhain","derived"],[24194,"buche","buchenholz","derived"],[24195,"buche","buchenlaub","derived"],[24196,"buche","buchenscheit","derived"],[24197,"buche","buch","related"]],"inflections":[["buche","buch","dative,singular"],["buche","buchen","first-person,indicative,present,singular"]]},"langlebigem":{"entries":[["langlebigem",null,null,null]],"senses":[[175055,"langlebigem","adj","strong dative masculine/neuter singular of langlebig",0]],"inflections":[["langlebigem","langlebig","dative,masculine,singular,strong,without-article"]]},"leichters":{"entries":[["leichters",null,null,null]],"senses":[[205304,"leichters","noun","genitive singular of Leichter",0]],"inflections":[["leichters","leichter","genitive"]]},"sephardischen":{"entries":[["sephardischen",null,null,null]],"senses":[[549635,"sephardischen","adj","inflection of sephardisch:",0],[549636,"sephardischen","adj","strong genitiv
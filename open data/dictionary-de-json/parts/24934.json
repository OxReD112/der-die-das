{"format_version":1,"partition":24934,"records":{"augenblick":{"entries":[["augenblick",null,"/ˈaʊɡənblɪk/","From Middle High German ougenblic (12th c. as “glance, look”, ca. 1300 in temporal use). By surface analysis, Auge (“eye”) + -n- + Blick (“glance”). Compare Yiddish אויגנבליק (oygnblik), Luxembourgish Abléck, Dutch ogenblik, Middle Low German ôgenblick (whence Danish øjeblik etc.). Semantically cf. also English blink of an eye.",{"g":"m","decl":"||/e|s/es|e|e|en|e"}]],"senses":[[26686,"augenblick","noun","moment, instant, blink of an eye (very short period of time)",0,"m"],[26687,"augenblick","intj","one second!, one moment!",1]]},"naturvölkern":{"entries":[["naturvölkern",null,null,null]],"senses":[[210012,"naturvölkern","noun","dative plural of Naturvolk",0,"n"]]},"nehmen heraus":{"entries":[["nehmen heraus",null,null,null]],"senses":[[492940,"nehmen heraus","verb","inflection of herausnehmen:",0],[492941,"nehmen heraus","verb","first/third-person plural present",1],[492942,"nehmen heraus","verb","first/third-person plural subjunctive I",2]]},"offenkettiger":{"entries":[["offenkettiger",null,null,null]],"senses":[[220228,"offenkettiger","adj","inflection of offenkettig:",0],[220229,"offenkettiger","adj","strong/mixed nominative masculine singular",1],[220230,"offenkettiger","adj","strong genitive/dative feminine singular",2],[220231,"offenkettiger","adj","strong genitive plural",3]],"inflections":[["offenkettiger","offenkettig","masculine,nominative,singular,strong"]]},"paurisch":{"entries":[["paurisch",null,"/ˈpaʊ̯ʁɪʃ/","From Paur, the dialect's form of Bauer, + -isch."]],"senses":[[590665,"paurisch","name","the East Central German dialect of Gablonz and the surrounding Izera mountains",0]]},"physiognomie":{"entries":[["physiognomie",null,null,null,{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[30835,"physiognomie","noun","physiognomy",0,"f"]]},"solidarisieren":{"entries":[["solidarisieren",null,null,"From French solidariser + -ieren.",null,"haben"]],"senses"
{"format_version":1,"partition":1783,"records":{"abend":{"entries":[["abend",null,"/ˈaːbənt/","From Middle High German ābent, from Old High German āband, from Proto-West Germanic *ābanþ, from Proto-Germanic *ēbanþs, possibly from Proto-Indo-European *epi (“after, behind”) → “last part of the day.\"\nCompare Low German Avend, Dutch avond, English even (evening), Old Norse aptann, Swedish afton, Norwegian and Danish aften. Compare English eve.",{"g":"m","decl":"|||s|e|e|en|e"}]],"senses":[[2420,"abend","adv","Formerly standard spelling of Abend which was deprecated in the spelling reform (Rechtschreibreform) of 1996.",0,null,["archaic"]],[2421,"abend","noun","evening; the time from dusk until midnight",1,"m"],[2422,"abend","noun","The west",2,"m",["archaic"]]]},"abgebremst":{"entries":[["abgebremst",null,null,null]],"senses":[[201849,"abgebremst","verb","past participle of abbremsen - slowed down, decelerated",0]],"inflections":[["abgebremst","abbremsen","participle,past"]]},"abwasseranlagen":{"entries":[["abwasseranlagen",null,null,null]],"senses":[[277117,"abwasseranlagen","noun","plural of Abwasseranlage",0,"f"]],"inflections":[["abwasseranlagen","abwasseranlage","plural"]]},"alttürkisch":{"entries":[["alttürkisch",null,"/altˈtyːʁkɪʃ/","From alt- + türkisch."]],"senses":[[419236,"alttürkisch","adj","Old Turkic",0]]},"antiklopfmittels":{"entries":[["antiklopfmittels",null,null,null]],"senses":[[201911,"antiklopfmittels","noun","genitive singular of Antiklopfmittel",0]],"inflections":[["antiklopfmittels","antiklopfmittel","genitive"]]},"arbiträrer":{"entries":[["arbiträrer",null,null,null]],"senses":[[329575,"arbiträrer","adj","inflection of arbiträr:",0],[329576,"arbiträrer","adj","strong/mixed nominative masculine singular",1],[329577,"arbiträrer","adj","strong genitive/dative feminine singular",2],[329578,"arbiträrer","adj","strong genitive plural",3]],"inflections":[["arbiträrer","arbiträr","masculine,nominative,singular,strong"]]},"arnsbergerin":{"entries":[["ar
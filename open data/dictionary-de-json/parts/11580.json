{"entries":[["wiel",null,"/viːl/","Possibly from Middle High German *wihel, ultimately from Proto-West Germanic *hwehwl, from Proto-Germanic *hwehwlą (“wheel”). In the sense “bundle of rope” through Middle Low German wêl. The sense “whirlpool” may be from Low German too, but it has also been attested in southern sources (the very first being notably from Nuremberg in the 15th century). Therefore inheritance through Old High German *wihil cannot be ruled out. Otherwise the word is only inherited in High German in the compounds Wielstein and Wielesche.",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[240290,"wiel","noun","vortex, whirl, whirlpool",0,"f",["obsolete"]],[240291,"wiel","noun","round bundle of old rope used to protect the sides of a ship",1,"f",["obsolete"],null,null,null,["nautical"]]]},"zusammenbrechen":{"entries":[["zusammenbrechen",null,"[tsuˈzamənˌbʁɛçn̩]","From zusammen- + brechen.",{"g":"n","decl":"|||s|-|-|-|-"},"sein"]],"senses":[[45169,"zusammenbrechen","verb","to break down, collapse",0],[45170,"zusammenbrechen","noun","gerund of zusammenbrechen",1,"n"]]},"abnickten":{"inflections":[["abnickten","abnicken","first-person,indicative,plural,preterite,subordinate-clause"]]},"absandelet":{"inflections":[["absandelet","absandeln","plural,second-person,subjunctive,subjunctive-i,subordinate-clause"]]},"bereiterklärst":{"inflections":[["bereiterklärst","bereiterklären","indicative,present,second-person,singular,subordinate-clause"]]},"erschwindelns":{"inflections":[["erschwindelns","erschwindeln","genitive"]]},"hintermeiers":{"inflections":[["hintermeiers","hintermeier","genitive,masculine"]]},"kerbten":{"inflections":[["kerbten","kerben","first-person,indicative,plural,preterite"]]},"pickigsten":{"inflections":[["pickigsten","pickig","genitive,masculine,singular,strong,superlative,without-article"]]},"renderten":{"inflections":[["renderten","rendern","first-person,indicative,plural,preterite"]]}}}
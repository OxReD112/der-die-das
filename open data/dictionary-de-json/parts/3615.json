ate tēmulentus (“drunk”)) is from Proto-Indo-European *tem- (“dazed, numbed”).\nIt is not related to Dame, despite popular folk etymology."]],"senses":[[41783,"dämlich","adj","very stupid",0]]},"ehrwürdigerem":{"entries":[["ehrwürdigerem",null,null,null]],"senses":[[466944,"ehrwürdigerem","adj","strong dative masculine/neuter singular comparative degree of ehrwürdig",0]],"inflections":[["ehrwürdigerem","ehrwürdig","comparative,dative,masculine,singular,strong,without-article"]]},"emporhöbt":{"entries":[["emporhöbt",null,null,null]],"senses":[[663727,"emporhöbt","verb","second-person plural dependent subjunctive II of emporheben",0]],"inflections":[["emporhöbt","emporheben","formal,plural,rare,second-person,subjunctive,subjunctive-ii,subordinate-clause"]]},"erhielte aufrecht":{"entries":[["erhielte aufrecht",null,null,null]],"senses":[[490503,"erhielte aufrecht","verb","first/third-person singular subjunctive II of aufrechterhalten",0]]},"fischartigste":{"entries":[["fischartigste",null,null,null]],"senses":[[349224,"fischartigste","adj","inflection of fischartig:",0],[349225,"fischartigste","adj","strong/mixed nominative/accusative feminine singular superlative degree",1],[349226,"fischartigste","adj","strong nominative/accusative plural superlative degree",2],[349227,"fischartigste","adj","weak nominative all-gender singular superlative degree",3],[349228,"fischartigste","adj","weak accusative feminine/neuter singular superlative degree",4]],"inflections":[["fischartigste","fischartig","feminine,nominative,singular,strong,superlative,without-article"]]},"frühindikator":{"entries":[["frühindikator",null,"[ˈfʁyːʔɪndiˌkaːtoːɐ̯]","From früh + Indikator.",{"g":"m","decl":"|||s|en|en|en|en"}]],"senses":[[706378,"frühindikator","noun","early indicator",0,"m"]]},"furchtlosere":{"entries":[["furchtlosere",null,null,null]],"senses":[[290702,"furchtlosere","adj","inflection of furchtlos:",0],[290703,"furchtlosere","adj","strong/mixed nominative/accusative feminine singular co
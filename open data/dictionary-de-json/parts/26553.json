{"format_version":1,"partition":26553,"records":{"ausreißen":{"entries":[["ausreißen",null,"/ˈʔaʊ̯sʁaɪ̯sn̩/","From Middle High German ūzrīzen, from Old High German ūzrīzan. Equivalent to aus- + reißen.\n(to run away): Compare typologically Russian удира́ть (udirátʹ), да́ть дёру (dátʹ djóru) (akin to драть (dratʹ)); also compare рвану́ть (rvanútʹ), сорва́ться (sorvátʹsja) (akin to рвать (rvatʹ)), ломану́ть (lomanútʹ), ломану́ться (lomanútʹsja) (akin to ломи́ть (lomítʹ)).",{"g":"n","decl":"|||s|-|-|-|-"},"both"]],"senses":[[26158,"ausreißen","verb","to tear out",0,null,null,null,"transitive"],[26159,"ausreißen","verb","to run away, to get away (to flee an enclosure, home, control with a leash, etc.; especially of animals and children)",1,null,null,null,"intransitive"],[26160,"ausreißen","noun","gerund of ausreißen",2,"n"]],"related_forms":[[35876,"ausreißen","ausreißen","derived"],[35877,"ausreißen","ausreißer","derived"],[35878,"ausreißen","ausreißung","derived"],[35879,"ausreißen","abreißen","related"],[35880,"ausreißen","anreißen","related"],[35881,"ausreißen","durchreißen","related"],[35882,"ausreißen","verreißen","related"]]},"befangenere":{"entries":[["befangenere",null,null,null]],"senses":[[451761,"befangenere","adj","inflection of befangen:",0],[451762,"befangenere","adj","strong/mixed nominative/accusative feminine singular comparative degree",1],[451763,"befangenere","adj","strong nominative/accusative plural comparative degree",2],[451764,"befangenere","adj","weak nominative all-gender singular comparative degree",3],[451765,"befangenere","adj","weak accusative feminine/neuter singular comparative degree",4]],"inflections":[["befangenere","befangen","comparative,feminine,nominative,singular,strong,without-article"]]},"fettarme":{"entries":[["fettarme",null,null,null]],"senses":[[260708,"fettarme","adj","inflection of fettarm:",0],[260709,"fettarme","adj","strong/mixed nominative/accusative feminine singular",1],[260710,"fettarme","adj","strong nominative/a
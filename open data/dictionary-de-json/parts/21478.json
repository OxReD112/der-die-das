{"format_version":1,"partition":21478,"records":{"aschener":{"entries":[["aschener",null,null,null]],"senses":[[428204,"aschener","adj","inflection of aschen:",0],[428205,"aschener","adj","strong/mixed nominative masculine singular",1],[428206,"aschener","adj","strong genitive/dative feminine singular",2],[428207,"aschener","adj","strong genitive plural",3]],"inflections":[["aschener","aschen","masculine,nominative,singular,strong"]]},"flansch":{"entries":[["flansch",null,"/flanʃ/","According to Kluge, Pfeifer and Duden, from Middle High German vlansch (“corner, end”), with possible relations to Flunsch (“pout, pouty mouth”) and to flennen (“to cry noisily, snivel”).\nHowever, the likely descendant of the inherited term seems to show very little usage in New High German, and with the sense having shifted towartds \"torn bit, strip of meat\". The modern meaning of \"flange\" appears fairly suddenly in the first half of the 19th century specifically in engineering. This sense, or any close to it, is markedly absent in Grimm's dictionary despite being contemperaneous. The closeness in sense and form could alternatively suggest a borrowing from English flange, flanch.",{"g":"m","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[592204,"flansch","noun","flange (projecting edge at the end of component (esp. of metal) to fasten to or anchor with other parts, now especially of pipes)",0,"m"]],"inflections":[["flansch","flanschen","imperative,second-person,singular"]]},"kriminologie":{"entries":[["kriminologie",null,null,"kriminell + -logie",{"g":"f","decl":"||||-|-|-|-"}]],"senses":[[100180,"kriminologie","noun","criminology",0,"f"]]},"lärchen-art":{"entries":[["lärchen-art",null,"[ˈlɛʁçn̩ˌʔaːɐ̯t]",null,{"w":"Lärchen-Art","g":"f","decl":"||||en|en|en|en"}]],"senses":[[716060,"lärchen-art","noun","alternative spelling of Lärchenart (“larch species”)",0,"f"]],"inflections":[["lärchen-art","lärchenart","alternative"]]},"ostentativere":{"entries":[["ostentativere",null,null,null]],"sens
ion_offsets":[[28,33]]}]}},{"sense_index":2,"display_status":"translation","data":{"glosses":["bir şeyi bilhassa dikkatli veya yoğun kullanmak"],"id":"tr-Kult-de-noun-WTk2ZDmy","examples":[{"text":"Er treibt einen wahren Kult mit seinem Boot.","bold_text_offsets":[[23,27]],"translation":"Botuyla âdetâ hakiki bir kült yaşıyor.","bold_translation_offsets":[[25,29]]}]}}]}],"Gitarre":[{"record_id":7046,"word":"Gitarre","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Gitarre","source":"tr.wiktionary","gender":["f"],"senses":[{"sense_index":0,"display_status":"reference","data":{"glosses":["gitar"],"id":"tr-Gitarre-de-noun-tw98J7Gr"}}]},{"record_id":1003331,"word":"Gitarre","pos":"noun","source_url":"https://de.wiktionary.org/wiki/Gitarre","source":"de.wiktionary","gender":["f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["gitar"],"id":"de-Gitarre-noun-1","sense_number":"1","definition_de":"ein populäres Zupfinstrument mit vier bis zwölf Saiten"}}]}],"anzuführen":[{"record_id":7658,"word":"anzuführen","pos":"verb","source_url":"https://tr.wiktionary.org/wiki/anzuf%C3%BChren","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"form-description","data":{"glosses":["anführen eyleminin “zu” mastarı"],"id":"tr-anzuführen-de-verb-bE4TqbqS"}}]}],"Roboters":[{"record_id":8039,"word":"Roboters","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Roboters","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"form-description","data":{"glosses":["Roboter sözcüğünün tamlayan tekil çekimi"],"id":"tr-Roboters-de-noun-U3fdljTK","tags":["form-of"],"form_of":[{"word":"Roboter"}]}}]}],"Rummenigge":[{"record_id":8769,"word":"Rummenigge","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Rummenigge","source":"tr.wiktionary","gender":["m","f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Bir soyadı."],"id":"tr-Rummenigge-de-name-twAi7g4e"},"name_like":["person","soyadı /
n later times by the Italian term's dissemination in the wake of the Godfather trilogy has not been substantiated. Doublet of Korporal and (obsolete) Kapo (“military commander”).",{"g":"m:f","decl":"|||s/|s|s|s|s","alt":[["m","|||s|s|s|s|s"],["f","||||-|-|-|-"],["m","|||s|-|-|-|-"]]}]],"senses":[[62354,"kapo","noun","corporal, non-commissioned officer",0,"m",["slang"]],[62355,"kapo","noun","foreman",1,"m",["Austria","Southern-Germany"]],[62356,"kapo","noun","kapo, prisoner functionary (a prisoner of a Nazi concentration camp who was given food and privileges in return for supervising other prisoners doing forced labor)",2,"m",["slang","historical"]],[62357,"kapo","noun","Cantonal police",3,"f",["Switzerland"]],[62358,"kapo","noun","leader, military commander",4,"m",["obsolete"]]]},"knebeln":{"entries":[["knebeln",null,"/ˈkneːbəln/","17th century, derived from Knebel, from Middle High German knebel, from Old High German knebil. The word originally meant a stick used to tighten a tie or to bind something to, later also the tie itself. Dutch knevelen shows the same semantic development, being used chiefly for “to gag”, but also in the broader sense “to tie up”."]],"senses":[[604384,"knebeln","verb","to gag (tie a piece of cloth around someone’s mouth to prevent them from shouting)",0],[604385,"knebeln","verb","to hog-tie (tie up someone’s arms and legs to prevent them from moving)",1,null,["uncommon","~not fully standard"]],[604386,"knebeln","verb","to hog-tie; to render helpless; to oppress; to enslave",2,null,["figuratively"]]],"related_forms":[[60185,"knebeln","knebelvertrag","derived"],[60186,"knebeln","knebel","related"]],"inflections":[["knebeln","knebel","dative,definite,plural"]]},"kunsthalle":{"entries":[["kunsthalle",null,"/ˈkʊnstˌhalə/","From Kunst (“art”) + Halle (“hall”).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[356728,"kunsthalle","noun","kunsthalle (facility that holds temporary art exhibitions)",0,"f"]]},"leidsamste":{"entries":[["leidsamste",null,n
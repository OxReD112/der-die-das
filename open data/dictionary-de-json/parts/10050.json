{"format_version":1,"partition":10050,"records":{"e-book":{"entries":[["e-book",null,"/ˈiːbʊk/","Unadapted borrowing from English e-book.",{"w":"E-Book","g":"n","decl":"|||s/|s|s|s|s"}]],"senses":[[31961,"e-book","noun","e-book",0,"n"],[31962,"e-book","noun","e-reader",1,"n",["uncommon"]]]},"erbfeind":{"entries":[["erbfeind",null,"/ˈɛrpˌfaɪ̯nt/","From Middle High German erbevīnt (“the Devil as the hereditary enemy of mankind”). Equivalent to Erbe (“inheritance, heritage”) + Feind (“enemy”).\nSince the 15th century used of the Turks (seen as infidel and followers of the Devil). Then generalised to any long-standing enmity without religious context. The new narrowing to the French is an influence of 19th-century nationalism, which resented France for the Napeolonic invasions and for its general opposition to German national unity. This narrowing was never absolute, however, and the word continued to be used in other contexts.",{"g":"m","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[390445,"erbfeind","noun","A historical enemy, hereditary (inherited) or sworn enemy believed to be hostile for generations (male or of unspecified gender)",0,"m"],[390446,"erbfeind","noun","the Devil",1,"m",["dated"]]],"related_forms":[[57003,"erbfeind","erbfeindin","derived"],[57004,"erbfeind","erbfeindlich","derived"],[57005,"erbfeind","erbfeindlichkeit","derived"],[57006,"erbfeind","erbfeindschaft","derived"],[57007,"erbfeind","erzfeind","related"],[57008,"erbfeind","erzfeindin","related"],[57009,"erbfeind","todfeind","related"],[57010,"erbfeind","todfeindin","related"]]},"flehest":{"entries":[["flehest",null,null,null]],"senses":[[79796,"flehest","verb","second-person singular subjunctive I of flehen",0]],"inflections":[["flehest","flehen","second-person,singular,subjunctive,subjunctive-i"]]},"gesondertes":{"entries":[["gesondertes",null,null,null]],"senses":[[196663,"gesondertes","adj","strong/mixed nominative/accusative neuter singular of gesondert",0]],"inflections":[["gesondertes","geson
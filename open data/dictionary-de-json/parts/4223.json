{"format_version":1,"partition":4223,"records":{"biotope":{"entries":[["biotope",null,null,null]],"senses":[[60061,"biotope","noun","nominative/accusative/genitive plural of Biotop",0]],"inflections":[["biotope","biotop","plural"]]},"brunnen":{"entries":[["brunnen",null,"/ˈbʁʊnən/","From Middle High German brunne, from Old High German brunno, from Proto-West Germanic *brunnō, from Proto-Germanic *brunnô, whence also Old English burna, Old Norse brunnr; ultimately from Proto-Indo-European *bʰrun- (“a bubbling forth; a fountain, wellspring, source”).\nThe form is Upper German, most Low and Central German dialects using Born (now poetic in the standard language). This southern origin also explains the vocalism; the expected form is Bronnen with -u- → -o- before a nasal geminate.",{"g":"m","decl":"|||s||||"}]],"senses":[[18058,"brunnen","noun","well",0,"m"]]},"desavouierten":{"entries":[["desavouierten",null,null,null]],"senses":[[126637,"desavouierten","verb","inflection of desavouieren:",0],[126638,"desavouierten","verb","first/third-person plural preterite",1],[126639,"desavouierten","verb","first/third-person plural subjunctive II",2]],"inflections":[["desavouierten","desavouieren","first-person,indicative,plural,preterite"]]},"entlehntem":{"entries":[["entlehntem",null,null,null]],"senses":[[360710,"entlehntem","adj","strong dative masculine/neuter singular of entlehnt",0]],"inflections":[["entlehntem","entlehnt","dative,masculine,singular,strong,without-article"]]},"epischerer":{"entries":[["epischerer",null,null,null]],"senses":[[287431,"epischerer","adj","inflection of episch:",0],[287432,"epischerer","adj","strong/mixed nominative masculine singular comparative degree",1],[287433,"epischerer","adj","strong genitive/dative feminine singular comparative degree",2],[287434,"epischerer","adj","strong genitive plural comparative degree",3]],"inflections":[["epischerer","episch","comparative,masculine,nominative,singular,strong,without-article"]]},"freunde in der not gehen hundert auf ein lot":{"entries":[["freunde in der not gehen hundert auf ein lot",null,"/ˈfʁɔʏ̯ndə ˌɪn dɛɐ̯ ˈnoːt ˌɡeːən ˈhʊndɐt ˌaʊ̯f aɪ̯n ˈloːt/","Literally, “friends in need are a hundred in a lot”, meaning that a friend in need weighs 1% of a Lot (English “lot”), which is a historic measure of weight equivalent to half an ounce. One could thus loosely translate: “Friends in need are weighed in milligrams.” There are two possible interpretations: Either (a) that one’s friends become “lightweight”, i.e. unreliable, when one is in need, or (b) that true friends in need are so rare that they need to be weighed in infinitesimal quantities."]],"senses":[[682493,"freunde in der not gehen hundert auf ein lot","proverb","a friend in need is a friend indeed",0]]},"getreideexporte":{"entries":[["getreideexporte",null,"[ɡəˈtʁaɪ̯dəʔɛksˌpɔʁtə]",null]],"senses":[[681966,"getreideexporte","noun","nominative/accusative/genitive plural of Getreideexport",0]],"inflections":[["getreideexporte","getreideexport","plural"]]},"kleinkinde":{"entries":[["kleinkinde",null,null,null]],"senses":[[501970,"kleinkinde","noun","dative singular of Kleinkind",0,"n"]],"inflections":[["kleinkinde","kleinkind","dative,singular"]]},"kognitiven":{"entries":[["kognitiven",null,null,null]],"senses":[[670189,"kognitiven","adj","inflection of kognitiv:",0],[670190,"kognitiven","adj","strong genitive masculine/neuter singular",1],[670191,"kognitiven","adj","weak/mixed genitive/dative all-gender singular",2],[670192,"kognitiven","adj","strong/weak/mixed accusative masculine singular",3],[670193,"kognitiven","adj","strong dative plural",4],[670194,"kognitiven","adj","weak/mixed all-case plural",5]],"inflections":[["kognitiven","kognitiv","genitive,masculine,singular,strong,without-article"]]},"pluralischer":{"entries":[["pluralischer",null,null,null]],"senses":[[532470,"pluralischer","adj","inflection of pluralisch:",0],[532471,"pluralischer","adj","strong/mixed nominative masculine singular",1],[53247
{"format_version":1,"partition":28787,"records":{"aristotelismus":{"entries":[["aristotelismus",null,"/aʁɪstoteˈlɪsmʊs/","Aristoteles (“Aristotle”) + -ismus (“-ism”)",{"g":"m","decl":"||||-|-|-|-"}]],"senses":[[55272,"aristotelismus","noun","Aristotelianism (philosophical system)",0,"m"]]},"entwischen":{"entries":[["entwischen",null,null,"From Middle High German entwischen, from Old High German intwisken. Traditionally considered to be a compound of ent- (“away from”) + wischen (“to wipe, scrub”). However, the second component is considered by Cheung to be derived from a different root, Proto-Indo-European *wyedʰ- (“to shoot, take aim, hit, wound”), with Sanskrit व्यध् (vyadh, “to pierce, hit”) and Old Armenian վէրք (vērkʻ, “wound”) as potential cognates.",null,"sein"]],"senses":[[123441,"entwischen","verb","to escape",0]]},"existenzrecht":{"entries":[["existenzrecht",null,"/ɛksɪsˈtɛntsʁɛçt/","Compound of Existenz + Recht.",{"g":"n","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[713257,"existenzrecht","noun","right to exist",0,"n"]]},"heiraten":{"entries":[["heiraten",null,"/ˈhaɪ̯ˌraːtən/","From Middle High German hīrāten, which is derived from Middle High German hīrāt (“marriage”), whence German Heirat (“marriage”).",{"g":"n","decl":"|||s|-|-|-|-"},"haben"]],"senses":[[35779,"heiraten","verb","to marry; to get married",0,null,null,null,"intransitive"],[35780,"heiraten","verb","to marry someone; to take someone as one's spouse",1,null,null,null,"transitive"],[35781,"heiraten","noun","gerund of heiraten",2,"n"],[35782,"heiraten","noun","plural of Heirat",3,"f"]],"related_forms":[[41831,"heiraten","einheiraten","derived"],[41832,"heiraten","erheiraten","derived"],[41833,"heiraten","hineinheiraten","derived"],[41834,"heiraten","verheiraten","derived"],[41835,"heiraten","wegheiraten","derived"],[41836,"heiraten","heirat","related"]],"inflections":[["heiraten","heirat","plural"]]},"kuboktaeders":{"entries":[["kuboktaeders",null,null,null]],"senses":[[364140,"kuboktaeders","no
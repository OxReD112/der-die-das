{"format_version":1,"partition":1493,"records":{"-it":{"entries":[["-it",null,"/ˈiːt/","From Latin -īta, -ītēs, from Ancient Greek -ῑ́της (-ī́tēs). Though not originally related, both ancient and modern uses of this ending often reflect the Semitic nisba suffix (whence also German -i as in Iraki, Israeli)."]],"senses":[[33420,"-it","suffix","-ite (used to form names of certain peoples, followers or descendants of a person, etc.)",0],[33421,"-it","suffix","-ite (used to form names of minerals and some rocks and fossils)",1],[33422,"-it","suffix","-ite (used to form names of salts and esters of acids whose name ends in -ous)",2]]},"-verdächtig":{"entries":[["-verdächtig",null,"/fɛɐ̯ˈdɛçtɪç/","From adjective verdächtig."]],"senses":[[145019,"-verdächtig","suffix","Used to form adjectives from nouns, the adjectives having the sense of \"a person or thing can expect to get the thing described the noun\".",0],[145020,"-verdächtig","suffix","Used to form adjectives from nouns, the adjectives having the sense of \"the thing described the noun can be expected from a person or thing\".",1]]},"abgekämpftestes":{"entries":[["abgekämpftestes",null,null,null]],"senses":[[443541,"abgekämpftestes","adj","strong/mixed nominative/accusative neuter singular superlative degree of abgekämpft",0]],"inflections":[["abgekämpftestes","abgekämpft","neuter,nominative,singular,strong,superlative,without-article"]]},"ahornblättrige":{"entries":[["ahornblättrige",null,null,null]],"senses":[[261376,"ahornblättrige","adj","inflection of ahornblättrig:",0],[261377,"ahornblättrige","adj","strong/mixed nominative/accusative feminine singular",1],[261378,"ahornblättrige","adj","strong nominative/accusative plural",2],[261379,"ahornblättrige","adj","weak nominative all-gender singular",3],[261380,"ahornblättrige","adj","weak accusative feminine/neuter singular",4]],"inflections":[["ahornblättrige","ahornblättrig","feminine,nominative,singular,strong,without-article"]]},"anstößiger":{"entries":[["anstöß
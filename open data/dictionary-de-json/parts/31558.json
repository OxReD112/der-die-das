{"format_version":1,"partition":31558,"records":{"bieder":{"entries":[["bieder",null,"/ˈbiːdɐ/","From Middle High German biderbe (also bederbe and shortened bider), from Old High German biderbi, piderpi, pidarpi, cognate with Bedarf.\nThe derogatory sense arises in the 19th century. The compound Biedermann in origin means \"brave, honest or capable man\", but today has a meaning of \"boring person, petty bourgeios\"."]],"senses":[[39031,"bieder","adj","honest, respectable, trustworthy",0,null,["dated"]],[39032,"bieder","adj","naive, simple-minded, guileless (sticking simple-mindedly to society's norms)",1,null,["derogatory"]],[39033,"bieder","adj","narrow-minded, bourgeois, petit bourgeois (sticking narrow-mindedly to society's norms, with the intent on being respectable)",2,null,["derogatory"]],[39034,"bieder","adj","conventional, conservative, drab, stodgy, prude",3]],"related_forms":[[43482,"bieder","anbiedern","derived"],[43483,"bieder","biederheit","derived"],[43484,"bieder","biederherz","derived"],[43485,"bieder","biederkeit","derived"],[43486,"bieder","biedermann","derived"],[43487,"bieder","biedermeier","derived"],[43488,"bieder","biedermeierstil","derived"],[43489,"bieder","biedermeierzeit","derived"],[43490,"bieder","biedersinn","derived"],[43491,"bieder","biederweib","derived"],[43492,"bieder","bedarf","related"],[43493,"bieder","bedürfen","related"]]},"gegenangriff":{"entries":[["gegenangriff",null,"/ˈɡeːɡn̩ˌʔanɡʁɪf/","From gegen- (“counter-”) + Angriff (“attack”).",{"g":"m","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[683912,"gegenangriff","noun","counterattack; counteroffensive",0,"m",null,null,null,null,["military"]]]},"hellenisches":{"entries":[["hellenisches",null,null,null]],"senses":[[442916,"hellenisches","adj","strong/mixed nominative/accusative neuter singular of hellenisch",0]],"inflections":[["hellenisches","hellenisch","neuter,nominative,singular,strong,without-article"]]},"minuziösesten":{"entries":[["minuziösesten",null,null,null]],"senses":[
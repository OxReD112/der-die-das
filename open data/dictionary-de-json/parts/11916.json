{"format_version":1,"partition":11916,"records":{"daube":{"entries":[["daube",null,"/ˈdaʊ̯bə/","From Middle High German dūge (13th c.), from Latin duga, doga, from Ancient Greek δοχή (dokhḗ). Cognate with Dutch duig. The form with -b- appears in the 15th century. It may have been influenced by Old French dove, from the same source. However, such influence is not certain. Intervocalic -b- and -g- are pronounced as fricatives or even approximants [β~ʋ], [ɣ~j] in many, chiefly Central German, dialects, which explains sporadic developments -g- → -b- after back rounded vowels.",{"g":"f","decl":"||||n|n|n|n","alt":[["f","||||n|n|n|n"],["f",""]]}]],"senses":[[535033,"daube","noun","stave (of a barrel)",0,"f"],[535034,"daube","noun","obsolete form of Taube (“dove”)",1,"f",["obsolete"]],[535035,"daube","noun","daube (French stew)",2,"f",["rare"]]]},"frohsinnigere":{"entries":[["frohsinnigere",null,null,null]],"senses":[[371522,"frohsinnigere","adj","inflection of frohsinnig:",0],[371523,"frohsinnigere","adj","strong/mixed nominative/accusative feminine singular comparative degree",1],[371524,"frohsinnigere","adj","strong nominative/accusative plural comparative degree",2],[371525,"frohsinnigere","adj","weak nominative all-gender singular comparative degree",3],[371526,"frohsinnigere","adj","weak accusative feminine/neuter singular comparative degree",4]],"inflections":[["frohsinnigere","frohsinnig","comparative,feminine,nominative,singular,strong,without-article"]]},"frühneuhochdeutsches":{"entries":[["frühneuhochdeutsches",null,null,null]],"senses":[[336147,"frühneuhochdeutsches","adj","strong/mixed nominative/accusative neuter singular of frühneuhochdeutsch",0]],"inflections":[["frühneuhochdeutsches","frühneuhochdeutsch","neuter,nominative,singular,strong,without-article"]]},"integrativem":{"entries":[["integrativem",null,null,null]],"senses":[[477730,"integrativem","adj","strong dative masculine/neuter singular of integrativ",0]],"inflections":[["integrativem","integrativ
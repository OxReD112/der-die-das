{"format_version":1,"partition":5368,"records":{"bequem":{"entries":[["bequem",null,"/bəˈkveːm/","From Middle High German bequæme, bekōme (“suitable”), from Old High German biquāmi, derived from biqueman (whence German bekommen). The word seems originally to have been more common in Central and Low German; therefore possibly reinforced by cognate Middle Low German bequēme. The consonantism -qu-, which generally remained more stable in the north than it did in Upper German, may also point to that. Further cognate with Dutch bekwaam, English queem, queme, Swedish bekväm."]],"senses":[[34330,"bequem","adj","comfortable, convenient",0],[34331,"bequem","adj","relaxed, easy (avoiding difficulties, effort, work)",1],[34332,"bequem","adj","suitable, fit",2,null,["archaic"]]],"related_forms":[[41142,"bequem","bequemlichkeit","related"],[41143,"bequem","bequemlich","related"]],"inflections":[["bequem","bequemen","imperative,second-person,singular"]]},"bukolischstem":{"entries":[["bukolischstem",null,null,null]],"senses":[[458834,"bukolischstem","adj","strong dative masculine/neuter singular superlative degree of bukolisch",0]],"inflections":[["bukolischstem","bukolisch","dative,masculine,singular,strong,superlative,without-article"]]},"cliffhangern":{"entries":[["cliffhangern",null,null,null]],"senses":[[593840,"cliffhangern","noun","dative plural of Cliffhanger",0]],"inflections":[["cliffhangern","cliffhanger","dative,definite,plural"]]},"ethischeres":{"entries":[["ethischeres",null,null,null]],"senses":[[405906,"ethischeres","adj","strong/mixed nominative/accusative neuter singular comparative degree of ethisch",0]],"inflections":[["ethischeres","ethisch","comparative,neuter,nominative,singular,strong,without-article"]]},"faszikel":{"entries":[["faszikel",null,"[fasˈt͡siːkl̩]","From Latin fasciculus (“small bundle, packet”).",{"g":"m","decl":"|||s|||n|"}]],"senses":[[375934,"faszikel","noun","bundle of papers, fascicle",0,"m"],[375935,"faszikel","noun","manuscript papers",1
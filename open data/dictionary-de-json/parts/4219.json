{"format_version":1,"partition":4219,"records":{"beschönigenden":{"entries":[["beschönigenden",null,null,null]],"senses":[[404543,"beschönigenden","adj","inflection of beschönigend:",0],[404544,"beschönigenden","adj","strong genitive masculine/neuter singular",1],[404545,"beschönigenden","adj","weak/mixed genitive/dative all-gender singular",2],[404546,"beschönigenden","adj","strong/weak/mixed accusative masculine singular",3],[404547,"beschönigenden","adj","strong dative plural",4],[404548,"beschönigenden","adj","weak/mixed all-case plural",5]],"inflections":[["beschönigenden","beschönigend","genitive,masculine,singular,strong,without-article"]]},"erfinders":{"entries":[["erfinders",null,null,null]],"senses":[[168461,"erfinders","noun","genitive singular of Erfinder",0]],"inflections":[["erfinders","erfinder","genitive"]]},"kaminsimses":{"entries":[["kaminsimses",null,null,null]],"senses":[[627614,"kaminsimses","noun","genitive of Kaminsims",0]],"inflections":[["kaminsimses","kaminsims","genitive"]]},"ladungsausgleiche":{"entries":[["ladungsausgleiche",null,null,null]],"senses":[[339918,"ladungsausgleiche","noun","nominative/accusative/genitive plural of Ladungsausgleich",0,"m"]],"inflections":[["ladungsausgleiche","ladungsausgleich","plural"]]},"letzte":{"entries":[["letzte",null,"/ˈlɛt͡stə/","From Middle High German lest, a contraction of lezzest, from Old High German lezzist (also lazzōst), itself superlative of laz (cognate to English late). The modern German form with -tz- is of northern origin; two separate origins have probably met in it: Firstly, there is a general tendency in some Central German dialects of inserting -t- before comparative and superlative endings. (Compare for this, for example, Ripuarian fröh → fröhter, fröhtste). Secondly, Middle Low German lest, contracted superlative of lat (“late”), had a regular or regularized variant letst, which is very rare in writing, but may have been more common in spoken dialects. (Compare modern German Low German lättst.) Related forms are Dutch laatst and lest, English latest and last, Luxembourgish lescht, Hunsrik letst.",{"g":"f","decl":"||r/n|r/n|/n|/n|n|r/n"}]],"senses":[[145490,"letzte","adj","last",0],[145491,"letzte","noun","female equivalent of Letzter: the last woman or girl",1,"f"],[145492,"letzte","noun","inflection of Letzter:",2,"m"],[145493,"letzte","noun","strong nominative/accusative plural",3,"f"],[145494,"letzte","noun","weak nominative singular",4,"f"]],"inflections":[["letzte","letzen","past"],["letzte","letzter","nominative,plural,strong"]]},"privilegiertest":{"entries":[["privilegiertest",null,null,null]],"senses":[[78139,"privilegiertest","verb","inflection of privilegieren:",0],[78140,"privilegiertest","verb","second-person singular preterite",1],[78141,"privilegiertest","verb","second-person singular subjunctive II",2]],"inflections":[["privilegiertest","privilegieren","indicative,preterite,second-person,singular"]]},"schadenfroher":{"entries":[["schadenfroher",null,null,null]],"senses":[[660813,"schadenfroher","adj","inflection of schadenfroh:",0],[660814,"schadenfroher","adj","strong/mixed nominative masculine singular",1],[660815,"schadenfroher","adj","strong genitive/dative feminine singular",2],[660816,"schadenfroher","adj","strong genitive plural",3]],"inflections":[["schadenfroher","schadenfroh","masculine,nominative,singular,strong"]]},"stabileres":{"entries":[["stabileres",null,null,null]],"senses":[[187245,"stabileres","adj","strong/mixed nominative/accusative neuter singular comparative degree of stabil",0]],"inflections":[["stabileres","stabil","comparative,neuter,nominative,singular,strong,without-article"]]},"verbleibendem":{"entries":[["verbleibendem",null,null,null]],"senses":[[221808,"verbleibendem","adj","strong dative masculine/neuter singular of verbleibend",0]],"inflections":[["verbleibendem","verbleibend","dative,masculine,singular,strong,without-article"]]},"verlachet":{"entries":[["verlachet",null,null,null]],"senses":[[655285,"verlachet","verb","second-person plural subjunctive I of verlachen",0]],"inflections":[["verlachet","verlachen","plural,second-person,subjunctive,subjunctive-i"]]},"wohlhabendere":{"entries":[["wohlhabendere",null,null,null]],"senses":[[326152,"wohlhabendere","adj","inflection of wohlhabend:",0],[326153,"wohlhabendere","adj","strong/mixed nominative/accusative feminine singular comparative degree",1],[326154,"wohlhabendere","adj","strong nominative/accusative plural comparative degree",2],[326155,"wohlhabendere","adj","weak nominative all-gender singular comparative degree",3],[326156,"wohlhabendere","adj","weak accusative feminine/neuter singular comparative degree",4]],"inflections":[["wohlhabendere","wohlhabend","comparative,feminine,nominative,singular,strong,without-article"]]},"zeese":{"entries":[["zeese",null,"/ˈtseːzə/","First attested in 1640. Probably deverbal (with East Central German vocalism) from Middle High German zeisen (“to pluck, pull apart”), from Old High German zeisan, *zeisen, from Proto-West Germanic *taisan, *taisijan (related with English tease).\nThe lack of an according Low German form *Teese is somewhat surprising. Therefore one might alternatively consider derivation from Low German seisen, zeisen (“to tie up”), itself from English seize; but this verb is attested too late to be a plausible etymon (cf. Dutch seizen since 1657).",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[718565,"zeese","noun","a kind of traditional dragnet used along the German Baltic coast",0,"f",null,null,null,null,["fishing","nautical"]],[718566,"zeese","noun","ellipsis of Zeesenboot or Zeesenkahn (“a boat used for fishing with such a net”)",1,"f",null,null,null,null,["fishing","nautical"]]],"related_forms":[[65718,"zeese","zeesenboot","derived"],[65719,"zeese","zeesenfischer","derived"],[65720,"zeese","zeesenkahn","derived"]]},"auscheckte":{"inflections":[["auscheckte","auschecken","first-person,indicative,preterite,singular,subordinate-clause"]]},"glaubenss
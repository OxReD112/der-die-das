{"format_version":1,"partition":104,"records":{"antihypertensivum":{"entries":[["antihypertensivum",null,null,"anti- + hypertensiv + -us (in its neuter form)",{"g":"n","decl":"|||s|2a|2a|2a|2a"}]],"senses":[[675591,"antihypertensivum","noun","antihypertensive, blood pressure medication",0,"n"]]},"anwendungsentwicklung":{"entries":[["anwendungsentwicklung",null,null,"Anwendung + -s- + Entwicklung",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[676902,"anwendungsentwicklung","noun","application development",0,"f"]]},"auf großem fuß leben":{"entries":[["auf großem fuß leben",null,"/aʊ̯f ˈɡʁoːsəm ˈfuːs ˌleːbən/","Literally, “to live on a big foot”. Compare French vivre sur un grand pied, of which it may be a calque; further also Dutch op grote voet leven, Danish leve på en stor fod, etc. First attested in German in the 17th century. It derives from “foot” in the sense of “basis, foundation” and thus “way, manner”, here referring to expenditures. Compare auf gutem Fuß stehen (“be on good terms”), Kriegsfuß (“state of war or conflict”).\nAn incorrect folk etymology derives it from the long, pointed crackow shoes worn by aristocrats in the 14th and 15th centuries, with the longest points worn by the most noble individuals."]],"senses":[[52822,"auf großem fuß leben","verb","to have an expensive life-style, to live the high life",0,null,["idiomatic"]]]},"bad liebensteinerin":{"entries":[["bad liebensteinerin",null,"[baːt ˈliːbn̩ˌʃtaɪnəʁɪn]","From Bad Liebensteiner + -in",{"w":"Bad Liebensteinerin","g":"f","decl":"||||nen|nen|nen|nen"}]],"senses":[[706731,"bad liebensteinerin","noun","A female person from Bad Liebenstein or of Bad Liebenstein descent",0,"f"]]},"befleckbarster":{"entries":[["befleckbarster",null,null,null]],"senses":[[404095,"befleckbarster","adj","inflection of befleckbar:",0],[404096,"befleckbarster","adj","strong/mixed nominative masculine singular superlative degree",1],[404097,"befleckbarster","adj","strong genitive/dative feminine singular superlative d
{"format_version":1,"partition":15023,"records":{"elfenbein":{"entries":[["elfenbein",null,"/ˈɛl.fənˌbaɪ̯n/","From Middle High German elfenbein, from Old High German elfantbein, from Proto-West Germanic *elpandabain. Equivalent to Elefant + Bein. The loss of initial h- in early modern German was due to the influence of Latin elephās. Since the 19th century the word has been remotivated, somewhat meaningfully (with regard to the pure white colour of ivory), as Elfe (“elf”) + Bein (“bone”).",{"g":"n","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[15404,"elfenbein","noun","ivory (material)",0,"n"]]},"entwürdigtet":{"entries":[["entwürdigtet",null,null,null]],"senses":[[495004,"entwürdigtet","verb","inflection of entwürdigen:",0],[495005,"entwürdigtet","verb","second-person plural preterite",1],[495006,"entwürdigtet","verb","second-person plural subjunctive II",2]],"inflections":[["entwürdigtet","entwürdigen","indicative,plural,preterite,second-person"]]},"gewalttätigeres":{"entries":[["gewalttätigeres",null,null,null]],"senses":[[292724,"gewalttätigeres","adj","strong/mixed nominative/accusative neuter singular comparative degree of gewalttätig",0]],"inflections":[["gewalttätigeres","gewalttätig","comparative,neuter,nominative,singular,strong,without-article"]]},"inderinnen":{"entries":[["inderinnen",null,null,null]],"senses":[[63687,"inderinnen","noun","plural of Inderin",0]],"inflections":[["inderinnen","inderin","plural"]]},"jesuitischstem":{"entries":[["jesuitischstem",null,null,null]],"senses":[[498463,"jesuitischstem","adj","strong dative masculine/neuter singular superlative degree of jesuitisch",0]],"inflections":[["jesuitischstem","jesuitisch","dative,masculine,singular,strong,superlative,without-article"]]},"maßstabsgerechte":{"entries":[["maßstabsgerechte",null,null,null]],"senses":[[402889,"maßstabsgerechte","adj","inflection of maßstabsgerecht:",0],[402890,"maßstabsgerechte","adj","strong/mixed nominative/accusative feminine singular",1],[402891,"maßstabsgerech
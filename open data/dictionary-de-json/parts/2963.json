{"format_version":1,"partition":2963,"records":{"aller":{"entries":[["aller",null,"/ˈalɐ/","From Old High German Alara, from earlier Elera and Alera, of uncertain origin:.\n* From Proto-Germanic *alizō (“alder”) + *ahwō (“water”), meaning \"alder water\".\n* From the Proto-Indo-European root *h₁ey- common in many other river names, such as the Allia in Latium, Alaunus in some Celtic sites, and the Ille in Brittany. See also French aller (“to go”), German eilen (“to hasten, hurry”), Swedish ila. More at Aller."]],"senses":[[6299,"aller","adj","inflection of all:",0],[6300,"aller","adj","strong/mixed nominative masculine singular",1],[6301,"aller","adj","strong genitive/dative feminine singular",2],[6302,"aller","adj","strong genitive plural",3],[6303,"aller","name","a river in Germany",4]],"inflections":[["aller","all","masculine,nominative,singular"]]},"bliebe übrig":{"entries":[["bliebe übrig",null,null,null]],"senses":[[274536,"bliebe übrig","verb","first/third-person singular subjunctive II of übrigbleiben",0]]},"bretternes":{"entries":[["bretternes",null,null,null]],"senses":[[430070,"bretternes","adj","strong/mixed nominative/accusative neuter singular of brettern",0]],"inflections":[["bretternes","brettern","neuter,nominative,singular,strong,without-article"]]},"erregbarem":{"entries":[["erregbarem",null,null,null]],"senses":[[204618,"erregbarem","adj","strong dative masculine/neuter singular of erregbar",0]],"inflections":[["erregbarem","erregbar","dative,masculine,singular,strong,without-article"]]},"herrgottswinkel":{"entries":[["herrgottswinkel",null,"/ˈhɛʁɡɔt͡sˌvɪŋkl̩/","From Herrgott + -s- + Winkel.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[628350,"herrgottswinkel","noun","A place in Christian houses decorated with a crucifix that is often located in a corner of the room opposite the stove.",0,"m",["Switzerland","Austria","Southern-Germany"]]]},"imperfektiv":{"entries":[["imperfektiv",null,"/ˈɪmpɛʁfɛktiːf/","im- + perfektiv or Imperfekt + -iv"]],"senses
{"format_version":1,"partition":15882,"records":{"-erweise":{"entries":[["-erweise",null,"/ɐˌvaɪ̯zə/","From the genitive feminine singular adjective ending -er and the feminine noun Weise. This was originally an adverbial genitive first used in Middle High German. For example, lustiger Weise → lustig + -erweise → lustigerweise. Adverbs formed this way represent univerbations of genitive absolute adjective-noun phrases."]],"senses":[[371387,"-erweise","suffix","Used to form adverbs from adjectives and participles; these adverbs are used to modify phrases or sentences. Cognate with English -wise.",0]]},"abgestürzt":{"entries":[["abgestürzt",null,null,null]],"senses":[[83468,"abgestürzt","verb","past participle of abstürzen",0]],"inflections":[["abgestürzt","abstürzen","participle,past"]]},"beglaubigen":{"entries":[["beglaubigen",null,"[bəˈɡlaʊ̯bɪɡn̩]","From be- + Glaube + -ig + -en.",{"g":"n","decl":"|||s|-|-|-|-"},"haben"]],"senses":[[592607,"beglaubigen","verb","to authenticate",0],[592608,"beglaubigen","verb","to accredit",1],[592609,"beglaubigen","noun","gerund of beglaubigen",2,"n"]],"related_forms":[[59169,"beglaubigen","beglaubigen","derived"],[59170,"beglaubigen","beglaubiger","derived"],[59171,"beglaubigen","beglaubigung","derived"],[59172,"beglaubigen","beglaubigend","derived"],[59173,"beglaubigen","beglaubigt","derived"]]},"durchblätterte":{"entries":[["durchblätterte",null,null,null]],"senses":[[655718,"durchblätterte","verb","inflection of durchblättern:",0],[655719,"durchblätterte","verb","first/third-person singular dependent preterite",1],[655720,"durchblätterte","verb","first/third-person singular dependent subjunctive II",2]],"inflections":[["durchblätterte","durchblättern","first-person,indicative,preterite,singular,subordinate-clause"]]},"ehrwürdig":{"entries":[["ehrwürdig",null,"/ˈeːɐ̯ˌvʏʁdɪç/","Ehre + -würdig"]],"senses":[[420584,"ehrwürdig","adj","venerable, reverend",0]]},"gratin":{"entries":[["gratin",null,"/ɡʁaˈtɛ̃ː/","Borrowed from French gr
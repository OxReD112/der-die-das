,63]],"translation":"В кладовой к потолку привешены были окорока, чтоб не портили мыши, сыры, головы сахару, провесная рыба, мешки с сушёными грибами, купленными у чухонца орехами.","bold_translation_offsets":[[61,65]],"ref":"И. А. Гончаров, «Обломов» / перевод Clara Brauner, 1859 г. [НКРЯ]"}]}},{"sense_index":1,"display_status":"translation","data":{"glosses":["комп. мышь, мышка"],"id":"ru-Maus-de-noun-sd4uDno5"}}]}],"Panzerschrank":[{"record_id":7113,"word":"Panzerschrank","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Panzerschrank","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["сейф"],"id":"ru-Panzerschrank-de-noun-BqFDXB6R"}}]}],"Mystiker":[{"record_id":7537,"word":"Mystiker","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Mystiker","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["мистик"],"id":"ru-Mystiker-de-noun-82KDQWLN"}}]}],"Semicha":[{"record_id":9168,"word":"Semicha","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Semicha","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["семиха (у евреев — посвящение в раввины)"],"id":"ru-Semicha-de-noun-3LHT4c5h","raw_tags":["еврейск."]}}]}],"Pik":[{"record_id":9203,"word":"Pik","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Pik","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["пик, остроконечная вершина (горы)"],"id":"ru-Pik-de-noun-G1Uh6zHn"}}]},{"record_id":9204,"word":"Pik","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Pik","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["разг. затаённая вражда"],"id":"ru-Pik-de-noun-oZT7BXKz","examples":[{"text":"einen Pik auf jemanden haben","translation":"иметь зуб на кого-либо"}]}}]},{"record_id":9205,"word":"Pik","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Pik","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["карт. пик, пики"],"id":"ru-P
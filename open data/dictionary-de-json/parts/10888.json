nominative,singular,strong,without-article"]]},"sintflut":{"entries":[["sintflut",null,"/ˈzɪn(t)ˌfluːt/","From Middle High German sinvluot, sintvluot, from Old High German sinfluot, sintfluot, from sin- (“great, eternal”, prefix) + fluot (“flood”), whence modern German Flut. The variant Sündflut is due to association with Sünde (“sin”), as also in cognate Dutch zondvloed. The i-form was almost fully obsolete for 200 years, until it was revived in the early 19th century after the scientific study of Middle High German. During the 20th century, it re-established itself in general use.",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[81695,"sintflut","noun","Deluge, the Great Flood.",0,"f",null,null,null,null,["religion"]],[81696,"sintflut","noun","deluge (heavy rain)",1,"f",["figuratively"]],[81697,"sintflut","noun","deluge (a great or overwhelming flood of anything, abstract or material)",2,"f",["figuratively"]]],"related_forms":[[49266,"sintflut","nach mir die sintflut","derived"],[49267,"sintflut","sintflutartig","derived"],[49268,"sintflut","vorsintflutlich","derived"]]},"standesbewusst":{"entries":[["standesbewusst",null,"/ˈʃtandəsbəˌvʊst/","Stand + bewusst"]],"senses":[[553387,"standesbewusst","adj","in accordance with social status",0]]},"steuerreform":{"entries":[["steuerreform",null,null,"Steuer + Reform",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[340085,"steuerreform","noun","tax reform",0,"f"]]},"eingespeichelt":{"inflections":[["eingespeichelt","einspeicheln","participle,past"]]},"mindestzeiten":{"inflections":[["mindestzeiten","mindestzeit","plural"]]},"osaft":{"inflections":[["osaft","o-saft","alternative"]]},"schaltknüppels":{"inflections":[["schaltknüppels","schaltknüppel","genitive"]]},"verdreizehnfachst":{"inflections":[["verdreizehnfachst","verdreizehnfachen","indicative,present,second-person,singular"]]},"virussen":{"inflections":[["virussen","virus","dative,definite,nonstandard,plural"]]}}}
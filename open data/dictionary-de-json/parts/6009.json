{"format_version":1,"partition":6009,"records":{"-keit":{"entries":[["-keit",null,"/kaɪ̯t/","Rebracketing of two suffixes in Upper German dialects of Middle High German: -ec (modern -ig) and -heit: -ec-heit was interpreted as -e-keit. Later this phenomenon spread to other suffixes, and even to Central German dialects, in which the equivalents of -ig had never been pronounced with a final [k]-sound. (Compare the modern German Standard German pronunciation of -ig [-ɪç].) However, in some northern dialects of Central German, like Ripuarian, -keit is still absent or has only recently been introduced from standard German. Compare Saterland Frisian -igaid."]],"senses":[[5910,"-keit","suffix","alternative form of -heit",0]],"inflections":[["-keit","-heit","alternative"]]},"assessoren":{"entries":[["assessoren",null,null,null]],"senses":[[649333,"assessoren","noun","nominative/genitive/dative/accusative plural of Assessor",0]],"inflections":[["assessoren","assessor","plural"]]},"aufgehenden":{"entries":[["aufgehenden",null,null,null]],"senses":[[645707,"aufgehenden","verb","inflection of aufgehend:",0],[645708,"aufgehenden","verb","strong genitive masculine/neuter singular",1],[645709,"aufgehenden","verb","weak/mixed genitive/dative all-gender singular",2],[645710,"aufgehenden","verb","strong/weak/mixed accusative masculine singular",3],[645711,"aufgehenden","verb","strong dative plural",4],[645712,"aufgehenden","verb","weak/mixed all-case plural",5]],"inflections":[["aufgehenden","aufgehend","genitive,masculine,singular,strong,without-article"]]},"barden":{"entries":[["barden",null,null,null]],"senses":[[387703,"barden","noun","genitive singular of Barde",0]],"inflections":[["barden","barde","genitive"]]},"belohnest":{"entries":[["belohnest",null,null,null]],"senses":[[118470,"belohnest","verb","second-person singular subjunctive I of belohnen",0]],"inflections":[["belohnest","belohnen","second-person,singular,subjunctive,subjunctive-i"]]},"bezahlst ab":{"entries":[["bezah
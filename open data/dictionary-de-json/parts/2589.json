raisōną (“to risk; later also: to fear”) had regularly merged in Middle Low German vrēsen. Compare to this Dutch vriezen and vrezen."]],"senses":[[374029,"unverfroren","adj","unabashed, blatant, brazen, audacious",0],[374030,"unverfroren","adv","unabashedly, blatantly",1]]},"verbittrest":{"entries":[["verbittrest",null,null,null]],"senses":[[381945,"verbittrest","verb","second-person singular subjunctive I of verbittern",0]],"inflections":[["verbittrest","verbittern","second-person,singular,subjunctive,subjunctive-i"]]},"versnobten":{"entries":[["versnobten",null,null,null]],"senses":[[323660,"versnobten","adj","inflection of versnobt:",0],[323661,"versnobten","adj","strong genitive masculine/neuter singular",1],[323662,"versnobten","adj","weak/mixed genitive/dative all-gender singular",2],[323663,"versnobten","adj","strong/weak/mixed accusative masculine singular",3],[323664,"versnobten","adj","strong dative plural",4],[323665,"versnobten","adj","weak/mixed all-case plural",5]],"inflections":[["versnobten","versnobt","genitive,masculine,singular,strong,without-article"]]},"vorleget":{"entries":[["vorleget",null,null,null]],"senses":[[651388,"vorleget","verb","second-person plural dependent subjunctive I of vorlegen",0]],"inflections":[["vorleget","vorlegen","plural,second-person,subjunctive,subjunctive-i,subordinate-clause"]]},"waldkauze":{"entries":[["waldkauze",null,null,null]],"senses":[[502569,"waldkauze","noun","dative of Waldkauz",0,"m"]],"inflections":[["waldkauze","waldkauz","dative,singular"]]},"übersiehst":{"entries":[["übersiehst",null,null,null]],"senses":[[108622,"übersiehst","verb","second-person singular present of übersehen",0]],"inflections":[["übersiehst","übersehen","indicative,present,second-person,singular"]]},"32-ecks":{"inflections":[["32-ecks","32-eck","genitive"]]},"aufkündigtest":{"inflections":[["aufkündigtest","aufkündigen","indicative,preterite,second-person,singular,subordinate-clause"]]},"auslebt":{"inflections":[["auslebt","ausleben"
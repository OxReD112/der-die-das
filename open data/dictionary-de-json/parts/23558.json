{"format_version":1,"partition":23558,"records":{"der mohr hat seine schuldigkeit getan, der mohr kann gehen":{"entries":[["der mohr hat seine schuldigkeit getan, der mohr kann gehen",null,null,"Literally, “the Moor has done his duty, the Moor can go”.\nThe original quotation was „Der Mohr hat seine Arbeit getan, der Mohr kann gehen“ (“The Moor has done his work, the Moor can go\"). It comes from the play Fiesco by Friedrich Schiller. The word Arbeit (“work”) is now more commonly replaced by Schuldigkeit (“duty”)."]],"senses":[[645371,"der mohr hat seine schuldigkeit getan, der mohr kann gehen","proverb","used when a person who has done a favor or been helpful (or by extension a thing that has been useful) but whose services are no longer needed is ungratefully replaced, dismissed or let go",0]]},"durchlöchern":{"entries":[["durchlöchern",null,"/dʊʁçˈlœçɐn/","durch- + löchern",null,"haben"]],"senses":[[611109,"durchlöchern","verb","to riddle (fill with holes)",0]]},"graphithaltigen":{"entries":[["graphithaltigen",null,null,null]],"senses":[[477960,"graphithaltigen","adj","inflection of graphithaltig:",0],[477961,"graphithaltigen","adj","strong genitive masculine/neuter singular",1],[477962,"graphithaltigen","adj","weak/mixed genitive/dative all-gender singular",2],[477963,"graphithaltigen","adj","strong/weak/mixed accusative masculine singular",3],[477964,"graphithaltigen","adj","strong dative plural",4],[477965,"graphithaltigen","adj","weak/mixed all-case plural",5]],"inflections":[["graphithaltigen","graphithaltig","genitive,masculine,singular,strong,without-article"]]},"krebsentstehungen":{"entries":[["krebsentstehungen",null,null,null]],"senses":[[363154,"krebsentstehungen","noun","plural of Krebsentstehung",0,"f"]],"inflections":[["krebsentstehungen","krebsentstehung","plural"]]},"kupfererze":{"entries":[["kupfererze",null,null,null]],"senses":[[235148,"kupfererze","noun","nominative/accusative/genitive plural of Kupfererz",0,"n"]],"inflections":[["kupfererze",
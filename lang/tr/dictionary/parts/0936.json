{"format_version":1,"partition":936,"records":{"Kindersprache":[{"record_id":895,"word":"Kindersprache","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Kindersprache","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["çocuk dili"],"id":"tr-Kindersprache-de-noun-vEax7DQ9"},"labels":[[0,0,["linguistics"]]]}]}],"Produktionsregeln":[{"record_id":1165,"word":"Produktionsregeln","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Produktionsregeln","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"form-description","data":{"glosses":["Produktionsregel sözcüğünün belirtilmemiş çekimi"],"id":"tr-Produktionsregeln-de-noun-6eNAmCVI","tags":["form-of"],"form_of":[{"word":"Produktionsregel"}]}}]}],"Eis":[{"record_id":1589,"word":"Eis","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Eis","source":"tr.wiktionary","gender":["n"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["dondurma"],"id":"tr-Eis-de-noun-njFEQlSP"},"labels":[[0,0,["cooking"]]]},{"sense_index":1,"display_status":"translation","data":{"glosses":["buz"],"id":"tr-Eis-de-noun-0SRB~GQd","raw_tags":["kriyoloji"]},"labels":[[0,0,["meteorology","hydrology"]]]}]}],"Deserteur":[{"record_id":3767,"word":"Deserteur","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Deserteur","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["asker kaçağı"],"id":"tr-Deserteur-de-noun-AjN8IgN6"},"labels":[[0,0,["military"]]]}]}],"urinieren":[{"record_id":4908,"word":"urinieren","pos":"verb","source_url":"https://tr.wiktionary.org/wiki/urinieren","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["işemek"],"id":"tr-urinieren-de-verb-aoi6FJjv"},"labels":[[0,0,["physiology"]]]}]}],"Heimweh":[{"record_id":6290,"word":"Heimweh","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Heimweh","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["sıla hasreti, vuslat"],"id":"tr-Heimweh-de-noun-eyuu4V7V"}}]}],"wirtschaftlich":[{"record_id":6827,"word":"wirtschaftlich","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/wirtschaftlich","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Ekonomiyi, bir millî ekonomiyi veya iş idaresiyle alakalı: ekonomik (olarak)"],"id":"tr-wirtschaftlich-de-adj-O6FNuAZm","examples":[{"text":"Das Ministerium ist für wirtschaftliche Fragen zuständig.","bold_text_offsets":[[24,39]],"translation":"Bakanlık, ekonomik konulardan mesuldür.","bold_translation_offsets":[[10,18]]},{"text":"„In Kontinentaleuropa und besonders in Frankreich betrachtet man die ersten Nachkriegsjahrzehnte, die von starken staatlichen Eingriffen geprägt waren, als eine segensreiche Zeit des Wachstums und macht häufig die um 1980 eingeleitete wirtschaftliche Liberalisierung für seinen Rückgang verantwortlich.“","bold_text_offsets":[[235,250]],"translation":"Kıta Avrupası'nda ve özellikle Fransa'da, güçlü devlet müdahalesinin damgasını vurduğu savaş sonrası ilk on yıllar, büyümenin kutsanmış bir devri olarak görülür ve bu gerilemenin sebebi olarak genellikle 1980'lerde başlayan ekonomik liberalleşme gösterilir.","bold_translation_offsets":[[224,232]]},{"text":"Brasilien steckt in einer der schwersten Rezessionen seit Jahrzehnten. Das Land hofft jedoch auf wirtschaftliche Impulse durch die eben zu Ende gegangenen Olympischen Spiele. Doch die dürften gering ausfallen, glaubt man Experten.","bold_text_offsets":[[97,112]],"translation":"Brezilya son yılların en kötü durgunluklarından birini yaşıyor. Ancak ülke, yeni sona eren Olimpiyat Oyunları'ndan ekonomik teşvik almayı ümit ediyor. Ancak uzmanlar bu oranların düşük olabileceğine inanıyor.","bold_translation_offsets":[[115,123]]},{"text":"„Den USA geht es nicht gut. Die republikanischen und demokratischen Regionen driften wirtschaftlich auseinander.“","bold_text_offsets":[[85,99]],"translation":"888"},{"text":"„Aber die Grenzsprengung auf der wirtschaftlichen Seite hat zwangsweise die Grenzsprengung auf der sozial-gesellschaftlichen Seite zur Folge.“","bold_text_offsets":[[33,49]],"translation":"888"}]},"labels":[[0,0,["economics"]]]},{"sense_index":1,"display_status":"translation","data":{"glosses":["Ekonomiklik prensibini takip ederek kâr getirici olan: ekonomik"],"id":"tr-wirtschaftlich-de-adj-JdFRZRLz","raw_tags":["artışlı"],"examples":[{"text":"Investitionen müssen wirtschaftlich sein.","bold_text_offsets":[[21,35]],"translation":"Yatırımların ekonomik olması lâzım.","bold_translation_offsets":[[13,21]]},{"text":"Grundsatz der Produktionslehre: Nur die Produktion am technologischen Rand ist wirtschaftlich.","bold_text_offsets":[[79,93]],"translation":"Üretim teorisinin temeli: Yalnızca teknolojik uçtaki üretim ekonomiktir.","bold_translation_offsets":[[60,68]]},{"text":"Unterdessen saß Physikprofessor Dyson als Experte in der Operationszentrale des Bomber Command, \"kalkulierte, wie man auf wirtschaftlichste Weise weitere 100 000 Leute ermordet\" - obwohl doch, wie er dann 1984 schrieb, der Protest dagegen seine moralische Pflicht gewesen wäre.","bold_text_offsets":[[122,139]],"translation":"Bu arada fizik profesörü Dyson, Bombardıman Komutanlığı'nın operasyon merkezinde bir mütehassıs olarak oturuyordu ve 1984'te yazdığı gibi bunu protesto etmenin ahlâkî vazifesi olmasına rağmen \"100.000 kişiyi daha ekonomik şekilde nasıl öldüreceğini hesaplıyordu\".","bold_translation_offsets":[[213,221]]},{"text":"Seine Schwiegereltern in spe haben erst einmal seine wirtschaftliche Situation durchleuchtet.","bold_text_offsets":[[53,68]],"translation":"Müstakbel kayınvalidesi ilk önce onun ekonomik hâlini tetkik etti.","bold_translation_offsets":[[38,46]]}]},"labels":[[0,0,["economics"]]]},{"sense_index":2,"display_status":"translation","data":{"glosses":["malî, parasal"],"id":"tr-wirtschaftlich-de-adj-4ac4kLkZ","raw_tags":["mâliye"],"examples":[{"text":"Ein Zinssatz unter 2% ist zur Zeit nicht wirtschaftlich, da er unter der Teuerungsrate liegt.","bold_text_offsets":[[41,55]],"translation":"Yüzde 2'nin altındaki faiz oranı enflasyon oranının altında olduğu için şu anda ekonomik değil.","bold_translation_offsets":[[80,88]]}]},"labels":[[0,0,["finance"]]]}]}],"mechanische Welle":[{"record_id":6965,"word":"mechanische Welle","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/mechanische%20Welle","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["mekanik dalga"],"id":"tr-mechanische_Welle-de-noun-ME~ZukBI","raw_tags":["dalgalar"]},"labels":[[0,0,["physics"]]]}]}],"Zoos":[{"record_id":8372,"word":"Zoos","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Zoos","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"form-description","data":{"glosses":["Zoo sözcüğünün çekimi:"],"id":"tr-Zoos-de-noun-irOAL3sJ","tags":["form-of"],"form_of":[{"word":"Zoo"}]}},{"sense_index":1,"display_status":"form-description","data":{"glosses":["Zoo sözcüğünün çekimi:","tamlayan tekil"],"id":"tr-Zoos-de-noun-rdkqh4j6","tags":["form-of"],"form_of":[{"word":"Zoo"}]}},{"sense_index":2,"display_status":"form-description","data":{"glosses":["Zoo sözcüğünün çekimi:","çoğul"],"id":"tr-Zoos-de-noun-KTl~8NNG","tags":["form-of"],"form_of":[{"word":"Zoo"}]}}]}],"Südosts":[{"record_id":9017,"word":"Südosts","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/S%C3%BCdosts","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"form-description","data":{"glosses":["Südost sözcüğünün tamlayan tekil çekimi"],"id":"tr-Südosts-de-noun-pU4imxx4","tags":["form-of"],"form_of":[{"word":"Südost"}]}}]}],"Siebenhandl":[{"record_id":10090,"word":"Siebenhandl","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Siebenhandl","source":"tr.wiktionary","gender":["m","f"],"senses":[{"sense_index":0,"disp
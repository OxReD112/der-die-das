{"format_version":1,"partition":13009,"records":{"eber":{"entries":[["eber",null,"/ˈeːbɐ/","From Middle High German ëber, from Old High German ebur, from Proto-West Germanic *ebur, from Proto-Germanic *eburaz, possibly from Proto-Indo-European *h₁ep-r-.\nCognate with Dutch ever, Latin aper, Serbo-Croatian vepar. Despite the similarity in form and meaning, not related to obsolete dialectal Bär (“boar”) or to Bär (“bear”).",{"g":"m","decl":"|||s|||n|"}]],"senses":[[4971,"eber","noun","boar (male pig, especially domestic)",0,"m"]]},"geisterzüge":{"entries":[["geisterzüge",null,null,null]],"senses":[[45159,"geisterzüge","noun","nominative/accusative/genitive plural of Geisterzug",0]],"inflections":[["geisterzüge","geisterzug","plural"]]},"orthografie":{"entries":[["orthografie",null,null,null,{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[46592,"orthografie","noun","alternative form of Orthographie",0,"f"]],"inflections":[["orthografie","orthographie","alternative,alternative,standard"]]},"pandanblatts":{"entries":[["pandanblatts",null,"/panˈdaːnˌblat͡s/",null]],"senses":[[705587,"pandanblatts","noun","genitive singular of Pandanblatt",0]],"inflections":[["pandanblatts","pandanblatt","genitive"]]},"planierraupe":{"entries":[["planierraupe",null,"/plaˈniːɐˌʁaʊpə/","From planier(en) + Raupe.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[47935,"planierraupe","noun","bulldozer (tractor)",0,"f"]]},"flämmte":{"inflections":[["flämmte","flämmen","past"]]},"gekungelt":{"inflections":[["gekungelt","kungeln","participle,past"]]},"windspiele":{"inflections":[["windspiele","windspiel","definite,nominative,plural"]]}}}
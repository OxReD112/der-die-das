 the vocalism -u- does not really agree with this. Finally, since the connection with prostitution is apparently very old, a relation with Middle Low German nütte (“useful, profitable”) might be considered.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[23550,"nutte","noun","whore; prostitute",0,"f",["informal"]]]},"profilbilds":{"entries":[["profilbilds",null,null,null]],"senses":[[629875,"profilbilds","noun","genitive singular of Profilbild",0]],"inflections":[["profilbilds","profilbild","genitive"]]},"startelfen":{"entries":[["startelfen",null,null,null]],"senses":[[713519,"startelfen","noun","plural of Startelf",0]],"inflections":[["startelfen","startelf","plural"]]},"videokamera":{"entries":[["videokamera",null,null,"Video + Kamera",{"g":"f","decl":"||||s|s|s|s"}]],"senses":[[633568,"videokamera","noun","video camera",0,"f"]]},"übermäßigeren":{"entries":[["übermäßigeren",null,null,null]],"senses":[[155118,"übermäßigeren","adj","inflection of übermäßig:",0],[155119,"übermäßigeren","adj","strong genitive masculine/neuter singular comparative degree",1],[155120,"übermäßigeren","adj","weak/mixed genitive/dative all-gender singular comparative degree",2],[155121,"übermäßigeren","adj","strong/weak/mixed accusative masculine singular comparative degree",3],[155122,"übermäßigeren","adj","strong dative plural comparative degree",4],[155123,"übermäßigeren","adj","weak/mixed all-case plural comparative degree",5]],"inflections":[["übermäßigeren","übermäßig","comparative,genitive,masculine,singular,strong,without-article"]]},"rentièren":{"inflections":[["rentièren","rentière","plural"]]},"selbstmitleidigen":{"inflections":[["selbstmitleidigen","selbstmitleidig","genitive,masculine,singular,strong,without-article"]]},"selbstzerstörerischere":{"inflections":[["selbstzerstörerischere","selbstzerstörerisch","comparative,feminine,nominative,singular,strong,without-article"]]},"vogelnestern":{"inflections":[["vogelnestern","vogelnest","dative,definite,plural"]]},"wachläget":{"infl
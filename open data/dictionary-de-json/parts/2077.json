{"format_version":1,"partition":2077,"records":{"-haftig":{"entries":[["-haftig",null,"/-ˌhaftɪç/","From Middle High German -haftec, from Old High German -haftīg. Equivalent to -haft + -ig.\nIn contemporary German the two variants -haft and -haftig have been mostly regularised in such a way that the adjective ends in simple -haft, but the nominal form ends in -haftigkeit, e.g. ernsthaft (“serious”) → Ernsthaftigkeit (“seriousness”)."]],"senses":[[147436,"-haftig","suffix","alternative form of -haft",0,null,["dated"]]]},"abgäben":{"entries":[["abgäben",null,null,null]],"senses":[[90235,"abgäben","verb","first/third-person plural dependent subjunctive II of abgeben",0]],"inflections":[["abgäben","abgeben","first-person,plural,subjunctive,subjunctive-ii,subordinate-clause"]]},"bagatellschaden":{"entries":[["bagatellschaden",null,"[baɡaˈtɛlˌʃaːdn̩]","From Bagatelle + Schaden.",{"g":"m","decl":"|||s|4äden|4äden|4äden|4äden"}]],"senses":[[720947,"bagatellschaden","noun","minor damage, minimal damage, petty damage",0,"m"]]},"laichten":{"entries":[["laichten",null,null,null]],"senses":[[346553,"laichten","verb","inflection of laichen:",0],[346554,"laichten","verb","first/third-person plural preterite",1],[346555,"laichten","verb","first/third-person plural subjunctive II",2]],"inflections":[["laichten","laichen","first-person,indicative,plural,preterite"]]},"safranen":{"entries":[["safranen",null,null,null]],"senses":[[247066,"safranen","noun","dative plural of Safran",0,"m"]],"inflections":[["safranen","safran","dative,definite,plural"]]},"telefons":{"entries":[["telefons",null,null,null]],"senses":[[56048,"telefons","noun","genitive singular of Telefon",0]],"inflections":[["telefons","telefon","genitive"]]},"zäheres":{"entries":[["zäheres",null,null,null]],"senses":[[211310,"zäheres","adj","strong/mixed nominative/accusative neuter singular comparative degree of zäh",0]],"inflections":[["zäheres","zäh","comparative,neuter,nominative,singular,strong,without-article"],["zäh
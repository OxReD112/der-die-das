{"format_version":1,"partition":7081,"records":{"-rath":{"entries":[["-rath",null,"/ʁaːt/","From Old High German rot (“clearing”), related to roden. The spelling with -a- reflects dialectal [ɔː] in these names. However, most Rhenish dialects should regularly have short [ɔ] (Central Franconian rodde), so there probably underlies some kind of analogy or older form of pronunciation. Another possibility would be influence by a Middle Low German spelling; compare -rade."]],"senses":[[678676,"-rath","suffix","A placename suffix found chiefly in the northern Rhineland.",0]]},"aschaffenburgs":{"entries":[["aschaffenburgs",null,"/aˈʃafn̩ˌbʊʁks/",null]],"senses":[[704182,"aschaffenburgs","name","genitive singular of Aschaffenburg",0]],"inflections":[["aschaffenburgs","aschaffenburg","genitive"]]},"aufgäbest":{"entries":[["aufgäbest",null,null,null]],"senses":[[90287,"aufgäbest","verb","second-person singular dependent subjunctive II of aufgeben",0]],"inflections":[["aufgäbest","aufgeben","second-person,singular,subjunctive,subjunctive-ii,subordinate-clause"]]},"aufheber":{"entries":[["aufheber",null,"/ˈaʊ̯fheːbɐ/","From aufheben + -er.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[688994,"aufheber","noun","agent noun of aufheben",0,"m"]]},"aufzeichnungsgeräte":{"entries":[["aufzeichnungsgeräte",null,null,null]],"senses":[[686414,"aufzeichnungsgeräte","noun","nominative/accusative/genitive plural of Aufzeichnungsgerät",0]],"inflections":[["aufzeichnungsgeräte","aufzeichnungsgerät","plural"]]},"den wald vor lauter bäumen nicht sehen":{"entries":[["den wald vor lauter bäumen nicht sehen",null,null,"Literally, “to not see the forest because of all the trees”.",null,"haben"]],"senses":[[714689,"den wald vor lauter bäumen nicht sehen","verb","to not see the forest for the trees",0]]},"erwähne":{"entries":[["erwähne",null,null,null]],"senses":[[260875,"erwähne","verb","inflection of erwähnen:",0],[260876,"erwähne","verb","first-person singular present",1],[260877,"erwähne","verb","firs
olemy mentions the Τευριοχαῖμαι (Teuriokhaîmai). Their name was traditionally connected to that of the Hermunduren, but this is discredited by modern etymologists on phonological grounds; instead, a connection to the Turones is sometimes proposed. Grahn-Hoek alternatively proposes a connection to the Thervingi (authors have at least mixed up the two groups since ancient times on account of the similarity of their names), particularly a subgroup living along the Τύρας (Túras)."]],"senses":[[25707,"thüringen","name","Thuringia (a state in central Germany)",0],[25708,"thüringen","name","a municipality of Vorarlberg, Austria",1]],"related_forms":[[35736,"thüringen","thüringisch","derived"],[35737,"thüringen","thüringer","derived"]]},"trostloses":{"entries":[["trostloses",null,null,null]],"senses":[[562055,"trostloses","adj","strong/mixed nominative/accusative neuter singular of trostlos",0]],"inflections":[["trostloses","trostlos","neuter,nominative,singular,strong,without-article"]]},"ungesättigte":{"entries":[["ungesättigte",null,null,null]],"senses":[[249256,"ungesättigte","adj","inflection of ungesättigt:",0],[249257,"ungesättigte","adj","strong/mixed nominative/accusative feminine singular",1],[249258,"ungesättigte","adj","strong nominative/accusative plural",2],[249259,"ungesättigte","adj","weak nominative all-gender singular",3],[249260,"ungesättigte","adj","weak accusative feminine/neuter singular",4]],"inflections":[["ungesättigte","ungesättigt","feminine,nominative,singular,strong,without-article"]]},"unterstützerin":{"entries":[["unterstützerin",null,"/ʊntɐˈʃtʏt͡səʁɪn/","From Unterstützer + -in.",{"g":"f","decl":"||||nen|nen|nen|nen"}]],"senses":[[620680,"unterstützerin","noun","female equivalent of Unterstützer",0,"f"]],"inflections":[["unterstützerin","unterstützer","feminine"]]},"urbanisierest":{"entries":[["urbanisierest",null,null,null]],"senses":[[131102,"urbanisierest","verb","second-person singular subjunctive I of urbanisieren",0]],"inflections":[["u
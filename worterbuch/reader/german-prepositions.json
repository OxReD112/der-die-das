? — где (место)","note_en":"Wo? — where (location)","example_de":"auf dem Tisch"},{"pattern":"auf + Akkusativ","case":"Akkusativ","position":"before","status":"standard","note_ru":"Wohin? — куда (направление)","note_en":"Wohin? — where to (direction)","example_de":"auf den Tisch"}],"contractions":{"aufs":"auf das"},"forms":null,"forms_note_ru":"Слитная форма: aufs = auf das.","forms_note_en":"Contracted form: aufs = auf das.","search_forms":["auf"],"wortschatz_excluded":true},{"id":"preposition-019","type":"preposition","word":"hinter","translation_ru":"за, позади","translation_en":"behind","cases":["Dativ","Akkusativ"],"government":[{"pattern":"hinter + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"Wo? — где (место)","note_en":"Wo? — where (location)","example_de":"hinter dem Haus"},{"pattern":"hinter + Akkusativ","case":"Akkusativ","position":"before","status":"standard","note_ru":"Wohin? — куда (направление)","note_en":"Wohin? — where to (direction)","example_de":"hinter das Haus"}],"contractions":{"hinterm":"hinter dem","hinters":"hinter das"},"forms":null,"forms_note_ru":"Разговорные слитные формы: hinterm = hinter dem, hinters = hinter das.","forms_note_en":"Colloquial contracted forms: hinterm = hinter dem, hinters = hinter das.","search_forms":["hinter"],"wortschatz_excluded":true},{"id":"preposition-020","type":"preposition","word":"in","translation_ru":"в (внутри, внутрь); через (о времени); в (о месяцах, временах года: im Mai)","translation_en":"in, inside; into; in (time)","cases":["Dativ","Akkusativ"],"government":[{"pattern":"in + Dativ","case":"Dativ","position":"before","status":"standard","note_ru":"Wo? — где (место); время: im Mai","note_en":"Wo? — where (location); time: im Mai","example_de":"in der Stadt"},{"pattern":"in + Akkusativ","case":"Akkusativ","position":"before","status":"standard","note_ru":"Wohin? — куда (направление)","note_en":"Wohin? — where to (direction)","example_de":"in die Stadt"}],"contractions":{"i
_offsets":[[268,276]],"translation":"Тогда смеялся и Ганно, потихоньку, но от всей души, ибо, не сговариваясь, оба они там, наверху, держались мнения, что проповедь―это довольно-таки пустячная болтовня, а подлинное богослужение―то, что пастору и его пастве представляется, вероятно, лишь подсобным средством для поднятия религиозности настроения,―иными словами, музыка. Томас Манн. Будденброки (Н. Ман, 1953)","bold_translation_offsets":[[213,219]]}]}},{"sense_index":4,"display_status":"translation","data":{"glosses":["(здание, в котором размещалась администрация деревни)"],"id":"ru-Gemeinde-de-noun-FchG-1QA","examples":[{"text":"In der Gemeinde sind auch Kindergarten und Polizei untergebracht.","bold_text_offsets":[[7,15]],"translation":"В муниципалитете также детский сад и полиции размещены.","bold_translation_offsets":[[2,15]]}]}}]}],"German":[{"record_id":3394,"word":"German","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/German","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["герман (химическое соединение)"],"id":"ru-German-de-noun-upxD5eEF"}}]}],"Gletscherwein":[{"record_id":3732,"word":"Gletscherwein","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Gletscherwein","senses":[{"sense_index":0,"display_status":"no-gloss","data":{"id":"ru-Gletscherwein-de-noun-47DEQpj8","tags":["no-gloss"]}}]}],"Defilee":[{"record_id":3823,"word":"Defilee","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Defilee","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["дефиле, ущелье, теснина; узкий (тесный) проход; каньон"],"id":"ru-Defilee-de-noun-T7GEXRgE"}},{"sense_index":1,"display_status":"translation","data":{"glosses":["прохождение торжественным маршем"],"id":"ru-Defilee-de-noun-itQVEu1Y"}}]}],"Haschemit":[{"record_id":4171,"word":"Haschemit","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Haschemit","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["хашимит (п
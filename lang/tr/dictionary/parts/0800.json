{"format_version":1,"partition":800,"records":{"Ablaut":[{"record_id":279,"word":"Ablaut","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Ablaut","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["ünlü almaşması"],"id":"tr-Ablaut-de-noun-N-G4XTfC"},"labels":[[0,0,["linguistics"]]]}]}],"Diphthongierung":[{"record_id":670,"word":"Diphthongierung","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Diphthongierung","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["ikili ünlüleşme"],"id":"tr-Diphthongierung-de-noun-bhI5nmhw"},"labels":[[0,0,["linguistics"]]]}]}],"spucken":[{"record_id":1702,"word":"spucken","pos":"verb","source_url":"https://tr.wiktionary.org/wiki/spucken","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["tükürmek"],"id":"tr-spucken-de-verb-DIwbBs1c"}}]}],"Brüderlichkeit":[{"record_id":2590,"word":"Brüderlichkeit","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Br%C3%BCderlichkeit","source":"tr.wiktionary","gender":["f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["kardeşlik"],"id":"tr-Brüderlichkeit-de-noun-eCKL-X0D"}}]}],"reich":[{"record_id":2828,"word":"reich","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/reich","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["bir şeyden çokça bulunduran"],"id":"tr-reich-de-adj-zgHYlTZd","examples":[{"text":"Korallenriffe sind reich an Lebewesen.","bold_text_offsets":[[19,24]],"translation":"Mercan resifleri canlılar açısından zengindir.","bold_translation_offsets":[[36,42]]},{"text":"Dieses Jahr gibt es eine nicht besonders reiche Weinernte.","bold_text_offsets":[[41,47]],"translation":"Bu yıl özellikle zengin bir şarap hasadı yok.","bold_translation_offsets":[[17,23]]},{"text":"Der Inselstaat Madagaskar ist berühmt für seine Artenvielfalt, reich an Rohstoffen und fruchtbarem Boden.","bold_text_offsets":[[63,68]],"translation":"Ada devleti Madagaskar, biyolojik çeşitliliği, hammadde bakımından zengin ve mümbit toprağıyla meşhurdur.","bold_translation_offsets":[[67,73]]}]}},{"sense_index":1,"display_status":"translation","data":{"glosses":["muhteşem"],"id":"tr-reich-de-adj-PiHpq6v7","examples":[{"text":"Das Buch ist reich bebildert.","bold_text_offsets":[[13,18]],"translation":"Kitap bol resimlendirilmiş.","bold_translation_offsets":[[6,9]]},{"text":"Aus der Backstube von Anne Schultes kommen nicht nur zu Ostern reich verzierte Gebäckstücke.","bold_text_offsets":[[63,68]],"translation":"Anne Schultes'un fırını yalnızca Paskalya'da zengin bir şekilde dekore edilmiş hamur işleri üretmiyor.","bold_translation_offsets":[[45,51]]}]}},{"sense_index":2,"display_status":"translation","data":{"glosses":["zengin"],"id":"tr-reich-de-adj-vPF-kPZp","examples":[{"text":"Bill Gates ist ein reicher Mann.","bold_text_offsets":[[19,26]],"translation":"Bill Gates zengin bir adamdır.","bold_translation_offsets":[[11,17]]},{"text":"Durch Spekulation reich werden zu wollen ist einfach die falsche Idee.","bold_text_offsets":[[18,23]],"translation":"Spekülasyon yoluyla zengin olmaya çalışmak tamamen yanlış bir fikirdir.","bold_translation_offsets":[[20,26]]},{"text":"Während reiche Menschen schon einmal herausstellen, was sie besitzen, tun das weniger vermögende natürlicherweise nur ungern.","bold_text_offsets":[[8,14]],"translation":"Zengin insanlar genellikle sahip oldukları şeyleri sergilerken, daha az varlıklı olanlar tabii olarak bunu yapmakta isteksizdirler.","bold_translation_offsets":[[0,6]]},{"text":"Die Kluft zwischen armen und reichen Kommunen wird immer größer, moniert der Deutsche Städtetag.","bold_text_offsets":[[29,36]],"translation":"Alman Şehirler Birliği, fakir ve zengin belediyeler arasındaki uçurumun giderek büyüdüğünü belirtiyor.","bold_translation_offsets":[[33,39]]},{"text":"In Deutschland wird das Vermögen des 'reichsten' Prozent statistisch nicht erfasst. Man vermutet aber, dass dieses oberste Hundertstel rund ein Drittel des gesamten Volksvermögens besitzt.","bold_text_offsets":[[38,48]],"translation":"Almanya'da en zengin yüzdenin serveti istatistikî olarak kayıt altına alınmıyor. Ancak bu ilk yüz kişinin toplam millî servetin yaklaşık üçte birine sahip olduğu farzediliyor.","bold_translation_offsets":[[11,20]]},{"text":"Nirgends leben so viele Milliardäre wie in Peking. Selfmademen sind die wenigsten unter ihnen: Reich wird man in China am besten, in dem man mit der KP mauschelt.","bold_text_offsets":[[95,100]],"translation":"Hiçbir yerde Pekin'deki kadar çok milyarder yaşamıyor. Bunların çok azı kendi kendini yetiştirmiş adamlardan oluşuyor: Çin'de zengin olmanın en iyi yolu Komünist Parti ile flört etmektir.","bold_translation_offsets":[[126,132]]},{"text":"„Die 46-Jährige, die in Angola auch «Prinzessin» genannt wird, gilt bis heute als reichste Frau Afrikas.“","bold_text_offsets":[[82,90]],"translation":"Angola'da “prenses” olarak da zikredilen 46 yaşındaki kadın, hâlâ Afrika'nın en zengin kadını olarak kabul ediliyor.","bold_translation_offsets":[[80,86]]}]}}]}],"Anfang":[{"record_id":2983,"word":"Anfang","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Anfang","source":"tr.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["başlangıç"],"id":"tr-Anfang-de-noun-1GnXibOB"}}]}],"piepen":[{"record_id":3424,"word":"piepen","pos":"verb","source_url":"https://tr.wiktionary.org/wiki/piepen","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["biplemek"],"id":"tr-piepen-de-verb--7Rcoojv"}}]}],"Zürich":[{"record_id":3605,"word":"Zürich","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Z%C3%BCrich","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"reference","data":{"glosses":["Zürih."],"id":"tr-Zürich-de-name-C8KSw70D"}}]},
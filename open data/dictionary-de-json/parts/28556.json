{"format_version":1,"partition":28556,"records":{"-chen":{"entries":[["-chen",null,"/çən/","From Middle High German -echen, -ichen, from Old High German *-ihīn, *-uhīn, from Proto-West Germanic *-ukīn.\nNative to the Central German dialects, -chen has widely replaced the southern-based -lein in standard usage. Cognate with German Low German -ken, -ke as well as Dutch -tje and -ken. More at -kin."]],"senses":[[11177,"-chen","suffix","nowadays the most common suffix to create a diminutive form",0]]},"emissionslinie":{"entries":[["emissionslinie",null,null,"Emission + Linie",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[249882,"emissionslinie","noun","emission line",0,"f",null,null,null,null,["physics"]]]},"funkloche":{"entries":[["funkloche",null,null,null]],"senses":[[501741,"funkloche","noun","dative singular of Funkloch",0,"n"]],"inflections":[["funkloche","funkloch","dative,singular"]]},"kainsmals":{"entries":[["kainsmals",null,null,null]],"senses":[[167119,"kainsmals","noun","genitive singular of Kainsmal",0]],"inflections":[["kainsmals","kainsmal","genitive"]]},"kräftigstem":{"entries":[["kräftigstem",null,null,null]],"senses":[[228779,"kräftigstem","adj","strong dative masculine/neuter singular superlative degree of kräftig",0]],"inflections":[["kräftigstem","kräftig","dative,masculine,singular,strong,superlative,without-article"]]},"schmelzfluss":{"entries":[["schmelzfluss",null,"[ˈʃmɛlt͡sˌflʊs]","From schmelzen + Fluss.",{"g":"m","decl":"||/e|es|3üsse|3üsse|3üssen|3üsse"}]],"senses":[[187154,"schmelzfluss","noun","molten mass; flux",0,"m"]]},"soziopathinnen":{"entries":[["soziopathinnen",null,null,null]],"senses":[[710630,"soziopathinnen","noun","plural of Soziopathin",0,"f"]],"inflections":[["soziopathinnen","soziopathin","plural"]]},"ständchens":{"entries":[["ständchens",null,"/ˈʃtɛntçəns/",null]],"senses":[[607572,"ständchens","noun","genitive singular of Ständchen",0]],"inflections":[["ständchens","ständchen","genitive"]]},"tätscheltet":{"entries":[["tätsch
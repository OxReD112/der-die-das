{"format_version":1,"partition":5172,"records":{"-ien":{"entries":[["-ien",null,"/i̯ən/","From Middle High German -ie, -je, from Latin -ia (feminine singular). Nouns with this Latinate suffix were originally strong (i.e. invariable) feminines, but inflected forms in -ien arose when the distinction between strong and weak feminines collapsed in later Middle High German. These were then treated by analogy with local names like Böhmen, Franken, Sachsen etc. (all originally dative plural of a tribe name)."]],"senses":[[30258,"-ien","suffix","Used to form country names; -ia",0],[30259,"-ien","suffix","Used to form the plurals of some neuter nouns of Latin descent whose original plural ends in -ia.",1]],"inflections":[["-ien","-ie","plural"]]},"abtörnendes":{"entries":[["abtörnendes",null,null,null]],"senses":[[444900,"abtörnendes","adj","strong/mixed nominative/accusative neuter singular of abtörnend",0]],"inflections":[["abtörnendes","abtörnend","neuter,nominative,singular,strong,without-article"]]},"handlungsfähigem":{"entries":[["handlungsfähigem",null,null,null]],"senses":[[525791,"handlungsfähigem","adj","strong dative masculine/neuter singular of handlungsfähig",0]],"inflections":[["handlungsfähigem","handlungsfähig","dative,masculine,singular,strong,without-article"]]},"hantigeren":{"entries":[["hantigeren",null,null,null]],"senses":[[482342,"hantigeren","adj","inflection of hantig:",0],[482343,"hantigeren","adj","strong genitive masculine/neuter singular comparative degree",1],[482344,"hantigeren","adj","weak/mixed genitive/dative all-gender singular comparative degree",2],[482345,"hantigeren","adj","strong/weak/mixed accusative masculine singular comparative degree",3],[482346,"hantigeren","adj","strong dative plural comparative degree",4],[482347,"hantigeren","adj","weak/mixed all-case plural comparative degree",5]],"inflections":[["hantigeren","hantig","comparative,genitive,masculine,singular,strong,without-article"]]},"kleinmütigem":{"entries":[["kleinmütigem
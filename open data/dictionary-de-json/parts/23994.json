{"format_version":1,"partition":23994,"records":{"angriffsflächen":{"entries":[["angriffsflächen",null,null,null]],"senses":[[199038,"angriffsflächen","noun","plural of Angriffsfläche",0,"f"]],"inflections":[["angriffsflächen","angriffsfläche","plural"]]},"bürgerinitiativen":{"entries":[["bürgerinitiativen",null,null,null]],"senses":[[351505,"bürgerinitiativen","noun","plural of Bürgerinitiative",0,"f"]],"inflections":[["bürgerinitiativen","bürgerinitiative","plural"]]},"dankt ab":{"entries":[["dankt ab",null,null,null]],"senses":[[102711,"dankt ab","verb","inflection of abdanken:",0],[102712,"dankt ab","verb","third-person singular present",1],[102713,"dankt ab","verb","second-person plural present",2],[102714,"dankt ab","verb","plural imperative",3]]},"deich":{"entries":[["deich",null,"/daɪ̯ç/","From Middle Low German dīk, from Old Saxon dīk, from Proto-West Germanic *dīk, from Proto-Germanic *dīkaz.\nOriginally the same word as Teich (“pond”). The sense “dike” spread via Low German, for which reason the form Deich is most often regarded as an artificial adaptation of Middle Low German dīk (“dike”) to the phonetic system of standard German. However, Deich is also the form natively developed in West Central German and it does mean “dike, dam, weir system” in most dialects of the Rhineland, particularly along the Lower Rhine. The supposition of an artificial adaptation is therefore possible but not inevitable.\nCognate to Dutch dijk, to West Frisian dyk, to English dyke, dike and to Saterland Frisian Diek.",{"g":"m","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[18093,"deich","noun","dyke, dike; permanent dam",0,"m"]]},"falle ins gewicht":{"entries":[["falle ins gewicht",null,null,null]],"senses":[[386062,"falle ins gewicht","verb","inflection of ins Gewicht fallen:",0],[386063,"falle ins gewicht","verb","first-person singular present",1],[386064,"falle ins gewicht","verb","first/third-person singular subjunctive I",2],[386065,"falle ins gewicht","verb","singular imperat
{"format_version":1,"partition":11158,"records":{"aische":{"entries":[["aische",null,"/ˈaɪ̯ʃə/","Borrowed from Turkish Ayşe, from Arabic عَائِشَة (ʕāʔiša). The use as a common noun is due to the name's commonness among Turkish immigrants, possibly reinforced by the unrelated noun Ische (“gal, chick”).",{"g":"f","decl":"||||n/s|n/s|n/s|n/s"}]],"senses":[[418492,"aische","name","a female given name from Arabic",0],[418493,"aische","noun","a woman or girl of Turkish descent",1,"f",["slang","offensive","mildly"]]]},"ausgestoßenen":{"entries":[["ausgestoßenen",null,"/ˈaʊ̯sɡəˌʃtoːsənən/",null]],"senses":[[619629,"ausgestoßenen","noun","inflection of Ausgestoßener:",0,"m"],[619630,"ausgestoßenen","noun","strong/weak/mixed genitive singular",1],[619631,"ausgestoßenen","noun","weak/mixed dative singular",2],[619632,"ausgestoßenen","noun","strong/weak/mixed accusative singular",3],[619633,"ausgestoßenen","noun","strong dative plural",4],[619634,"ausgestoßenen","noun","weak/mixed all-case plural",5]],"inflections":[["ausgestoßenen","ausgestoßene","dative,plural,strong"],["ausgestoßenen","ausgestoßener","genitive"]]},"mein name ist hase":{"entries":[["mein name ist hase",null,"/maɪ̯n ˈnaːmə ɪst ˈhaːzə/","Literally, “my name is Hase”, but often reinterpreted as “My name is hare”. because the underlying anecdote is not generally known. In 1854, Heidelberg student Victor von Hase gave his ID card to a fellow student, so the latter could flee to France; when the ID was later found, Hase was questioned by the university, and he replied: Mein Name ist Hase, ich verneine die Generalfragen, ich weiß von nichts. (“My name is Hase, I say no to the general questions, I know of nothing.”) His categorical denial became popular."]],"senses":[[101182,"mein name ist hase","phrase","I know (of) nothing; I am not involved",0,null,["idiomatic"]]]},"nachgeliefertem":{"entries":[["nachgeliefertem",null,null,null]],"senses":[[183199,"nachgeliefertem","adj","strong dative masculine/neuter singular of
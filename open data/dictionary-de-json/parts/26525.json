{"format_version":1,"partition":26525,"records":{"euer majestät":{"entries":[["euer majestät",null,null,"Using an archaic apocopic form of the possessive. While optional in this case, the same is more or less obligatory in some other titles like Euer Gnaden (“your Grace”), Euer Ehren (“your Honor”)."]],"senses":[[630609,"euer majestät","phrase","alternative form of Eure Majestät",0]]},"flechse":{"entries":[["flechse",null,"/ˈflɛksə/","16th century, of unknown origin. Widely assumed to be from an underlying *Flechtsehne (literally “wattle-sinew, braid-sinew”), from flechten + Sehne; but this is neither attested nor entirely clear semantically. Derivation from Latin flexus (“bent, bending”) is usually dismissed, though it should be noted that the earliest attestation of 1564 is spelt with -x-.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[376005,"flechse","noun","sinew, especially of an animal",0,"f",["archaic","regional"]]],"inflections":[["flechse","flachse","alternative"]]},"packerln":{"entries":[["packerln",null,null,null]],"senses":[[697036,"packerln","noun","plural of Packerl",0],[697037,"packerln","noun","dative plural of Packerl",1]],"inflections":[["packerln","packerl","plural"]]},"strittigem":{"entries":[["strittigem",null,null,null]],"senses":[[555393,"strittigem","adj","strong dative masculine/neuter singular of strittig",0]],"inflections":[["strittigem","strittig","dative,masculine,singular,strong,without-article"]]},"trafo":{"entries":[["trafo",null,null,"From Transformator, since the 20th century.",{"g":"m","decl":"|||s/|s|s|s|s"}]],"senses":[[647924,"trafo","noun","syllabic abbreviation of Transformator",0,"m",null,null,null,null,["electrical"]]]},"unplacierteste":{"entries":[["unplacierteste",null,null,null]],"senses":[[568698,"unplacierteste","adj","inflection of unplaciert:",0],[568699,"unplacierteste","adj","strong/mixed nominative/accusative feminine singular superlative degree",1],[568700,"unplacierteste","adj","strong nominative/accusative plural
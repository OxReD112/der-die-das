"noun","source_url":"https://tr.wiktionary.org/wiki/Gem%C3%BCsegarten","source":"tr.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["bostan, sebze bahçesi"],"id":"tr-Gemüsegarten-de-noun-rt8kH1xF"}}]}],"Verwaltung":[{"record_id":4958,"word":"Verwaltung","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Verwaltung","source":"tr.wiktionary","gender":["f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["hükûmet, idare, yönetim"],"id":"tr-Verwaltung-de-noun-CXdPrs21"},"labels":[[0,0,["politics"]]]}]}],"Theater":[{"record_id":5848,"word":"Theater","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Theater","source":"tr.wiktionary","gender":["n"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["sahneleme yapılan yer, tiyatro"],"id":"tr-Theater-de-noun-l7c4Dkt5","examples":[{"text":"Das Theater wird renoviert.","bold_text_offsets":[[4,11]],"translation":"Tiyatro yenileniyor.","bold_translation_offsets":[[0,7]]},{"text":"„Jeden Tag sitze ich in der kleinen Konditorei gegenüber dem Theater und warte auf sie.“","bold_text_offsets":[[61,68]],"translation":"Her gün tiyatronun karşısındaki küçük pastanede oturup onu bekliyorum. .","bold_translation_offsets":[[8,18]]},{"text":"„Das Theater war kein großes Theater mit einer riesigen Bühne, sondern ein kleines Theater .“","bold_text_offsets":[[5,12],[29,36],[83,90]],"translation":"Tiyatro, büyük sahnesi olan büyük bir tiyatro değil, küçük bir tiyatrodur.","bold_translation_offsets":[[0,7],[38,45],[63,70],[63,73]]}]},"labels":[[0,0,["theater"]]]},{"sense_index":1,"display_status":"translation","data":{"glosses":["tiyatrodaki bir oyun"],"id":"tr-Theater-de-noun-G8lbwPiK","examples":[{"text":"„Sie besuchte zum erstem Mal ein Kino, ein Museum, ging ins Theater und in die Oper.“","bold_text_offsets":[[60,67]],"translation":"İlk defa bir sinemayı, bir müzeyi ziyaret etti, tiyatroya ve operaya gitti.","bold_translation_offsets":[[48,57]]}]},"labels":[[0,0,["theater"]]]},{"sense_index":2,"display_status":"translation","data":{"glosses":["sahneleme sanatı"],"id":"tr-Theater-de-noun-kCXa9-4o","examples":[{"text":"Wir haben großes Theater erlebt.","bold_text_offsets":[[17,24]],"translation":"Harika bir tiyatro gördük.","bold_translation_offsets":[[11,18]]},{"text":"„Viele der beeindruckendsten Metaphern Schopenhauers (und, ehrlich gesagt, der gesamten Literaturgeschichte), sind der Welt des Theaters entliehen.“","bold_text_offsets":[[128,136]],"translation":"Schopenhauer'in en tesir edici metaforlarının çoğu (ve açıkçası bütün edebiyat tarihi) tiyatro dünyasından ödünç alınmıştır.","bold_translation_offsets":[[87,94]]}]},"labels":[[0,0,["theater"]]]},{"sense_index":3,"display_status":"translation","data":{"glosses":["tiyatro oynayan oyuncular grubu"],"id":"tr-Theater-de-noun-WNZd3Jtj"},"labels":[[0,0,["theater"]]]},{"sense_index":4,"display_status":"translation","data":{"glosses":["(âmiyâne): gösteri, isyan, kargaşa, rahatsız etme, skandal, yaygara"],"id":"tr-Theater-de-noun-kUEJbZ3Q","examples":[{"text":"Mach nicht immer so ein Theater.","bold_text_offsets":[[24,31]],"translation":"Her zaman böyle yaygara koparma.","bold_translation_offsets":[[16,23]]}]}}]},{"record_id":5849,"word":"Theater","pos":"noun","source_pos":"abbrev","source_url":"https://tr.wiktionary.org/wiki/Theater","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"no-gloss","data":{"id":"tr-Theater-de-abbrev-47DEQpj8","tags":["no-gloss"]}}]}],"Forschung":[{"record_id":6621,"word":"Forschung","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Forschung","source":"tr.wiktionary","gender":["f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["araştırma, inceleme, tetkik"],"id":"tr-Forschung-de-noun-UidbQHxv","raw_tags":["araştırma"],"examples":[{"text":"Die Forschung soll immer neue Erkenntnisse erarbeiten.","bold_text_offsets":[[4,13]],"translation":"Araştırma her zaman yeni bulgular üretmelidir.","bold_translation_offsets":[[0,9]]},{"text":"„Ohnehin sei juristische Forschung, wie sie jetzt in Kooperation mit den russischen Strafrechtlern erfolgt […], keine Selbstverständlichkeit, so der Potsdamer Rechtswissenschaftler.“","bold_text_offsets":[[25,35]],"translation":"Her hâlükârda Potsdamlı hukuk mütehassısına göre şu anda Rus ceza avukatlarıyla iş birliği içinde yürütülmekte olan hukukî araştırma, kat'î değildir […].","bold_translation_offsets":[[123,132]]},{"text":"„Alltägliche Nahrungsmittel, die Impfstoffe oder andere medizinisch wirksame Zusatzstoffe enthalten, gibt es zwar noch nicht zu kaufen, sie sind aber schon Gegenstand der Forschung.“","bold_text_offsets":[[171,181]],"translation":"Aşılar veya diğer tıbbî açıdan etkili katkı maddeleri içeren günlük gıdalar henüz satın alınamıyor, ancak bunlar zaten araştırma konusu.","bold_translation_offsets":[[119,128]]},{"text":"„Privatgelehrte und Kulturaktivisten veröffentlichten ihre Forschungen zur jüdischen Geschichte und zur jiddischen Sprache und kitap kaynağı vermehrt auf Jiddisch.“","bold_text_offsets":[[59,70]],"translation":"Özel akademisyenler ve kültürel aktivistler, Yahudi tarihi ve Yahudi Almancası ve edebiyatı hakkındaki araştırmalarını Yahudi Almancasında giderek daha fazla yayınladılar.","bold_translation_offsets":[[103,118]]},{"text":"„Auch heute noch herrscht an kreativer Forschung kein Mangel.“","bold_text_offsets":[[39,48]],"translation":"Bugün bile kreatif araştırma konusunda hâlâ bir eksiklik yok.","bold_translation_offsets":[[19,28]]}]}},{"sense_index":1,"display_status":"translation","data":{"glosses":["araştırma yapanların bütünü"],"id":"tr-Forschung-de-noun-3DN7f0F7","raw_tags":["araştırma","meslekler"],"examples":[{"text":"„Die Forschung weiß, dass diese Art von Aufopferung zu den härtesten Belastungen gehört, denen ein Mensch sich aussetzen kann.“","bold_text_offsets":[[5,14]],"translation":"Araştırmalar, bu tür fedakârlığın bir kişinin maruz kalabileceği en ağır streslerden biri olduğunu biliyor.","bold_translation_offsets":[[0,12]]},{"text":"„Doktor Vielguts Denkweise ist in der Forschung weit verbreitet.“","bold_text_offsets":[[38,47]],"translation":"Doktor Vielgut'un düşünce tarzı araştırmalarda yaygındır.","bold_translation_offsets":[[32,46]]}]}}]}],"Förster":[{"record_id":8137,"word":"Förster","pos":"name","source_url":"https://tr.wiktionary.org/wiki/F%C3%B6rster","source":"tr.wiktionary","gender":["m","f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Bir soyadı."],"id":"tr-Förster-de-name-twAi7g4e"},"name_like":["person","soyadı / ad"],"shown":["Bir soyadı"]}]},{"record_id":1007226,"word":"Förster","pos":"noun","source_url":"https://de.wiktionary.org/wiki/F%C3%B6rster","source":"de.wiktionary","gender":["m"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["ormancı"],"id":"de-Förster-noun-1","sense_number":"1","definition_de":"beruflich mit der Verwaltung und Bewirtschaftung eines Walds und des dortigen Wilds betraute Person"}}]}],"Frieder":[{"record_id":8497,"word":"Frieder","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Frieder","source":"tr.wiktionary","gender":["m","f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Bir soyadı."],"id":"tr-Frieder-de-name-twAi7g4e"},"name_like":["person","soyadı / ad"],"shown":["Bir soyadı"]}]}],"purulent":[{"record_id":11911,"word":"purulent","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/purulent","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"no-gloss","data":{"glosses":["Bu tanımın Türkçe çevirisi şimdilik Vikisözlük'te eksik hâldedir. Lütfen eklenmesine yardımcı olun ve sonrasında {{tanımisteniyor}} şablonunu kaldırın."],"id":"tr-purulent-de-adj-9Eb2Fz7a"}}]}],"extrasolar":[{"record_id":12228,"word":"extrasolar","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/extrasolar","source":"tr.wiktionary","senses":[{"sense
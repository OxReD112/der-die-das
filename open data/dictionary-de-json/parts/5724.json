 handle”), from Old High German hanthaba, anthaba (also Old Saxon handhava; Middle Dutch hanthave only attested 1490), but the semantics seem problematic. Alternatively a new compound from hant + Middle High German habe, Middle Dutch have (“possession, belongings”); cf. Middle High German hanthab (“stolen good”, ca. 1350).",{"g":"n","decl":"|||s|-|-|-|-"}]],"senses":[[186013,"handhaben","verb","to handle, to wield, to employ (a tool, often not in a resultative sense but rather indicating the manner or quality of employment)",0],[186014,"handhaben","verb","to go about, to deal with, to handle (a situation or matter, often not in a resultative sense but rather indicating the general strategy or manner in which a challenge is approached)",1],[186015,"handhaben","verb","to protect someone, to enforce their rights",2,null,["obsolete"]],[186016,"handhaben","noun","gerund of handhaben",3,"n"]],"related_forms":[[52404,"handhaben","handhaber","derived"],[52405,"handhaben","handhabung","derived"],[52406,"handhaben","handhaben","related"],[52407,"handhaben","handhabe","related"],[52408,"handhaben","handhabend","related"],[52409,"handhaben","hantieren","related"]],"inflections":[["handhaben","handhabe","plural"]]},"hantiertest":{"entries":[["hantiertest",null,null,null]],"senses":[[377760,"hantiertest","verb","inflection of hantieren:",0],[377761,"hantiertest","verb","second-person singular preterite",1],[377762,"hantiertest","verb","second-person singular subjunctive II",2]],"inflections":[["hantiertest","hantieren","indicative,preterite,second-person,singular"]]},"intonation":{"entries":[["intonation",null,null,null,{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[389231,"intonation","noun","intonation",0,"f"]]},"kirchengestühle":{"entries":[["kirchengestühle",null,null,null]],"senses":[[384113,"kirchengestühle","noun","nominative/accusative/genitive plural of Kirchengestühl",0,"n"]],"inflections":[["kirchengestühle","kirchengestühl","plural"]]},"kompostes":{"entries":[["kompo
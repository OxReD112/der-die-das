ned rare until the 16th century. Its derivation from the -i- in Latin corporis, corpori seems unlikely in such a late borrowing. Probably the dissimilated variant körpel received the umlaut by analogy with diminutives in -el. Some Central German dialects show secondary umlaut before -r- + labial (see Hunsrik Kerrper, Kerrver and Luxembourgish Kierper), but precisely these dialects make little or no use of this word. See English corpse for more.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[18961,"körper","noun","body (of a person, animal, etc.)",0,"m"],[18962,"körper","noun","body",1,"m"],[18963,"körper","noun","body, solid (three-dimensional object)",2,"m"],[18964,"körper","noun","field (algebraic structure with addition and multiplication)",3,"m"]],"related_forms":[[28739,"körper","körperlich","derived"],[28740,"körper","körpergeruch","related"],[28741,"körper","körpergröße","related"],[28742,"körper","körperhaltung","related"],[28743,"körper","körperlänge","related"],[28744,"körper","körperlich","related"],[28745,"körper","körpermolekül","related"],[28746,"körper","körpernah","related"],[28747,"körper","körperschaft","related"],[28748,"körper","körpersprache","related"],[28749,"körper","körperteil","related"],[28750,"körper","körperumfang","related"],[28751,"körper","körperverletzung","related"]]},"lichtverschmutzung":{"entries":[["lichtverschmutzung",null,"[ˈlɪçtfɛɐ̯ˌʃmʊt͡sʊŋ]","Licht + Verschmutzung",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[615087,"lichtverschmutzung","noun","light pollution",0,"f"]]},"programmierens":{"entries":[["programmierens",null,null,null]],"senses":[[143489,"programmierens","noun","genitive singular of Programmieren",0]],"inflections":[["programmierens","programmieren","genitive"]]},"pulverhornes":{"entries":[["pulverhornes",null,null,null]],"senses":[[647301,"pulverhornes","noun","genitive singular of Pulverhorn",0]],"inflections":[["pulverhornes","pulverhorn","genitive"]]},"risikofaktors":{"entries":[["risikofaktors",null,null,nul
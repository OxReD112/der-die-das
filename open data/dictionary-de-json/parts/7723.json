 do it",1]],"related_forms":[[49330,"friemeln","auseinanderfriemeln","derived"],[49331,"friemeln","friemelei","derived"],[49332,"friemeln","herumfriemeln","derived"],[49333,"friemeln","reinfriemeln","derived"]]},"gebrauchten":{"entries":[["gebrauchten",null,null,null]],"senses":[[153538,"gebrauchten","adj","inflection of gebraucht:",0],[153539,"gebrauchten","adj","strong genitive masculine/neuter singular",1],[153540,"gebrauchten","adj","weak/mixed genitive/dative all-gender singular",2],[153541,"gebrauchten","adj","strong/weak/mixed accusative masculine singular",3],[153542,"gebrauchten","adj","strong dative plural",4],[153543,"gebrauchten","adj","weak/mixed all-case plural",5]],"inflections":[["gebrauchten","gebrauchen","first-person,indicative,plural,preterite"],["gebrauchten","gebraucht","genitive,masculine,singular,strong,without-article"]]},"gehen her":{"entries":[["gehen her",null,null,null]],"senses":[[273744,"gehen her","verb","inflection of hergehen:",0],[273745,"gehen her","verb","first/third-person plural present",1],[273746,"gehen her","verb","first/third-person plural subjunctive I",2]]},"herzerfrischenderer":{"entries":[["herzerfrischenderer",null,null,null]],"senses":[[483074,"herzerfrischenderer","adj","inflection of herzerfrischend:",0],[483075,"herzerfrischenderer","adj","strong/mixed nominative masculine singular comparative degree",1],[483076,"herzerfrischenderer","adj","strong genitive/dative feminine singular comparative degree",2],[483077,"herzerfrischenderer","adj","strong genitive plural comparative degree",3]],"inflections":[["herzerfrischenderer","herzerfrischend","comparative,masculine,nominative,singular,strong,without-article"]]},"heyßestem":{"entries":[["heyßestem",null,null,null]],"senses":[[339294,"heyßestem","adj","strong dative masculine/neuter singular superlative degree of heyß",0]],"inflections":[["heyßestem","heyß","dative,masculine,singular,strong,superlative,without-article"]]},"hügelgräber":{"entries":[["hügelgräber",null,n
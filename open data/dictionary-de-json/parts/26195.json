rst-person,indicative,plural,preterite"]]},"zwo":{"entries":[["zwo",null,"/t͡svoː/","Zwo was originally feminine of Early New High German zween m, but is now used as a variant of zwei without gender distinction. Compare, however, Luxembourgish zwou, which is still a feminine form of zwéin. The same is true of some German dialects, e.g. in Switzerland.\nIt is inherited from the feminine numerals: Middle High German zwō f, from Old High German zwō f, from Proto-West Germanic twō f, from Proto-Germanic *twaōz, *twōz f, from Proto-Indo-European *dweh₂h₁(e) f.\nMore at Proto-Germanic *twai m."]],"senses":[[13240,"zwo","num","two",0],[13241,"zwo","num","feminine of zween",1,null,["obsolete","dialectal","~in Standard German"]]],"inflections":[["zwo","zween","feminine"]]},"überlegenheiten":{"entries":[["überlegenheiten",null,null,null]],"senses":[[384806,"überlegenheiten","noun","plural of Überlegenheit",0,"f"]],"inflections":[["überlegenheiten","überlegenheit","plural"]]},"audiophileres":{"inflections":[["audiophileres","audiophil","comparative,neuter,nominative,singular,strong,without-article"]]},"löwenern":{"inflections":[["löwenern","löwener","dative,definite,plural"]]},"nachrechnens":{"inflections":[["nachrechnens","nachrechnen","genitive"]]},"schrappte":{"inflections":[["schrappte","schrappen","past"]]},"verflüchtige":{"inflections":[["verflüchtige","verflüchtigen","first-person,indicative,present,singular"]]},"vorbeigeschrammt":{"inflections":[["vorbeigeschrammt","vorbeischrammen","participle,past"]]}}}
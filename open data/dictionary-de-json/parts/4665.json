{"format_version":1,"partition":4665,"records":{"10-dm-banknoten":{"entries":[["10-dm-banknoten",null,"[t͡seːnˈdeːmaʁkˌbaŋknoːtən]",null]],"senses":[[694000,"10-dm-banknoten","noun","plural of 10-DM-Banknote",0,"f"]],"inflections":[["10-dm-banknoten","10-dm-banknote","plural"]]},"aaß":{"entries":[["aaß",null,null,null,{"g":"n","decl":"||/e|es|e|e|en|e"}]],"senses":[[213010,"aaß","noun","obsolete spelling of Aas",0,"n",["obsolete"]]]},"auskurieren":{"entries":[["auskurieren",null,null,"aus- + kurieren"]],"senses":[[600901,"auskurieren","verb","to fully cure",0]]},"befriedungen":{"entries":[["befriedungen",null,null,null]],"senses":[[606569,"befriedungen","noun","plural of Befriedung",0]],"inflections":[["befriedungen","befriedung","plural"]]},"beginnendes":{"entries":[["beginnendes",null,null,null]],"senses":[[595231,"beginnendes","verb","strong/mixed nominative/accusative neuter singular of beginnend",0]],"inflections":[["beginnendes","beginnend","neuter,nominative,singular,strong,without-article"]]},"bönhase":{"entries":[["bönhase",null,"/ˈbøːnˌhaːzə/","From Middle Low German bönhase, bonehase (“cat”), from böne (“loft, attic”) + hase (“hare”), the former being cognate of German Bühne (“stage”). The word is first attested in the early 14th century as a personal name (and is thus probably even older). Since the 15th century it meant “illegally working craftsperson”. The sense “cat” is only attested later on, but there can be little doubt that it is the original meaning. Compare German Dachhase, English roof rabbit, etc., which in fact must be loan translations of the Low German unless there were some ancient source for all of them. It was formerly supposed that the illegal workers were called Bönhasen as a pun on Ancient Greek βάναυσος (bánausos, “worker in an ignoble trade”), whence later German Banause, but this is highly unlikely since Greek studies were only just being revived in the 15th century. More probably these workers were simply compared to stray cats who holed up in lofts and fled when chased (as they commonly were by the members of the official guilds).",{"g":"m","decl":"|n|n|n|n|n|n|n"}]],"senses":[[10413,"bönhase","noun","cat; roof rabbit",0,"m",["archaic","humorous","Northern-Germany"]],[10414,"bönhase","noun","A skilled manual worker or craftsperson who works illegally, originally without the concession of the respective guild.",1,"m",["historical","Northern-Germany"]],[10415,"bönhase","noun","botcher; bungler (incompetent worker)",2,"m",["Northern-Germany"]]],"related_forms":[[13410,"bönhase","bühne","related"],[13411,"bönhase","hase","related"]]},"couvert":{"entries":[["couvert",null,null,"Borrowed from French couvert.",{"g":"n","decl":"|||s|s|s|s|s"}]],"senses":[[33630,"couvert","noun","alternative spelling of Kuvert",0,"n"]],"inflections":[["couvert","kuvert","alternative"]]},"desertierend":{"entries":[["desertierend",null,null,null]],"senses":[[71989,"desertierend","verb","present participle of desertieren",0]],"inflections":[["desertierend","desertieren","participle,present"]]},"eingeschüchterter":{"entries":[["eingeschüchterter",null,null,null]],"senses":[[628361,"eingeschüchterter","adj","comparative degree of eingeschüchtert",0],[628362,"eingeschüchterter","adj","inflection of eingeschüchtert:",1],[628363,"eingeschüchterter","adj","strong/mixed nominative masculine singular",2],[628364,"eingeschüchterter","adj","strong genitive/dative feminine singular",3],[628365,"eingeschüchterter","adj","strong genitive plural",4]],"inflections":[["eingeschüchterter","eingeschüchtert","masculine,nominative,singular,strong"]]},"einstweilig":{"entries":[["einstweilig",null,"/ˈaɪ̯nstvaɪ̯lɪç/",null]],"senses":[[145115,"einstweilig","adj","temporary",0],[145116,"einstweilig","adj","provisional, interim",1]]},"energiearmen":{"entries":[["energiearmen",null,null,null]],"senses":[[223719,"energiearmen","adj","inflection of energiearm:",0],[223720,"energiearmen","adj","strong genitive masculine/neuter singular",1],[223721,
{"format_version":1,"partition":163,"records":{"brandschatzung":{"entries":[["brandschatzung",null,null,"Brandschatz + -ung. 16th-century recharacterization of the earlier (Middle High German) synonym Brandschatz.\nThe original meaning of the term is \"exaction of tribute under the threat of pillaging\". The shift to the now-prevalent meaning of \"looting, pillaging\" takes place in the 20th century, apparently by misunderstanding, but this usage is now sanctioned by the Duden, which glosses the term as Plünderung (“pillage”).",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[119005,"brandschatzung","noun","the exaction of tribute from a city under the threat of setting fire to it.",0,"f"],[119006,"brandschatzung","noun","looting and pillaging",1,"f"]]},"couragierteres":{"entries":[["couragierteres",null,null,null]],"senses":[[284384,"couragierteres","adj","strong/mixed nominative/accusative neuter singular comparative degree of couragiert",0]],"inflections":[["couragierteres","couragiert","comparative,neuter,nominative,singular,strong,without-article"]]},"elftältestes":{"entries":[["elftältestes",null,null,null]],"senses":[[676247,"elftältestes","adj","strong/mixed nominative/accusative neuter singular of elftältest",0]],"inflections":[["elftältestes","elftältest","neuter,nominative,singular,strong,without-article"]]},"exfreunde":{"entries":[["exfreunde",null,null,null]],"senses":[[593857,"exfreunde","noun","nominative/accusative/genitive plural of Exfreund",0],[593858,"exfreunde","noun","dative of Exfreund",1]],"inflections":[["exfreunde","exfreund","plural"]]},"gelehrteste":{"entries":[["gelehrteste",null,null,null]],"senses":[[365121,"gelehrteste","adj","inflection of gelehrt:",0],[365122,"gelehrteste","adj","strong/mixed nominative/accusative feminine singular superlative degree",1],[365123,"gelehrteste","adj","strong nominative/accusative plural superlative degree",2],[365124,"gelehrteste","adj","weak nominative all-gender singular superlative degree",3],[36512
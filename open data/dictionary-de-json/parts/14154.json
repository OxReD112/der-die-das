{"format_version":1,"partition":14154,"records":{"draht":{"entries":[["draht",null,"/dʁaːt/","From Middle High German drāt (“wire, thread”), from Old High German drāt, thrāt, from Proto-West Germanic *þrādu, from Proto-Germanic *þrēduz, from Proto-Indo-European *treh₁-tu-, from *terh₁- (“rub, twist”). Related to drehen (“to turn, twist”), with which it was still associated in early modern German, as is proved by the insertion of the lengthening -h- (which is only used before sonorants or stem-finally). Cognate with Dutch draad, Low German Draat, English thread, Danish, Norwegian, and Swedish tråd, Icelandic þráður.",{"g":"m","decl":"||/e|es/s|3ähte|3ähte|3ähten|3ähte"}]],"senses":[[16418,"draht","noun","wire (thread of metal; conductor)",0,"m"],[16419,"draht","noun","thread",1,"m",["obsolete"]]],"related_forms":[[24351,"draht","drahtig","derived"],[24352,"draht","drahtlos","derived"],[24353,"draht","einen guten draht haben","derived"],[24354,"draht","guter draht","derived"],[24355,"draht","verdrahten","derived"],[24356,"draht","drahtbrücke","related"],[24357,"draht","drahtesel","related"],[24358,"draht","drahtseil","related"],[24359,"draht","drahtsieb","related"],[24360,"draht","drahtzaun","related"],[24361,"draht","drahtzieher","related"],[24362,"draht","eisendraht","related"],[24363,"draht","golddraht","related"],[24364,"draht","kaninchendraht","related"],[24365,"draht","kupferdraht","related"],[24366,"draht","maschendraht","related"],[24367,"draht","nanodraht","related"],[24368,"draht","nato-draht","related"],[24369,"draht","silberdraht","related"],[24370,"draht","stacheldraht","related"]],"inflections":[["draht","drahten","imperative,second-person,singular"]]},"gescheiten":{"entries":[["gescheiten",null,null,null]],"senses":[[474667,"gescheiten","adj","inflection of gescheit:",0],[474668,"gescheiten","adj","strong genitive masculine/neuter singular",1],[474669,"gescheiten","adj","weak/mixed genitive/dative all-gender singular",2],[474670,"gescheiten","adj","stro
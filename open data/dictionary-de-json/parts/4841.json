{"format_version":1,"partition":4841,"records":{"abgebrüht":{"entries":[["abgebrüht",null,"/ˈap.ɡəˌbʁyːt/","Attested from the 16th century. Formally, ab (“off”) + gebrüht (“scalded, boiled”), based on the idea that things are hardened or “steeled” by boiling (e.g. eggs, compare hartgesotten, English hard-boiled). At the same time, perhaps originally, from vulgar Middle Low German brǖden (“to fuck”, also in the sense of “to afflict”), cognate and synonymous with early modern German bräuten, from Braut (“bride”); meaning that someone is the opposite of “innocent”."]],"senses":[[417236,"abgebrüht","adj","callous and cunning; experienced in “the game”, in immoral behaviour",0,null,["derogatory"]]],"inflections":[["abgebrüht","abbrühen","participle,past"]]},"auskünften":{"entries":[["auskünften",null,null,null]],"senses":[[353075,"auskünften","noun","dative plural of Auskunft",0,"f"]],"inflections":[["auskünften","auskunft","dative,definite,plural"]]},"bewegliches":{"entries":[["bewegliches",null,null,null]],"senses":[[187936,"bewegliches","adj","strong/mixed nominative/accusative neuter singular of beweglich",0]],"inflections":[["bewegliches","beweglich","neuter,nominative,singular,strong,without-article"]]},"chaotischster":{"entries":[["chaotischster",null,null,null]],"senses":[[284252,"chaotischster","adj","inflection of chaotisch:",0],[284253,"chaotischster","adj","strong/mixed nominative masculine singular superlative degree",1],[284254,"chaotischster","adj","strong genitive/dative feminine singular superlative degree",2],[284255,"chaotischster","adj","strong genitive plural superlative degree",3]],"inflections":[["chaotischster","chaotisch","masculine,nominative,singular,strong,superlative,without-article"]]},"einsprachigen":{"entries":[["einsprachigen",null,null,null]],"senses":[[401963,"einsprachigen","adj","inflection of einsprachig:",0],[401964,"einsprachigen","adj","strong genitive masculine/neuter singular",1],[401965,"einsprachigen","adj","weak/mixed genitiv
{"format_version":1,"partition":30823,"records":{"anstandslos":{"entries":[["anstandslos",null,"/ˈanʃtantsˌloːs/","From Anstand (“objection; decency”) + -s- + -los (“-less”). The sense “objection” is chiefly obsolete except in the dated expression Anstand nehmen an (“to object to”). Still common is the derivative verb beanstanden."]],"senses":[[634491,"anstandslos","adj","willing, ready, prompt, without objection or undue delay",0],[634492,"anstandslos","adj","insolent, without decency",1,null,["Switzerland"]]]},"banjospieler":{"entries":[["banjospieler",null,"/ˈbɛn.(d)ʒoˌʃpiːlɐ/","From Banjo + Spieler.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[711383,"banjospieler","noun","banjoist, banjo player (one who plays a banjo)",0,"m"]],"inflections":[["banjospieler","banjospielerin","masculine"]]},"kabylisches":{"entries":[["kabylisches",null,null,null]],"senses":[[213942,"kabylisches","adj","strong/mixed nominative/accusative neuter singular of kabylisch",0]],"inflections":[["kabylisches","kabylisch","neuter,nominative,singular,strong,without-article"]]},"versammlungen":{"entries":[["versammlungen",null,null,null]],"senses":[[56424,"versammlungen","noun","plural of Versammlung",0]],"inflections":[["versammlungen","versammlung","plural"]]},"aufrieft":{"inflections":[["aufrieft","aufrufen","indicative,plural,preterite,second-person,subordinate-clause"]]},"ausbrächten":{"inflections":[["ausbrächten","ausbringen","first-person,plural,subjunctive,subjunctive-ii,subordinate-clause"]]},"elbetals":{"inflections":[["elbetals","elbetal","definite,genitive,singular"]]},"gebeugtester":{"inflections":[["gebeugtester","gebeugt","masculine,nominative,rare,singular,strong,superlative,without-article"]]},"schuldgeplagter":{"inflections":[["schuldgeplagter","schuldgeplagt","masculine,nominative,singular,strong"]]},"verzäunst":{"inflections":[["verzäunst","verzäunen","indicative,present,second-person,singular"]]}}}
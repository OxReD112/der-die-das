{"format_version":1,"partition":27538,"records":{"-heit":{"entries":[["-heit",null,"/-haɪ̯t/","From Middle High German -heit, from Old High German -heit, from Proto-West Germanic *-haidu, ultimately from Proto-Germanic *haiduz (“personality, character, manner, way”). Cognate with Dutch -heid, English -hood, Danish -hed."]],"senses":[[14782,"-heit","suffix","Converts an adjective into a noun and usually denotes an abstract quality of the adjectival root. It is often equivalent to the English suffixes -ness, -th, -ty, -dom",0],[14783,"-heit","suffix","Converts concrete nouns into abstract nouns",1]]},"arbeitsunfähigkeit":{"entries":[["arbeitsunfähigkeit",null,"[ˈaʁbaɪ̯t͡sʊnfɛːɪçkaɪ̯t]","From Arbeit + -s- + Unfähigkeit.",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[229016,"arbeitsunfähigkeit","noun","sick leave",0,"f",null,null,null,null,["healthcare"]]]},"arschritze":{"entries":[["arschritze",null,null,"Arsch + Ritze"]],"senses":[[646016,"arschritze","noun","crack (space between the buttocks)",0,null,["colloquial","vulgar"]]]},"finanzschwächster":{"entries":[["finanzschwächster",null,null,null]],"senses":[[289699,"finanzschwächster","adj","inflection of finanzschwach:",0],[289700,"finanzschwächster","adj","strong/mixed nominative masculine singular superlative degree",1],[289701,"finanzschwächster","adj","strong genitive/dative feminine singular superlative degree",2],[289702,"finanzschwächster","adj","strong genitive plural superlative degree",3]],"inflections":[["finanzschwächster","finanzschwach","masculine,nominative,singular,strong,superlative,without-article"]]},"germanisieren":{"entries":[["germanisieren",null,"/ˌɡɛʁmaːniˈziːʁən/","From germanisch + -isieren.",{"g":"n","decl":"|||s|-|-|-|-"},"haben"]],"senses":[[587948,"germanisieren","verb","to Germanize",0],[587949,"germanisieren","verb","to confiscate Jewish property and make it the property of a German",1,null,["uncommon","Nazism"]],[587950,"germanisieren","noun","gerund of germanisieren",2,"n"]],"relate
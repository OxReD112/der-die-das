","verb","to be possible, to make sense",3],[14853,"können","verb","to be allowed (to do something); to be permitted (to do something); may.",4],[14854,"können","verb","to be in the legal situation of being able to realize a legal effect even if it be legally disallowed",5],[14855,"können","verb","to be to blame, to be at fault",6,null,["informal","~in the negative with \"nichts\""]],[14856,"können","noun","gerund of können; skill, ability",7,"n"]],"related_forms":[[21511,"können","können","derived"],[21512,"können","könner","derived"]]},"leistungsfähigeren":{"entries":[["leistungsfähigeren",null,null,null]],"senses":[[223430,"leistungsfähigeren","adj","inflection of leistungsfähig:",0],[223431,"leistungsfähigeren","adj","strong genitive masculine/neuter singular comparative degree",1],[223432,"leistungsfähigeren","adj","weak/mixed genitive/dative all-gender singular comparative degree",2],[223433,"leistungsfähigeren","adj","strong/weak/mixed accusative masculine singular comparative degree",3],[223434,"leistungsfähigeren","adj","strong dative plural comparative degree",4],[223435,"leistungsfähigeren","adj","weak/mixed all-case plural comparative degree",5]],"inflections":[["leistungsfähigeren","leistungsfähig","comparative,genitive,masculine,singular,strong,without-article"]]},"mais.-whg.":{"entries":[["mais.-whg.",null,null,null]],"senses":[[34656,"mais.-whg.","noun","abbreviation of Maisonettenwohnung",0]]},"materialistischen":{"entries":[["materialistischen",null,null,null]],"senses":[[517561,"materialistischen","adj","inflection of materialistisch:",0],[517562,"materialistischen","adj","strong genitive masculine/neuter singular",1],[517563,"materialistischen","adj","weak/mixed genitive/dative all-gender singular",2],[517564,"materialistischen","adj","strong/weak/mixed accusative masculine singular",3],[517565,"materialistischen","adj","strong dative plural",4],[517566,"materialistischen","adj","weak/mixed all-case plural",5]],"inflections":[["materialistischen"
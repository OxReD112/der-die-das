{"format_version":1,"partition":5397,"records":{"-erei":{"entries":[["-erei",null,"/əˈʁaɪ̯/","From Middle High German -erīe, from Old French -erie. The suffix first became productive in German to designate workshops pertaining to occupation names ending in -er, such as Bäckerei (“bakery”) from Bäcker (“baker”). These cases are more properly analyzed as derivations in -ei from the occupation name. Later on, -erei began to be freely attached to verb stems, autonomously from agent nouns. Compare e.g. Bäckerei above with Backerei (“baking”) derived directly from backen (“to bake”). Similar developments took place in Dutch -erij and, to a lesser degree, English -ery."]],"senses":[[33263,"-erei","suffix","Used to form verbal nouns, which often have an informal, frequentative and/or negative overtone.",0]]},"augenweide":{"entries":[["augenweide",null,"/ˈaʊ̯ɡn̩ˌvaɪ̯də/","From Middle High German ougenweide. Equivalent to Auge (“eye”) + Weide (“meal”), the latter element being obsolete in this sense in modern German.",{"g":"f","decl":"||||n|n|n|n"}]],"senses":[[33696,"augenweide","noun","feast for the eyes, eye candy",0,"f",["dated"]]]},"ausstrahlten":{"entries":[["ausstrahlten",null,null,null]],"senses":[[663831,"ausstrahlten","verb","inflection of ausstrahlen:",0],[663832,"ausstrahlten","verb","first/third-person plural dependent preterite",1],[663833,"ausstrahlten","verb","first/third-person plural dependent subjunctive II",2]],"inflections":[["ausstrahlten","ausstrahlen","first-person,indicative,plural,preterite,subordinate-clause"]]},"begünstigt":{"entries":[["begünstigt",null,null,null]],"senses":[[223541,"begünstigt","verb","past participle of begünstigen - benefited",0],[223542,"begünstigt","adj","preferential",1]],"inflections":[["begünstigt","begünstigen","present,singular,third-person"]]},"berußt":{"entries":[["berußt",null,null,null]],"senses":[[269948,"berußt","verb","past participle of berußen",0],[269949,"berußt","verb","inflection of berußen:",1],[269950,"beru
{"format_version":1,"partition":27152,"records":{"fisimatenten":{"entries":[["fisimatenten",null,"/ˌfɪ.zi.maˈtɛn.tən/","From Central Franconian visimetent (“nonsense”, attested 1499 in Cologne; now in the form Fissematente). Further origin unsettled. Possibly from Middle High German visament, fisiment (“ornamentation of a coat of arms”).\nPopular etymology has derived it from French je visite ma tante (“I'm visiting my aunt”), used as an excuse, or visitez ma tente (“visit my tent”), supposedly used by soldiers to invite girls to their garrisons. None of this is factual, however.",{"g":"p","decl":"-|-|-|-||||"}]],"senses":[[418362,"fisimatenten","noun","fuss; ado; useless or fretful behaviour, talk",0,"p",["colloquial"]]]},"gestotter":{"entries":[["gestotter",null,"/ɡəˈʃtɔtɐ/","ge- + stottern",{"g":"n","decl":"|||s|-|-|-|-"}]],"senses":[[609146,"gestotter","noun","stuttering",0,"n"]]},"hydrogeniumoxid":{"entries":[["hydrogeniumoxid",null,null,null,{"g":"n","decl":"||/e|es/s|e|e|en|e"}]],"senses":[[174003,"hydrogeniumoxid","noun","hydrogen oxide",0,"n",null,null,null,null,["inorganic-chemistry"]]]},"hürdenläufen":{"entries":[["hürdenläufen",null,null,null]],"senses":[[712304,"hürdenläufen","noun","dative plural of Hürdenlauf",0]],"inflections":[["hürdenläufen","hürdenlauf","dative,definite,plural"]]},"lagertest ein":{"entries":[["lagertest ein",null,null,null]],"senses":[[380832,"lagertest ein","verb","inflection of einlagern:",0],[380833,"lagertest ein","verb","second-person singular preterite",1],[380834,"lagertest ein","verb","second-person singular subjunctive II",2]]},"liebesnests":{"entries":[["liebesnests",null,null,null]],"senses":[[690543,"liebesnests","noun","genitive singular of Liebesnest",0]],"inflections":[["liebesnests","liebesnest","genitive"]]},"minnesingern":{"entries":[["minnesingern",null,null,null]],"senses":[[665795,"minnesingern","noun","dative plural of Minnesinger",0]],"inflections":[["minnesingern","minnesinger","dative,definite,plural"]]},"
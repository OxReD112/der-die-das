anic *krumô, *krūmô (“fragment, crumb”). Cognate with English crumb. Also related to Dutch kruim, which goes back to a variant with an original long vowel, however.\nThe modern long vowel in Krümel is due to the levelling effect of Krume. The expected form would be *Krümmel since following -mel, -mer regularly blocked vowel lengthening in open syllables (compare Himmel, Hammer). Pronunciations with a short vowel remain current in regional speech.",{"g":"m","decl":"|||s|||n|"}]],"senses":[[3016,"krümel","noun","crumb (small broken-off piece, particularly of bread)",0,"m"]],"inflections":[["krümel","krümeln","first-person,indicative,present,singular"]]},"nachgeht":{"entries":[["nachgeht",null,null,null]],"senses":[[661853,"nachgeht","verb","inflection of nachgehen:",0],[661854,"nachgeht","verb","second-person plural dependent present",1],[661855,"nachgeht","verb","third-person singular dependent present",2]],"inflections":[["nachgeht","nachgehen","indicative,plural,present,second-person,subordinate-clause"]]},"oberengadinerin":{"entries":[["oberengadinerin",null,"[ˈoːbɐˌʔɛŋɡadiːnəʁɪn]","From Oberengadiner + -in",{"g":"f","decl":"||||nen|nen|nen|nen"}]],"senses":[[707177,"oberengadinerin","noun","female equivalent of Oberengadiner",0,"f"]]},"rationiertet":{"entries":[["rationiertet",null,null,null]],"senses":[[78370,"rationiertet","verb","inflection of rationieren:",0],[78371,"rationiertet","verb","second-person plural preterite",1],[78372,"rationiertet","verb","second-person plural subjunctive II",2]],"inflections":[["rationiertet","rationieren","indicative,plural,preterite,second-person"]]},"sulfoxylate":{"entries":[["sulfoxylate",null,null,null]],"senses":[[221209,"sulfoxylate","noun","nominative/accusative/genitive plural of Sulfoxylat",0,"n"]],"inflections":[["sulfoxylate","sulfoxylat","plural"]]},"wandelbares":{"entries":[["wandelbares",null,null,null]],"senses":[[581070,"wandelbares","adj","strong/mixed nominative/accusative neuter singular of wandelbar",0]],"in
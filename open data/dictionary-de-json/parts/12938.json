{"format_version":1,"partition":12938,"records":{"für lau":{"entries":[["für lau",null,"/fyːr ˈlaʊ̯/","From West Central German dialects, from für (“for”) + a word that is generally derived from Yiddish לא (loy, “no, not”), pronounced lou in Western Yiddish, from Hebrew לֹא (lō, “no, not”).\nAlternatively lau could be simply the adjective lau (literally “lukewarm”), which is also used for “lazy, parasitic” in the same dialects. The most probable scenario is perhaps that both words have influenced each other."]],"senses":[[589651,"für lau","adv","for free",0,null,["informal","regional","Germany","Western"]]]},"laffes":{"entries":[["laffes",null,null,null]],"senses":[[408204,"laffes","adj","strong/mixed nominative/accusative neuter singular of laff",0]],"inflections":[["laffes","laff","neuter,nominative,singular,strong,without-article"]]},"losketten":{"entries":[["losketten",null,"[ˈloːsˌkɛtn̩]","los- + Kette + -en",null,"haben"]],"senses":[[593535,"losketten","verb","to unchain",0]]},"moren":{"entries":[["moren",null,"/moːɐ̯n/",null]],"senses":[[101582,"moren","noun","plural of More",0],[101583,"moren","noun","plural of Mora",1]],"inflections":[["moren","mora","plural"],["moren","more","plural"]]},"plagte":{"entries":[["plagte",null,null,null]],"senses":[[630707,"plagte","verb","inflection of plagen:",0],[630708,"plagte","verb","first/third-person singular preterite",1],[630709,"plagte","verb","first/third-person singular subjunctive II",2]],"inflections":[["plagte","plagen","past"]]},"resorption":{"entries":[["resorption",null,null,null,{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[197703,"resorption","noun","absorption",0,"f"],[197704,"resorption","noun","reabsorption",1,"f"],[197705,"resorption","noun","resorption",2,"f"]]},"schimmligster":{"entries":[["schimmligster",null,null,null]],"senses":[[544107,"schimmligster","adj","inflection of schimmlig:",0],[544108,"schimmligster","adj","strong/mixed nominative masculine singular superlative degree",1],[544109,"schi
6686,"lüpfet","verb","second-person plural subjunctive I of lüpfen",0]],"inflections":[["lüpfet","lüpfen","plural,second-person,subjunctive,subjunctive-i"]]},"odel":{"entries":[["odel",null,"/ˈoːdəl/","From Middle High German atel, ultimately from Proto-Germanic *adalaz. Cognate with English addle (“putrid”).",{"g":"m","decl":"|||s|-|-|-|-"}]],"senses":[[599244,"odel","noun","liquid manure",0,"m",["Bavaria"]]]},"schlicht":{"entries":[["schlicht",null,"/ʃlɪçt/","Chiefly Low German, also to a lesser degree Central German variant of schlecht. From Middle Low German slicht and northern Middle High German sliht (both “flat, straight, simple”), from Proto-Germanic *slihtaz, which see for cognates. Since the Late Middle Ages, schlecht/schlicht developed the sense “bad”, which became predominant over time, but did not displace the original one entirely. By the 17th century, attempts were made to reserve the i-variant specifically to the older meaning, but the semantic split between both forms was completed only during the 19th century. The adverbs schlechthin and schlechterdings (both “plainly, absolutely”) remain as relicts to this day."]],"senses":[[34296,"schlicht","adj","plain, simple, artless, natural",0],[34297,"schlicht","verb","second-person plural preterite of schleichen",1]],"inflections":[["schlicht","schleichen","indicative,plural,preterite,second-person"],["schlicht","schlichten","imperative,second-person,singular"]]},"seelen":{"entries":[["seelen",null,"/ˈzeːlən/",null]],"senses":[[42280,"seelen","noun","plural of Seele",0]],"inflections":[["seelen","seele","plural"]]},"stechbeitel":{"entries":[["stechbeitel",null,"/ˈʃtɛçˌbaɪ̯tl̩/","From stechen + Beitel (“wood chisel”).",{"g":"m","decl":"|||s|||n|"}]],"senses":[[627028,"stechbeitel","noun","chisel, wood chisel (a tool for caving wood, etc.)",0,"m"]]},"untrennbarer":{"entries":[["untrennbarer",null,null,null]],"senses":[[321282,"untrennbarer","adj","inflection of untrennbar:",0],[321283,"untrennbarer","adj","s
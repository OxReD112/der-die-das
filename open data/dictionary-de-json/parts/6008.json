,null,"/ˈʃniːfən/","First attested in the 17th century as schnieben, a Central German variant of schnauben. The form with f is analogous to schnaufen, which compare.\nIn spite of the late attestation, the form may be very old and continue the eu-variant of Proto-Germanic *sneufaną ~ *snūfaną (compare for this variation kriechen ~ krauchen). An alternative theory considers it a backformation from the strong past tense schnob, geschnoben by analogy with verbs of the class fliegen, flog, geflogen etc.",null,"haben"]],"senses":[[713638,"schniefen","verb","to sniff up snot through the nose",0,null,null,null,"intransitive"],[713639,"schniefen","verb","to make a sound similar to the above as an expression of sadness or pity",1,null,null,null,"intransitive"],[713640,"schniefen","verb","to sniff (drugs)",2,null,null,null,"transitive"]],"related_forms":[[65604,"schniefen","schniefnase","derived"]]},"schokopuddinge":{"entries":[["schokopuddinge",null,null,null]],"senses":[[612699,"schokopuddinge","noun","nominative/accusative/genitive plural of Schokopudding",0]],"inflections":[["schokopuddinge","schokopudding","plural"]]},"staatenloser":{"entries":[["staatenloser",null,"[ˈʃtaːtn̩ˌloːzɐ]","Substantivization of staatenlos (“stateless”).",{"g":"m","decl":"/1|1n|1m/1n|1n|1/1n|1/1n|1n|/1n"}]],"senses":[[313464,"staatenloser","adj","inflection of staatenlos:",0],[313465,"staatenloser","adj","strong/mixed nominative masculine singular",1],[313466,"staatenloser","adj","strong genitive/dative feminine singular",2],[313467,"staatenloser","adj","strong genitive plural",3],[313468,"staatenloser","noun","stateless person",4,"m"],[313469,"staatenloser","noun","inflection of Staatenlose:",5,"f"],[313470,"staatenloser","noun","strong genitive/dative singular",6,"m"],[313471,"staatenloser","noun","strong genitive plural",7,"m"]],"inflections":[["staatenloser","staatenlos","masculine,nominative,singular,strong"],["staatenloser","staatenlose","genitive"]]},"streikgelder":{"entries":[["streikgel
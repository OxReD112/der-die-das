],[119025,"hauchen","verb","to breathe out",1],[119026,"hauchen","noun","dative plural of Hauch",2,"m"]],"related_forms":[[50872,"hauchen","anhauchen","derived"],[50873,"hauchen","aushauchen","derived"],[50874,"hauchen","einhauchen","derived"]],"inflections":[["hauchen","hauch","dative,definite,plural"]]},"innehaltet":{"entries":[["innehaltet",null,null,null]],"senses":[[652133,"innehaltet","verb","inflection of innehalten:",0],[652134,"innehaltet","verb","second-person plural dependent present",1],[652135,"innehaltet","verb","second-person plural dependent subjunctive I",2]],"inflections":[["innehaltet","innehalten","indicative,plural,present,second-person,subordinate-clause"]]},"musealstes":{"entries":[["musealstes",null,null,null]],"senses":[[522098,"musealstes","adj","strong/mixed nominative/accusative neuter singular superlative degree of museal",0]],"inflections":[["musealstes","museal","neuter,nominative,singular,strong,superlative,without-article"]]},"pech":{"entries":[["pech",null,"/pɛç/","Etymology tree\nProto-Indo-European *pik-der.\nProto-Italic *piks\nLatin pixbor.\nProto-West Germanic *pik\nOld High German pëh\nMiddle High German pëch\nGerman Pech\nInherited from Middle High German pëch, bëch, from Old High German pëh, bëh, from Proto-West Germanic *pik (“pitch, tar, wood resin”), from Latin pix.\nThe form is unusual as it shows unshifted p-, but shifted -ch, even though the shift of initial p- to pf- occurred later than that of postvocalic -k to -ch. Theodor Frings therefore considered that the word was at first restricted to West Central German along the Rhine (which lacks the pf-shift) and only spread to Upper German slightly later when the shift was no longer active. (Middle High German pfich occurs only once in a Central German text from the 14th century and is thus probably a hypercorrection.)",{"g":"n","decl":"||/e|s/es|e|e|en|e"}]],"senses":[[12941,"pech","noun","pitch (sticky substance)",0,"n"],[12942,"pech","noun","bad luck, misfortune",1,"n"
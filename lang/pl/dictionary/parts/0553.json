,0,["figuratively"]]]},{"sense_index":3,"display_status":"translation","data":{"glosses":["(porównawczo wobec człowieka) pod pewnym względem wykazuje cechy (najczęściej negatywne) jak u zwierząt, np. bycie bezlitosnym, gwałtownym itp."],"id":"pl-Tier-de-noun-hoa55-Mm","examples":[{"text":"Ich arbeite und leide wie ein Tier für meine Erfolge.","bold_text_offsets":[[30,34]],"translation":"Pracuję i męczę się jak zwierzę, by osiągnąć sukces.","bold_translation_offsets":[[24,31]]}]}},{"sense_index":4,"display_status":"translation","data":{"glosses":["samica daniela, jelenia szlachetnego lub łosia"],"id":"pl-Tier-de-noun-ZQw5XaKH","examples":[{"text":"Würde ich diese sagenumwobene Landschaft sehen, in der vor 15 Jahren ein paar Tiere und Hirsche ausgesetzt worden waren?","bold_text_offsets":[[78,83]],"translation":"Gdybym mógł zobaczyć ten owiany legendami krajobraz, w którym 15 lat temu wypuszczono kilka samic saren i jeleni.","bold_translation_offsets":[[92,103]]}]},"labels":[[0,0,["hunting"]]]}]}],"dänisch":[{"record_id":1650,"word":"dänisch","pos":"adj","source_url":"https://pl.wiktionary.org/wiki/d%C3%A4nisch","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["duński"],"id":"pl-dänisch-de-adj-1xXBOajT"}}]}],"Säure":[{"record_id":2325,"word":"Säure","pos":"noun","gender":["f"],"source_url":"https://pl.wiktionary.org/wiki/S%C3%A4ure","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["kwas"],"id":"pl-Säure-de-noun-J5zxDUnJ","examples":[{"text":"Jede Säure besteht aus mindestens einem Wasserstoffatom und dem Säurerest.","bold_text_offsets":[[5,10],[64,69]],"translation":"Każdy kwas składa się z co najmniej jednego atomu wodoru oraz reszty kwasowej.","bold_translation_offsets":[[6,10],[69,73]]}]},"labels":[[0,0,["chemistry"]]]}]},{"record_id":2326,"word":"Säure","pos":"unknown","source_url":"https://pl.wiktionary.org/wiki/S%C3%A4ure","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["(w złoż
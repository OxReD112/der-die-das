{"format_version":1,"partition":16067,"records":{"ambitionen":{"entries":[["ambitionen",null,null,null]],"senses":[[48223,"ambitionen","noun","plural of Ambition",0,"f"]],"inflections":[["ambitionen","ambition","plural"]]},"eisern":{"entries":[["eisern",null,"/ˈaɪ̯zɐn/","From Middle High German īseren, īserīn, from Old High German īsarnīn, from Proto-Germanic *īsarnīnaz. Equivalent to Eiser (“iron”), older variant of Eisen + -en. Now reanalysable as Eisen (“iron”) + -ern, but historically eisern is itself one of the words that contributed to the development of this extended suffix -ern (see there)."]],"senses":[[204199,"eisern","adj","iron, ironclad, made of iron",0],[204200,"eisern","adj","staunch, unyielding",1,null,["figuratively"]]],"related_forms":[[52706,"eisern","eiserne krone","derived"],[52707,"eisern","eiserner bestand","derived"],[52708,"eisern","eiserner vorhang","derived"],[52709,"eisern","eiserner wille","derived"],[52710,"eisern","eisernes kreuz","derived"],[52711,"eisern","zum eisernen bestand gehören","derived"],[52712,"eisern","ehern","related"],[52713,"eisern","kupfern","related"],[52714,"eisern","silbern","related"],[52715,"eisern","golden","related"]]},"drehbewegungen":{"inflections":[["drehbewegungen","drehbewegung","plural"]]},"feldgrillen":{"inflections":[["feldgrillen","feldgrille","plural"]]}}}
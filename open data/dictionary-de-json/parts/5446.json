"]],[20982,"gerät","verb","third-person singular present of geraten",3]],"related_forms":[[31713,"gerät","gerätemäßig","derived"],[31714,"gerät","gerätebox","related"],[31715,"gerät","gerätehaus","related"],[31716,"gerät","geräteraum","related"],[31717,"gerät","geräteschrank","related"],[31718,"gerät","geräteschuppen","related"],[31719,"gerät","gerätschaft","related"]],"inflections":[["gerät","geraten","present,singular,third-person"]]},"knitterfrei":{"entries":[["knitterfrei",null,"/ˈknɪtɐˌfʁaɪ̯/","knittern + -frei"]],"senses":[[506235,"knitterfrei","adj","crease-resistant, wrinkle-free",0]]},"menschenunwürdigeres":{"entries":[["menschenunwürdigeres",null,null,null]],"senses":[[302371,"menschenunwürdigeres","adj","strong/mixed nominative/accusative neuter singular comparative degree of menschenunwürdig",0]],"inflections":[["menschenunwürdigeres","menschenunwürdig","comparative,neuter,nominative,singular,strong,without-article"]]},"pegidistinnen":{"entries":[["pegidistinnen",null,null,null]],"senses":[[634431,"pegidistinnen","noun","plural of Pegidistin",0]],"inflections":[["pegidistinnen","pegidistin","plural"]]},"prinzipienreiter":{"entries":[["prinzipienreiter",null,"/pʁɪnˈtsiːpi̯ənˌʁaɪ̯tɐ/","Prinzip + Reiter",{"g":"m","decl":"|||s|||n|"}]],"senses":[[683305,"prinzipienreiter","noun","stickler for principles; pedant",0,"m",["colloquial","derogatory"]]]},"schwerwiegenderer":{"entries":[["schwerwiegenderer",null,null,null]],"senses":[[310972,"schwerwiegenderer","adj","inflection of schwerwiegend:",0],[310973,"schwerwiegenderer","adj","strong/mixed nominative masculine singular comparative degree",1],[310974,"schwerwiegenderer","adj","strong genitive/dative feminine singular comparative degree",2],[310975,"schwerwiegenderer","adj","strong genitive plural comparative degree",3]],"inflections":[["schwerwiegenderer","schwerwiegend","comparative,masculine,nominative,singular,strong,without-article"]]},"verbaselte":{"entries":[["verbaselte",null,null,null]],"senses":[[39
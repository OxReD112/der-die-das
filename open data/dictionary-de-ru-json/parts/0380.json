en.","bold_text_offsets":[[106,112]],"translation":"связывают бремена тяжелые и неудобоносимые и возлагают на плечи людям, а сами не хотят и перстом двинуть их…","bold_translation_offsets":[[81,86]],"ref":"«Евангелие от Матфея», 23:4 // «Die Lutherbibel»"}]}},{"sense_index":1,"display_status":"translation","data":{"glosses":["хотеть, требовать, добиваться"],"id":"ru-wollen-de-verb-esF30zwN"}},{"sense_index":2,"display_status":"translation","data":{"glosses":["хотеть, собираться, намереваться"],"id":"ru-wollen-de-verb-B~OE~9j5","raw_tags":["указывает на отнесённость действия к будущему"]}},{"sense_index":3,"display_status":"translation","data":{"glosses":["утверждать"],"id":"ru-wollen-de-verb-GBTLNE3w","raw_tags":["выражает сомнение говорящего в справедливости чьих-либо слов"]}}]}],"Kopfrechnen":[{"record_id":14889,"word":"Kopfrechnen","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Kopfrechnen","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["устный счёт, решение задач в уме"],"id":"ru-Kopfrechnen-de-noun-9E1EWmk4"}}]}],"Erhitzer":[{"record_id":16752,"word":"Erhitzer","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Erhitzer","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["нагреватель"],"id":"ru-Erhitzer-de-noun-dArYNfH7"}}]}],"Verkehrsstau":[{"record_id":17189,"word":"Verkehrsstau","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Verkehrsstau","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["пробка, затор"],"id":"ru-Verkehrsstau-de-noun-EQk7y8sl"}}]}],"Profilmeter":[{"record_id":19309,"word":"Profilmeter","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Profilmeter","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["техн. профилометр"],"id":"ru-Profilmeter-de-noun-Zh8W-5Bc"}}]}],"-es":[{"record_id":19593,"word":"-es","pos":"suffix","source_url":"https://ru.wiktionary.org/wiki/-es","senses":[{"sense_index":0,"display
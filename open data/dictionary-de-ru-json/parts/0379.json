{"format_version":1,"partition":379,"records":{"Caprivi":[{"record_id":2185,"word":"Caprivi","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Caprivi","senses":[{"sense_index":0,"display_status":"no-gloss","data":{"id":"ru-Caprivi-de-noun-47DEQpj8","tags":["no-gloss"]}}]}],"Bruder":[{"record_id":2189,"word":"Bruder","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Bruder","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["брат"],"id":"ru-Bruder-de-noun-2ZMGRI6Y","examples":[{"text":"Ich aber sage euch: Wer mit seinem Bruder zürnet, der ist des Gerichts schuldig; wer aber zu seinem Bruder sagt: Racha! der ist des Rats schuldig; wer aber sagt: Du Narr! der ist des höllischen Feuers schuldig.","bold_text_offsets":[[35,41],[100,106]],"translation":"А Я говорю вам, что всякий, гневающийся на брата своего напрасно, подлежит суду; кто же скажет брату своему: «рака́», подлежит синедриону; а кто скажет: «безумный», подлежит геенне огненной.","bold_translation_offsets":[[43,48],[95,100]],"ref":"«Евангелие от Матфея», 5:22 // «The Luther Bible»"}]}},{"sense_index":1,"display_status":"translation","data":{"glosses":["перен. собрат, приятель, единомышленник"],"id":"ru-Bruder-de-noun-z2Wwxw6Z"}},{"sense_index":2,"display_status":"translation","data":{"glosses":["религ. брат (член религиозной общины), монах"],"id":"ru-Bruder-de-noun-Kso122Ud"}},{"sense_index":3,"display_status":"translation","data":{"glosses":["разг., презр. тип, субъект"],"id":"ru-Bruder-de-noun-WRwMplh8"}}]}],"Fuzzy":[{"record_id":3587,"word":"Fuzzy","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Fuzzy","senses":[{"sense_index":0,"display_status":"no-gloss","data":{"id":"ru-Fuzzy-de-noun-47DEQpj8","tags":["no-gloss"]}}]}],"Inguschisch":[{"record_id":4251,"word":"Inguschisch","pos":"noun","source_url":"https://ru.wiktionary.org/wiki/Inguschisch","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["ингушский язык"],"id":"ru-Inguschisc
ich was then still entirely predictable). In fact, some scholars consider that all continental forms go back to Old English hopian, introduced as a religious term by Anglo-Saxon missionaries. The word was at any rate absent from Upper German, where it only established itself in later Middle High German, gradually displacing the now obsolete gedingen. See English hope for more.",{"g":"n","decl":"|||s|-|-|-|-"},"haben"]],"senses":[[16148,"hoffen","verb","to hope",0,null,null,null,"intransitive"],[16149,"hoffen","noun","gerund of hoffen",1,"n"]]},"rasenderem":{"entries":[["rasenderem",null,null,null]],"senses":[[213327,"rasenderem","adj","strong dative masculine/neuter singular comparative degree of rasend",0]],"inflections":[["rasenderem","rasend","comparative,dative,masculine,singular,strong,without-article"]]},"vertagend":{"entries":[["vertagend",null,"[fɛʁˈtaːɡənt]",null]],"senses":[[347633,"vertagend","verb","present participle of vertagen",0]],"inflections":[["vertagend","vertagen","participle,present"]]},"beytritten":{"inflections":[["beytritten","beytritt","dative,definite,plural"]]},"dreikönigstagen":{"inflections":[["dreikönigstagen","dreikönigstag","dative,definite,plural"]]},"erstklassigsten":{"inflections":[["erstklassigsten","erstklassig","genitive,masculine,singular,strong,superlative,without-article"]]},"schwarzbrenne":{"inflections":[["schwarzbrenne","schwarzbrennen","first-person,indicative,present,singular,subordinate-clause"]]},"trierischstem":{"inflections":[["trierischstem","trierisch","dative,masculine,singular,strong,superlative,without-article"]]}}}
es":[["strafttet ab",null,null,null]],"senses":[[390715,"strafttet ab","verb","inflection of abstrafen:",0],[390716,"strafttet ab","verb","second-person plural preterite",1],[390717,"strafttet ab","verb","second-person plural subjunctive II",2]]},"unlustigstes":{"entries":[["unlustigstes",null,null,null]],"senses":[[568274,"unlustigstes","adj","strong/mixed nominative/accusative neuter singular superlative degree of unlustig",0]],"inflections":[["unlustigstes","unlustig","neuter,nominative,singular,strong,superlative,without-article"]]},"v":{"entries":[["v",null,"/faʊ̯/","For the origin of the letter, see v.\nOrthography and pronunciation\nGermanic f was pronounced [v] in some dialects of Middle High German and was predominantly spelt v. This voicing was later reversed stem-initially in most dialects and stem-internally in some (including Standard German). In inherited words, the spelling mostly switched back to f accordingly. This always happened before l, r, u, ü, but otherwise there remains a number of relicts. These are the prefix ver-, the words Frevel, Vater, Vetter, Vieh, viel, vier, Vogel, Volk, voll, von, vor, and their derivatives.\nIn native German proper nouns, initial V is always /f/, but the internal pronunciation is hard to predict and differs by region. For example, it is usually /f/ in northern German placenames (e.g. Hannover, Havel, Jever), but /v/ in western ones (e.g. Grevenbroich, Leverkusen, Overath).\nV was retained in words of foreign origin and its pronunciation varied. The contemporary standard is normally /v/, but always /f/ in Eva, Vau, Veilchen, Veit, Vettel, Vlies, Vogt. The words Vers, Vesper, Vize have /f/ in Germany, but usually /v/ in Austria. Both ways are de-facto standard in Evangelium, hieven, Larve, Nerven, Pulver (though dictionaries may recognise only one form or the other).",{"w":"v","g":"n","decl":"||||/s|/s|/s|/s","alt":[["n","||||/s|/s|/s|/s"],["n","||||/s|/s|/s|/s","V"]]}]],"senses":[[9763,"v","character","The twenty-second letter of the German alphabet, called Vau and written in the Latin script.",0]]},"verbrächten":{"entries":[["verbrächten",null,null,null]],"senses":[[344500,"verbrächten","verb","first-person plural subjunctive II of verbringen",0]],"inflections":[["verbrächten","verbringen","first-person,formal,plural,rare,subjunctive,subjunctive-ii"]]},"verordnungsdurchsetzungen":{"entries":[["verordnungsdurchsetzungen",null,"/fɛʁˈɔʁtnʊŋsˌdʊrçzɛtsʊŋən/",null]],"senses":[[695822,"verordnungsdurchsetzungen","noun","plural of Verordnungsdurchsetzung",0,"f"]],"inflections":[["verordnungsdurchsetzungen","verordnungsdurchsetzung","plural"]]},"verrücktheit":{"entries":[["verrücktheit",null,"/fɛɐ̯ˈʁʏkthaɪ̯t/","verrückt + -heit",{"g":"f","decl":"||||en|en|en|en"}]],"senses":[[634270,"verrücktheit","noun","craziness, madness",0,"f"]]},"widersachers":{"entries":[["widersachers",null,null,null]],"senses":[[50446,"widersachers","noun","genitive singular of Widersacher",0]],"inflections":[["widersachers","widersacher","genitive"]]},"abschasselet":{"inflections":[["abschasselet","abschasseln","plural,second-person,subjunctive,subjunctive-i,subordinate-clause"]]},"abzublitzen":{"inflections":[["abzublitzen","abblitzen","infinitive,infinitive-zu"]]},"anabole":{"inflections":[["anabole","anabol","feminine,nominative,singular,strong,without-article"]]},"aneckest":{"inflections":[["aneckest","anecken","second-person,singular,subjunctive,subjunctive-i,subordinate-clause"]]},"beichtgeheimnissen":{"inflections":[["beichtgeheimnissen","beichtgeheimnis","dative,definite,plural"]]},"biskottenkuchens":{"inflections":[["biskottenkuchens","biskottenkuchen","genitive"]]},"bollst":{"inflections":[["bollst","bellen","indicative,preterite,second-person,singular"]]},"boraxes":{"inflections":[["boraxes","borax","genitive"]]},"bücherschränken":{"inflections":[["bücherschränken","bücherschrank","dative,definite,plural"]]},"coulombschen":{"inflections":[["coulombschen","coulombsch","genitive,masculine,singular,st
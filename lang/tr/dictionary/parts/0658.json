lation":"Özellikle matematik alanında Leibniz adının doğrudan ilişkilendirildiği iki başarı vardır: ikili sayı sistemi ve sonsuz küçükler hesabı.","bold_translation_offsets":[[97,109]]}]},"labels":[[0,0,["mathematics"]]]}]}],"Einheiten":[{"record_id":7364,"word":"Einheiten","pos":"noun","source_url":"https://tr.wiktionary.org/wiki/Einheiten","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"form-description","data":{"glosses":["Einheit sözcüğünün çoğul çekimi"],"id":"tr-Einheiten-de-noun-wW7k0y-l","tags":["form-of"],"form_of":[{"word":"Einheit"}]}}]}],"Kirschbaum":[{"record_id":9727,"word":"Kirschbaum","pos":"name","source_url":"https://tr.wiktionary.org/wiki/Kirschbaum","source":"tr.wiktionary","gender":["m","f"],"senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["Bir soyadı."],"id":"tr-Kirschbaum-de-name-twAi7g4e"},"name_like":["person","soyadı / ad"],"shown":["Bir soyadı"]}]}],"willentlich":[{"record_id":11379,"word":"willentlich","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/willentlich","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"no-gloss","data":{"glosses":["Bu tanımın Türkçe çevirisi şimdilik Vikisözlük'te eksik hâldedir. Lütfen eklenmesine yardımcı olun ve sonrasında {{tanımisteniyor}} şablonunu kaldırın."],"id":"tr-willentlich-de-adj-9Eb2Fz7a"}}]}],"pekuniär":[{"record_id":11413,"word":"pekuniär","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/pekuni%C3%A4r","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"translation","data":{"glosses":["parasal"],"id":"tr-pekuniär-de-adj-DQj3btGv"}}]}],"zylindrisch":[{"record_id":11688,"word":"zylindrisch","pos":"adj","source_url":"https://tr.wiktionary.org/wiki/zylindrisch","source":"tr.wiktionary","senses":[{"sense_index":0,"display_status":"no-gloss","data":{"glosses":["Bu tanımın Türkçe çevirisi şimdilik Vikisözlük'te eksik hâldedir. Lütfen eklenmesine yardımcı olun ve sonrasında {{tanımisteniyor}} şablonun